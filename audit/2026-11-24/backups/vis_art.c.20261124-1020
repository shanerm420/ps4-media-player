/* vis_art.c - the painted visualizations.
 *
 * The simple looks in ui.c are built from rectangles, which is fine for a bar
 * graph and wrong for a wave, a flag or a body: the console's software renderer
 * has no shapes, so every curve ends up as a staircase. These looks are painted
 * into a pixel canvas instead - one buffer, real alpha, real edges - and handed
 * to the renderer as a single texture. On the console that is both smoother and
 * cheaper than the thousands of little fills it replaces.
 */

#include <math.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <SDL2/SDL.h>

#include "vis_art.h"
#include "appcfg.h"
#include "applog.h"
#include "ps_mark.h"

/* The look's settings live in config.ini (see src/appcfg.c for the defaults
 * and ranges); the quality ladder reports through the one log. */

#define ART_PI 3.14159265358979

static double band_at(const UiModel *m, double u);
static double wave_at(const UiModel *m, double u);
static void   art_col(double v, int *r, int *g, int *b);

/* ------------------------------------------------------------------ canvas -- */

typedef struct {
    unsigned char *p;         /* r,g,b,a per pixel (ABGR8888 in memory) */
    int            w, h;
} Cv;

static void cv_ell_soft(Cv *c, double cx, double cy, double rx, double ry,
                        int r, int g, int b, int a);

static unsigned char *cv_alloc(int w, int h)
{
    return (unsigned char *)malloc((size_t)w * (size_t)h * 4);
}

/* The canvas is kept between frames. Allocating a few megabytes every frame
 * was pointless work at best, and at worst it is what a heap that is already
 * fragmented needs least. */
static unsigned char *s_cv;
static size_t         s_cv_cap;
static size_t         s_cv_peak;

size_t vis_art_mem_peak(void)
{
    return s_cv_peak;
}

static unsigned char *cv_get(int w, int h)
{
    size_t need = (size_t)w * (size_t)h * 4;

    if (!s_cv || s_cv_cap < need) {
        free(s_cv);
        s_cv = cv_alloc(w, h);
        s_cv_cap = s_cv ? need : 0;
        if (s_cv_cap > s_cv_peak)
            s_cv_peak = s_cv_cap;      /* the paint buffer is the app's biggest
                                        * allocation, so its high-water mark is
                                        * the number worth reporting */
    }
    return s_cv;
}

/* Opaque write with no blending and no coverage maths: the hot loops - water,
 * cloth, the LED wall - write a million of these a frame. */
static void cv_put(Cv *c, int x, int y, int r, int g, int b)
{
    unsigned char *q;

    if (x < 0 || y < 0 || x >= c->w || y >= c->h)
        return;
    q = c->p + ((size_t)y * (size_t)c->w + (size_t)x) * 4;
    q[0] = (unsigned char)(r < 0 ? 0 : r > 255 ? 255 : r);
    q[1] = (unsigned char)(g < 0 ? 0 : g > 255 ? 255 : g);
    q[2] = (unsigned char)(b < 0 ? 0 : b > 255 ? 255 : b);
    q[3] = 255;
}

/* A table sine. Every painted look calls sine per pixel - the water twice, the
 * cloth once, the floor mirror once - and the libm call was the single largest
 * cost in all of them. 4096 entries is far more resolution than a 1080p frame
 * can show. */
static float s_sin[4096];
static int   s_sin_ready;

static void sin_build(void)
{
    int i;

    for (i = 0; i < 4096; i++)
        s_sin[i] = (float)sin((double)i * 6.283185307179586 / 4096.0);
    s_sin_ready = 1;
}

static double fsind(double a)
{
    int i;

    if (!s_sin_ready)
        sin_build();
    i = (int)(a * 651.8986469044033);          /* 4096 / 2pi */
    return (double)s_sin[i & 4095];
}

static double fcosd(double a)
{
    return fsind(a + 1.5707963267948966);
}

static int clampi(int v, int lo, int hi)
{
    return v < lo ? lo : v > hi ? hi : v;
}

/* A projected point can land thousands of pixels off the canvas, and a polygon
 * with one corner behind the eye used to be walked row by row across that whole
 * off-screen extent - the row loop and the line's bounding box both did, which
 * is where the first 3D build spent 350 ms a frame. Everything is clamped to
 * the canvas before it is walked, and a wild coordinate is brought into range
 * before the cast so the clamp itself cannot overflow. */
static int cv_i(double v)
{
    if (!(v == v))
        return 0;                        /* NaN */
    if (v >  1000000.0) return  1000000;
    if (v < -1000000.0) return -1000000;
    return (int)v;
}

static void cv_set(Cv *c, int x, int y, int r, int g, int b, int a)
{
    unsigned char *q;

    if (!c->p || x < 0 || y < 0 || x >= c->w || y >= c->h || a <= 0)
        return;
    q = c->p + ((size_t)y * c->w + x) * 4;
    if (a >= 255) {
        q[0] = (unsigned char)clampi(r, 0, 255);
        q[1] = (unsigned char)clampi(g, 0, 255);
        q[2] = (unsigned char)clampi(b, 0, 255);
        q[3] = 255;
        return;
    }
    q[0] = (unsigned char)((r * a + q[0] * (255 - a)) / 255);
    q[1] = (unsigned char)((g * a + q[1] * (255 - a)) / 255);
    q[2] = (unsigned char)((b * a + q[2] * (255 - a)) / 255);
    q[3] = 255;
}

/* Additive light: adds to the frame instead of covering it.
 *
 * Everything in the club's air is additive - beam cores, the glow round a
 * laser, flecks off the mirror ball, dust - because two crossing beams have to
 * be brighter where they cross, and src-over can only paint the second one over
 * the first. Nothing outside the club calls this, so no other look changes. */
static void cv_add(Cv *c, int x, int y, int r, int g, int b, int a)
{
    unsigned char *q;
    unsigned dr, dg, db;
    int      vr, vg, vb;

    if (!c->p || x < 0 || y < 0 || x >= c->w || y >= c->h || a <= 0)
        return;
    if (a > 255)
        a = 255;
    /* What a pixel gains does not depend on the pixel: these three products
     * divide by 255 for every write, and the club's air alone writes a million
     * and a half of them a frame. Worked out once per call instead - the same
     * integers, so the picture cannot move. */
    dr = (unsigned)((r * a) / 255);
    dg = (unsigned)((g * a) / 255);
    db = (unsigned)((b * a) / 255);
    q = c->p + ((size_t)y * (size_t)c->w + (size_t)x) * 4;
    vr = (int)q[0] + (int)dr;
    vg = (int)q[1] + (int)dg;
    vb = (int)q[2] + (int)db;
    q[0] = (unsigned char)(vr < 0 ? 0 : vr > 255 ? 255 : vr);
    q[1] = (unsigned char)(vg < 0 ? 0 : vg > 255 ? 255 : vg);
    q[2] = (unsigned char)(vb < 0 ? 0 : vb > 255 ? 255 : vb);
}

/* An additive beam sheet: a quad filled by scanline.
 *
 * This is the primitive the club's whole atmosphere is built from - a beam is
 * three of these at widening widths and falling strength, a laser core is one
 * at a couple of pixels. It is a *quad* and not a capsule on purpose: the
 * capsule version needs a square root per pixel for its round ends, and at
 * forty beams a frame that alone measured twelve milliseconds. A beam of light
 * in smoke does not need a round end; it needs an edge you cannot see, which
 * the two one-pixel feathers below give it. The far end is faded so a beam
 * thins as it travels instead of stopping dead at the floor. */
static void cv_beam_add(Cv *c, double x0, double y0, double x1, double y1,
                        double hw0, double hw1, int r, int g, int b, int a)
{
    double xs[4], ys[4], miny, maxy, invh;
    int    y, i, y_lo, y_hi;

    if (!c->p || a <= 0)
        return;
    xs[0] = x0 - hw0; ys[0] = y0;
    xs[1] = x0 + hw0; ys[1] = y0;
    xs[2] = x1 + hw1; ys[2] = y1;
    xs[3] = x1 - hw1; ys[3] = y1;

    miny = ys[0]; maxy = ys[0];
    for (i = 1; i < 4; i++) {
        if (ys[i] < miny) miny = ys[i];
        if (ys[i] > maxy) maxy = ys[i];
    }
    invh = maxy > miny ? 1.0 / (maxy - miny) : 0.0;
    y_lo = cv_i(miny);
    y_hi = cv_i(maxy) + 1;
    if (y_lo < 0) y_lo = 0;
    if (y_hi > c->h) y_hi = c->h;

    for (y = y_lo; y < y_hi; y++) {
        double yy = (double)y + 0.5, lo = 1e9, hi = -1e9, aa, inv;
        int    x_lo, x_hi, x;

        for (i = 0; i < 4; i++) {
            int    j  = (i + 1) & 3;
            double ay2 = ys[i], by2 = ys[j];

            if ((ay2 <= yy && by2 > yy) || (by2 <= yy && ay2 > yy)) {
                double t  = (yy - ay2) / (by2 - ay2);
                double xx = xs[i] + (xs[j] - xs[i]) * t;

                if (xx < lo) lo = xx;
                if (xx > hi) hi = xx;
            }
        }
        if (hi - lo < 0.6)
            continue;
        aa = (double)a * (1.0 - 0.45 * (yy - miny) * invh);
        if (aa < 1.0)
            continue;
        /* Across the beam it falls off toward both edges. Without this a beam
         * is a translucent rectangle with two visible sides - which is exactly
         * what it looked like - and with it the same pixels read as light. */
        inv = 1.0 / (hi - lo);
        x_lo = cv_i(lo);
        x_hi = cv_i(hi) + 1;
        if (x_lo < 0) x_lo = 0;
        if (x_hi > c->w) x_hi = c->w;
        for (x = x_lo; x < x_hi; x++) {
            double u  = ((double)x + 0.5 - lo) * inv;
            double prof = 1.0 - fabs(u * 2.0 - 1.0);

            if (prof <= 0.02)
                continue;
            cv_add(c, x, y, r, g, b, (int)(aa * prof * 1.45));
        }
    }
}

static void cv_fill(Cv *c, int r, int g, int b)
{
    int i, n;

    if (!c->p)
        return;
    n = c->w * c->h;
    for (i = 0; i < n; i++) {
        c->p[i * 4 + 0] = (unsigned char)clampi(r, 0, 255);
        c->p[i * 4 + 1] = (unsigned char)clampi(g, 0, 255);
        c->p[i * 4 + 2] = (unsigned char)clampi(b, 0, 255);
        c->p[i * 4 + 3] = 255;
    }
}

static void cv_vgrad(Cv *c, int x, int y, int w, int h,
                     int r0, int g0, int b0, int r1, int g1, int b1)
{
    int j, i;

    for (j = 0; j < h; j++) {
        double u = h > 1 ? (double)j / (double)(h - 1) : 0.0;
        int cr = (int)(r0 + (r1 - r0) * u);
        int cg = (int)(g0 + (g1 - g0) * u);
        int cb = (int)(b0 + (b1 - b0) * u);

        for (i = 0; i < w; i++)
            cv_set(c, x + i, y + j, cr, cg, cb, 255);
    }
}

static void cv_rect(Cv *c, int x, int y, int w, int h, int r, int g, int b, int a)
{
    int i, j;

    for (j = 0; j < h; j++)
        for (i = 0; i < w; i++)
            cv_set(c, x + i, y + j, r, g, b, a);
}

/* soft round falloff: haze, lamps, bloom, and the light a body throws on a floor */
/* One block of a soft stamp, written the way the shape loops actually use it.
 *
 * cv_soft alone used to account for two thirds of every cv_set call in a Rave
 * frame - 161 million in sixty frames - because a stamp called it once per
 * pixel of the block, and each of those calls re-tested the bounds, re-clamped
 * the three colour channels and then threw the colour away. This does the
 * bounds test once for the whole block and the clamp once per stamp, and writes
 * row by row through a pointer. The arithmetic is cv_set's, digit for digit, so
 * the picture cannot move; anything that is not wholly inside the canvas still
 * goes through cv_set so clipping behaves exactly as it did. */
static inline void cv_blk(Cv *c, int x, int y, int block,
                          int r, int g, int b, int al)
{
    int by, bx;
    int xe = x + block, ye = y + block;

    if (x >= 0 && y >= 0 && xe <= c->w && ye <= c->h) {
        if (al >= 255) {
            uint32_t v = (uint32_t)r | ((uint32_t)g << 8)
                       | ((uint32_t)b << 16) | 0xFF000000u;

            for (by = y; by < ye; by++) {
                unsigned char *q = c->p + ((size_t)by * (size_t)c->w + x) * 4;

                for (bx = 0; bx < block; bx++, q += 4)
                    *(uint32_t *)q = v;
            }
        } else {
            for (by = y; by < ye; by++) {
                unsigned char *q = c->p + ((size_t)by * (size_t)c->w + x) * 4;

                const int ia = 255 - al;

                for (bx = 0; bx < block; bx++, q += 4) {
                    uint32_t v0, v1;
                    int      dr, dg, db;

                    memcpy(&v0, q, 4);
                    dr = (int)(v0 & 0xFFu);
                    dg = (int)((v0 >> 8) & 0xFFu);
                    db = (int)((v0 >> 16) & 0xFFu);
                    v1 = (uint32_t)((r * al + dr * ia) / 255)
                       | ((uint32_t)((g * al + dg * ia) / 255) << 8)
                       | ((uint32_t)((b * al + db * ia) / 255) << 16)
                       | 0xFF000000u;
                    memcpy(q, &v1, 4);
                }
            }
        }
        return;
    }

    for (by = 0; by < block; by++)
        for (bx = 0; bx < block; bx++)
            cv_set(c, x + bx, y + by, r, g, b, al);
}

static void cv_soft(Cv *c, double cx, double cy, double rad,
                    int r, int g, int b, int a)
{
    int x, y, block = 1;

    /* A wide falloff is smooth by nature, so it is computed on a coarse grid
     * and stamped: at full resolution a big haze would otherwise cost more
     * than the rest of the frame put together. */
    if (rad > 170.0)
        block = 4;
    else if (rad > 90.0)
        block = 3;
    else if (rad > 34.0)
        block = 2;

    r = clampi(r, 0, 255);
    g = clampi(g, 0, 255);
    b = clampi(b, 0, 255);

    int y_lo = cv_i(cy - rad), y_hi = cv_i(cy + rad);
    int x_lo = cv_i(cx - rad), x_hi = cv_i(cx + rad);

    if (y_lo < -4) y_lo = -4;
    if (x_lo < -4) x_lo = -4;
    if (y_hi > c->h + 4) y_hi = c->h + 4;
    if (x_hi > c->w + 4) x_hi = c->w + 4;
    for (y = y_lo; y <= y_hi; y += block) {
        for (x = x_lo; x <= x_hi; x += block) {
            double dx = (x + block * 0.5 - cx) / rad;
            double dy = (y + block * 0.5 - cy) / rad;
            double d = dx * dx + dy * dy;
            int    al;

            if (d >= 1.0)
                continue;
            d = 1.0 - sqrt(d);
            al = (int)(a * d * d);
            if (al <= 1)
                continue;
            cv_blk(c, x, y, block, r, g, b, al);
        }
    }
}

/* a shaded sphere: body color under a light from the upper left */
static void cv_ball(Cv *c, double cx, double cy, double rad,
                    int br, int bg, int bl, int lr, int lg, int lb)
{
    int x, y;

    if (rad < 0.6)
        return;
    for (y = (int)(cy - rad - 1); y <= (int)(cy + rad + 1); y++) {
        for (x = (int)(cx - rad - 1); x <= (int)(cx + rad + 1); x++) {
            double dx = (x + 0.5 - cx) / rad, dy = (y + 0.5 - cy) / rad;
            double d2 = dx * dx + dy * dy, d, lam, sh, spec, cov;

            if (d2 > 1.4)
                continue;
            d = sqrt(d2);
            cov = (1.0 - d) * rad + 0.6;
            if (cov <= 0.0)
                continue;
            if (cov > 1.0)
                cov = 1.0;
            if (d2 > 1.0)
                d2 = 1.0;
            lam = (-dx * 0.50) + (-dy * 0.62) + sqrt(1.0 - d2) * 0.62;
            if (lam < 0.0)
                lam = 0.0;
            sh = 0.24 + 0.76 * lam;
            spec = pow(lam, 14.0);
            cv_set(c, x, y,
                   (int)(br * sh + lr * spec),
                   (int)(bg * sh + lg * spec),
                   (int)(bl * sh + lb * spec),
                   (int)(255 * cov));
        }
    }
}

static void cv_ring(Cv *c, double cx, double cy, double rad, double thick,
                    int r, int g, int b, int a)
{
    int x, y;
    double outer = rad + thick / 2.0 + 1.0;

    for (y = (int)(cy - outer); y <= (int)(cy + outer); y++) {
        for (x = (int)(cx - outer); x <= (int)(cx + outer); x++) {
            double dx = x + 0.5 - cx, dy = y + 0.5 - cy;
            double d = sqrt(dx * dx + dy * dy);
            double cov = thick / 2.0 + 0.6 - fabs(d - rad);

            if (cov <= 0.0)
                continue;
            if (cov > 1.0)
                cov = 1.0;
            cv_set(c, x, y, r, g, b, (int)(a * cov));
        }
    }
}

static void cv_line(Cv *c, double x0, double y0, double x1, double y1,
                    double thick, int r, int g, int b, int a)
{
    double half = thick / 2.0;
    double vx = x1 - x0, vy = y1 - y0;
    double len2 = vx * vx + vy * vy;
    double inv2 = len2 > 0.0001 ? 1.0 / len2 : 0.0;
    int    x, y;

    if (thick <= 0.0 || a <= 0)
        return;

    /* The scan follows the line instead of boxing it.
     *
     * This used to walk the whole bounding rectangle of the segment and ask,
     * per pixel, whether it was inside the line. For a diagonal that rectangle
     * is the entire canvas, so one edge cost a quarter of a million square
     * roots - and with four thousand edges a frame that was most of the frame
     * time. Walking the long axis and stepping across the line only as far as
     * its own width reaches touches the pixels that can possibly be lit, which
     * is the band plus the two round ends. The coverage maths is unchanged, so
     * the edges are exactly as smooth as they were. */
    if (fabs(vx) >= fabs(vy)) {
        double slope = vx != 0.0 ? vy / vx : 0.0;
        double dyh   = half * sqrt(1.0 + slope * slope) + 1.0;
        int    lo = cv_i((x0 < x1 ? x0 : x1) - half - 2.0);
        int    hi = cv_i((x0 > x1 ? x0 : x1) + half + 2.0);

        if (lo < 0) lo = 0;
        if (hi > c->w - 1) hi = c->w - 1;
        for (x = lo; x <= hi; x++) {
            double xc = x + 0.5;
            double t  = vx != 0.0 ? (xc - x0) / vx : 0.0;
            double yc;
            int    y_lo, y_hi;

            if (t < 0.0) t = 0.0;
            if (t > 1.0) t = 1.0;
            yc   = y0 + vy * t;
            y_lo = cv_i(yc - dyh - 1.0);
            y_hi = cv_i(yc + dyh + 1.0);
            if (y_lo < 0) y_lo = 0;
            if (y_hi > c->h - 1) y_hi = c->h - 1;
            for (y = y_lo; y <= y_hi; y++) {
                double px_ = xc - x0, py_ = y + 0.5 - y0;
                double u = (px_ * vx + py_ * vy) * inv2;
                double ax, ay, d, cov;

                if (u < 0.0) u = 0.0;
                if (u > 1.0) u = 1.0;
                ax = px_ - vx * u;
                ay = py_ - vy * u;
                d  = sqrt(ax * ax + ay * ay);
                cov = half + 0.6 - d;
                if (cov <= 0.0)
                    continue;
                if (cov > 1.0)
                    cov = 1.0;
                cv_set(c, x, y, r, g, b, (int)(a * cov));
            }
        }
    } else {
        double slope = vy != 0.0 ? vx / vy : 0.0;
        double dxh   = half * sqrt(1.0 + slope * slope) + 1.0;
        int    lo = cv_i((y0 < y1 ? y0 : y1) - half - 2.0);
        int    hi = cv_i((y0 > y1 ? y0 : y1) + half + 2.0);

        if (lo < 0) lo = 0;
        if (hi > c->h - 1) hi = c->h - 1;
        for (y = lo; y <= hi; y++) {
            double yc = y + 0.5;
            double t  = vy != 0.0 ? (yc - y0) / vy : 0.0;
            double xc;
            int    x_lo, x_hi;

            if (t < 0.0) t = 0.0;
            if (t > 1.0) t = 1.0;
            xc   = x0 + vx * t;
            x_lo = cv_i(xc - dxh - 1.0);
            x_hi = cv_i(xc + dxh + 1.0);
            if (x_lo < 0) x_lo = 0;
            if (x_hi > c->w - 1) x_hi = c->w - 1;
            for (x = x_lo; x <= x_hi; x++) {
                double px_ = x + 0.5 - x0, py_ = yc - y0;
                double u = (px_ * vx + py_ * vy) * inv2;
                double ax, ay, d, cov;

                if (u < 0.0) u = 0.0;
                if (u > 1.0) u = 1.0;
                ax = px_ - vx * u;
                ay = py_ - vy * u;
                d  = sqrt(ax * ax + ay * ay);
                cov = half + 0.6 - d;
                if (cov <= 0.0)
                    continue;
                if (cov > 1.0)
                    cov = 1.0;
                cv_set(c, x, y, r, g, b, (int)(a * cov));
            }
        }
    }
}

/* A limb that changes thickness along its length: wide at the shoulder, narrow
 * at the wrist. This single primitive is what stopped every figure looking
 * like sticks pushed together. */
static void cv_taper(Cv *c, double x0, double y0, double x1, double y1,
                     double w0, double w1, int r, int g, int b, int a)
{
    double vx = x1 - x0, vy = y1 - y0;
    double len2 = vx * vx + vy * vy;
    double inv2 = len2 > 0.0001 ? 1.0 / len2 : 0.0;
    double maxr = (w0 > w1 ? w0 : w1) + 2.0;
    int    x, y;

    if (a <= 0 || maxr <= 0.0)
        return;

    /* Swept along the long axis for the same reason as cv_line: the old
     * rectangle scan paid for the empty corners of every limb. */
    if (fabs(vx) >= fabs(vy)) {
        int lo = cv_i((x0 < x1 ? x0 : x1) - maxr);
        int hi = cv_i((x0 > x1 ? x0 : x1) + maxr);

        if (lo < 0) lo = 0;
        if (hi > c->w - 1) hi = c->w - 1;
        for (x = lo; x <= hi; x++) {
            double xc = x + 0.5;
            double t  = vx != 0.0 ? (xc - x0) / vx : 0.0;
            double rad, yc, dyh;
            int    y_lo, y_hi;

            if (t < 0.0) t = 0.0;
            if (t > 1.0) t = 1.0;
            rad = w0 + (w1 - w0) * t;
            yc  = y0 + vy * t;
            dyh = rad * (1.0 + fabs(vy / (vx != 0.0 ? vx : 1.0))) + 2.0;
            y_lo = cv_i(yc - dyh);
            y_hi = cv_i(yc + dyh);
            if (y_lo < 0) y_lo = 0;
            if (y_hi > c->h - 1) y_hi = c->h - 1;
            for (y = y_lo; y <= y_hi; y++) {
                double px_ = xc - x0, py_ = y + 0.5 - y0;
                double u = (px_ * vx + py_ * vy) * inv2;
                double ax, ay, d, rr, cov;

                if (u < 0.0) u = 0.0;
                if (u > 1.0) u = 1.0;
                ax = px_ - vx * u;
                ay = py_ - vy * u;
                d  = sqrt(ax * ax + ay * ay);
                rr = w0 + (w1 - w0) * u;
                cov = rr + 0.7 - d;
                if (cov <= 0.0)
                    continue;
                if (cov > 1.0)
                    cov = 1.0;
                cv_set(c, x, y, r, g, b, (int)(a * cov));
            }
        }
    } else {
        int lo = cv_i((y0 < y1 ? y0 : y1) - maxr);
        int hi = cv_i((y0 > y1 ? y0 : y1) + maxr);

        if (lo < 0) lo = 0;
        if (hi > c->h - 1) hi = c->h - 1;
        for (y = lo; y <= hi; y++) {
            double yc = y + 0.5;
            double t  = vy != 0.0 ? (yc - y0) / vy : 0.0;
            double rad, xc, dxh;
            int    x_lo, x_hi;

            if (t < 0.0) t = 0.0;
            if (t > 1.0) t = 1.0;
            rad = w0 + (w1 - w0) * t;
            xc  = x0 + vx * t;
            dxh = rad * (1.0 + fabs(vx / (vy != 0.0 ? vy : 1.0))) + 2.0;
            x_lo = cv_i(xc - dxh);
            x_hi = cv_i(xc + dxh);
            if (x_lo < 0) x_lo = 0;
            if (x_hi > c->w - 1) x_hi = c->w - 1;
            for (x = x_lo; x <= x_hi; x++) {
                double px_ = x + 0.5 - x0, py_ = yc - y0;
                double u = (px_ * vx + py_ * vy) * inv2;
                double ax, ay, d, rr, cov;

                if (u < 0.0) u = 0.0;
                if (u > 1.0) u = 1.0;
                ax = px_ - vx * u;
                ay = py_ - vy * u;
                d  = sqrt(ax * ax + ay * ay);
                rr = w0 + (w1 - w0) * u;
                cov = rr + 0.7 - d;
                if (cov <= 0.0)
                    continue;
                if (cov > 1.0)
                    cov = 1.0;
                cv_set(c, x, y, r, g, b, (int)(a * cov));
            }
        }
    }
}

/* filled polygon with edge coverage, for cloth, sails, stars and hair */
static void cv_poly(Cv *c, const double *xs, const double *ys, int n,
                    int r, int g, int b, int a)
{
    double miny = ys[0], maxy = ys[0];
    double xc[32];
    int y, i;

    for (i = 1; i < n; i++) {
        if (ys[i] < miny) miny = ys[i];
        if (ys[i] > maxy) maxy = ys[i];
    }
    {
    int y_lo = cv_i(miny), y_hi = cv_i(maxy) + 1;

    if (y_lo < 0) y_lo = 0;
    if (y_hi > c->h) y_hi = c->h;
    for (y = y_lo; y < y_hi; y++) {
        int nc = 0, k;

        for (i = 0; i < n; i++) {
            int    j = (i + 1) % n;
            double yy = y + 0.5;

            if ((ys[i] <= yy && ys[j] > yy) || (ys[j] <= yy && ys[i] > yy)) {
                double t = (yy - ys[i]) / (ys[j] - ys[i]);

                if (nc < 30)
                    xc[nc++] = xs[i] + t * (xs[j] - xs[i]);
            }
        }
        for (k = 1; k < nc; k++) {         /* insertion sort, tiny arrays */
            double v = xc[k];
            int    m = k - 1;

            while (m >= 0 && xc[m] > v) {
                xc[m + 1] = xc[m];
                m--;
            }
            xc[m + 1] = v;
        }
        for (k = 0; k + 1 < nc; k += 2) {
            int x0, x1;

            if (xc[k + 1] < 0.0 || xc[k] > (double)c->w)
                continue;
            x0 = xc[k] < 0.0 ? 0 : (int)floor(xc[k]);
            x1 = xc[k + 1] > (double)c->w ? c->w : (int)ceil(xc[k + 1]);
            if (x1 > c->w) x1 = c->w;

            for (i = x0; i < x1; i++) {
                double l = i > xc[k] ? (double)i : xc[k];
                double rr = i + 1 < xc[k + 1] ? (double)(i + 1) : xc[k + 1];
                double cov = rr - l;

                if (cov > 1.0)
                    cov = 1.0;
                if (cov > 0.0)
                    cv_set(c, i, y, r, g, b, (int)(a * cov));
            }
        }
    }
    }
}

/* A point inside a quad, given its two texture coordinates. The corners must
 * arrive in winding order: c0 (0,0), c1 (1,0), c2 (1,1), c3 (0,1). */
static void quad_pt(const double *xs, const double *ys, double u, double v,
                    double *ox, double *oy)
{
    double w0 = (1.0 - u) * (1.0 - v), w1 = u * (1.0 - v);
    double w2 = u * v, w3 = (1.0 - u) * v;

    *ox = xs[0] * w0 + xs[1] * w1 + xs[2] * w2 + xs[3] * w3;
    *oy = ys[0] * w0 + ys[1] * w1 + ys[2] * w2 + ys[3] * w3;
}

/* A quad filled like a panel instead of a sheet of tint.
 *
 * The tesseract's glass faces used to be one flat alpha wash, which at full
 * resolution reads as a sheet of colored plastic and nothing more. This fills
 * the same quad with a depth gradient - darker where the glass turns away from
 * the eye - and then lays a fine grid of seams across it, so each face reads as
 * panelled glass with structure behind it. The fill walks scanlines and takes
 * the two edge crossings, so it costs the pane's own area rather than the
 * bounding box of a rotated square. */
static void cv_quad_tex(Cv *c, const double *xs, const double *ys,
                        int r0, int g0, int b0, int r1, int g1, int b1,
                        int a, int seam_a, int cells)
{
    double miny = ys[0], maxy = ys[0];
    int    y, i, k, y_lo, y_hi;

    if (!c->p || a <= 0)
        return;
    for (i = 1; i < 4; i++) {
        if (ys[i] < miny) miny = ys[i];
        if (ys[i] > maxy) maxy = ys[i];
    }
    y_lo = cv_i(miny);
    y_hi = cv_i(maxy) + 1;
    if (y_lo < 0) y_lo = 0;
    if (y_hi > c->h) y_hi = c->h;
    if (y_hi <= y_lo || maxy - miny < 1.0)
        return;

    for (y = y_lo; y < y_hi; y++) {
        double yy = y + 0.5, lo = 1e9, hi = -1e9, v, inv;
        int    rr, gg, bb, x0, x1;

        for (i = 0; i < 4; i++) {
            int    j  = (i + 1) & 3;
            double ay = ys[i], by = ys[j];

            if ((ay <= yy && by > yy) || (by <= yy && ay > yy)) {
                double t = (yy - ay) / (by - ay);
                double x = xs[i] + (xs[j] - xs[i]) * t;

                if (x < lo) lo = x;
                if (x > hi) hi = x;
            }
        }
        if (hi - lo < 0.6)
            continue;

        v   = (yy - miny) / (maxy - miny);
        inv = 1.0 / (hi - lo);
        rr  = (int)(r0 + (double)(r1 - r0) * v);
        gg  = (int)(g0 + (double)(g1 - g0) * v);
        bb  = (int)(b0 + (double)(b1 - b0) * v);

        x0 = lo < 0.0 ? 0 : (int)lo;
        x1 = hi > (double)c->w ? c->w : (int)ceil(hi);
        if (x1 > c->w) x1 = c->w;
        for (i = x0; i < x1; i++) {
            double u  = ((double)i + 0.5 - lo) * inv;
            double ef = u < 0.035 ? 0.40 + u * 17.0
                      : u > 0.965 ? 0.40 + (1.0 - u) * 17.0 : 1.0;

            if (ef > 1.0)
                ef = 1.0;
            cv_set(c, i, y, rr, gg, bb, (int)((double)a * ef));
        }
    }

    /* the seams: fine panel lines, laid with the same bilinear map the fill
     * used, so they follow the quad however it is turned */
    for (k = 1; k < cells; k++) {
        double u = (double)k / (double)cells;
        double ax, ay, bx, by;

        quad_pt(xs, ys, u, 0.0, &ax, &ay);
        quad_pt(xs, ys, u, 1.0, &bx, &by);
        cv_line(c, ax, ay, bx, by, 0.8, 150, 205, 250, seam_a);

        quad_pt(xs, ys, 0.0, u, &ax, &ay);
        quad_pt(xs, ys, 1.0, u, &bx, &by);
        cv_line(c, ax, ay, bx, by, 0.8, 150, 205, 250, seam_a);
    }
}

static void star_shape(Cv *c, double cx, double cy, double rad, double rot,
                       int r, int g, int b, int a)
{
    double xs[10], ys[10];
    int    i;

    for (i = 0; i < 10; i++) {
        double an = rot + (double)i * ART_PI / 5.0 - ART_PI / 2.0;
        double rr = (i & 1) ? rad * 0.44 : rad;

        xs[i] = cx + cos(an) * rr;
        ys[i] = cy + sin(an) * rr;
    }
    cv_poly(c, xs, ys, 10, r, g, b, a);
}

/* ------------------------------------------------------------------ shared -- */

static SDL_Texture *s_tex;
static int          s_tex_w, s_tex_h;
static unsigned char *s_up;
static size_t         s_up_cap;

/* Bilinear expansion of the canvas to the frame.
 *
 * The reduced-quality path paints at half or a third of the frame, and a
 * nearest-neighbour expansion of that is exactly what "boxy" means: each
 * painted pixel becomes a hard square four or nine times its size, so every
 * curve turns into a staircase and every glow into a grid. This filter reads
 * four neighbours and blends, which is what the eye expects, and it is done
 * separably - one vertical blend of two source rows per output row, then a
 * horizontal pass - so the cost stays around the price of the copy it
 * replaces. */
static int  *s_col0, *s_col1, *s_colf;
static int   s_col_w, s_col_sw;
static unsigned char *s_vrow;
static size_t s_vrow_cap;

static void col_table(int w, int sw)
{
    int x;

    if (s_col_w == w && s_col_sw == sw && s_col0)
        return;
    free(s_col0);
    free(s_col1);
    free(s_colf);
    s_col0 = (int *)malloc(sizeof(int) * (size_t)w);
    s_col1 = (int *)malloc(sizeof(int) * (size_t)w);
    s_colf = (int *)malloc(sizeof(int) * (size_t)w);
    s_col_w = s_col0 && s_col1 && s_colf ? w : 0;
    s_col_sw = sw;
    if (!s_col_w)
        return;
    for (x = 0; x < w; x++) {
        long num = (long)x * sw;

        s_col0[x] = (int)(num / w);
        s_col1[x] = s_col0[x] + 1 < sw ? s_col0[x] + 1 : sw - 1;
        s_colf[x] = (int)(((num % w) * 256) / w);
    }
}

static int upscale_bilinear(const Cv *src, unsigned char *dst, int w, int h)
{
    int x, y, c, sw = src->w, sh = src->h;
    size_t need = (size_t)sw * 3;

    if (!src->p || sw < 1 || sh < 1)
        return 0;
    col_table(w, sw);
    if (!s_col_w)
        return 0;
    if (!s_vrow || s_vrow_cap < need) {
        free(s_vrow);
        s_vrow = (unsigned char *)malloc(need);
        s_vrow_cap = s_vrow ? need : 0;
    }
    if (!s_vrow)
        return 0;

    for (y = 0; y < h; y++) {
        long   num = (long)y * sh;
        int    sy0 = (int)(num / h);
        int    sy1 = sy0 + 1 < sh ? sy0 + 1 : sh - 1;
        int    fy  = (int)(((num % h) * 256) / h);
        const unsigned char *ra = src->p + (size_t)sy0 * (size_t)sw * 4;
        const unsigned char *rb = src->p + (size_t)sy1 * (size_t)sw * 4;
        unsigned char *drow = dst + (size_t)y * (size_t)w * 4;

        for (x = 0; x < sw; x++) {
            for (c = 0; c < 3; c++) {
                int a = ra[x * 4 + c], b = rb[x * 4 + c];

                s_vrow[x * 3 + c] = (unsigned char)(a + (((b - a) * fy) >> 8));
            }
        }
        for (x = 0; x < w; x++) {
            int    i0 = s_col0[x] * 3, i1 = s_col1[x] * 3;
            int    f  = s_colf[x];

            drow[x * 4 + 0] = (unsigned char)(s_vrow[i0] + (((s_vrow[i1] - s_vrow[i0]) * f) >> 8));
            drow[x * 4 + 1] = (unsigned char)(s_vrow[i0 + 1] + (((s_vrow[i1 + 1] - s_vrow[i0 + 1]) * f) >> 8));
            drow[x * 4 + 2] = (unsigned char)(s_vrow[i0 + 2] + (((s_vrow[i1 + 2] - s_vrow[i0 + 2]) * f) >> 8));
            drow[x * 4 + 3] = 255;
        }
    }
    return 1;
}

/* Puts the canvas on screen at the frame's own pixel size.
 *
 * When the canvas is smaller than the frame - which is what happens when the
 * quality step below has reduced it - the expansion is done here, in software,
 * because the blit must be 1:1: a scaled blit is the renderer's slow path, the
 * same one that was costing the background 45 ms a frame. */
static unsigned long long s_a3_rv_calls, s_a3_rv_bakes, s_a3_rv_alloc_fail;
static unsigned long long s_a3_rv_bytes;
static unsigned long long s_a3_pr_calls, s_a3_pr_upscales, s_a3_pr_uploads;
static unsigned long long s_a3_pr_texcreates, s_a3_pr_copies;
static unsigned long long s_a3_pr_upscale_bytes, s_a3_pr_upload_bytes;
static unsigned long long s_a3_frames;
static int s_a3_style = -1;
static int s_a3_step = -1;

static int art_present(SDL_Renderer *r, Cv *c, int x, int y, int w, int h)
{
    SDL_Rect dst;
    Cv       out;

    s_a3_pr_calls++;

    if (!c->p || w < 1 || h < 1)
        return 0;

    out = *c;
    if (c->w != w || c->h != h) {
        size_t need = (size_t)w * (size_t)h * 4;

        if (!s_up || s_up_cap < need) {
            free(s_up);
            s_up = cv_alloc(w, h);
            s_up_cap = s_up ? need : 0;
        }
        if (!s_up || !upscale_bilinear(c, s_up, w, h))
            return 0;
        s_a3_pr_upscales++;
        s_a3_pr_upscale_bytes += (unsigned long long)need;
        out.p = s_up;
        out.w = w;
        out.h = h;
    }

    if (!s_tex || s_tex_w != out.w || s_tex_h != out.h) {
        if (s_tex) {
            SDL_DestroyTexture(s_tex);
            s_tex = NULL;
        }
        s_tex = SDL_CreateTexture(r, SDL_PIXELFORMAT_ABGR8888,
                                  SDL_TEXTUREACCESS_STREAMING, out.w, out.h);
        s_tex_w = out.w;
        s_tex_h = out.h;
        s_a3_pr_texcreates++;
    }
    if (!s_tex)
        return 0;

    s_a3_pr_uploads++;
    s_a3_pr_upload_bytes += (unsigned long long)out.w *
                            (unsigned long long)out.h * 4ULL;
    SDL_UpdateTexture(s_tex, NULL, out.p, out.w * 4);
    SDL_SetTextureBlendMode(s_tex, SDL_BLENDMODE_NONE);
    dst.x = x; dst.y = y; dst.w = w; dst.h = h;
    SDL_RenderCopy(r, s_tex, NULL, &dst);
    s_a3_pr_copies++;
    return 1;
}

/* -------------------------------------------------------------- finish kit -- */

/* Mirrors everything above a line into the floor below it, dimmed and, if
 * wanted, wobbling - which is most of what makes a flat drawing look like a
 * lit room. */
static void fx_reflect(Cv *c, double horizon, double strength, double wobble)
{
    int y0 = (int)horizon, x, y;

    if (y0 <= 0 || y0 >= c->h || !c->p)
        return;
    for (y = y0 + 1; y < c->h; y++) {
        int    src = 2 * y0 - y;
        double d = (double)(y - y0) / (double)(c->h - y0);
        int    a = (int)(strength * (1.0 - d) * (1.0 - d) * 255.0);

        if (src < 0)
            break;
        if (a <= 0)
            continue;
        for (x = 0; x < c->w; x++) {
            double wsh = fsind((double)y * 0.09 + (double)x * 0.006) * wobble * 3.0;
            int    base_x = x + (int)wsh;
            int    r3 = 0, g3 = 0, b3 = 0, n = 0, d3;
            unsigned char *dp = c->p + ((size_t)y * (size_t)c->w + (size_t)x) * 4;

            /* three taps, so the mirror blurs instead of tearing */
            for (d3 = -2; d3 <= 2; d3 += 2) {
                int sx = base_x + d3;
                unsigned char *sp;

                if (sx < 0) sx = 0;
                if (sx >= c->w) sx = c->w - 1;
                sp = c->p + ((size_t)src * (size_t)c->w + (size_t)sx) * 4;
                r3 += sp[0]; g3 += sp[1]; b3 += sp[2]; n++;
            }
            r3 /= n; g3 /= n; b3 /= n;
            r3 = (int)(r3 * 0.86 + 6); g3 = (int)(g3 * 0.86 + 8); b3 = (int)(b3 * 0.86 + 14);
            dp[0] = (unsigned char)((r3 * a + dp[0] * (255 - a)) / 255);
            dp[1] = (unsigned char)((g3 * a + dp[1] * (255 - a)) / 255);
            dp[2] = (unsigned char)((b3 * a + dp[2] * (255 - a)) / 255);
        }
    }
}

/* a sky of small stars, twinkling, thinning toward the ground */
static void fx_stars(Cv *c, double t, int n, double horizon)
{
    int i;

    for (i = 0; i < n; i++) {
        double sx = fmod((double)i * 97.31 + (double)(i * i) * 0.017, (double)c->w);
        double sy = fmod((double)i * 43.77, horizon > 0.0 ? horizon : (double)c->h);
        double tw = 0.5 + 0.5 * sin(t * (0.8 + (double)(i % 7) * 0.3) + (double)i);

        cv_soft(c, sx, sy, 0.9 + (double)(i % 3) * 0.55, 210, 230, 255,
                (int)(22 + 78 * tw));
    }
}

/* a faint grid, for looks that want structure behind them */
static void fx_grid_hint(Cv *c, int r, int g, int b, int a)
{
    int k;

    for (k = 1; k < 14; k++)
        cv_line(c, 0.0, (double)c->h * (double)k / 14.0,
                (double)c->w, (double)c->h * (double)k / 14.0, 1.0, r, g, b, a);
    for (k = 1; k < 20; k++)
        cv_line(c, (double)c->w * (double)k / 20.0, 0.0,
                (double)c->w * (double)k / 20.0, (double)c->h, 1.0, r, g, b, a);
}

/* ---- the room's clock ----------------------------------------------------
 * Everything in a club moves on one downbeat, so the crowd, the DJ, the dancers
 * and the beams all read the same phase. The tempo stretches with the level,
 * which is what makes a loud passage feel faster without touching the music. */
static double beat_phase(const UiModel *m)
{
    double bpm = 116.0 + 34.0 * (double)m->vis_level;      /* beats a minute */

    return fmod(m->elapsed_sec * bpm / 60.0, 1.0);
}

/* One on the beat, falling to zero before the next: the snap an arm hits on. */
static double beat_pulse(const UiModel *m)
{
    double p = 1.0 - beat_phase(m);

    return p * p * p;
}

/* The same pulse, a fraction of a beat late. A pit does not land all at once:
 * the front of the room hears the drop a hair after the back does, and that
 * small lag, spread across the width of the floor, is the surge. */
static double beat_shift(const UiModel *m, double sh)
{
    double ph = fmod(beat_phase(m) + sh + 4.0, 1.0);
    double p  = 1.0 - ph;

    return p * p * p;
}

/* Embers drifting in the air over a light: they cost a soft dot each, and they
 * do more for depth than a hundred extra polygons. */
static void art_sparks(Cv *c, const UiModel *m, double x0, double x1,
                       double y0, double y1, int n, int r, int g, int b)
{
    double t  = m->elapsed_sec;
    double lv = (double)m->vis_level;
    double bp = beat_pulse(m);
    double sw = x1 - x0 > 1.0 ? x1 - x0 : 1.0;
    double sh = y1 - y0 > 1.0 ? y1 - y0 : 1.0;
    int    i;

    for (i = 0; i < n; i++) {
        double sx = x0 + fmod((double)i * 137.5 + t * (7.0 + (double)(i % 5) * 2.2), sw);
        double sy = y1 - fmod((double)i * 71.3 + t * (10.0 + (double)(i % 4) * 3.0), sh);
        double tw = (0.35 + 0.65 * fsind(t * 2.6 + (double)i * 1.7))
                  * (0.35 + 0.85 * lv);

        cv_soft(c, sx, sy, 1.0 + (double)(i % 3) * 0.7 + bp * 1.3,
                r, g, b, (int)(8 + 26 * tw));
    }
}

/* a far wall of panels, receding - depth behind a bar chart */
static void fx_wall(Cv *c, int r, int g, int b, int a)
{
    int k;

    for (k = 1; k < 10; k++) {
        double u = (double)k / 10.0;

        cv_line(c, (double)c->w * u, 0.0, (double)c->w * u, (double)c->h,
                1.0, r, g, b, a);
    }
    for (k = 1; k < 6; k++) {
        double u = (double)k / 6.0;

        cv_line(c, 0.0, (double)c->h * u, (double)c->w, (double)c->h * u,
                1.0, r, g, b, a);
    }
}

/* the panel hardware around the LED matrix: a frame and the unlit cells */
static void fx_bezel(Cv *c)
{
    int i, j;
    double cell = (double)c->w / 24.0;

    for (i = 0; i < 24; i++)
        for (j = 0; j < 12; j++)
            cv_soft(c, ((double)i + 0.5) * cell,
                    ((double)j + 0.5) * ((double)c->h / 12.0),
                    cell * 0.24, 60, 90, 130, 26);
    cv_rect(c, 0, 0, c->w, 2, 40, 60, 90, 160);
    cv_rect(c, 0, c->h - 2, c->w, 2, 40, 60, 90, 160);
}

/* a graticule: the small ticks along the edges of a scope face */
static void fx_ticks(Cv *c, int r, int g, int b, int a)
{
    int i;

    for (i = 0; i < c->w; i += 12) {
        int tall = (i % 60 == 0) ? 7 : 3;

        cv_rect(c, i, 0, 1, tall, r, g, b, a);
        cv_rect(c, i, c->h - tall, 1, tall, r, g, b, a);
    }
    for (i = 0; i < c->h; i += 12) {
        int wide = (i % 60 == 0) ? 7 : 3;

        cv_rect(c, 0, i, wide, 1, r, g, b, a);
        cv_rect(c, c->w - wide, i, wide, 1, r, g, b, a);
    }
}

/* the club's lasers: thin beams sweeping over the crowd */
static void fx_lasers(Cv *c, double t, double lv, double floor_y)
{
    int i;

    for (i = 0; i < 5; i++) {
        double a = -1.5708 + 0.55 * sin(t * (0.7 + 0.2 * (double)i) + (double)i * 1.7);
        double x0 = (double)c->w * (0.16 + 0.17 * (double)i);
        double x1 = x0 + cos(a) * (double)c->h * 1.6;
        double y1 = sin(a) * (double)c->h * 1.6 + floor_y;

        cv_line(c, x0, 0.0, x1, y1, 6.0, 120, 60, 200, (int)(10 + 16 * lv));
        cv_line(c, x0, 0.0, x1, y1, 2.2, 190, 130, 255, (int)(26 + 40 * lv));
        cv_line(c, x0, 0.0, x1, y1, 0.9, 240, 220, 255, (int)(30 + 50 * lv));
    }
}

/* ------------------------------------------------------------------ light -- */

static unsigned char *s_bloom;
static unsigned char *s_bloom_tmp;
static int            s_bloom_w, s_bloom_h;

/* Extra bloom a single look can ask for. Only the club sets it (RV_BLOOM_GAIN);
 * every other look gets exactly the bloom it always had. */
static double s_bloom_boost = 1.0;

/* The lighting pass every look gets for free. Bright areas bleed into their
 * neighbours, the frame is graded toward the app's blue, and the corners fall
 * away - which is most of what separates a diagram from a photograph. It runs
 * on a quarter-size copy, so it costs almost nothing. */
/* 4x4 ordered dither offsets in -2..+1, which is about one step of the 8-bit
 * output once the vignette has scaled it. Symmetric around zero so the picture
 * does not drift brighter or darker. */
static const signed char s_dith[16] = {
    -2,  0, -1,  1,
     1, -1,  0, -2,
    -1,  1, -2,  0,
     0, -2,  1, -1
};
static int *s_bsum;
static int  s_bsum_n;

static void art_finish(Cv *c, const UiModel *m)
{
    int    bw, bh, x, y, k;
    double lv = (double)m->vis_level;
    double gain = (0.58 + 0.80 * lv) * s_bloom_boost;

    if (!c->p || c->w < 64 || c->h < 48)
        return;

    bw = c->w / 4;
    bh = c->h / 4;
    if (bw < 8 || bh < 6)
        return;

    if (s_bloom_w != bw || s_bloom_h != bh) {
        free(s_bloom);
        free(s_bloom_tmp);
        s_bloom = (unsigned char *)malloc((size_t)bw * (size_t)bh * 3);
        s_bloom_tmp = (unsigned char *)malloc((size_t)bw * (size_t)bh * 3);
        s_bloom_w = bw;
        s_bloom_h = bh;
    }
    if (!s_bloom || !s_bloom_tmp)
        return;

    /* bright pass: only what is already lit gets to glow */
    for (y = 0; y < bh; y++) {
        for (x = 0; x < bw; x++) {
            unsigned char *q = c->p + (((size_t)(y * 4) * (size_t)c->w) + (size_t)(x * 4)) * 4;
            int r = q[0], g = q[1], b = q[2];
            int lum = (r * 77 + g * 151 + b * 28) >> 8;
            unsigned char *o = s_bloom + ((size_t)y * (size_t)bw + (size_t)x) * 3;
            int over = lum - 62;

            if (over < 0) {
                o[0] = o[1] = o[2] = 0;
            } else {
                int sc = over * 255 / (255 - 62);

                if (sc > 255) sc = 255;
                o[0] = (unsigned char)(r * sc / 255);
                o[1] = (unsigned char)(g * sc / 255);
                o[2] = (unsigned char)(b * sc / 255);
            }
        }
    }

    /* Two separable blurs: a tight one that hugs the shape, then a wide one
     * that lays a real halo around it. A single radius either looks like a
     * smudge or does not read at all.
     *
     * Each direction keeps a running sum and slides it, so a pixel costs three
     * adds instead of a fresh seventeen-tap pass: same box average, a fraction
     * of the work. This was the second largest single cost in the look. */
    /* the canvas changes size with the quality step, so this has to follow it:
     * a buffer sized for a third of the frame would be overflowed the moment the
     * step went back up */
    if (!s_bsum || s_bsum_n < bw * 3) {
        free(s_bsum);
        s_bsum = (int *)malloc(sizeof(int) * (size_t)bw * 3);
        s_bsum_n = s_bsum ? bw * 3 : 0;
        if (!s_bsum)
            return;
    }
    for (k = 0; k < 2; k++) {
        const int rad = (k == 0) ? 3 : 8;
        const int n   = rad * 2 + 1;
        int       ix, d;

        for (y = 0; y < bh; y++) {
            unsigned char *row = s_bloom + (size_t)y * (size_t)bw * 3;
            unsigned char *o   = s_bloom_tmp + (size_t)y * (size_t)bw * 3;
            int            sr = 0, sg = 0, sb = 0;

            for (d = -rad; d <= rad; d++) {
                int c0 = (d < 0 ? 0 : (d >= bw ? bw - 1 : d)) * 3;

                sr += row[c0]; sg += row[c0 + 1]; sb += row[c0 + 2];
            }
            for (x = 0; x < bw; x++) {
                int a, b2;

                o[x * 3]     = (unsigned char)(sr / n);
                o[x * 3 + 1] = (unsigned char)(sg / n);
                o[x * 3 + 2] = (unsigned char)(sb / n);
                a  = (x - rad < 0 ? 0 : x - rad) * 3;
                b2 = (x + rad + 1 >= bw ? bw - 1 : x + rad + 1) * 3;
                sr += row[b2] - row[a];
                sg += row[b2 + 1] - row[a + 1];
                sb += row[b2 + 2] - row[a + 2];
            }
        }
        /* the vertical half slides a sum per column, held in s_bsum */
        for (ix = 0; ix < bw * 3; ix++)
            s_bsum[ix] = 0;
        for (d = -rad; d <= rad; d++) {
            unsigned char *q = s_bloom_tmp
                             + (size_t)(d < 0 ? 0 : (d >= bh ? bh - 1 : d))
                             * (size_t)bw * 3;

            for (ix = 0; ix < bw * 3; ix++)
                s_bsum[ix] += q[ix];
        }
        for (y = 0; y < bh; y++) {
            unsigned char *o = s_bloom + (size_t)y * (size_t)bw * 3;
            unsigned char *add, *sub;

            for (ix = 0; ix < bw * 3; ix++)
                o[ix] = (unsigned char)(s_bsum[ix] / n);
            add = s_bloom_tmp
                + (size_t)(y + rad + 1 >= bh ? bh - 1 : y + rad + 1)
                * (size_t)bw * 3;
            sub = s_bloom_tmp
                + (size_t)(y - rad < 0 ? 0 : y - rad) * (size_t)bw * 3;
            for (ix = 0; ix < bw * 3; ix++)
                s_bsum[ix] += add[ix] - sub[ix];
        }
    }

    /* Composite: bloom, grade, vignette, in one pass.
     *
     * This is the one loop that runs over every pixel of a full-screen look, so
     * it is integer arithmetic and the vignette is tabulated per column instead
     * of being a square root and two multiplies per pixel. Same picture, a
     * fraction of the work. */
    {
        int *vcol = (int *)malloc(sizeof(int) * (size_t)c->w);
        int  gr = (int)(gain * 1.15 * 256.0 / 255.0);
        int  gg = (int)(gain * 1.10 * 256.0 / 255.0);
        int  gb = (int)(gain * 1.05 * 256.0 / 255.0);

        if (!vcol)
            return;
        for (x = 0; x < c->w; x++) {
            double nx = ((double)x / (double)c->w) * 2.0 - 1.0;

            vcol[x] = (int)(1024.0 * (1.0 - 0.2550 * nx * nx));
        }

        for (y = 0; y < c->h; y++) {
            double ny = ((double)y / (double)c->h) * 2.0 - 1.0;
            int    vy = (int)(1024.0 * 0.3000 * ny * ny);
            unsigned char *row  = c->p + (size_t)y * (size_t)c->w * 4;
            /* The bloom buffer is the canvas divided by four, rounded down, so
             * its last row and column cover a few pixels further than it does.
             * The index has to be clamped to it: at step 3 the canvas is 546x186
             * and x/4 reached 136 of the 136 columns that exist, reading one
             * past the end of the buffer. */
            int            by   = y / 4 < bh ? y / 4 : bh - 1;
            unsigned char *brow = s_bloom + (size_t)by * (size_t)bw * 3;

            for (x = 0; x < c->w; x++) {
                unsigned char *q  = row + (size_t)x * 4;
                int            bx = x / 4 < bw ? x / 4 : bw - 1;
                unsigned char *bq = brow + (size_t)bx * 3;
                int v  = vcol[x] - vy;
                /* Ordered 4x4 dither, added before the vignette multiplies the
                 * value down and before it is cut to eight bits. A big dark
                 * gradient on a TV banded without it, and the old pseudo-random
                 * grain only moved the bands around: this scatters the rounding
                 * error instead, which is what a dither is for. */
                int dt = s_dith[((y & 3) << 2) | (x & 3)];
                int r  = q[0] + ((bq[0] * gr) >> 8) + dt;
                int g  = q[1] + ((bq[1] * gg) >> 8) + dt;
                int b  = q[2] + ((bq[2] * gb) >> 8) + dt;

                r = ((r * v) >> 10) + 2;
                g = ((g * v) >> 10) + 3;
                b = ((b * v) >> 10) + 6;
                /* shadows lean blue */
                if (r < 96)
                    b += (96 - r) >> 4;
                q[0] = (unsigned char)(r < 0 ? 0 : r > 255 ? 255 : r);
                q[1] = (unsigned char)(g < 0 ? 0 : g > 255 ? 255 : g);
                q[2] = (unsigned char)(b < 0 ? 0 : b > 255 ? 255 : b);
            }
        }
        free(vcol);
    }
}

/* --------------------------------------------------------------- fluid -- */

/* The quality step the frame is being painted at: 1 full canvas, 2 half, 3
 * third. Set once per frame by art_draw_style() before the style is called, and
 * read by every pass that has a cheaper form at a lower step. */
static int s_paint_step = 1;

/* =========================================== liquid: tweakable settings ====
 * Everything about the water that is worth changing lives here.
 *
 *   damping      how long a swell lives, as the velocity kept per substep;
 *                1 is no damping at all
 *   shakers      how hard the three stacks hit, and how far behind the right
 *                wall stack is (that lag is the surge crossing the tank)
 *   gain         pixels of surface height per metre: how big the wave looks
 *   crest        metres of height that count as a full crest, i.e. how much
 *                of the frame's colour range the wave uses
 *   chop         the fine texture and what drives each octave, so a bass-heavy
 *                passage and a treble-heavy one do not look the same
 *   tank floor   the water line and the bottom of the tank, as frame fractions
 *   glass        the tank's own furniture: side walls, front glass, floor lines
 */
#define FL_DAMP        (cfg.liquid.damp)  /* velocity kept per 1/480 s substep        */
#define FL_BREAK_SLOPE (cfg.liquid.break_slope)      /* steepness at which a crest spills        */
#define FL_SHAKE_MUL   (cfg.liquid.shake_mul)      /* shaker strength                          */
#define FL_WALL_DELAY  (cfg.liquid.wall_delay)     /* beat fraction the right stack lags by    */
#define FL_SELF_LIMIT  (cfg.liquid.self_limit)      /* how hard a big tank damps its own drive  */
#define FL_GAIN        (cfg.liquid.gain)      /* px per metre of surface height           */
#define FL_GAIN_LVL    (cfg.liquid.gain_level)      /* extra px per metre with the level        */
#define FL_CREST_M     (cfg.liquid.crest_m)     /* metres that count as a full crest        */
#define FL_GLOW        (cfg.liquid.glow)      /* light filling the gaps between shafts   */
#define FL_SHEEN       (cfg.liquid.sheen)      /* sheen just under the surface             */
#define FL_REFLECT     (cfg.liquid.reflect)      /* the mirrored glow under the surface      */
#define FL_CHOP_MID    (cfg.liquid.chop_mid)      /* mid bands -> medium chop                 */
#define FL_CHOP_HIGH   (cfg.liquid.chop_high)      /* high bands -> fine shimmer               */
#define FL_WAVE_WOBBLE (cfg.liquid.wave_wobble)      /* the waveform -> a slow surface wobble    */
#define FL_FOAM        (cfg.liquid.foam)      /* white water                              */
#define FL_AIR         (cfg.liquid.air)      /* the water line, frame fraction           */
#define FL_FLOOR_Y     (cfg.liquid.floor_y)      /* the tank's floor, frame fraction         */
/* The floor sits a little higher than the configured line, so the tank reads as
 * a body of water with a bottom rather than as a dark skirt. Applied on top of
 * the setting, in frame fractions, so a config.ini written before v116 gets the
 * lift as well. */
#define FL_FLOOR_LIFT  0.030
#define FL_GLASS       (cfg.liquid.glass)      /* side walls, front glass, floor lines     */
#define FL_SURFACE_LIFT (cfg.liquid.surface_lift)  /* water line above air, frame fraction  */
/* The surface height that spans the body's palette. A full crest is FL_CREST_M,
 * but an ordinary swell is a fraction of that. Mapping the body's colour to the
 * full crest made every lit column read as a full crest, which is why the water
 * was one flat cyan; this is the scale it is actually drawn on. The rim and the
 * foam keep their own scale (0.012 m) and are not affected by this. */
#define FL_BODY_M      (FL_CREST_M * 0.30)

/* A real shallow-water solve, not a sum of sines.
 *
 * The tank is a height field h(x) carrying its own vertical velocity, stepped
 * on a fixed 480 Hz clock by the nonlinear shallow-water equation
 *
 *     h_tt = g (H + h) h_xx - 2 h_x h_t - loss h_t
 *
 * Crests therefore travel at the local wave speed, steepen where they run into
 * slower water, break when they are too steep to hold, and reflect off the
 * glass. No wave in the picture is an animation curve: the shape at any instant
 * is whatever the last two seconds of music pushed into the tank.
 *
 * Three stacks drive it - the pair at the walls hit a hair apart, which is what
 * makes the surge cross the tank instead of popping, and every downbeat drops a
 * ring in the middle. The same field is the reference for anything else that
 * has to move like a liquid: fl_step() advances it and leaves surface, slope,
 * curvature and foam behind, and the look lights its water only from those. */

#define FL_N     384                  /* cells across the tank */
/* Wide enough for a 4K canvas at full quality: the per-column arrays are
 * indexed by canvas x, so the old 2400 cap made a 3840-wide frame return
 * without drawing anything at all. Beyond this the look still draws, at
 * whatever reduced step the ladder gives it. */
#define FL_MAXW 4096                  /* widest canvas the look maps onto */
#define FL_TANK  1.85                 /* metres of glass, for the physics */

static double fl_h[FL_N];             /* surface elevation, m */
static double fl_v[FL_N];             /* its vertical velocity, m/s */
static double fl_foam[FL_N];          /* white water left by a break */
static double fl_map[FL_MAXW];        /* surface as canvas rows */
static double fl_slope[FL_MAXW];      /* rows per pixel */
static double fl_focus[FL_MAXW];      /* how hard the surface focuses light */
static double fl_foam_px[FL_MAXW];
static double fl_acc;                 /* simulated time not yet stepped */
static double fl_last_t = -1.0;
static double fl_phase;
static double fl_dt = 1.0 / 60.0;
static int    fl_ready;

/* The three per-channel depth falloffs, 65 steps, built once. The old fill did
 * three divisions a pixel; this is three table reads and three multiplies, and
 * it is what pays for the water being shaded by the wave. */
static unsigned short fl_lt[65][3];   /* 255 * falloff, for integer maths     */
static int    fl_lut_ok;
static double fl_mid = 0.5;          /* mean of the middle bands, 0..1       */
static double fl_high = 0.5;         /* mean of the top bands, 0..1           */
static double fl_crest[FL_MAXW];      /* 0 = trough, 1 = crest, per canvas px */
static double fl_body[FL_MAXW];       /* the same height, smoothed, in metres;
                                       * the body of the water is lit by this,
                                       * never by the per-column value */

static void fl_lut_build(void)
{
    int i;

    if (fl_lut_ok)
        return;
    for (i = 0; i <= 64; i++) {
        double d = (double)i / 64.0;

        /* 255 * falloff, so the fill can multiply and shift instead of doing
         * three floating-point divides a pixel - this loop runs over a
         * megapixel a frame and it is the most expensive thing in the look */
        /* red goes first, then green, and blue holds on longest: that is what
         * makes the water read as deep instead of merely dark. The old 6/2.9/
         * 1.5 falloffs kept too much green in the deep end, so the whole body
         * stayed the same cyan at every depth. */
        fl_lt[i][0] = (unsigned short)(255.0 / (1.0 + 9.0 * d) + 0.5);
        fl_lt[i][1] = (unsigned short)(255.0 / (1.0 + 3.6 * d) + 0.5);
        fl_lt[i][2] = (unsigned short)(255.0 / (1.0 + 1.2 * d) + 0.5);
    }
    fl_lut_ok = 1;
}

typedef struct { double x, y, vx, vy, life; } FlDrop;
static FlDrop  fl_drop[96];
static int     fl_drop_ready;
static unsigned fl_rand_state = 2463534242u;

static double fl_rand(void)
{
    fl_rand_state = fl_rand_state * 1664525u + 1013904223u;
    return (double)((fl_rand_state >> 9) & 0xffffu) / 65535.0;
}

static void fl_step(const UiModel *m)
{
    const double dx    = FL_TANK / (double)(FL_N - 1);
    const double still = 0.40;                  /* still water, m */
    const double g     = 9.81;
    const double dt    = 1.0 / 480.0;
    double t     = m->elapsed_sec;
    double lv    = (double)m->vis_level;
    double pulse = beat_pulse(m);
    double phase = beat_phase(m);
    double bass  = 0.0, midb = 0.0, hib = 0.0;
    double lim   = 1.0;
    double fdt;
    int    subs, i, k, d, drop = 0;

    for (i = 0; i < 6; i++)
        bass += (double)m->vis_bands[i];
    bass /= 6.0;
    /* the middle of the spectrum moves the medium ripples, the top of it the
     * fine sparkle. Both are handed to art_liquid as statics, which is cheaper
     * than threading them through and matches how the rim colour travels. */
    for (i = 6; i < 18; i++)
        midb += (double)m->vis_bands[i];
    midb /= 12.0;
    for (i = 18; i < VIS_BANDS; i++)
        hib += (double)m->vis_bands[i];
    hib /= (double)(VIS_BANDS - 18);
    fl_mid  = midb;
    fl_high = hib;

    if (!fl_ready) {
        for (i = 0; i < FL_N; i++) {
            fl_h[i] = 0.0;
            fl_v[i] = 0.0;
            fl_foam[i] = 0.0;
        }
        fl_acc = 0.0;
        fl_phase = phase;
        fl_last_t = t;
        fl_ready = 1;
    }
    if (t < fl_last_t - 0.10 || t > fl_last_t + 1.00) {   /* a seek, or a stall */
        fl_acc = 0.0;
        fl_last_t = t;
        fl_phase = phase;
    }
    fdt = t - fl_last_t;
    if (fdt < 0.0)
        fdt = 0.0;
    if (fdt > 0.10)
        fdt = 0.10;
    fl_last_t = t;
    fl_dt = fdt > 0.001 ? fdt : 1.0 / 60.0;
    fl_acc += fdt;

    subs = (int)(fl_acc / dt);
    if (subs > 16) {
        subs = 16;
        fl_acc = 0.0;
    } else if (subs > 0) {
        fl_acc -= (double)subs * dt;
    }

    if (phase < fl_phase - 0.5)
        drop = 1;
    fl_phase = phase;

    /* How hard the tank is already moving. The stacks push against this, so a
     * loud passage saturates instead of driving the surface into the clamp - a
     * limiter for water, and the reason the bigger shakers below stay stable. */
    {
        double sum = 0.0;

        for (i = 0; i < FL_N; i++)
            sum += fl_h[i] * fl_h[i];
        lim = 1.0 / (1.0 + FL_SELF_LIMIT * sqrt(sum / (double)FL_N));
        if (lim < 0.15)
            lim = 0.15;
    }

    for (k = 0; k < subs; k++) {
        /* one propagation pass: the equation of the surface, at the local
         * depth (so a crest runs faster than the trough ahead of it) with the
         * steepening term that turns a smooth swell into a breaking lip */
        for (i = 1; i < FL_N - 1; i++) {
            double lap = fl_h[i - 1] - 2.0 * fl_h[i] + fl_h[i + 1];
            double sl  = (fl_h[i + 1] - fl_h[i - 1]) * 0.5 / dx;
            double acc = g * (still + fl_h[i]) * lap / (dx * dx)
                       - 1.40 * sl * fl_v[i];

            fl_v[i] += acc * dt;
        }

        /* the stacks */
        /* The two stacks at the walls hit a hair apart - the right one reads
         * the beat a fraction late - which is what makes the surge cross the
         * tank instead of the whole surface rising at once. The comment above
         * claimed this from the start; now the code does it. */
        for (d = 0; d < 3; d++) {
            int    ctr = d == 0 ? 9 : (d == 1 ? FL_N / 2 : FL_N - 10);
            double pd  = d == 2 ? beat_shift(m, FL_WALL_DELAY) : pulse;
            double amp = (d == 1 ? 0.55 : 0.85) * (0.30 + 0.70 * pd)
                       * (0.10 + 0.90 * bass) * (0.40 + 0.60 * lv)
                       * 26.0 * FL_SHAKE_MUL * lim;
            int    a = ctr - 14 < 1 ? 1 : ctr - 14;
            int    b = ctr + 14 > FL_N - 2 ? FL_N - 2 : ctr + 14;
            int    j;

            for (j = a; j <= b; j++) {
                double q = (double)(j - ctr) / 6.0;

                fl_v[j] += amp * dt / (1.0 + q * q * q * q);
            }
        }

        /* the downbeat is one ring dropped in the middle: it is the splash the
         * ear hears, and it is what the caustics on the floor are made of */
        if (drop && k == 0) {
            int j;

            for (j = FL_N / 2 - 20; j <= FL_N / 2 + 20; j++) {
                double q = (double)(j - FL_N / 2) / 8.0;

                fl_v[j] -= (0.40 + 0.30 * lv) / (1.0 + q * q * q * q);
            }
        }

        for (i = 1; i < FL_N - 1; i++) {
            double sl   = (fl_h[i + 1] - fl_h[i - 1]) * 0.5 / dx;
            double loss = FL_DAMP;

            /* too steep to hold: the crest spills instead of growing, its
             * energy goes into white water, and the wave behind it calms.
             * Gentler than it was, so a swell survives several seconds. */
            if (fabs(sl) > FL_BREAK_SLOPE) {
                double ex = fabs(sl) - FL_BREAK_SLOPE;

                loss -= 0.0006 + ex * 0.0025;
                fl_foam[i] += ex * 0.85;
            }
            fl_foam[i] *= 0.9994;
            fl_v[i] *= loss;
            fl_h[i] += fl_v[i] * dt;
            if (fl_h[i] > 0.16) {
                fl_h[i] = 0.16;
                if (fl_v[i] > 0.0)
                    fl_v[i] *= 0.25;
            }
            if (fl_h[i] < -0.16) {
                fl_h[i] = -0.16;
                if (fl_v[i] < 0.0)
                    fl_v[i] *= 0.25;
            }
        }
    }
}

/* ------------------------------------------------------------------ liquid -- */

/* The waveform, smoothed into a slow wobble. At full rate the 160 samples are
 * about ten pixels apart on a 1080p canvas, which is aliasing rather than a
 * wobble; averaging eight at a time leaves twenty gentle cycles across the
 * tank, which is what a surface being pushed by a bass line looks like. */
static double fl_wave_slow(const UiModel *m, double u)
{
    int    i0 = (int)(u * (double)(VIS_WAVE - 8));
    double sum = 0.0;
    int    i;

    if (i0 < 0)
        i0 = 0;
    if (i0 > VIS_WAVE - 8)
        i0 = VIS_WAVE - 8;
    for (i = 0; i < 8; i++)
        sum += (double)m->vis_wave[i0 + i];
    return sum / 8.0;
}

static void art_liquid(Cv *c, const UiModel *m)
{
    const double dx     = FL_TANK / (double)(FL_N - 1);
    const double t      = m->elapsed_sec;
    const double lv     = (double)m->vis_level;
    /* The water sits above the raw air setting. On a 16:9 frame the old line
     * left a third of the visualizer as an empty dark room, which read as a
     * letterbox inside the picture. The lift moves that room's share into the
     * water and leaves the tank's floor where it was. */
    double base = (double)c->h * (FL_AIR - FL_SURFACE_LIFT);

    if (base < (double)c->h * 0.12)
        base = (double)c->h * 0.12;
    /* how many pixels a metre of surface height is worth. The shading below
     * reads the wave, so the wave has to be big enough on screen to be read:
     * at the old gain a swell was four pixels and every column looked the
     * same, which is why the water body stayed flat however it was lit. */
    const double gain   = (double)c->h * (FL_GAIN + FL_GAIN_LVL * lv);
    const int    floorY = (int)((double)c->h * (FL_FLOOR_Y - FL_FLOOR_LIFT));
    int          x, y, i;

    if (c->w > FL_MAXW || c->w < 8 || c->h < 8)
        return;

    fl_lut_build();
    fl_step(m);

    /* --- the field, on this canvas ---------------------------------------- */
    for (x = 0; x < c->w; x++) {
        double u  = (double)x / (double)(c->w > 1 ? c->w - 1 : 1);
        double fi = u * (double)(FL_N - 1);
        int    i0 = (int)fi;
        double fr = fi - (double)i0;
        int    i1 = i0 + 1 < FL_N ? i0 + 1 : FL_N - 1;
        double hh, cap;

        if (i0 < 0)
            i0 = 0;
        hh  = fl_h[i0] * (1.0 - fr) + fl_h[i1] * fr;
        fl_foam_px[x] = fl_foam[i0] * (1.0 - fr) + fl_foam[i1] * fr;
        fl_slope[x]   = (fl_h[i1] - fl_h[i0]) / dx;

        /* capillary chop: the solve is 384 cells wide, and this is the small
         * texture the eye expects on water without moving the big shape */
        /* Capillary chop. The old frequencies were 61 and 137 cycles across
         * the tank, which is about fourteen pixels a cycle at 1080p: the lip
         * hopped between rows every frame and shimmered. These are slow enough
         * to be sampled properly and small enough to be texture, not noise. */
        /* Four octaves, and each answers a different part of the music: the
         * long one the low end, the middle two the mid bands, the fine one the
         * top. A bass-heavy passage rolls, a treble-heavy one shimmers, and the
         * waveform wobbles the whole surface a little. */
        cap = (0.0014 + 0.0018 * lv) * fsind(u * 7.0 + t * 1.3)
            + (0.0011 + 0.0014 * lv) * fsind(u * 13.0 - t * 2.3)
            + (0.0006 + 0.0011 * lv) * FL_CHOP_MID * (0.35 + 0.65 * fl_mid)
              * fsind(u * 29.0 + t * 3.7)
            + (0.0003 + 0.0007 * lv) * FL_CHOP_HIGH * (0.30 + 0.70 * fl_high)
              * fsind(u * 47.0 - t * 5.1)
            + 0.0016 * FL_WAVE_WOBBLE * (0.4 + 0.6 * lv) * fl_wave_slow(m, u);

        fl_map[x] = base - (hh + cap) * gain;
        if (fl_map[x] < (double)c->h * 0.055)
            fl_map[x] = (double)c->h * 0.055;
        if (fl_map[x] > (double)c->h * 0.58)
            fl_map[x] = (double)c->h * 0.58;
    }

    /* one soft pass, so a crest is a curve and not a row of steps */
    {
        double prev = fl_map[0];

        for (x = 1; x < c->w - 1; x++) {
            double cur = fl_map[x];

            fl_map[x] = (prev + 2.0 * cur + fl_map[x + 1]) * 0.25;
            prev = cur;
        }
    }

    for (x = 0; x < c->w; x++) {
        int    xa = x > 0 ? x - 1 : x;
        int    xb = x < c->w - 1 ? x + 1 : x;
        double sl = (fl_map[xb] - fl_map[xa]) * 0.5;
        double cu = fl_map[xa] - 2.0 * fl_map[x] + fl_map[xb];
        double f  = 1.0 - cu * 0.30;

        fl_slope[x] = sl;
        if (f < 0.12) f = 0.12;
        if (f > 2.60) f = 2.60;
        fl_focus[x] = f;

        /* How much of a crest this column is: the surface height itself (a
         * crest is water pushed up) with the curvature mixed in, because a thin
         * crest concentrates light. This one number drives the whole body of
         * the water under the column. */
        {
            double hn = (base - fl_map[x]) / (gain > 1.0 ? gain : 1.0) / 0.012;
            double cn;

            if (hn > 1.0) hn = 1.0;
            if (hn < -1.0) hn = -1.0;
            cn = 0.5 + 0.5 * hn * 1.30;
            cn += (f - 1.0) * 0.28;
            if (cn < 0.0) cn = 0.0;
            if (cn > 1.0) cn = 1.0;
            fl_crest[x] = cn;
        }
    }

    /* The body of the water is lit by a smoothed copy of the surface. A metre
     * of water under a swell averages the wave out, and the raw per-column
     * field in the body is what drew the height field as vertical stripes down
     * the tank. The rim and the foam still read fl_crest column by column, so
     * the crest line and the foam are exactly what they were. */
    {
        int r = c->w / 50;

        if (r < 2)
            r = 2;
        for (x = 0; x < c->w; x++) {
            int    a = x - r < 0 ? 0 : x - r;
            int    b = x + r >= c->w ? c->w - 1 : x + r;
            double sum = 0.0;

            for (i = a; i <= b; i++)
                sum += base - fl_map[i];
            fl_body[x] = sum / (double)(b - a + 1)
                       / (gain > 1.0 ? gain : 1.0);
        }
    }

    /* --- the room above the tank ------------------------------------------
     * This has to reach the floor, not stop just under the resting water line.
     * It used to end at base+10 with a lighter colour than the untouched canvas,
     * so whenever the surface dipped through that row there was a dead straight
     * horizontal seam across the tank - a line where the room's gradient stopped
     * painting. Running it down to the floor leaves no row unpainted. */
    cv_vgrad(c, 0, 0, c->w, floorY, 5, 8, 18, 12, 24, 48);

    /* The headroom is not empty: the lamps that make the shafts stand above
     * it, and their light on the room is what stops the top of the tank being
     * a black band. Two wide soft pools, drawn before the water so the surface
     * cuts them off where it rises. */
    cv_ell_soft(c, (double)c->w * 0.50, (double)c->h * 0.02,
                (double)c->w * 0.38, (double)c->h * 0.062,
                96, 150, 214, 30);
    cv_ell_soft(c, (double)c->w * 0.50, (double)c->h * 0.045,
                (double)c->w * 0.20, (double)c->h * 0.030,
                170, 208, 246, 26);

    /* The light standing over the water. A tank is lit from above - that is
     * where the shafts come from - and this is the glow those lights leave on
     * the underside of the surface. It is also what the reflection below
     * mirrors: a reflection of a black room is a black reflection. */
    /* Kept at every step: this is the light the front glass reflects, and at a
     * stepped canvas it is a few thousand pixels. Losing it above step 2 is why
     * the water line sat in a black band at the step the console runs. */
    {
        for (x = 0; x < c->w; x++) {
            int    y0 = (int)fl_map[x];
            double cr = fl_crest[x];
            int    i;

            for (i = 1; i <= 6; i++) {
                int yy = y0 - i;
                int a;

                if (yy < 0)
                    break;
                a = (int)((10.0 + 26.0 * cr) * (1.0 - (double)i / 7.0)
                          * (0.5 + 0.6 * lv));
                if (a > 0)
                    cv_add(c, x, yy, 150, 206, 236, a);
            }
        }
    }

    /* --- the tank's side walls --------------------------------------------
     * Two dark panes raking away from the camera with a lit inner edge. Without
     * them the water is a band across the frame; with them it is inside
     * something, and the shot finally has a left and a right. */
    /* Drawn at every quality step. This block used to give way above step 2,
     * and step 3 is the step the console actually runs: that is why the tank's
     * sides were missing there and the glass read as a thin strip. At a stepped
     * canvas the whole block is a few thousand pixels. */
    if (FL_GLASS > 0.01) {
        int sw = (int)((double)c->w * 0.055);

        if (sw > 2) {
            int sx, y;
            int wy  = cv_i(fl_map[sw < c->w ? sw : 0]);
            int wcr = (int)(120.0 * fl_crest[sw < c->w ? sw : 0]);

            for (sx = 0; sx < sw; sx++) {
                double k = 1.0 - (double)sx / (double)sw;
                int    a = (int)(232.0 * (0.42 + 0.58 * k) * FL_GLASS);

                if (a < 2)
                    continue;
                /* two rows at a time: a vertical gradient at a two-row step is
                 * invisible, and this strip is a tenth of a megapixel */
                for (y = 0; y < c->h; y += 2) {
                    double vy = 1.0 - 0.30 * (double)y / (double)c->h;
                    int    al = (int)((double)a * vy);
                    int    cr, cg, cb;

                    if (al < 2)
                        continue;
                    /* The pane used to be one near-black strip, so the tank had
                     * an outline instead of a side. It is a face of glass now:
                     * above the water line it is cold and lit from the room,
                     * below it it holds the water's own colour and brightens
                     * where a crest is pressed against it. */
                    if (y > wy) {
                        cr = 7 + (int)(16.0 * k) + (wcr >> 3);
                        cg = 20 + (int)(44.0 * k) + (wcr >> 2);
                        cb = 38 + (int)(58.0 * k) + (wcr >> 2);
                    } else {
                        cr = 13 + (int)(38.0 * k);
                        cg = 21 + (int)(56.0 * k);
                        cb = 35 + (int)(74.0 * k);
                    }
                    cv_set(c, sx, y, cr, cg, cb, al);
                    cv_set(c, c->w - 1 - sx, y, cr, cg, cb, al);
                    if (y + 1 < c->h) {
                        cv_set(c, sx, y + 1, cr, cg, cb, al);
                        cv_set(c, c->w - 1 - sx, y + 1, cr, cg, cb, al);
                    }
                }
            }
            /* the room's windows, caught in the pane: two long soft highlights
             * down the glass, which is what says glass rather than paint */
            cv_ell_soft(c, (double)sw * 0.42, (double)c->h * 0.30,
                        (double)sw * 0.30, (double)c->h * 0.22,
                        150, 190, 230, 26);
            cv_ell_soft(c, (double)(c->w - 1) - (double)sw * 0.42,
                        (double)c->h * 0.26, (double)sw * 0.24,
                        (double)c->h * 0.18, 150, 190, 230, 20);
            /* the lit inner edge of each pane, then the front glass' own
             * highlight, which is what says "you are looking through
             * something" rather than "at" something */
            cv_line(c, (double)sw, 0.0, (double)sw, (double)c->h, 1.6,
                    88, 132, 176, (int)(90.0 * FL_GLASS));
            cv_line(c, (double)(c->w - 1 - sw), 0.0,
                    (double)(c->w - 1 - sw), (double)c->h, 1.6,
                    88, 132, 176, (int)(90.0 * FL_GLASS));
            cv_line(c, (double)sw + 2.0, 0.0, (double)sw + 2.0,
                    (double)c->h, 0.8, 200, 226, 255, 26);
            cv_line(c, (double)(c->w - 3 - sw), 0.0,
                    (double)(c->w - 3 - sw), (double)c->h, 0.8,
                    200, 226, 255, 26);
            /* The edge of the glass catches the room, so it gets a soft band
             * inside the line: a drawn outline is a strip, a lit edge is a
             * pane with thickness. */
            cv_line(c, (double)sw + 4.0, 0.0, (double)sw + 4.0,
                    (double)c->h, 4.0, 120, 170, 214,
                    (int)(17.0 * FL_GLASS));
            cv_line(c, (double)(c->w - 5 - sw), 0.0,
                    (double)(c->w - 5 - sw), (double)c->h, 4.0,
                    120, 170, 214, (int)(15.0 * FL_GLASS));
            cv_ell_soft(c, (double)c->w * 0.5, (double)c->h * 0.06,
                        (double)c->w * 0.34, (double)c->h * 0.05,
                        190, 220, 250, (int)(14.0 * FL_GLASS));
        }
    }

    /* --- water ------------------------------------------------------------
     * The body of the water is lit by the wave it is the body of. A column
     * under a crest is bright, green and translucent - the water there is thin
     * and the light is entering right at that point - and a column over a
     * trough is deep, dark and blue, because the light has further to fall.
     * Light also reaches *deeper* under a crest, so the depth scale itself
     * moves with the wave instead of being a fixed ramp from the surface down.
     *
     * The three channel falloffs are a 65-step table, so the fill costs three
     * multiplies and three reads a pixel instead of three divisions. */
    for (x = 0; x < c->w; x++) {
        int    y0    = (int)fl_map[x];
        double span  = (double)(floorY - y0);
        double slope = fl_slope[x];
        double cr    = fl_crest[x];
        /* The body is lit by the smoothed height, not by the per-column crest
         * value the rim uses. cr saturates as soon as the surface is a
         * centimetre up, so it was 1 across almost the whole tank: the body
         * came out one flat cyan, and the columns that did differ drew the
         * height field as vertical stripes. This spans the palette over the
         * height an ordinary swell actually has. */
        double hs    = fl_body[x];
        double crb   = 0.5 + 0.5 * (hs / (fabs(hs) + FL_BODY_M));
        double uc    = 2.0 * (double)x / (double)(c->w > 1 ? c->w - 1 : 1) - 1.0;
        double lit   = (0.88 + 0.26 * crb)
                     * (1.0 + 0.09 * fsind((double)x * 0.0021 + t * 0.21))
                     /* the room's light comes from above the middle of the tank,
                      * so the water is a little dimmer against the glass. Very
                      * low frequency, so it is volume, not a band. */
                     * (1.0 - 0.20 * uc * uc);
        int    dinv, tr8, tg8, tb8, dacc = 0;
        int    glow, midk;
        double she0;

        if (span < 2.0)
            span = 2.0;
        /* depth, accumulated in 1/16384ths so the loop never divides */
        dinv = (int)((1.0 + 0.55 * crb) / span * 16384.0);
        if (dinv < 1)
            dinv = 1;
        /* The colour at the surface, before the depth falloff: dark blue over
         * a trough at one end, thin green water on a crest at the other. The
         * green is what makes a lit column look like water rather than like a
         * brighter blue, so the crest end is green-cyan, not cyan. */
        tr8 = (int)((6.0 + 52.0 * crb) * lit);
        tg8 = (int)((22.0 + 168.0 * crb) * lit);
        tb8 = (int)((60.0 + 112.0 * crb) * lit);
        she0 = (0.24 + 0.76 * crb) * (0.20 + 0.80 * lv) * FL_SHEEN;

        /* ---- the light that fills the gaps between the shafts ----------------
         * The shafts are seven narrow columns and between them the water used to
         * fall to nothing, which read as holes in the tank. This is a wide, slow
         * variation across the whole body - never bright, never zero - so the
         * lit columns stand out against lit water instead of against black. */
        glow = (int)((5.0 + 9.0 * lv) * FL_GLOW
                     * (0.55 + 0.45 * fsind((double)x * 0.0062 - t * 0.35))
                     * (0.70 + 0.30 * crb));

        /* ---- middepth structure --------------------------------------------
         * A band about a third of the way down whose strength follows how steep
         * the surface is here. Below a crest the light bends back out of the
         * body and lays a soft shelf of colour at that depth; below a flat patch
         * there is no shelf. It is the difference between water that is a ramp
         * from bright to dark and water that has something inside it. */
        midk = (int)((9.0 + 30.0 * crb)
                     * (0.70 + 0.30 * fsind((double)x * 0.0041 + t * 0.55))
                     * (0.55 + 0.45 * lv) * FL_GLOW);

        for (y = y0; y < floorY; y++) {
            int    di = dacc >> 8;      /* 0..64 over the depth of the tank */
            int    r, g, b;
            unsigned char *q;

            if (di > 64)
                di = 64;
            /* the deep end of the falloff keeps a trace of blue rather than
             * going to black: a trough that is the same colour as the room
             * behind it reads as a hole in the tank, not as deep water */
            r = 2 + ((tr8 * (int)fl_lt[di][0]) >> 8);
            g = 9 + ((tg8 * (int)fl_lt[di][1]) >> 8);
            b = 26 + ((tb8 * (int)fl_lt[di][2]) >> 8);

            /* the sheen just under the surface: light the crest turns back
             * into the water, smooth and tied to the wave's own shape */
            if (di < 17) {
                double sh = 1.0 - (double)di / 17.0;
                double she;

                sh *= sh;
                she = sh * she0;
                r += (int)(she * 0.45);
                g += (int)she;
                b += (int)(she * 0.72);
            }
            if (di > 7 && di < 40) {
                int k = 40 - di;

                /* a broad shelf, not a stripe: the falloff is quadratic so it
                 * fades into the body above and below it */
                k = (k * k) / 33;
                r += (midk * k) >> 7;
                g += (midk * k) >> 6;
                b += (midk * k) >> 6;
            }
            r += glow;
            g += glow;
            b += glow + (glow >> 2);
            /* written straight into the row: this loop is the most-run loop in
             * the look, and cv_put's bounds test plus two multiplies a pixel
             * cost more than the shading does */
            if (y < 0 || y >= c->h) {
                dacc += dinv;
                continue;
            }
            q = c->p + (size_t)y * (size_t)c->w * 4 + (size_t)x * 4;
            {
                unsigned cr8 = (unsigned)(r < 0 ? 0 : r > 255 ? 255 : r);
                unsigned cg8 = (unsigned)(g < 0 ? 0 : g > 255 ? 255 : g);
                unsigned cb8 = (unsigned)(b < 0 ? 0 : b > 255 ? 255 : b);

                /* one 32-bit store rather than four byte stores: this loop runs
                 * over a megapixel a frame and every store here is memory */
                *(unsigned int *)q = cr8 | (cg8 << 8) | (cb8 << 16) | 0xff000000u;
            }
            dacc += dinv;
        }

        /* ---- the room, reflected -----------------------------------------
         * Not a tint band any more: the glow standing over the water, mirrored
         * into the first rows under the surface, sampled from the canvas with a
         * sideways offset that follows the slope - so the reflection stretches
         * and compresses as the surface moves, which is what makes water read
         * as a surface instead of a pane of glass. */
        if (s_paint_step <= 2 && y0 > 4) {
            int rh = (int)(span * 0.08);
            int yy;

            if (rh > 30)
                rh = 30;
            for (yy = 1; yy <= rh; yy++) {
                double k  = (double)yy / (double)(rh + 1);
                int    sy = y0 - yy - 1;
                int    sx = (int)((double)x - slope * 4.0 * k);
                const unsigned char *q;

                if (sy < 0 || y0 + yy >= floorY)
                    break;
                if (sx < 0)
                    sx = 0;
                if (sx >= c->w)
                    sx = c->w - 1;
                q = c->p + ((size_t)sy * (size_t)c->w + (size_t)sx) * 4;
                cv_set(c, x, y0 + yy, q[0], (int)q[1] + 10, (int)q[2] + 18,
                       (int)((38.0 + 34.0 * cr) * (1.0 - k)));
            }
        }

        /* ---- the surface edge --------------------------------------------
         * A thin refractive rim and a soft translucent band under it, both
         * built from the slope. The three fixed rows this replaces - dark at
         * +2, mid at +1, light at -1 - put a pen line under every crest and
         * made the water look outlined rather than wet. */
        {
            double fy    = fl_map[x];
            int    yy    = (int)fy;
            double fr    = fy - (double)yy;
            double foam  = fl_foam_px[x];
            double stp   = slope < 0.0 ? -slope : slope;
            double rimk  = stp > 3.0 ? 1.0 : stp / 3.0;
            /* White water is not only what the solver calls a break. A face
             * steep enough to tear is throwing foam whether or not the crest
             * line was above the threshold this substep, and that is most of the
             * foam in a real tank: driving it from the slope is what makes it
             * show up on the music instead of only on the loudest hit. */
            {
                double sf = (stp - 2.4) / 2.9;

                if (sf > 1.0)
                    sf = 1.0;
                sf *= (0.42 + 0.58 * lv) * FL_FOAM;
                if (sf > foam)
                    foam = sf;
            }
            int    a0    = (int)(255.0 * (1.0 - fr));
            int    a1    = (int)(255.0 * fr);
            int    rr    = (int)(184.0 + 62.0 * rimk);
            int    rg    = (int)(228.0 + 22.0 * rimk);

            /* the water just under the lip: translucent, brighter where the
             * face is steep, gone by the fourth row */
            cv_set(c, x, yy + 3, 70, 134, 172, (int)(12.0 + 18.0 * rimk));
            cv_set(c, x, yy + 2, 96, 168, 202, (int)(22.0 + 30.0 * rimk));
            cv_set(c, x, yy + 1, 128, 196, 224, (int)(34.0 + 40.0 * rimk));

            /* the rim itself: sub-pixel coverage split over the two rows the
             * surface crosses, so the edge is exact and never steps */
            cv_set(c, x, yy,     rr, rg, 255, a0);
            cv_set(c, x, yy + 1, rr, rg, 255, a1);

            /* the wet highlight just above it */
            cv_set(c, x, yy - 1, 132, 196, 228, (int)(44.0 + 46.0 * rimk));

            /* White water: a clump of overlapping soft patches along the crest
             * with a thin film trailing below it, not one soft dot. The jitter
             * is per column and stable, so two neighbours do not paint the same
             * blob and the foam reads as texture rather than as dots. */
            if (foam > 0.10 && FL_FOAM > 0.01) {
                double fa  = foam > 1.0 ? 1.0 : foam;
                double r   = 1.4 + 3.6 * fa;
                int    al  = (int)((18.0 + 120.0 * fa) * FL_FOAM);
                int    jit = (int)((unsigned)(x * 2654435761u >> 24) & 3u);

                if (s_paint_step <= 2) {
                    cv_soft(c, (double)x - r * 0.7 + (double)jit * 0.35,
                            fl_map[x] - 0.6, r * 0.90, 240, 250, 255, al / 2);
                    cv_soft(c, (double)x + r * 0.6, fl_map[x] - 1.4, r * 0.80,
                            250, 253, 255, al / 2);
                }
                cv_soft(c, (double)x, fl_map[x] - 1.2, r, 244, 252, 255, al);
                /* the film the crest leaves behind as it passes */
                if (s_paint_step <= 1 && fa > 0.35) {
                    int yy;

                    for (yy = 1; yy <= 3; yy++)
                        cv_set(c, x, (int)fl_map[x] + 2 + yy, 210, 232, 244,
                               (int)(26.0 * fa / (double)(yy + 1)));
                }
            }
        }
    }

    /* --- shafts: the room's light coming down through the surface ---------
     * Where the surface focuses light, it throws it down into the water, so a
     * shaft does not fall where the clock puts it: it bends toward the nearest
     * crest and brightens on it. A short search either side is cheaper than a
     * real refraction and reads the same. */
    for (i = 0; i < 7; i++) {
        double sx  = fmod((double)i * 281.0 + t * 8.0
                          + 46.0 * fsind((double)i * 2.1 + t * 0.17),
                          (double)c->w + 320.0) - 160.0;
        int    cx, k, best = -1;
        double bv = -1.0, len, sy, crs;

        if (sx < 0.0)
            sx = 0.0;
        if (sx > (double)(c->w - 1))
            sx = (double)(c->w - 1);
        for (k = -70; k <= 70; k += 5) {
            int ci = (int)sx + k;

            if (ci < 1 || ci >= c->w - 1)
                continue;
            if (fl_crest[ci] > bv) {
                bv   = fl_crest[ci];
                best = ci;
            }
        }
        cx  = best >= 0 ? best : (int)sx;
        crs = bv > 0.0 ? bv : 0.5;
        len = ((double)floorY - fl_map[cx])
            * (0.55 + 0.50 * fmod((double)i * 0.7, 1.0))
            * (0.72 + 0.50 * crs);
        sy  = fl_map[cx] + len * 0.5;
        /* A second, wider ellipse per shaft was the obvious way to soften its
         * edge, and it measured 2 ms a frame at step 1 and 1.4 ms at step 3 -
         * the halo is wide, so it covers the whole canvas once the canvas is
         * stepped down. Widening the single ellipse instead costs the same
         * thing for the same reason. A dimmer core fades out over the same
         * distance as a bright one, so this is the shaft it was, with its
         * brightness drawn back. */
        cv_ell_soft(c, (double)cx, sy,
                    26.0 + 30.0 * fmod((double)i * 0.43, 1.0), len * 0.5,
                    58, 140, 164,
                    (int)((16.0 + 24.0 * lv) * (0.55 + 0.80 * crs)));
    }

    /* --- the floor of the tank: the light that crossed the water lands here */
    cv_vgrad(c, 0, floorY, c->w, c->h - floorY, 7, 17, 34, 2, 6, 14);

    /* the floor receding: lines that crowd together toward the bottom of the
     * frame, so the bottom of the tank is a plane instead of a colour */
    if (FL_GLASS > 0.01) {
        int sk;

        /* six lines instead of four, crowding faster toward the bottom: the
         * floor is a plane running away from the camera, and four lines read
         * as one band at the foot of the water */
        for (sk = 1; sk <= 6; sk++) {
            double u     = (double)sk / 7.0;
            double yy    = (double)floorY + (double)(c->h - floorY) * u * u;
            double inset = (double)c->w * (0.13 - 0.016 * (double)sk);

            cv_line(c, inset, yy, (double)c->w - inset, yy, 1.0,
                    36, 78, 104, (int)(44.0 * FL_GLASS));
        }
    }
    cv_ell_soft(c, (double)c->w * 0.5, (double)floorY - 4.0,
                (double)c->w * 0.52, (double)c->h * 0.055,
                34, 86, 116, (int)(20.0 + 40.0 * lv));

    /* The floor is wet, so the water stands on it twice: a band just under the
     * floor line that follows the surface - brighter under a crest, where the
     * light is - and a second, softer pool below it. This is what ties the
     * bottom of the tank to the wave instead of leaving it a flat skirt. The
     * brightness comes from the smoothed height, so the band cannot stripe. */
    for (x = 0; x < c->w; x++) {
        double cb = 0.5 + 0.5 * (fl_body[x] /
                                 (fabs(fl_body[x]) + FL_BODY_M));
        int    a  = (int)((9.0 + 40.0 * cb) * (0.45 + 0.55 * lv));
        int    yy;

        for (yy = 1; yy <= 3; yy++)
            cv_set(c, x, floorY + yy, 44, 108, 132,
                   a / (yy == 1 ? 1 : (yy == 2 ? 2 : 4)));
    }
    cv_ell_soft(c, (double)c->w * 0.5,
                (double)floorY + (double)(c->h - floorY) * 0.42,
                (double)c->w * 0.46, (double)(c->h - floorY) * 0.20,
                30, 96, 118, (int)(14.0 + 26.0 * lv));
    cv_line(c, 0.0, (double)floorY, (double)c->w, (double)floorY, 1.6,
            62, 116, 146, 90);
    /* Each caustic is three nested soft ellipses and they are the most
     * expensive thing under the water, so the count is what gives way when the
     * canvas is stepped down rather than the pattern getting coarser. */
    {
    int nc = s_paint_step >= 2 ? 14 : 20;

    for (i = 0; i < nc; i++) {
        double fx  = fmod((double)i * 197.3 + t * 11.0
                          + 60.0 * fsind((double)i * 1.3 + t * 0.21),
                          (double)c->w + 240.0) - 120.0;
        /* seen through the water: the floor pattern is offset by the slope of
         * the surface above it, so the light on the bottom bends with the wave
         * instead of sliding across it on rails */
        double fy  = (double)floorY + (double)(c->h - floorY)
                   * (0.12 + 0.72 * fmod((double)i * 0.41, 1.0));
        double rad = (double)(c->h - floorY)
                   * (0.85 + 1.15 * fmod((double)i * 0.57, 1.0));
        int    cx  = (int)fx;
        double fo  = fl_focus[cx < 0 ? 0 : (cx >= c->w ? c->w - 1 : cx)];
        double sl  = fl_slope[cx < 0 ? 0 : (cx >= c->w ? c->w - 1 : cx)];
        double ccr = fl_crest[cx < 0 ? 0 : (cx >= c->w ? c->w - 1 : cx)];
        /* brighter under a crest: that is where the surface is focusing the
         * light that makes the pattern on the bottom in the first place */
        int    a   = (int)((46.0 + 84.0 * lv * fo) * (0.70 + 0.50 * ccr));

        if (s_paint_step <= 2)
            fx += sl * 16.0;

        cv_ell_soft(c, fx, fy, rad * 1.60, rad * 0.30,  34,  92, 118, a);
        cv_ell_soft(c, fx, fy, rad * 0.75, rad * 0.13,  96, 176, 190, a);
        cv_ell_soft(c, fx, fy, rad * 0.28, rad * 0.05, 190, 238, 236, a / 2);
    }
    }

    /* --- the glass: the water climbs the wall and catches the room's light */
    for (i = 0; i < 5; i++) {
        int ya = (int)(fl_map[i] - 2.0);
        int yb = (int)(fl_map[c->w - 1 - i] - 2.0);

        cv_set(c, i, ya,              190, 228, 255, 120 - 18 * i);
        cv_set(c, i, ya + 1,           90, 150, 200,  80 - 12 * i);
        cv_set(c, i, ya + 2,           40,  90, 140,  50 -  8 * i);
        cv_set(c, c->w - 1 - i, yb,   190, 228, 255, 120 - 18 * i);
        cv_set(c, c->w - 1 - i, yb + 1, 90, 150, 200,  80 - 12 * i);
        cv_set(c, c->w - 1 - i, yb + 2, 40,  90, 140,  50 -  8 * i);
    }

    /* --- spray thrown off the breaking crests ----------------------------- */
    if (!fl_drop_ready) {
        for (i = 0; i < 96; i++) {
            fl_drop[i].life = 0.0;
            fl_drop[i].x = fl_drop[i].y = fl_drop[i].vx = fl_drop[i].vy = 0.0;
        }
        fl_drop_ready = 1;
    }
    {
        int spawn = 0;
        /* a budget per second, not per frame: at 100 fps the old fixed four a
         * frame threw twice the spray it does at 45 */
        int want  = (int)(6.5 * (fl_dt * 60.0) + 0.5);

        if (want < 1)
            want = 1;
        if (want > 12)
            want = 12;
        for (i = 0; i < 96 && spawn < want; i++) {
            int tries;

            if (fl_drop[i].life > 0.0)
                continue;
            for (tries = 0; tries < 14; tries++) {
                int cx;

                /* Most of the spray now leaves a crest rather than any column
                 * that happens to have foam on it: a random column is stepped
                 * to the highest water within a twentieth of the width, so the
                 * drops cluster where the water is breaking instead of lying
                 * across the whole tank like snow. */
                if (fl_rand() < 0.72) {
                    int    span  = c->w / 20;
                    int    seedx = (int)(fl_rand() * (double)c->w);
                    int    k, best = -1;
                    double hv = -1.0;

                    if (span < 2)
                        span = 2;
                    for (k = -span; k <= span; k += 2) {
                        int ci = seedx + k;

                        if (ci < 1 || ci >= c->w - 1)
                            continue;
                        if (fl_crest[ci] > hv) {
                            hv   = fl_crest[ci];
                            best = ci;
                        }
                    }
                    cx = best >= 0 ? best : seedx;
                } else {
                    cx = (int)(fl_rand() * (double)c->w);
                }

                if (cx < 1 || cx >= c->w - 1 || fl_foam_px[cx] <= 0.28)
                    continue;
                fl_drop[i].x  = (double)cx;
                fl_drop[i].y  = fl_map[cx] - 1.0;
                fl_drop[i].vx = (fl_rand() - 0.5) * 90.0;
                /* thrown harder and living longer, so a break reads as spray
                 * that hangs and falls rather than as a spark that blinks */
                fl_drop[i].vy = -(95.0 + fl_rand() * 155.0) * (0.7 + 0.5 * lv);
                fl_drop[i].life = 0.55 + fl_rand() * 0.60;
                spawn++;
                break;
            }
        }
    }
    for (i = 0; i < 96; i++) {
        if (fl_drop[i].life <= 0.0)
            continue;
        fl_drop[i].vy += 780.0 * fl_dt;
        fl_drop[i].x  += fl_drop[i].vx * fl_dt;
        fl_drop[i].y  += fl_drop[i].vy * fl_dt;
        fl_drop[i].life -= fl_dt;
        if (fl_drop[i].life > 0.0)
            cv_soft(c, fl_drop[i].x, fl_drop[i].y, 1.8 + 1.6 * lv,
                    232, 248, 255, (int)(110.0 + 145.0 * (fl_drop[i].life > 0.5
                                                          ? 1.0
                                                          : fl_drop[i].life / 0.5)));
    }

    /* --- the glint that runs along the crests -----------------------------
     * Four points of light riding the highest water they can find. They sit two
     * rows under the lip on purpose: the crest line and the foam are drawn
     * exactly as they were, and this is light refracted just beneath them,
     * travelling with the wave. The slow twinkle is what stops four highlights
     * reading as four little lamps. */
    for (i = 0; i < 5; i++) {
        double g    = fmod((double)i * (double)c->w * 0.23
                           + t * (26.0 + 7.0 * (double)i), (double)c->w);
        int    cx   = (int)g;
        int    span = c->w / 18;
        int    k, best = -1;
        double bv = -1.0;

        if (span < 4)
            span = 4;
        for (k = -span; k <= span; k += 2) {
            int ci = cx + k;

            if (ci < 1 || ci >= c->w - 1)
                continue;
            if (fl_crest[ci] > bv) {
                bv   = fl_crest[ci];
                best = ci;
            }
        }
        if (best >= 0 && bv > 0.45) {
            /* Bright enough to be seen against the lit water: at 40-100 alpha
             * a white streak two rows under a crest disappeared into the teal
             * band, which is what the first render of this showed. */
            double tw = 0.70 + 0.30 * fsind(t * 3.1 + (double)i * 1.7);
            int    a  = (int)((215.0 + 40.0 * bv) * tw * (0.65 + 0.35 * lv));
            double rx = 14.0 + 12.0 * bv;

            /* A flat streak rather than a dot: the light skims the surface, so
             * it is long and thin. It sits five rows under the lip and its
             * height is capped, so not one pixel of the crest line or of the
             * foam above it is touched - the halo below included.
             *
             * v116: the v114 glint measured +52 luma over 262 pixels on the
             * host and was invisible on the television at viewing distance. A
             * brighter core inside a wide, dim halo is how a highlight reads
             * across a room; it still sits entirely under the lip. */
            if (a > 3) {
                cv_ell_soft(c, (double)best, fl_map[best] + 5.5,
                            rx * 1.9, 3.4, 255, 252, 232, a / 3);
                cv_ell_soft(c, (double)best, fl_map[best] + 5.5,
                            rx, 2.3, 255, 253, 236, a);
            }
        }
    }

    /* a little dust in the air over the tank */
    art_sparks(c, m, 0.0, (double)c->w, (double)c->h * 0.06,
               (double)base, 20, 170, 220, 255);
}

/* ------------------------------------------------------------------ flag -- */

static void art_flag(Cv *c, const UiModel *m)
{
    const int stripes = 13;
    double    t = m->elapsed_sec;
    double    lv = (double)m->vis_level;
    double    sh = (double)c->h / (double)stripes;
    double    canton_w = (double)c->w * 0.42;
    double    pole = (double)c->w * 0.014 + 2.0;
    double   *rip;
    double   *rowlit;
    int       x, k, i, yy;

    rip = (double *)malloc(sizeof(double) * (size_t)c->w);
    rowlit = (double *)malloc(sizeof(double) * (size_t)c->h);
    if (!rip || !rowlit) {
        free(rip);
        free(rowlit);
        return;
    }
    /* the weave's vertical light is one value per scan line: it was a sine per
     * pixel, which was most of this look's frame time */
    for (yy = 0; yy < c->h; yy++)
        rowlit[yy] = 0.96 + 0.06 * fsind((double)yy * 0.055 + t * 1.2);

    for (x = 0; x < c->w; x++) {
        double u = (double)x / (double)c->w;
        double big = (double)c->h * (0.030 + 0.060 * lv);
        double small_ = (double)c->h * 0.012;

        rip[x] = big * sin(u * 7.0 - t * 2.3)
               + big * 0.40 * sin(u * 15.0 + t * 1.6)
               + small_ * sin(u * 33.0 - t * 3.1);
    }

    /* a little grit in the air in front of the cloth */
    art_sparks(c, m, 0.0, (double)c->w, (double)c->h * 0.05,
               (double)c->h * 0.95, 20, 220, 216, 200);

    /* Cloth, per pixel. The bands are not stacked rectangles any more: one
     * continuous strip of cloth is displaced by the beat and the stripe index
     * is read from the displaced position, so the bands can never separate and
     * show background through the flag. */
    for (x = 0; x < c->w; x++) {
        double crease = fcosd((double)x * 0.052 + t * 1.7) * 0.64
                      + fcosd((double)x * 0.021 - t * 0.90) * 0.36;
        double slope = 0.0;
        double shade = 0.80 + 0.24 * crease + 0.12 * crease * crease * crease;
        double top = rip[x];
        int    in_canton = x < (int)canton_w;
        double clit = 0.0;
        int    y, yy0 = (int)top, yy1 = (int)(top + sh * (double)stripes);

        if (in_canton)
            clit = (double)band_at(m, 0.06 + 0.34 * (double)x / canton_w);

        if (x > 0 && x < c->w - 1)
            slope = (rip[x + 1] - rip[x - 1]) * 0.5;
        shade -= slope * 0.035;
        if (shade < 0.46)
            shade = 0.46;
        if (shade > 1.20)
            shade = 1.20;

        for (y = yy0; y < yy1 && y < c->h; y++) {
            double v = ((double)y - top) / (sh * (double)stripes);
            double vd = v
                      + 0.055 * lv * sin(v * 9.0 - t * 2.4 + (double)x * 0.004)
                      + 0.022 * lv * sin(v * 21.0 + t * 1.3);
            double pos = vd * (double)stripes;
            double frac, s;
            int    b;
            double br, bg, bb;

            k = (int)floor(pos);
            if (k < 0)
                k = 0;
            if (k > stripes - 1)
                k = stripes - 1;
            frac = pos - floor(pos);

            /* The canton is part of the cloth: the same displacement, the
             * same crease shading, the same weave. Painting it afterwards as a
             * flat rectangle is what left the blue block floating over the
             * stripes with its own light on it. */
            if (in_canton && v < 7.0 / 13.0) {
                s = shade * rowlit[y];
                cv_put(c, x, y,
                       (int)(( 22.0 + clit * 30.0) * s),
                       (int)(( 40.0 + clit * 46.0) * s),
                       (int)((104.0 + clit * 66.0) * s));
                continue;
            }

            b = k * VIS_BANDS / stripes;
            {
                double lit = (double)m->vis_bands[b];

                if (k % 2 == 0) {
                    br = 168.0 + lit * 74.0;
                    bg =  24.0 + lit * 44.0;
                    bb =  44.0 + lit * 50.0;
                } else {
                    br = 234.0 + lit * 20.0;
                    bg = 234.0 + lit * 17.0;
                    bb = 236.0 + lit * 16.0;
                }
            }
            s = shade * rowlit[y];
            if (frac < 0.045 || frac > 0.955)     /* the stitched seam */
                s *= 0.84;
            cv_put(c, x, y, (int)(br * s), (int)(bg * s), (int)(bb * s));
        }
    }

    /* the seam where the canton is sewn on, following the same cloth */
    for (x = (int)canton_w - 3; x < (int)canton_w; x++) {
        double top = rip[x];

        cv_line(c, (double)x, top + 1.0, (double)x, top + sh * 7.0 - 1.0,
                1.4, 6, 10, 30, 120);
        cv_line(c, (double)x, top + 1.0, (double)x, top + sh * 7.0 - 1.0,
                1.0, 190, 204, 236, 70);
    }

    for (i = 0; i < 50; i++) {
        int    row = 0, count, index = i, col;
        double rowstep = 1.0 / 9.0;
        int    long_row = 1;

        while (index >= (long_row ? 6 : 5)) {
            index -= long_row ? 6 : 5;
            long_row = !long_row;
            row++;
        }
        count = long_row ? 6 : 5;
        col = index;
        {
            int    b = i * VIS_BANDS / 50;
            double lit = (double)m->vis_bands[b];
            double ux = (double)c->w * 0.42;
            double cx = ux * (0.10 + 0.80 * (double)(col + (long_row ? 0 : 0.5))
                             / (double)count);
            /* the stars ride the cloth: no vertical lift, so they can never
             * float above the canton again */
            double cy = rip[(int)cx] + sh * 7.0 *
                        (rowstep + (double)row * (0.93 / 9.0));
            double rad = sh * 0.26 * (1.0 + lit * 0.55);

            /* the stars are sewn on, not spinning: a fixed orientation, a
             * tight glow, and they sit in the cloth like everything else */
            cv_soft(c, cx, cy, rad * 2.2, 150, 200, 255, (int)(18 + lit * 44));
            star_shape(c, cx, cy, rad, 0.0, 238, 246, 255, 255);
            cv_soft(c, cx, cy, rad * 0.8, 255, 255, 255, (int)(90 + lit * 80));
        }
    }

    {
        /* The hoist: a dark band where the cloth is stitched to the pole, and
         * a shadow just under it. The pole and its rings used to be drawn over
         * the flag, which put floating circles on the canton. */
        int yy;

        for (yy = (int)rip[0]; yy < c->h; yy++) {
            double s = 1.0 - 0.10 * (double)yy / (double)c->h;

            cv_set(c, (int)(pole * 0.30), yy,
                   (int)(58 * s), (int)(56 * s), (int)(66 * s), 255);
            cv_set(c, (int)(pole * 0.55), yy,
                   (int)(116 * s), (int)(112 * s), (int)(122 * s), 255);
            cv_set(c, (int)(pole * 0.80), yy,
                   (int)(36 * s), (int)(34 * s), (int)(42 * s), 255);
        }
    }
    free(rip);
    free(rowlit);
}

/* ------------------------------------------------------------------ worm -- */

static void art_worm(Cv *c, const UiModel *m)
{
    double t = m->elapsed_sec;
    double w = (double)c->w, h = (double)c->h;
    double gy = h * 0.78;
    double x0 = w * 0.16, x1 = w * 0.80;
    double rmax = h * 0.086;
    double endy = gy, endr = rmax;
    int    x, y, i;

    /* a damp cellar floor */
    cv_vgrad(c, 0, 0, c->w, c->h, 5, 8, 13, 12, 12, 20);
    cv_soft(c, w * 0.55, h * 0.95, w * 0.60, 46, 26, 64, 110);
    cv_rect(c, 0, (int)gy + 10, c->w, c->h, 11, 10, 16, 255);
    cv_rect(c, 0, (int)gy + 10, c->w, 2, 44, 38, 58, 200);
    art_sparks(c, m, 0.0, w, h * 0.10, gy - h * 0.02, 22, 210, 210, 240);
    for (i = 0; i < c->w; i += 46)
        cv_line(c, i, gy + 12, i - 26, (double)c->h, 1.4, 20, 18, 28, 160);

    /* the body, column by column: one tube, a real highlight, no banding */
    for (x = (int)x0; x <= (int)x1; x++) {
        double u = ((double)x - x0) / (x1 - x0);
        double ph = t * 2.3 - u * 5.2;
        double cy = gy - (0.30 + 0.70 * u) * (h * 0.30)
                   - sin(ph) * h * 0.055;
        double bulge = 0.36 + 0.64 * sin(ART_PI * (0.16 + 0.74 * u));
        double rad = rmax * bulge;
        double lift = 0.5 + 0.5 * sin(ph * 0.5);
        int    y0 = (int)(cy - rad), y1 = (int)(cy + rad);

        endy = cy;
        endr = rad;

        /* two shadows: the broad one the body throws, and the tight dark
         * where it actually touches the floor */
        /* The broad shadow was laid down every other column at two hundred
         * pixels across, which was most of this look's frame time. Six columns
         * apart and a touch tighter is invisible on screen. */
        if (x % 6 == 0) {
            cv_soft(c, (double)x, gy + 16, rad * 1.9, 6, 5, 10, 74);
            cv_soft(c, (double)x, gy + 12, rad * 0.9, 4, 3, 7, 96);
        }

        for (y = y0; y <= y1; y++) {
            double ty = ((double)y + 0.5 - cy) / rad;
            double d2 = 1.0 - ty * ty;
            double d, lam, cov, spec, mott;
            int    cr, cg, cb;

            if (d2 <= 0.0)
                continue;
            d = sqrt(d2);
            cov = (rad - fabs((double)y + 0.5 - cy)) + 0.6;
            if (cov <= 0.0)
                continue;
            if (cov > 1.0)
                cov = 1.0;
            /* A cylinder, not a stripe: the visible surface normal at this
             * height is (0, ty, sqrt(1-ty*ty)). Lighting it properly is what
             * gives the body its roundness, and the half vector gives the wet
             * highlight a place to live instead of a hard band. */
            lam = ty * -0.78 + d * 0.44;
            if (lam < 0.0)
                lam = 0.0;
            spec = pow(ty * -0.60 + d * 0.72, 24.0) * 0.85;
            mott = 0.95 + 0.05 * sin((double)x * 0.21 + ty * 5.0)
                        + 0.03 * sin((double)x * 0.07 - ty * 2.1);
            cr = (int)((168 + 26 * lift) * lam * mott + 255 * spec);
            cg = (int)(( 96 + 20 * lift) * lam * mott + 250 * spec);
            cb = (int)((124 + 26 * lift) * lam * mott + 255 * spec);
            cv_set(c, x, y, cr, cg, cb, (int)(255 * cov));
        }
        /* the wet back: a soft sheen laid on the tube, not a drawn line */
        if (x > (int)x0)
            cv_soft(c, (double)x, cy - rad * 0.40, rad * 0.34,
                    255, 238, 250, 52);
        if (x % 13 == 0)
            cv_soft(c, (double)x + sin((double)x * 1.3) * 3.0, cy + rad * 0.30,
                    rad * 0.13, 172, 92, 128, 40);
    }

    /* head: grown out of the end of the tube, not parked beside it */
    {
        double hx = x1 + endr * 0.55;
        double hy = endy - endr * 0.55;
        double hr = endr * 1.9;
        double er = hr * 0.24;

        cv_taper(c, x1 - endr * 0.8, endy, hx, hy, endr * 0.95, hr * 0.92,
                 198, 126, 152, 255);
        cv_soft(c, hx, gy + 14, hr * 2.2, 6, 5, 10, 120);
        cv_ball(c, hx, hy, hr * 1.05, 30, 18, 36, 80, 46, 96);
        cv_ball(c, hx, hy, hr, 206, 132, 156, 255, 246, 255);
        cv_soft(c, hx - hr * 0.34, hy - hr * 0.44, hr * 0.48, 255, 250, 255, 110);
        cv_line(c, hx + hr * 0.08, hy + hr * 0.60, hx + hr * 0.60, hy + hr * 0.46,
                2.6, 96, 40, 70, 220);
        cv_soft(c, hx + hr * 0.36, hy + hr * 0.68, hr * 0.15, 70, 16, 36, 200);
        cv_ball(c, hx + hr * 0.24, hy - hr * 0.26, er + 1.4, 250, 250, 255, 255, 255, 255);
        cv_ball(c, hx + hr * 0.50, hy + hr * 0.26, er + 1.4, 250, 250, 255, 255, 255, 255);
        cv_ball(c, hx + hr * 0.31, hy - hr * 0.26, er * 0.62, 40, 70, 50, 60, 170, 130);
        cv_ball(c, hx + hr * 0.57, hy + hr * 0.26, er * 0.62, 40, 70, 50, 60, 170, 130);
        cv_set(c, (int)(hx + hr * 0.26), (int)(hy - hr * 0.33), 255, 255, 255, 255);
        cv_set(c, (int)(hx + hr * 0.52), (int)(hy + hr * 0.19), 255, 255, 255, 255);
    }

    /* rings of muscle along the back, catching the light in sequence */
    for (i = 0; i < 26; i++) {
        double u = 0.06 + 0.86 * (double)i / 26.0;
        double bx = x0 + u * (x1 - x0);
        double ph = t * 2.3 - u * 5.2;
        double bcy = gy - (0.30 + 0.70 * u) * (h * 0.30) - sin(ph) * h * 0.055;
        double bul = 0.36 + 0.64 * sin(ART_PI * (0.16 + 0.74 * u));
        double br = rmax * bul;

        cv_line(c, bx - br * 0.22, bcy - br * 0.88, bx + br * 0.06,
                bcy - br * 0.82, 1.0, 255, 236, 242, 22);
        cv_soft(c, bx, bcy + br * 0.16, br * 0.26, 120, 44, 78, 22);
    }

    /* tail: one continuous taper out of the body's start, so the two are the
     * same animal instead of a body with a blob beside it */
    {
        double ty0 = gy - h * 0.09 - sin(t * 2.3) * h * 0.055;
        double ty1 = gy - 0.30 * (h * 0.30) - sin(t * 2.3) * h * 0.055;

        for (i = 0; i < 48; i++) {
            double u = (double)i / 47.0;
            double yy = ty0 + (ty1 - ty0) * u * u;
            double xx = x0 - (1.0 - u) * w * 0.075;
            double rr = rmax * (0.13 + 0.53 * u);

            cv_soft(c, xx, gy + 14.0, rr * 2.0, 4, 3, 8, 60);
            cv_ball(c, xx, yy, rr, 164, 100, 124, 246, 226, 244);
        }
    }
}

/* -------------------------------------------------------------- windmill -- */

static void art_blade(Cv *c, double hx, double hy, double ang, double len,
                      double wid, int alpha, double lit)
{
    /* six points: root and tip on both edges, plus the centreline, so the
     * cloth can be lit on one half and left in shadow on the other */
    double ca = cos(ang), sa = sin(ang);
    double w0 = wid * 0.14, w1 = wid * 1.08;
    double lx0 = hx + ca * (len * 0.10) - sa * w0;
    double ly0 = hy + sa * (len * 0.10) + ca * w0;
    double lx1 = hx + ca * len - sa * w1;
    double ly1 = hy + sa * len + ca * w1;
    double tx0 = hx + ca * (len * 0.10) + sa * w0;
    double ty0 = hy + sa * (len * 0.10) - ca * w0;
    double tx1 = hx + ca * len + sa * w1;
    double ty1 = hy + sa * len - ca * w1;
    double mx0 = hx + ca * (len * 0.10);
    double my0 = hy + sa * (len * 0.10);
    double mx1 = hx + ca * len;
    double my1 = hy + sa * len;
    int    k;

    /* lit half (sunset side) and shadowed half */
    cv_poly(c, (double[]){ lx0, lx1, mx1, mx0 }, (double[]){ ly0, ly1, my1, my0 }, 4,
            (int)(214 + lit * 30), (int)(204 + lit * 32), (int)(186 + lit * 44), alpha);
    cv_poly(c, (double[]){ mx0, mx1, tx1, tx0 }, (double[]){ my0, my1, ty1, ty0 }, 4,
            (int)(150 + lit * 26), (int)(140 + lit * 26), (int)(128 + lit * 30), alpha);

    /* the wooden leading spar and the trailing edge */
    cv_line(c, lx0, ly0, lx1, ly1, 3.6, 62, 50, 40, alpha);
    cv_line(c, tx0, ty0, tx1, ty1, 2.2, 78, 62, 48, alpha);
    cv_line(c, mx0, my0, mx1, my1, 1.2, 96, 80, 60, alpha / 2);

    /* four rungs and one diagonal: enough to read as a frame, not a ladder */
    for (k = 1; k <= 4; k++) {
        double u = 0.16 + 0.80 * (double)k / 4.0;
        double rw = w0 + (w1 - w0) * u;

        cv_line(c, hx + ca * len * u - sa * rw, hy + sa * len * u + ca * rw,
                hx + ca * len * u + sa * rw, hy + sa * len * u - ca * rw,
                1.3, 86, 70, 54, alpha * 3 / 4);
    }
    cv_line(c, lx0, ly0, mx1, my1, 1.3, 86, 70, 54, alpha * 2 / 3);
}

static void art_windmill(Cv *c, const UiModel *m)
{
    double t = m->elapsed_sec;
    double w = (double)c->w, h = (double)c->h;
    double hx = w * 0.47, hy = h * 0.415;
    double len = h * 0.395;
    double ang = t * 1.25 + (double)m->vis_level * 1.4;
    int    k, i;

    /* dusk sky */
    cv_vgrad(c, 0, 0, c->w, (int)(h * 0.62), 16, 18, 44, 96, 62, 72);
    cv_vgrad(c, 0, (int)(h * 0.62), c->w, c->h - (int)(h * 0.62), 96, 62, 72, 22, 18, 30);
    for (i = 0; i < 34; i++) {
        double sx = fmod((double)i * 97.3, w);
        double sy = fmod((double)i * 41.7, h * 0.52);
        double tw = 0.5 + 0.5 * sin(t * 1.6 + (double)i);

        cv_soft(c, sx, sy, 1.3 + (double)(i % 3) * 0.6, 225, 238, 255,
                (int)(70 + 90 * tw));
    }
    /* the sun, low and behind the sails */
    cv_soft(c, w * 0.76, h * 0.58, h * 0.34, 255, 140, 80, 70);
    cv_soft(c, w * 0.76, h * 0.58, h * 0.17, 255, 196, 128, 120);
    cv_soft(c, w * 0.76, h * 0.58, h * 0.07, 255, 236, 200, 150);
    /* the dust the sails turn through, lit by the low sun */
    art_sparks(c, m, 0.0, w, h * 0.18, h * 0.86, 24, 255, 214, 180);

    /* long cloud bands lit from underneath by that sun: the layer that turns a
     * gradient into an evening */
    for (i = 0; i < 7; i++) {
        double cy = h * (0.16 + 0.052 * (double)i);
        double cw = w * (0.22 + 0.10 * (double)(i % 4));
        double cx = w * (0.18 + 0.62 * fmod((double)i * 0.37 + t * 0.006, 1.0));
        double d = 1.0 - (double)i / 8.0;

        cv_soft(c, cx, cy + 6.0, cw, 236, 148, 126, (int)(16 + 24 * d));
        cv_soft(c, cx, cy, cw * 0.9, 96, 84, 128, (int)(22 + 26 * d));
        cv_soft(c, cx + cw * 0.5, cy + 3.0, cw * 0.30, 255, 190, 150, (int)(20 * d));
    }

    /* far hills, two layers so there is depth behind the tower */
    {
        double xs[6], ys[6];

        xs[0] = 0;        ys[0] = h;
        xs[1] = 0;        ys[1] = h * 0.80;
        xs[2] = w * 0.30; ys[2] = h * 0.74;
        xs[3] = w * 0.62; ys[3] = h * 0.79;
        xs[4] = w;        ys[4] = h * 0.75;
        xs[5] = w;        ys[5] = h;
        cv_poly(c, xs, ys, 6, 30, 30, 48, 255);
    }
    {
        double xs[5], ys[5];

        xs[0] = 0;        ys[0] = h;
        xs[1] = 0;        ys[1] = h * 0.87;
        xs[2] = w * 0.52; ys[2] = h * 0.83;
        xs[3] = w;        ys[3] = h * 0.88;
        xs[4] = h * 0 + w; ys[4] = h;
        cv_poly(c, xs, ys, 5, 16, 18, 30, 255);
    }

    /* the mill: stone body, brick courses, lit face and shadowed face */
    {
        double bw = w * 0.072, tw = w * 0.050;
        double by = h * 0.90, ty = h * 0.38;

        cv_poly(c, (double[]){ hx - bw, hx + bw, hx + tw, hx - tw },
                   (double[]){ by, by, ty, ty }, 4, 58, 52, 48, 255);
        /* the sun is behind and to the right, so that face is the lit one */
        cv_poly(c, (double[]){ hx, hx + bw, hx + tw, hx },
                   (double[]){ by, by, ty, ty }, 4, 104, 90, 78, 238);
        /* brick courses */
        for (k = 0; k < 14; k++) {
            double u = (double)k / 14.0;
            double yy = ty + (by - ty) * u;
            double halfw = tw + (bw - tw) * u;

            cv_line(c, hx - halfw, yy, hx + halfw, yy, 1.2, 54, 46, 42, 110);
        }
        /* door, window with a warm lamp, and the balcony */
        cv_poly(c, (double[]){ hx - w * 0.016, hx + w * 0.016,
                               hx + w * 0.016, hx - w * 0.016 },
                   (double[]){ by, by, by - h * 0.085, by - h * 0.085 }, 4,
                38, 30, 26, 255);
        cv_line(c, hx, by, hx, by - h * 0.085, 1.6, 24, 20, 18, 220);
        cv_soft(c, hx, by - h * 0.045, w * 0.028, 255, 186, 110, 120);
        cv_rect(c, (int)(hx - w * 0.010), (int)(h * 0.55),
                (int)(w * 0.020), (int)(h * 0.030), 44, 48, 66, 255);
        cv_rect(c, (int)(hx - w * 0.010), (int)(h * 0.55), (int)(w * 0.020), 2,
                220, 200, 160, 150);
        cv_rect(c, (int)(hx - tw - 4), (int)ty - 3, (int)(tw * 2 + 8), 5,
                62, 56, 50, 255);
        /* cap: a dark shingled cone with a small ridge */
        cv_poly(c, (double[]){ hx - tw - 6, hx + tw + 6, hx },
                   (double[]){ ty - 2, ty - 2, ty - h * 0.10 }, 3, 40, 34, 32, 255);
        cv_poly(c, (double[]){ hx, hx + tw + 6, hx },
                   (double[]){ ty - 2, ty - 2, ty - h * 0.10 }, 3, 76, 64, 56, 170);
    }

    /* ambient shadow where the mill meets the field, and the sun catching
     * its right-hand edge */
    cv_soft(c, hx + w * 0.030, h * 0.905, w * 0.085, 6, 6, 10, 130);
    cv_soft(c, hx + w * 0.050, h * 0.895, w * 0.055, 4, 4, 8, 80);
    cv_line(c, hx + w * 0.060, h * 0.895, hx + w * 0.042, h * 0.395,
            2.4, 255, 196, 132, 120);
    cv_line(c, hx - w * 0.060, h * 0.895, hx - w * 0.042, h * 0.395,
            1.6, 120, 160, 220, 46);

    /* sails: two ghosts for motion, then the live one */
    for (k = 0; k < 4; k++) {
        double a = ang + (double)k * ART_PI / 2.0;

        art_blade(c, hx, hy, a - 0.11, len, h * 0.066, 14, m->vis_level);
        art_blade(c, hx, hy, a - 0.05, len, h * 0.066, 26, m->vis_level);
        art_blade(c, hx, hy, a, len, h * 0.066, 255, m->vis_level);
    }
    cv_ball(c, hx, hy, h * 0.032, 78, 70, 64, 255, 220, 190);
    cv_ring(c, hx, hy, h * 0.038, 2.2, 40, 34, 30, 220);
    for (k = 0; k < 4; k++) {
        double a = (double)k * ART_PI / 2.0 + 0.78;

        cv_set(c, (int)(hx + cos(a) * h * 0.024), (int)(hy + sin(a) * h * 0.024),
               240, 230, 210, 220);
    }

    /* grass and a path, so the mill stands somewhere */
    /* the field itself, warmer near the sun and falling into shadow at the
     * edges, with grass that catches the last light on its tips */
    {
        double gx[4], gy[4];

        gx[0] = 0.0;      gy[0] = h * 0.86;
        gx[1] = w;        gy[1] = h * 0.87;
        gx[2] = w;        gy[2] = h;
        gx[3] = 0.0;      gy[3] = h;
        cv_poly(c, gx, gy, 4, 24, 27, 30, 255);
        cv_soft(c, w * 0.70, h * 0.92, w * 0.48, 148, 108, 62, 86);
        cv_soft(c, w * 0.10, h * 1.00, w * 0.35, 8, 10, 16, 80);
    }
    for (i = 0; i < 130; i++) {
        double gx = (double)i * w / 130.0;
        double gh = h * (0.022 + 0.020 * sin((double)i * 1.7));
        double tip = 0.4 + 0.6 * ((double)i / 130.0);

        cv_line(c, gx, h, gx + 1.5, h - gh, 2.2, 26, 30, 30, 235);
        cv_line(c, gx + 1.5, h - gh, gx + 2.0, h - gh - 2.0, 1.2,
                (int)(80 + 70 * tip), (int)(84 + 56 * tip), (int)(60 + 30 * tip), 180);
    }
    cv_soft(c, hx, h * 0.93, w * 0.06, 90, 80, 60, 40);
}

/* ------------------------------------------------------------- the humans -- */

/* A pose is a skeleton; the drawing adds thickness where a body has it. */
typedef struct {
    double px, py;             /* pelvis */
    double cx, cy;             /* chest centre */
    double nx, ny;             /* neck */
    double hx, hy, hr;         /* head */
    double ex[2], ey[2];       /* elbows */
    double wx[2], wy[2];       /* wrists */
    double kx[2], ky[2];       /* knees */
    double ax[2], ay[2];       /* ankles */
    double sw;                 /* shoulder half width */
    double hw;                 /* hip half width */
    double th;                 /* body scale: thickness unit */
} Pose;

static void pose_default(Pose *p, double cx, double ground, double H)
{
    memset(p, 0, sizeof(*p));
    p->th = H * 0.058;
    p->sw = H * 0.110;
    p->hw = H * 0.090;
    p->hr = H * 0.076;
    p->px = cx;
    p->py = ground - H * 0.470;
    p->cx = cx;
    p->cy = ground - H * 0.715;
    p->nx = cx;
    p->ny = ground - H * 0.795;
    p->hx = cx;
    p->hy = ground - H * 0.912;
}

static void pose_legs(Pose *p, double k0x, double k0y, double a0x, double a0y,
                      double k1x, double k1y, double a1x, double a1y)
{
    p->kx[0] = k0x; p->ky[0] = k0y; p->ax[0] = a0x; p->ay[0] = a0y;
    p->kx[1] = k1x; p->ky[1] = k1y; p->ax[1] = a1x; p->ay[1] = a1y;
}

static void pose_arms(Pose *p, double e0x, double e0y, double w0x, double w0y,
                      double e1x, double e1y, double w1x, double w1y)
{
    p->ex[0] = e0x; p->ey[0] = e0y; p->wx[0] = w0x; p->wy[0] = w0y;
    p->ex[1] = e1x; p->ey[1] = e1y; p->wx[1] = w1x; p->wy[1] = w1y;
}

static void bg_grad(Cv *c, int y0, int y1, int r0, int g0, int b0,
                    int r1, int g1, int b1)
{
    int y, x, n;

    if (!c->p)
        return;
    if (y0 < 0) y0 = 0;
    if (y1 > c->h) y1 = c->h;
    n = y1 - y0;
    if (n <= 0)
        return;
    for (y = y0; y < y1; y++) {
        double u = n > 1 ? (double)(y - y0) / (double)(n - 1) : 0.0;
        unsigned char *q = c->p + (size_t)y * (size_t)c->w * 4;
        unsigned char cr = (unsigned char)clampi((int)(r0 + (r1 - r0) * u), 0, 255);
        unsigned char cg = (unsigned char)clampi((int)(g0 + (g1 - g0) * u), 0, 255);
        unsigned char cb = (unsigned char)clampi((int)(b0 + (b1 - b0) * u), 0, 255);

        for (x = 0; x < c->w; x++) {
            q[0] = cr;
            q[1] = cg;
            q[2] = cb;
            q[3] = 255;
            q += 4;
        }
    }
}

static void bg_rect(Cv *c, int x, int y, int w, int h, int r, int g, int b)
{
    int i, j;

    if (!c->p)
        return;
    if (x < 0) { w += x; x = 0; }
    if (y < 0) { h += y; y = 0; }
    if (x + w > c->w) w = c->w - x;
    if (y + h > c->h) h = c->h - y;
    if (w <= 0 || h <= 0)
        return;
    r = clampi(r, 0, 255);
    g = clampi(g, 0, 255);
    b = clampi(b, 0, 255);
    for (j = 0; j < h; j++) {
        unsigned char *q = c->p + ((size_t)(y + j) * (size_t)c->w + (size_t)x) * 4;

        for (i = 0; i < w; i++) {
            q[0] = (unsigned char)r;
            q[1] = (unsigned char)g;
            q[2] = (unsigned char)b;
            q[3] = 255;
            q += 4;
        }
    }
}

/* A hard-edged ellipse: eyes, irises, lips, platters, shadow pools. The circle
 * primitives could not do any of those, and a circle is not a jaw. */
static void cv_ell(Cv *c, double cx, double cy, double rx, double ry,
                   int r, int g, int b, int a)
{
    int x, y;

    if (rx < 0.7 || ry < 0.7 || a <= 0)
        return;
    for (y = cv_i(cy - ry - 1.0); y <= cv_i(cy + ry + 1.0); y++) {
        double ny = ((double)y + 0.5 - cy) / ry;
        double hw;

        if (ny <= -1.0 || ny >= 1.0)
            continue;
        hw = rx * sqrt(1.0 - ny * ny);
        for (x = cv_i(cx - hw - 1.0); x <= cv_i(cx + hw + 1.0); x++) {
            double cov = hw + 0.6 - fabs((double)x + 0.5 - cx);

            if (cov <= 0.0)
                continue;
            if (cov > 1.0)
                cov = 1.0;
            cv_set(c, x, y, r, g, b, (int)(a * cov));
        }
    }
}

/* The soft version, block stamped like cv_soft: shadows on a floor are wide
 * and smooth, and a wide smooth thing should not cost a pixel at a time. */
static void cv_ell_soft(Cv *c, double cx, double cy, double rx, double ry,
                        int r, int g, int b, int a)
{
    int x, y, block = 1;
    double big = rx > ry ? rx : ry;

    if (rx < 0.7 || ry < 0.7 || a <= 0)
        return;
    if (big > 170.0)
        block = 4;
    else if (big > 90.0)
        block = 3;
    else if (big > 34.0)
        block = 2;

    r = clampi(r, 0, 255);
    g = clampi(g, 0, 255);
    b = clampi(b, 0, 255);

    for (y = cv_i(cy - ry); y <= cv_i(cy + ry); y += block) {
        for (x = cv_i(cx - rx); x <= cv_i(cx + rx); x += block) {
            double dx = ((double)x + block * 0.5 - cx) / rx;
            double dy = ((double)y + block * 0.5 - cy) / ry;
            double d = dx * dx + dy * dy;
            int    al;

            if (d >= 1.0)
                continue;
            d = 1.0 - sqrt(d);
            al = (int)(a * d * d);
            if (al <= 1)
                continue;
            cv_blk(c, x, y, block, r, g, b, al);
        }
    }
}

/* ---- the light rig the performers are drawn with ------------------------ */

/* Two lights, one rig. A stage key comes down cool from the upper left and the
 * LED wall throws a second, coloured light from behind. One light is what made
 * the old figures read as cut-outs: every limb had one flat fill and no
 * terminator, so nothing looked round. */
typedef struct {
    int    kr, kg, kb;      /* key tint, 0-255 */
    int    fr, fg, fb;      /* fill / wall tint */
    double sheen;           /* specular strength */
} Rig;

/* One point of a lit cylinder or torso. nx is where the surface faces across
 * the body: -1 its left edge, 0 straight at the camera, +1 its right edge. Two
 * half-lambert terms do the lighting and the highlight is key^8 rather than a
 * pow() call, because this runs across a million pixels. */
static void art_shade(Cv *c, int x, int y, double nx, double cov,
                      int r, int g, int b, int a, const Rig *rig)
{
    double nz, key, fill, sp, rim, sh;
    double kk, gk, bk, ff, fg2, fb2;
    int    cr, cg, cb;

    if (nx < -1.0) nx = -1.0;
    if (nx >  1.0) nx =  1.0;
    nz   = sqrt(1.0 - nx * nx);
    key  = nz * 0.84 - nx * 0.46;
    fill = nz * 0.50 + nx * 0.66;
    if (key  < 0.0) key  = 0.0;
    if (fill < 0.0) fill = 0.0;

    sp = key * key;
    sp *= sp;
    sp *= sp;                                   /* key^8 */

    sh = 0.135 + 0.72 * key;
    kk = 0.58 + 0.49 * (double)rig->kr / 255.0;
    gk = 0.58 + 0.49 * (double)rig->kg / 255.0;
    bk = 0.58 + 0.49 * (double)rig->kb / 255.0;
    ff = 0.34 * fill * (double)rig->fr / 255.0;
    fg2 = 0.34 * fill * (double)rig->fg / 255.0;
    fb2 = 0.34 * fill * (double)rig->fb / 255.0;

    cr = (int)((double)r * (sh * kk + ff) + sp * rig->sheen * 168.0);
    cg = (int)((double)g * (sh * gk + fg2) + sp * rig->sheen * 178.0);
    cb = (int)((double)b * (sh * bk + fb2) + sp * rig->sheen * 190.0);

    /* The rim is the wall behind the performer, so it is coldest on the key
     * side and takes the wall's colour on the other. Three pixels of it is
     * what separates a body from the backdrop it stands in front of. */
    rim = 1.0 - nz;
    rim *= rim;
    cr += (int)(rim * (nx < 0.0 ? 62.0 * kk
                                : 96.0 * (double)rig->fr / 255.0));
    cg += (int)(rim * (nx < 0.0 ? 62.0 * gk
                                : 96.0 * (double)rig->fg / 255.0));
    cb += (int)(rim * (nx < 0.0 ? 62.0 * bk
                                : 96.0 * (double)rig->fb / 255.0));

    cv_set(c, x, y, cr, cg, cb, (int)(a * cov));
}

/* A limb as a lit capsule: wide at one end, narrow at the other, shaded across
 * its own axis. The normal handed to art_shade is the real perpendicular
 * offset from the limb's axis, so the terminator follows a bent arm instead of
 * always falling down the middle of the screen. */
static void art_limb(Cv *c, double x0, double y0, double x1, double y1,
                     double w0, double w1, int r, int g, int b, int a,
                     const Rig *rig)
{
    double vx = x1 - x0, vy = y1 - y0;
    double len2 = vx * vx + vy * vy;
    double inv2 = len2 > 0.0001 ? 1.0 / len2 : 0.0;
    double maxr = (w0 > w1 ? w0 : w1) + 2.0;
    double plen = sqrt(len2);
    double pxn = plen > 0.0001 ? vy / plen : 1.0;
    double pyn = plen > 0.0001 ? -vx / plen : 0.0;
    int    axis;

    if (a <= 0 || maxr <= 0.0)
        return;
    /* the perpendicular is kept pointing up the screen, so the lit side of a
     * horizontal arm is its top no matter which way the arm runs */
    if (pyn > 0.0) {
        pxn = -pxn;
        pyn = -pyn;
    }

    axis = fabs(vx) >= fabs(vy) ? 0 : 1;

    if (axis == 1) {
        int lo = cv_i((y0 < y1 ? y0 : y1) - maxr);
        int hi = cv_i((y0 > y1 ? y0 : y1) + maxr);

        if (lo < 0) lo = 0;
        if (hi > c->h - 1) hi = c->h - 1;
        for (; lo <= hi; lo++) {
            double yc = (double)lo + 0.5;
            double t = vy != 0.0 ? (yc - y0) / vy : 0.0;
            double rad, xc, dxh;
            int    x_lo, x_hi, x;

            if (t < 0.0) t = 0.0;
            if (t > 1.0) t = 1.0;
            rad = w0 + (w1 - w0) * t;
            if (rad < 0.35)
                continue;
            xc  = x0 + vx * t;
            dxh = rad * (1.0 + fabs(vx / (vy != 0.0 ? vy : 1.0))) + 2.0;
            x_lo = cv_i(xc - dxh);
            x_hi = cv_i(xc + dxh);
            if (x_lo < 0) x_lo = 0;
            if (x_hi > c->w - 1) x_hi = c->w - 1;
            for (x = x_lo; x <= x_hi; x++) {
                double px2 = (double)x + 0.5 - x0, py2 = yc - y0;
                double u = (px2 * vx + py2 * vy) * inv2;
                double ax, ay, d, rr, cov, nx;

                if (u < 0.0) u = 0.0;
                if (u > 1.0) u = 1.0;
                ax = px2 - vx * u;
                ay = py2 - vy * u;
                d  = sqrt(ax * ax + ay * ay);
                rr = w0 + (w1 - w0) * u;
                cov = rr + 0.7 - d;
                if (cov <= 0.0)
                    continue;
                if (cov > 1.0)
                    cov = 1.0;
                nx = (ax * pxn + ay * pyn) / rr;
                art_shade(c, x, lo, nx, cov, r, g, b, a, rig);
            }
        }
    } else {
        int lo = cv_i((x0 < x1 ? x0 : x1) - maxr);
        int hi = cv_i((x0 > x1 ? x0 : x1) + maxr);

        if (lo < 0) lo = 0;
        if (hi > c->w - 1) hi = c->w - 1;
        for (; lo <= hi; lo++) {
            double xc = (double)lo + 0.5;
            double t = vx != 0.0 ? (xc - x0) / vx : 0.0;
            double rad, yc, dyh;
            int    y_lo, y_hi, y;

            if (t < 0.0) t = 0.0;
            if (t > 1.0) t = 1.0;
            rad = w0 + (w1 - w0) * t;
            if (rad < 0.35)
                continue;
            yc  = y0 + vy * t;
            dyh = rad * (1.0 + fabs(vy / (vx != 0.0 ? vx : 1.0))) + 2.0;
            y_lo = cv_i(yc - dyh);
            y_hi = cv_i(yc + dyh);
            if (y_lo < 0) y_lo = 0;
            if (y_hi > c->h - 1) y_hi = c->h - 1;
            for (y = y_lo; y <= y_hi; y++) {
                double px2 = xc - x0, py2 = (double)y + 0.5 - y0;
                double u = (px2 * vx + py2 * vy) * inv2;
                double ax, ay, d, rr, cov, nx;

                if (u < 0.0) u = 0.0;
                if (u > 1.0) u = 1.0;
                ax = px2 - vx * u;
                ay = py2 - vy * u;
                d  = sqrt(ax * ax + ay * ay);
                rr = w0 + (w1 - w0) * u;
                cov = rr + 0.7 - d;
                if (cov <= 0.0)
                    continue;
                if (cov > 1.0)
                    cov = 1.0;
                nx = (ax * pxn + ay * pyn) / rr;
                art_shade(c, lo, y, nx, cov, r, g, b, a, rig);
            }
        }
    }
}

/* A column of body between two heights, with its own centre line and width
 * profile. Used for the dancer's torso and the DJ's back, which is why it takes
 * the profile rather than reading it off a Pose. */
static void art_col_shade(Cv *c, double top, double bot, double cxt, double cxb,
                          double wtop, double wmid, double wbot,
                          int r, int g, int b, int a, const Rig *rig)
{
    int y;

    if (bot <= top + 1.0)
        return;
    for (y = cv_i(top); y <= cv_i(bot); y++) {
        double u = ((double)y - top) / (bot - top);
        double hw, cxx;
        int    x;

        if (u < 0.45) {
            double k = u / 0.45;
            hw = wtop + (wmid - wtop) * (k * k * (3.0 - 2.0 * k));
        } else {
            double k = (u - 0.45) / 0.55;
            hw = wmid + (wbot - wmid) * (k * k * (3.0 - 2.0 * k));
        }
        cxx = cxt + (cxb - cxt) * (u * u * (3.0 - 2.0 * u));
        if (hw < 1.0)
            continue;
        for (x = cv_i(cxx - hw - 1.0); x <= cv_i(cxx + hw + 1.0); x++) {
            double cov = hw + 0.6 - fabs((double)x + 0.5 - cxx);

            if (cov <= 0.0)
                continue;
            if (cov > 1.0)
                cov = 1.0;
            art_shade(c, x, y, ((double)x + 0.5 - cxx) / hw, cov,
                      r, g, b, a, rig);
        }
    }
}

/* A sneaker: white upper over a dark sole, pointing away from the hip. */

/* A head with a face on it.
 *
 * The old head was a lit sphere with a hair blob over one side, which reads as
 * a mannequin at any size. This is an egg with a jaw, a brow ridge, sockets,
 * eyes with catchlights, a nose shadow and lips - and because a real performer
 * turns their head while they move, the whole face slides left and right with
 * the turn value instead of being glued to the centre. */

/* The performer, built from lit volumes instead of a silhouette.
 *
 * Order matters and is painter's order, because the painter's is the only one
 * available: the far leg and far arm go down first, then the body over them,
 * then the near limbs, then the head. Cloth, skin and shoe are three different
 * materials now, so the figure reads as a dressed person under stage light and
 * not as a dark shape with a belt. */

/* ---------------------------------------------------- the performers, v2 -- */

/* A wardrobe is a handful of colours, one per performer. Skin, cloth and shoe
 * are separated because a figure reads as dressed only when the three do not
 * shade the same way. */
typedef struct {
    int skin_r, skin_g, skin_b;
    int top_r,  top_g,  top_b;
    int leg_r,  leg_g,  leg_b;
    int shoe_r, shoe_g, shoe_b;
    int hair_r, hair_g, hair_b;
} Kit;

/* A material is a rig with its own gloss. Handing every surface the one global
 * sheen is most of why the first pass looked like a shop mannequin: skin took
 * the same hard highlight as a plastic shoe. */
static Rig art_mat(const Rig *rig, double sheen)
{
    Rig r = *rig;

    r.sheen = rig->sheen * sheen;
    return r;
}

static void lerp2(double x0, double y0, double x1, double y1, double u,
                  double *ox, double *oy)
{
    *ox = x0 + (x1 - x0) * u;
    *oy = y0 + (y1 - y0) * u;
}

/* A hand: a palm and four fingers, built along the forearm so it points where
 * the arm points. At 1080p this is twenty pixels across, and those twenty
 * pixels are most of the difference between a dancer and a mannequin. */
static void art_hand(Cv *c, double wx, double wy, double ex, double ey,
                     double t, double flip, const Rig *rig, const Kit *k)
{
    double dx = wx - ex, dy = wy - ey;
    double len = sqrt(dx * dx + dy * dy);
    double ux, uy, pxn, pyn;
    int    i;

    if (len < 0.001) {
        ux = 0.0;
        uy = 1.0;
    } else {
        ux = dx / len;
        uy = dy / len;
    }
    pxn = -uy * flip;
    pyn =  ux * flip;

    art_limb(c, wx - ux * t * 0.06, wy - uy * t * 0.06,
             wx + ux * t * 0.22, wy + uy * t * 0.22,
             t * 0.19, t * 0.175, k->skin_r, k->skin_g, k->skin_b, 255, rig);

    for (i = 0; i < 4; i++) {
        double off = ((double)i - 1.5) * t * 0.070;
        double ang = ((double)i - 1.5) * 0.085;
        double ca = fcosd(ang), sa = fsind(ang);
        double fx = ux * ca - uy * sa, fy = ux * sa + uy * ca;
        double sx = wx + ux * t * 0.19 + pxn * off;
        double sy = wy + uy * t * 0.19 + pyn * off;
        double fl = t * (0.33 - 0.024 * fabs((double)i - 1.5));

        art_limb(c, sx, sy, sx + fx * fl, sy + fy * fl,
                 t * 0.060, t * 0.042,
                 k->skin_r, k->skin_g, k->skin_b, 255, rig);
    }
    {
        double ang = 1.05 * flip;
        double ca = fcosd(ang), sa = fsind(ang);
        double fx = ux * ca - uy * sa, fy = ux * sa + uy * ca;
        double sx = wx + ux * t * 0.02 + pxn * t * 0.12;
        double sy = wy + uy * t * 0.02 + pyn * t * 0.12;

        art_limb(c, sx, sy, sx + fx * t * 0.23, sy + fy * t * 0.23,
                 t * 0.075, t * 0.055,
                 k->skin_r, k->skin_g, k->skin_b, 255, rig);
    }
}

/* A sneaker from the side: a sole that runs past the upper, a toe cap, an
 * ankle collar and three laces. The old foot was a flat wedge. */
static void art_shoe2(Cv *c, double ax, double ay, double t, double dir,
                      const Rig *rig, const Kit *k)
{
    double toe = ax + dir * t * 1.10;
    int    i;

    art_limb(c, ax - dir * t * 0.26, ay + t * 0.02, toe, ay - t * 0.03,
             t * 0.19, t * 0.15, 24, 24, 34, 255, rig);
    art_limb(c, ax - dir * t * 0.20, ay - t * 0.30, toe - dir * t * 0.10,
             ay - t * 0.19, t * 0.33, t * 0.24,
             k->shoe_r, k->shoe_g, k->shoe_b, 255, rig);
    cv_ell(c, toe - dir * t * 0.26, ay - t * 0.20, t * 0.24, t * 0.15,
           clampi(k->shoe_r - 26, 0, 255), clampi(k->shoe_g - 26, 0, 255),
           clampi(k->shoe_b - 22, 0, 255), 255);
    cv_ell_soft(c, toe - dir * t * 0.30, ay - t * 0.28, t * 0.20, t * 0.09,
                255, 255, 255, 60);
    art_limb(c, ax - dir * t * 0.08, ay - t * 0.62, ax + dir * t * 0.12,
             ay - t * 0.50, t * 0.22, t * 0.25,
             clampi(k->shoe_r - 34, 0, 255), clampi(k->shoe_g - 34, 0, 255),
             clampi(k->shoe_b - 30, 0, 255), 255, rig);
    for (i = 0; i < 3; i++) {
        double u = (double)i;

        cv_line(c, ax + dir * t * (0.02 + u * 0.10), ay - t * (0.40 - u * 0.02),
                ax + dir * t * (0.12 + u * 0.13), ay - t * (0.46 - u * 0.02),
                t * 0.050, 240, 244, 252, 200);
    }
    cv_ell_soft(c, ax - dir * t * 0.14, ay + t * 0.03, t * 0.19, t * 0.06,
                2, 2, 6, 130);
}

/* A head with a face on it: skull, cheekbone, ear, eyes with a lid line and
 * lashes, brow, nose with nostrils, lips, and hair with a part. `back` swaps
 * the face for the back of the head, which is what the DJ shows the room. */
/* A head with a face on it, drawn as a graphic rather than a doll.
 *
 * The skull is an egg with a jaw; the hair is a set of overlapping lit ellipses
 * rather than a polygon, because a polygon's straight edge across the forehead
 * is what read as a wig. The eyes are almond-shaped because a skin-toned lid is
 * stamped back over the top third of each one - a bare white circle is what
 * made the earlier face look startled. `back` draws the back of the head, which
 * is the side the DJ shows the room. */
static void art_head2(Cv *c, double hx, double hy, double hr, double turn,
                      double tail, const Rig *rig, double now, int a,
                      const Kit *k, int back)
{
    double fx = hx + turn * hr * 0.22;
    double ey = hy - hr * 0.02;
    double sep = hr * 0.32;
    double erx = hr * 0.140, ery = hr * 0.078;
    Rig    skin = art_mat(rig, 0.34);
    int    y, i;

    /* a warm key on skin: the cool one turned every arm grey */
    skin.kr = 246;
    skin.kg = 214;
    skin.kb = 190;

    for (y = cv_i(hy - hr * 1.06); y <= cv_i(hy + hr * 1.06); y++) {
        double ny = ((double)y + 0.5 - hy) / (hr * 1.06);
        double hw;
        int    x;

        if (ny <= -1.0 || ny >= 1.0)
            continue;
        hw = hr * sqrt(1.0 - ny * ny);
        if (ny > 0.20) {
            double q = (ny - 0.20) / 0.86;

            hw *= 1.0 - 0.46 * q * q;              /* the jaw comes in */
        }
        if (ny > -0.05 && ny < 0.35)
            hw *= 1.03;                            /* cheekbones */
        for (x = cv_i(fx - hw - 1.0); x <= cv_i(fx + hw + 1.0); x++) {
            double cov = hw + 0.6 - fabs((double)x + 0.5 - fx);

            if (cov <= 0.0)
                continue;
            if (cov > 1.0)
                cov = 1.0;
            art_shade(c, x, y, ((double)x + 0.5 - fx) / hr, cov,
                      k->skin_r, k->skin_g, k->skin_b, a, &skin);
        }
    }

    if (back) {
        cv_ell(c, fx, hy - hr * 0.02, hr * 1.02, hr * 1.02,
               k->hair_r, k->hair_g, k->hair_b, 250);
        cv_ell_soft(c, fx - hr * 0.34, hy - hr * 0.52, hr * 0.52, hr * 0.32,
                    206, 190, 220, 90);
        cv_ell_soft(c, fx + hr * 0.10, hy + hr * 0.42, hr * 0.34, hr * 0.24,
                    8, 6, 14, 90);
        for (i = 0; i < 2; i++)
            cv_ell(c, fx + (i ? hr * 0.96 : -hr * 0.96), hy + hr * 0.10,
                   hr * 0.12, hr * 0.18,
                   clampi(k->skin_r - 30, 0, 255), clampi(k->skin_g - 30, 0, 255),
                   clampi(k->skin_b - 24, 0, 255), 235);
        return;
    }

    /* eye sockets, then the eyes under lid shadows */
    for (i = 0; i < 2; i++) {
        double ex = fx + (i ? sep : -sep);
        double gz = turn * hr * 0.07;

        cv_ell_soft(c, ex, ey - hr * 0.10, erx * 1.5, ery * 1.4,
                    70, 44, 42, (int)(a * 0.28));
        cv_ell(c, ex, ey, erx * 1.02, ery * 1.08, 238, 236, 232, a);
        cv_ell(c, ex + gz, ey + ery * 0.06, erx * 0.62, ery * 0.86,
               104, 72, 54, a);
        cv_ell(c, ex + gz, ey + ery * 0.08, erx * 0.62, ery * 0.86,
               44, 30, 26, (int)(a * 0.45));
        cv_ell(c, ex + gz, ey + ery * 0.08, erx * 0.28, ery * 0.46,
               16, 12, 14, a);
        cv_ell(c, ex + gz - erx * 0.22, ey - ery * 0.16,
               erx * 0.15, ery * 0.22, 255, 255, 255, a);
        /* the lid: the skin comes back down over the top of the eye, which is
         * what turns a circle into an almond */
        cv_ell(c, ex, ey - ery * 1.48, erx * 1.16, ery * 1.16,
               k->skin_r, k->skin_g, k->skin_b, a);
        cv_ell_soft(c, ex, ey - ery * 1.52, erx * 1.10, ery * 0.70,
                    120, 74, 66, (int)(a * 0.26));
        /* lash line along the lid edge, flicked at the outer corner */
        cv_line(c, ex - erx * 0.98, ey - ery * 0.52,
                ex + erx * 0.20, ey - ery * 0.74, hr * 0.028,
                44, 30, 28, (int)(a * 0.58));
        cv_line(c, ex + erx * 0.20, ey - ery * 0.74,
                ex + erx * 1.04, ey - ery * 0.44, hr * 0.024,
                44, 30, 28, (int)(a * 0.50));
        cv_line(c, ex + erx * 1.00, ey - ery * 0.48,
                ex + erx * 1.32, ey - ery * 0.98, hr * 0.018,
                44, 30, 28, (int)(a * 0.42));
        cv_line(c, ex - erx * 0.86, ey + ery * 0.86,
                ex + erx * 0.80, ey + ery * 0.74, hr * 0.020,
                140, 88, 78, (int)(a * 0.32));
        /* brow: a soft shadow above the lid, arched */
        cv_line(c, ex - erx * 1.10, ey - hr * 0.30 - turn * hr * 0.03,
                ex - erx * 0.05, ey - hr * 0.36 - turn * hr * 0.04,
                hr * 0.045, 116, 74, 64, (int)(a * 0.24));
        cv_line(c, ex - erx * 0.05, ey - hr * 0.36 - turn * hr * 0.04,
                ex + erx * 1.10, ey - hr * 0.31 - turn * hr * 0.05,
                hr * 0.042, 116, 74, 64, (int)(a * 0.20));
    }

    /* the nose is a shadow and a light, not a structure */
    cv_line(c, fx + turn * hr * 0.09, ey + hr * 0.02,
            fx + turn * hr * 0.14, hy + hr * 0.20, hr * 0.070,
            244, 208, 182, (int)(a * 0.26));
    cv_ell_soft(c, fx + turn * hr * 0.12, hy + hr * 0.26, hr * 0.12, hr * 0.070,
                132, 80, 66, (int)(a * 0.38));
    cv_ell_soft(c, fx + turn * hr * 0.13, hy + hr * 0.22, hr * 0.07, hr * 0.04,
                255, 226, 202, (int)(a * 0.35));

    /* mouth: a shadow line, a lit lower lip, a highlight */
    cv_ell(c, fx + turn * hr * 0.09, hy + hr * 0.535, hr * 0.175, hr * 0.058,
           150, 84, 86, (int)(a * 0.78));
    cv_ell(c, fx + turn * hr * 0.09, hy + hr * 0.578, hr * 0.142, hr * 0.040,
           210, 138, 126, (int)(a * 0.80));
    {
        double mx = fx + turn * hr * 0.09;

        cv_line(c, mx - hr * 0.16, hy + hr * 0.552, mx - hr * 0.06,
                hy + hr * 0.532, hr * 0.020, 96, 48, 52, (int)(a * 0.70));
        cv_line(c, mx - hr * 0.06, hy + hr * 0.532, mx + hr * 0.07,
                hy + hr * 0.532, hr * 0.020, 96, 48, 52, (int)(a * 0.70));
        cv_line(c, mx + hr * 0.07, hy + hr * 0.532, mx + hr * 0.17,
                hy + hr * 0.554, hr * 0.020, 96, 48, 52, (int)(a * 0.70));
    }
    cv_ell_soft(c, fx + turn * hr * 0.07, hy + hr * 0.566, hr * 0.075, hr * 0.020,
                255, 228, 212, (int)(a * 0.35));

    cv_ell_soft(c, fx - hr * 0.42, hy + hr * 0.12, hr * 0.28, hr * 0.22,
                255, 224, 200, (int)(a * 0.15));
    cv_ell_soft(c, fx, hy + hr * 0.14, hr * 0.26, hr * 0.15,
                238, 154, 124, (int)(a * 0.12));
    cv_ell_soft(c, fx, hy + hr * 0.92, hr * 0.28, hr * 0.13,
                64, 34, 36, (int)(a * 0.32));
    cv_ell_soft(c, fx, hy + hr * 0.74, hr * 0.13, hr * 0.06,
                255, 226, 202, (int)(a * 0.20));

    /* the hair: a shell over the skull with a real hairline, walked row by row
     * from the skull's own silhouette so its edge is a curve all the way
     * round. It stops above the brows, and the sides frame the face. */
    {
        Rig hair = art_mat(rig, 0.60);

        hair.kr = 214;
        hair.kg = 202;
        hair.kb = 206;
        for (y = cv_i(hy - hr * 1.24); y <= cv_i(hy + hr * 0.58); y++) {
            double ny = ((double)y + 0.5 - (hy - hr * 0.06)) / (hr * 1.18);
            double hw, inner;
            int    x;

            if (ny <= -1.0 || ny >= 1.0)
                continue;
            hw = hr * 1.10 * sqrt(1.0 - ny * ny);
            if (y < hy - hr * 0.30)
                inner = 0.0;                       /* the crown is solid */
            else if (y < hy + hr * 0.12)
                inner = hr * (0.58 + 0.34 * ((double)y - (hy - hr * 0.30))
                              / (hr * 0.42));      /* the temples */
            else
                inner = hr * 0.90;                 /* the locks beside the jaw */
            for (x = cv_i(fx - hw - 1.0); x <= cv_i(fx + hw + 1.0); x++) {
                double dx = fabs((double)x + 0.5 - fx);
                double cov;

                if (dx > hw + 0.6)
                    continue;
                cov = hw + 0.6 - dx;
                if (cov > 1.0)
                    cov = 1.0;
                if (dx < inner - 0.6)
                    continue;
                if (dx < inner + 0.6 && dx - inner + 0.6 < cov)
                    cov = dx - inner + 0.6;
                if (cov <= 0.0)
                    continue;
                art_shade(c, x, y, ((double)x + 0.5 - fx) / (hr * 1.05), cov,
                          k->hair_r, k->hair_g, k->hair_b, a, &hair);
            }
        }
    }
    /* the shadow the fringe throws on the forehead, and the light on the crown */
    cv_ell_soft(c, fx, hy - hr * 0.34, hr * 0.72, hr * 0.085,
                40, 24, 24, (int)(a * 0.30));
    cv_ell_soft(c, fx - hr * 0.38, hy - hr * 0.96, hr * 0.48, hr * 0.16,
                clampi(k->hair_r + 80, 0, 255), clampi(k->hair_g + 60, 0, 255),
                clampi(k->hair_b + 66, 0, 255), (int)(a * 0.42));
    for (i = 0; i < 6; i++) {
        double u = -0.80 + 1.60 * (double)i / 5.0;
        double sw = fsind(now * 1.6 + (double)i * 0.9) * hr * 0.035;

        cv_taper(c, fx + u * hr * 0.80, hy - hr * 1.06,
                 fx + u * hr * 1.00 + sw, hy - hr * 0.52,
                 hr * 0.080, hr * 0.020,
                 clampi(k->hair_r + 58, 0, 255), clampi(k->hair_g + 44, 0, 255),
                 clampi(k->hair_b + 50, 0, 255), (int)(a * 0.30));
    }
    /* the ear on the turned-away side, under the hair */
    cv_ell(c, fx - hr * (0.94 + 0.02 * turn), hy + hr * 0.10,
           hr * 0.11, hr * 0.17,
           clampi(k->skin_r - 34, 0, 255), clampi(k->skin_g - 34, 0, 255),
           clampi(k->skin_b - 28, 0, 255), (int)(a * 0.85));
    cv_ell_soft(c, fx - hr * (0.94 + 0.02 * turn), hy + hr * 0.10,
                hr * 0.05, hr * 0.075, 62, 34, 34, (int)(a * 0.35));

    /* the ponytail: four segments, each lagging the one before it */
    if (tail > 0.01) {
        double px2 = fx + hr * 0.86, py2 = hy - hr * 0.70;
        double base = 0.92 + fsind(now * 3.0) * 0.30 * tail;
        int    seg;

        cv_ell(c, px2, py2, hr * 0.13, hr * 0.11, 224, 88, 158,
               (int)(a * 0.90));
        for (seg = 0; seg < 4; seg++) {
            double len = hr * (0.60 - 0.09 * (double)seg);
            double ang = base + fsind(now * 3.1 - 0.55 * (double)seg) * 0.32 * tail;
            double nx2 = px2 + fcosd(ang) * len;
            double ny2 = py2 + fsind(ang) * len + len * 0.30;
            double wgt = hr * (0.22 - 0.035 * (double)seg);

            cv_taper(c, px2, py2, nx2, ny2, wgt, wgt * 0.82,
                     k->hair_r, k->hair_g, k->hair_b, (int)(a * 0.97));
            cv_line(c, px2 - wgt * 0.28, py2, nx2 - wgt * 0.28, ny2,
                    hr * 0.050, clampi(k->hair_r + 74, 0, 255),
                    clampi(k->hair_g + 58, 0, 255), clampi(k->hair_b + 66, 0, 255),
                    (int)(a * 0.46));
            px2 = nx2;
            py2 = ny2;
        }
    }
}

/* The performer, second pass.
 *
 * Same skeleton, but the body is built from overlapping volumes rather than one
 * capsule per bone: a quadriceps riding on the thigh, a calf on the shin, a
 * bicep on the arm, a knee and an elbow ball at each joint, hands with fingers,
 * sneakers with soles. Cloth is matte, skin is soft, shoes are glossy, and the
 * torso is three stacked columns - hips, waist, chest - because a dancer bends
 * and a single column cannot. */
static void art_dancer2(Cv *c, const Pose *p, const Rig *rig, double lv,
                        int ghost, double turn, double tail, double now,
                        const Kit *k)
{
    double t = p->th;
    double shy = p->cy - t * 0.95;
    double hipx, ax0, ay0, ax1, ay1;
    int    near = p->ay[0] >= p->ay[1] ? 0 : 1;
    int    far = 1 - near;
    Rig    skin = art_mat(rig, 0.36);
    Rig    cloth = art_mat(rig, 0.26);
    int    i;

    skin.kr = 246;
    skin.kg = 214;
    skin.kb = 190;

    if (ghost) {
        int gr = ghost == 2 ? 14 : 26, gg = ghost == 2 ? 16 : 28;
        int gb = ghost == 2 ? 30 : 48;
        int ga = ghost == 2 ? 80 : 46;

        for (i = 0; i < 2; i++) {
            cv_taper(c, p->px + (i ? 1.0 : -1.0) * p->hw * 0.52, p->py,
                     p->kx[i], p->ky[i], t * 0.86, t * 0.58, gr, gg, gb, ga);
            cv_taper(c, p->kx[i], p->ky[i], p->ax[i], p->ay[i],
                     t * 0.58, t * 0.28, gr, gg, gb, ga);
            cv_taper(c, p->cx + (i ? 1.0 : -1.0) * p->sw * 0.86, shy,
                     p->ex[i], p->ey[i], t * 0.44, t * 0.30, gr, gg, gb, ga);
            cv_taper(c, p->ex[i], p->ey[i], p->wx[i], p->wy[i],
                     t * 0.32, t * 0.22, gr, gg, gb, ga);
        }
        cv_taper(c, p->px - p->hw * 0.95, p->py, p->cx + p->sw * 0.92, shy,
                 p->sw * 0.94, p->sw * 0.86, gr, gg, gb, ga);
        cv_ell(c, p->hx, p->hy, p->hr, p->hr * 1.04, gr, gg, gb, ga);
        return;
    }

    /* a contact shadow under each foot: without it a dancer floats, and no
     * amount of detail on the body fixes a missing shadow */
    for (i = 0; i < 2; i++)
        cv_ell_soft(c, p->ax[i], p->ay[i] + t * 0.07, t * 0.66, t * 0.13,
                    3, 3, 9, 150);
    cv_ell_soft(c, p->cx, p->ay[near] + t * 0.05, t * 1.05, t * 0.10,
                3, 3, 9, 60);

    /* ---- the far side, laid down first so the body covers it ---- */
    i = far;
    hipx = p->px + (i ? 1.0 : -1.0) * p->hw * 0.50;
    art_limb(c, hipx, p->py - t * 0.14, p->kx[i], p->ky[i],
             t * 0.88, t * 0.58, k->leg_r, k->leg_g, k->leg_b, 255, &cloth);
    lerp2(hipx, p->py - t * 0.14, p->kx[i], p->ky[i], 0.20, &ax0, &ay0);
    lerp2(hipx, p->py - t * 0.14, p->kx[i], p->ky[i], 0.74, &ax1, &ay1);
    art_limb(c, ax0, ay0, ax1, ay1, t * 0.74, t * 0.58,
             clampi(k->leg_r + 12, 0, 255), clampi(k->leg_g + 10, 0, 255),
             clampi(k->leg_b + 16, 0, 255), 255, &cloth);
    cv_ball(c, p->kx[i], p->ky[i], t * 0.42, k->leg_r, k->leg_g, k->leg_b,
            clampi(k->leg_r + 16, 0, 255), clampi(k->leg_g + 14, 0, 255),
            clampi(k->leg_b + 20, 0, 255));
    art_limb(c, p->kx[i], p->ky[i], p->ax[i], p->ay[i],
             t * 0.60, t * 0.26, k->leg_r, k->leg_g, k->leg_b, 255, &cloth);
    lerp2(p->kx[i], p->ky[i], p->ax[i], p->ay[i], 0.08, &ax0, &ay0);
    lerp2(p->kx[i], p->ky[i], p->ax[i], p->ay[i], 0.44, &ax1, &ay1);
    art_limb(c, ax0, ay0, ax1, ay1, t * 0.52, t * 0.34,
             clampi(k->leg_r + 14, 0, 255), clampi(k->leg_g + 12, 0, 255),
             clampi(k->leg_b + 18, 0, 255), 255, &cloth);
    art_shoe2(c, p->ax[i], p->ay[i], t, i ? 1.0 : -1.0, rig, k);

    art_limb(c, p->cx + (i ? 1.0 : -1.0) * p->sw * 0.88, shy + t * 0.02,
             p->ex[i], p->ey[i], t * 0.52, t * 0.37,
             k->skin_r, k->skin_g, k->skin_b, 255, &skin);
    lerp2(p->cx + (i ? 1.0 : -1.0) * p->sw * 0.88, shy + t * 0.02,
          p->ex[i], p->ey[i], 0.30, &ax0, &ay0);
    lerp2(p->cx + (i ? 1.0 : -1.0) * p->sw * 0.88, shy + t * 0.02,
          p->ex[i], p->ey[i], 0.72, &ax1, &ay1);
    art_limb(c, ax0, ay0, ax1, ay1, t * 0.40, t * 0.32,
             clampi(k->skin_r + 10, 0, 255), clampi(k->skin_g + 8, 0, 255),
             clampi(k->skin_b + 8, 0, 255), 255, &skin);
    cv_ball(c, p->ex[i], p->ey[i], t * 0.27, k->skin_r, k->skin_g, k->skin_b,
            clampi(k->skin_r + 10, 0, 255), clampi(k->skin_g + 12, 0, 255),
            clampi(k->skin_b + 14, 0, 255));
    art_limb(c, p->ex[i], p->ey[i], p->wx[i], p->wy[i],
             t * 0.38, t * 0.24, k->skin_r, k->skin_g, k->skin_b, 255, &skin);
    art_hand(c, p->wx[i], p->wy[i], p->ex[i], p->ey[i], t,
             i ? 1.0 : -1.0, &skin, k);
    /* a band of light at the wrist: it reads at any distance and it is what
     * makes the arms look like they belong to somebody under lights */
    {
        double bx_, by_;

        lerp2(p->ex[i], p->ey[i], p->wx[i], p->wy[i], 0.88, &bx_, &by_);
        cv_ball(c, bx_, by_, t * 0.150, 250, 252, 255, 255, 255, 255);
        cv_soft(c, bx_, by_, t * 0.42, 210, 240, 255, 60);
    }

    /* ---- hips, waist and chest: three columns, not one ---- */
    art_col_shade(c, p->py - t * 0.48, p->py + t * 0.66,
                  p->px, p->px, p->hw * 0.92, p->hw * 1.02, p->hw * 1.10,
                  k->leg_r, k->leg_g, k->leg_b, 255, &cloth);
    /* the trapezius goes down before the clothes, so the top covers it */
    for (i = 0; i < 2; i++) {
        cv_taper(c, p->nx, p->ny - t * 0.04,
                 p->cx + (i ? 1.0 : -1.0) * p->sw * 0.58, shy + t * 0.02,
                 t * 0.28, t * 0.20, k->skin_r, k->skin_g, k->skin_b, 255);
    }
    art_col_shade(c, p->cy + t * 1.22, p->py - t * 0.42,
                  p->cx, p->px, p->sw * 0.76, p->hw * 0.90, p->hw * 1.00,
                  k->skin_r, k->skin_g, k->skin_b, 255, &skin);
    art_col_shade(c, shy - t * 0.16, p->cy + t * 1.28,
                  p->cx, p->cx, p->sw * 1.02, p->sw * 1.06, p->sw * 0.88,
                  k->top_r, k->top_g, k->top_b, 255, &cloth);
    /* the top's hem and the leggings' waistband: the two lines that make them
     * clothes instead of paint */
    cv_line(c, p->cx - p->sw * 0.86, p->cy + t * 1.28,
            p->cx + p->sw * 0.86, p->cy + t * 1.28, t * 0.13,
            24, 22, 40, 235);
    cv_line(c, p->px - p->hw * 0.94, p->py - t * 0.44,
            p->px + p->hw * 0.94, p->py - t * 0.44, t * 0.20,
            24, 22, 40, 235);
    /* neckline: a scoop of skin at the collarbone */
    cv_ell(c, p->cx, shy - t * 0.14, p->sw * 0.26, t * 0.32,
           k->skin_r, k->skin_g, k->skin_b, 255);
    cv_ell_soft(c, p->cx, shy + t * 0.14, p->sw * 0.24, t * 0.10,
                60, 34, 40, 90);

    /* straps over the shoulders: they end where the shoulder cap begins */

    /* collarbones, and the soft shadow under the chest line */
    for (i = 0; i < 2; i++) {
        cv_line(c, p->cx + (i ? 1.0 : -1.0) * t * 0.14, shy + t * 0.10,
                p->cx + (i ? 1.0 : -1.0) * p->sw * 0.52, shy + t * 0.24,
                t * 0.075, 250, 214, 194, 120);
    }
    cv_ell_soft(c, p->cx, p->cy + t * 0.76, p->sw * 0.70, t * 0.22,
                26, 22, 44, 80);
    /* a navel, because a bare midriff without one is a wardrobe dummy */
    cv_ell(c, p->px, p->py - t * 0.90, t * 0.055, t * 0.075, 96, 56, 52, 150);

    /* ---- the near side, in front of the body ---- */
    i = near;
    hipx = p->px + (i ? 1.0 : -1.0) * p->hw * 0.50;
    art_limb(c, hipx, p->py - t * 0.14, p->kx[i], p->ky[i],
             t * 0.90, t * 0.60, k->leg_r, k->leg_g, k->leg_b, 255, &cloth);
    lerp2(hipx, p->py - t * 0.14, p->kx[i], p->ky[i], 0.20, &ax0, &ay0);
    lerp2(hipx, p->py - t * 0.14, p->kx[i], p->ky[i], 0.74, &ax1, &ay1);
    art_limb(c, ax0, ay0, ax1, ay1, t * 0.76, t * 0.60,
             clampi(k->leg_r + 16, 0, 255), clampi(k->leg_g + 14, 0, 255),
             clampi(k->leg_b + 20, 0, 255), 255, &cloth);
    cv_ball(c, p->kx[i], p->ky[i], t * 0.36, k->leg_r, k->leg_g, k->leg_b,
            clampi(k->leg_r + 18, 0, 255), clampi(k->leg_g + 16, 0, 255),
            clampi(k->leg_b + 22, 0, 255));
    art_limb(c, p->kx[i], p->ky[i], p->ax[i], p->ay[i],
             t * 0.62, t * 0.27, k->leg_r, k->leg_g, k->leg_b, 255, &cloth);
    lerp2(p->kx[i], p->ky[i], p->ax[i], p->ay[i], 0.08, &ax0, &ay0);
    lerp2(p->kx[i], p->ky[i], p->ax[i], p->ay[i], 0.44, &ax1, &ay1);
    art_limb(c, ax0, ay0, ax1, ay1, t * 0.54, t * 0.36,
             clampi(k->leg_r + 18, 0, 255), clampi(k->leg_g + 16, 0, 255),
             clampi(k->leg_b + 22, 0, 255), 255, &cloth);
    /* the outseam and its highlight, the cheapest way to make a leg read */
    cv_line(c, hipx + (hipx > p->px ? t * 0.80 : -t * 0.80), p->py + t * 0.10,
            p->kx[i] + (p->kx[i] > p->px ? t * 0.50 : -t * 0.50),
            p->ky[i] - t * 0.10, t * 0.07, 168, 92, 150, 60);
    art_shoe2(c, p->ax[i], p->ay[i], t, i ? 1.0 : -1.0, rig, k);

    /* ---- neck, trapezius, head ---- */
    /* a rim from the light behind her, down the near edge: the cheapest way
     * to lift a body off the wall behind it */
    cv_taper(c, p->cx + (i ? 1.0 : -1.0) * p->sw * 1.06, shy + t * 0.12,
             p->px + (i ? 1.0 : -1.0) * p->hw * 1.10, p->py - t * 0.30,
             t * 0.09, t * 0.12, 255, 220, 236, 46);
    art_limb(c, p->nx, shy + t * 0.10, p->hx, p->hy + p->hr * 0.62,
             t * 0.30, t * 0.34, k->skin_r, k->skin_g, k->skin_b, 255, &skin);
    cv_ell_soft(c, p->hx, p->hy + p->hr * 1.02, p->hr * 0.62, p->hr * 0.26,
                40, 22, 30, 120);
    art_head2(c, p->hx, p->hy, p->hr, turn, tail, rig, now, 255, k, 0);

    i = near;
    art_limb(c, p->cx + (i ? 1.0 : -1.0) * p->sw * 0.88, shy + t * 0.02,
             p->ex[i], p->ey[i], t * 0.54, t * 0.38,
             k->skin_r, k->skin_g, k->skin_b, 255, &skin);
    lerp2(p->cx + (i ? 1.0 : -1.0) * p->sw * 0.88, shy + t * 0.02,
          p->ex[i], p->ey[i], 0.02, &ax0, &ay0);
    lerp2(p->cx + (i ? 1.0 : -1.0) * p->sw * 0.88, shy + t * 0.02,
          p->ex[i], p->ey[i], 0.34, &ax1, &ay1);
    art_limb(c, ax0, ay0, ax1, ay1, t * 0.50, t * 0.38,
             k->skin_r, k->skin_g, k->skin_b, 255, &skin);
    cv_ball(c, p->cx + (i ? 1.0 : -1.0) * p->sw * 0.86, shy + t * 0.04,
            t * 0.42, k->skin_r, k->skin_g, k->skin_b,
            clampi(k->skin_r + 26, 0, 255), clampi(k->skin_g + 34, 0, 255),
            clampi(k->skin_b + 42, 0, 255));
    art_limb(c, p->cx + (i ? 1.0 : -1.0) * p->sw * 0.66, shy + t * 0.04,
             p->cx + (i ? 1.0 : -1.0) * p->sw * 1.00, shy + t * 0.24,
             t * 0.30, t * 0.24, k->top_r, k->top_g, k->top_b, 255, &cloth);
    cv_line(c, p->cx + (i ? 1.0 : -1.0) * p->sw * 0.84, shy + t * 0.02,
            p->cx + (i ? 1.0 : -1.0) * p->sw * 1.02, shy + t * 0.22,
            t * 0.070, clampi(k->top_r - 74, 0, 255),
            clampi(k->top_g - 66, 0, 255), clampi(k->top_b - 58, 0, 255), 195);
    lerp2(p->cx + (i ? 1.0 : -1.0) * p->sw * 0.88, shy + t * 0.02,
          p->ex[i], p->ey[i], 0.30, &ax0, &ay0);
    lerp2(p->cx + (i ? 1.0 : -1.0) * p->sw * 0.88, shy + t * 0.02,
          p->ex[i], p->ey[i], 0.72, &ax1, &ay1);
    art_limb(c, ax0, ay0, ax1, ay1, t * 0.42, t * 0.34,
             clampi(k->skin_r + 12, 0, 255), clampi(k->skin_g + 10, 0, 255),
             clampi(k->skin_b + 10, 0, 255), 255, &skin);
    cv_ball(c, p->ex[i], p->ey[i], t * 0.28, k->skin_r, k->skin_g, k->skin_b,
            clampi(k->skin_r + 12, 0, 255), clampi(k->skin_g + 14, 0, 255),
            clampi(k->skin_b + 16, 0, 255));
    art_limb(c, p->ex[i], p->ey[i], p->wx[i], p->wy[i],
             t * 0.39, t * 0.25, k->skin_r, k->skin_g, k->skin_b, 255, &skin);
    /* a wristband, which is what tells the eye this is a limb and not a tube */
    lerp2(p->ex[i], p->ey[i], p->wx[i], p->wy[i], 0.74, &ax0, &ay0);
    lerp2(p->ex[i], p->ey[i], p->wx[i], p->wy[i], 0.86, &ax1, &ay1);
    art_limb(c, ax0, ay0, ax1, ay1, t * 0.27, t * 0.25, 236, 92, 150, 255, rig);
    art_hand(c, p->wx[i], p->wy[i], p->ex[i], p->ey[i], t,
             i ? 1.0 : -1.0, &skin, k);
    /* a band of light at the wrist: it reads at any distance and it is what
     * makes the arms look like they belong to somebody under lights */
    {
        double bx_, by_;

        lerp2(p->ex[i], p->ey[i], p->wx[i], p->wy[i], 0.88, &bx_, &by_);
        cv_ball(c, bx_, by_, t * 0.150, 250, 252, 255, 255, 255, 255);
        cv_soft(c, bx_, by_, t * 0.42, 210, 240, 255, 60);
    }

    /* sweat: one soft highlight along the near shoulder and the near thigh */
    cv_ell_soft(c, p->cx + p->sw * 0.34, shy + t * 0.12, t * 0.86, t * 0.26,
                255, 246, 250, (int)(28 + 32 * lv));
    cv_ell_soft(c, p->kx[near] - t * 0.10, p->ky[near] - t * 0.90,
                t * 0.34, t * 0.62, 255, 244, 250, (int)(14 + 18 * lv));
}

/* A reflection in a polished floor: the same skeleton, turned over, squashed
 * by the angle the boards are seen at. */
static void pose_mirror(Pose *d, const Pose *s, double ground, double squash)
{
    int i;

    *d = *s;
    d->py = ground + (ground - s->py) * squash;
    d->cy = ground + (ground - s->cy) * squash;
    d->ny = ground + (ground - s->ny) * squash;
    d->hy = ground + (ground - s->hy) * squash;
    for (i = 0; i < 2; i++) {
        d->ey[i] = ground + (ground - s->ey[i]) * squash;
        d->wy[i] = ground + (ground - s->wy[i]) * squash;
        d->ky[i] = ground + (ground - s->ky[i]) * squash;
        d->ay[i] = ground + (ground - s->ay[i]) * squash;
    }
}

/* What the performer stands in: a broad cast shadow thrown to the right by the
 * key, two tight contact pools, and the wall's colour bleeding across the
 * boards. Without this a figure floats, however well it is shaded. */
static void art_figure_shadow(Cv *c, const Pose *p, double ground, double lv)
{
    double t = p->th;

    cv_ell_soft(c, p->px + t * 2.4, ground - t * 0.34, t * 6.8, t * 1.15,
                2, 2, 6, 165);
    cv_ell_soft(c, p->px + t * 1.1, ground - t * 0.20, t * 3.6, t * 0.70,
                2, 2, 6, 110);
    cv_ell_soft(c, p->ax[0] + t * 0.6, ground - t * 0.12, t * 1.8, t * 0.48,
                2, 2, 6, 150);
    cv_ell_soft(c, p->ax[1] + t * 0.6, ground - t * 0.12, t * 1.8, t * 0.48,
                2, 2, 6, 150);
    cv_ell_soft(c, p->px, ground - t * 0.10, t * 5.4, t * 0.90,
                46, 66, 128, (int)(16 + 24 * lv));
}

/* ---------------------------------------------------------------- the stage - */

/* A beam from the rig down to the floor: three nested cones, bright at the core,
 * with the colour taken from the band that is driving it. The fourth, widest
 * cone only appears when the music is really up, because that is when a real
 * lamp's haze reads all the way out. */
static void dance_beam(Cv *c, double sx, double ey, double tx, double spread,
                       double lit, int cool)
{
    int    k, n = lit > 0.42 ? 4 : 3;
    int    r, g, b;

    art_col(0.16 + 0.84 * lit, &r, &g, &b);
    if (cool) {
        r = (r + 110) / 2;
        g = (g + 190) / 2;
        b = (b + 230) / 2;
    }
    for (k = n - 1; k >= 0; k--) {
        double sp = spread * (0.34 + 0.28 * (double)k);
        int    al = (int)(7.0 + 12.0 * lit) + (n - 1 - k) * 3;

        cv_poly(c, (double[]){ sx - 4.0, sx + 4.0, tx + sp, tx - sp },
                   (double[]){ 0.0, 0.0, ey, ey }, 4, r, g, b, al);
    }
    cv_soft(c, tx, ey, spread * 1.7, r, g, b, (int)(14 + 26 * lit));
    cv_ell_soft(c, tx, ey - 2.0, spread * 1.5, spread * 0.34, 255, 250, 240,
                (int)(10 + 22 * lit));
}

/* The room the performer stands in.
 *
 * A curved LED wall that answers the music band by band, a truss of lamps whose
 * beams rake the floor, a polished stage with the beams pooled on it, and dark
 * masking legs in the foreground that frame the shot. The legs are the cheapest
 * thing here and they do the most: they put something in front of the stage, so
 * the stage reads as being behind it. */
static void dance_stage(Cv *c, const UiModel *m, int cool)
{
    double t = m->elapsed_sec;
    double w = (double)c->w, h = (double)c->h;
    double lv = (double)m->vis_level;
    double top = h * 0.042, bot = h * 0.548;
    int    i, x;

    bg_grad(c, 0, c->h, 10, 11, 21, 4, 4, 10);

    /* ---- the wall ---- */
    for (x = 0; x < c->w; x++) {
        double u = (double)x / (w > 1.0 ? w - 1.0 : 1.0);
        double e = fabs(u - 0.5) * 2.0;
        double bow = e * e * h * 0.050;          /* the wall bends away */
        double lit = band_at(m, u);
        double fade = 1.0 - 0.50 * e * e;
        int    y0 = cv_i(top + bow), y1 = cv_i(bot + bow * 0.40);
        int    y;

        for (y = y0; y < y1; y++) {
            double d = (double)(y - y0) / (double)(y1 - y0 + 1);
            double g1 = 1.0 - 0.56 * d;
            int    scan = ((y & 3) == 0) ? 9 : 0;

            cv_put(c, x, y,
                   (int)((9 + 92 * lit * lit) * fade * g1) + scan,
                   (int)((15 + 136 * lit) * fade * g1) + scan,
                   (int)((35 + 174 * lit) * fade * g1) + scan);
        }
    }
    /* the panel grid: 18 columns, 8 rows */
    for (i = 0; i <= 18; i++) {
        x = (int)((double)i * w / 18.0);

        cv_line(c, (double)x, top, (double)x, bot + h * 0.028, 1.6, 3, 4, 9, 210);
    }
    for (i = 1; i < 8; i++) {
        double yy = top + (bot - top) * (double)i / 8.0;

        cv_line(c, 0.0, yy, w, yy, 1.6, 3, 4, 9, 195);
    }
    /* the hot core of each panel that is shouting, plus the wash off the wall */
    for (i = 0; i < 18; i++) {
        double lit = band_at(m, ((double)i + 0.5) / 18.0);

        if (lit > 0.28)
            cv_soft(c, ((double)i + 0.5) * w / 18.0, top + (bot - top) * 0.20,
                    h * 0.048, 194, 228, 255, (int)(20 + 68 * lit));
    }
    cv_soft(c, w * 0.5, h * 0.14, w * 0.56, 40, 74, 156, (int)(12 + 24 * lv));

    /* ---- upstage truss and its lamps ---- */
    bg_rect(c, 0, cv_i(h * 0.034), c->w, (int)(h * 0.012), 13, 14, 22);
    cv_line(c, 0.0, h * 0.0435, w, h * 0.0435, 1.6, 70, 74, 96, 190);
    for (i = 0; i < 9; i++) {
        double sx = w * (0.055 + 0.111 * (double)i);
        double swing = fsind(t * 0.52 + (double)i * 1.13) * w * 0.055;
        double tx = sx + swing;
        double ey = h * (0.665 + 0.085 * fabs(fsind(t * 0.83 + (double)i * 0.71)));
        double lit = band_at(m, (double)i / 8.0);
        double flick = 0.86 + 0.14 * fsind(t * 9.0 + (double)i);

        dance_beam(c, sx, ey, tx, w * (0.050 + 0.016 * (double)(i % 3)),
                   lit * flick, cool);
        /* the can: a body, a lens and a flare at the mouth */
        bg_rect(c, cv_i(sx - 9.0), cv_i(h * 0.030), 18, (int)(h * 0.016), 16, 17, 24);
        cv_ell(c, sx, h * 0.045, 7.5, 4.5, 26, 28, 38, 230);
        cv_soft(c, sx, h * 0.047, 16.0, 200, 235, 255,
                (int)(40 + 90 * lit * flick));
    }

    /* ---- the floor ---- */
    bg_grad(c, cv_i(top + h * 0.50), c->h, 20, 24, 40, 5, 5, 12);
    /* boards running to a vanishing point below the frame, and the joins
     * closing up as they recede */
    for (i = -7; i <= 7; i++) {
        cv_line(c, w * 0.5 + (double)i * w * 0.052, h * 0.560,
                w * 0.5 + (double)i * w * 0.34, h * 1.0, 1.1, 62, 96, 160, 40);
    }
    for (i = 1; i <= 7; i++) {
        double u = (double)i / 7.0;
        double yy = h * 0.560 + h * 0.44 * u * u;

        cv_line(c, 0.0, yy, w, yy, 1.0, 56, 88, 150, (int)(14 + 22 * u));
    }
    /* the beams pool on the boards, stretched by the shallow angle */
    for (i = 0; i < 9; i++) {
        double sx = w * (0.055 + 0.111 * (double)i);
        double swing = fsind(t * 0.52 + (double)i * 1.13) * w * 0.055;
        double ey = h * (0.665 + 0.085 * fabs(fsind(t * 0.83 + (double)i * 0.71)));
        double lit = band_at(m, (double)i / 8.0);
        int    r, g, b;

        art_col(0.16 + 0.84 * lit, &r, &g, &b);
        cv_ell_soft(c, sx + swing, ey, w * 0.085, h * 0.016, r, g, b,
                    (int)(12 + 26 * lit));
    }
    /* one wet smear of each beam running toward the camera, the way a polished
     * stage carries a light source */
    for (i = 0; i < 9; i += 2) {
        double sx = w * (0.055 + 0.111 * (double)i);
        double swing = fsind(t * 0.52 + (double)i * 1.13) * w * 0.055;
        double lit = band_at(m, (double)i / 8.0);
        int    r, g, b;

        art_col(0.16 + 0.84 * lit, &r, &g, &b);
        cv_ell_soft(c, sx + swing * 1.4, h * 0.945, w * 0.028, h * 0.075,
                    r, g, b, (int)(10 + 22 * lit));
    }
    /* the downstage edge, lit from below: the line that says "stage" */
    cv_line(c, 0.0, h * 0.884, w, h * 0.884, 3.0, 150, 196, 246,
            (int)(70 + 70 * lv));
    cv_ell_soft(c, w * 0.5, h * 0.884, w * 0.62, h * 0.030,
                90, 140, 210, 40);

    /* ---- haze in the air, thickest where the beams enter ---- */
    for (i = 0; i < 7; i++)
        cv_soft(c, w * (0.10 + 0.135 * (double)i),
                h * (0.30 + 0.055 * (double)(i % 4)), w * 0.13,
                96, 128, 210, 20);

    /* ---- masking legs in the foreground ---- */
    {
        double mw = w * 0.052;

        for (x = 0; x < (int)mw; x++) {
            double edge = 1.0 - (double)x / mw;
            int    shade = (int)(3 + 13 * edge * edge);

            bg_rect(c, x, 0, 1, c->h, shade, shade, shade + 7);
        }
        for (x = c->w - (int)mw; x < c->w; x++) {
            double edge = (double)(x - (c->w - mw)) / mw;
            int    shade = (int)(3 + 13 * edge * edge);

            bg_rect(c, x, 0, 1, c->h, shade, shade, shade + 7);
        }
        cv_line(c, mw, 0.0, mw, h, 1.8, 70, 92, 150, 110);
        cv_line(c, w - mw, 0.0, w - mw, h, 1.8, 70, 92, 150, 110);
    }
}

/* --------------------------------------------------------------- the poses - */

/* The skeleton for a moment in a routine. Held separate from the drawing so the
 * motion trails can be the same figure, evaluated a few frames earlier. */
static void dance_build(Pose *p, double t, double lv, double w, double h,
                        int style, double cx, double H, double ground,
                        double bp, double *turn, double *tail)
{
    *turn = 0.0;
    *tail = style == VIS_STYLE_DANCE ? 1.0 : (style == VIS_STYLE_DANCE3 ? 0.6 : 0.0);

    pose_default(p, cx, ground, H);

    if (style == VIS_STYLE_DANCE) {              /* hip-hop bounce */
        double beat = t * 2.5;
        /* the bounce lands on the room's beat and settles after it, instead of
         * riding a private sine wave the music knows nothing about */
        double bnc = (0.34 * fabs(sin(beat)) + 0.66 * bp) * H * 0.060;
        double lean = sin(beat * 0.5) * w * 0.016;       /* slow weight shift */
        double shift = sin(beat * 0.25);                  /* a sway per bar */
        double whip = sin(beat + 0.9);
        double kick = 0.5 + 0.5 * sin(beat * 0.5 + 1.2);
        double nod = bp * H * 0.018;

        p->py -= bnc;
        p->px += lean * 0.55 + shift * w * 0.006;
        p->cy = p->py - H * 0.245;
        p->cx += lean + whip * w * 0.010 - shift * w * 0.008;
        p->nx = p->cx;
        p->ny = p->cy - H * 0.080;
        p->hx = p->cx + sin(beat + 0.6) * w * 0.012;
        p->hy = p->ny - H * 0.117 + nod + sin(beat * 2.0) * h * 0.005;
        *turn = sin(beat * 0.5 + 0.4) * 0.75 + bp * 0.10;

        /* the back foot lifts and rolls, the front one takes the weight; the
         * working knee comes up with the step so she travels and not just
         * bobs */
        pose_legs(p,
                  p->px - H * 0.078 - lean * 0.5,
                  ground - H * (0.252 + 0.070 * kick),
                  p->px - H * 0.112 - shift * w * 0.010, ground,
                  p->px + H * 0.090 + lean * 0.5,
                  ground - H * 0.245 - bnc * 0.45,
                  p->px + H * 0.072, ground - bnc * 0.75);
        /* the near arm snaps down on the beat while the far one floats: two
         * arms on the same phase is a jumping jack, not a dance */
        pose_arms(p,
                  p->cx - H * 0.152, p->cy + H * 0.070,
                  p->cx - H * 0.078 - sin(beat) * w * 0.018,
                  p->cy + H * (0.005 - 0.040 * bp),
                  p->cx + H * 0.198, p->cy - H * 0.050,
                  p->cx + H * 0.210, p->cy - H * (0.225 + 0.055 * lv)
                                    - bp * H * 0.032);
    } else if (style == VIS_STYLE_DANCE2) {      /* robot: snapped poses */
        double step = floor(t * 5.0) / 5.0;
        int    gr = ((int)(step * 5.0 + 0.001)) & 3;
        double easy = (t * 5.0) - floor(t * 5.0);
        double ax, ay, tilt;

        easy = easy * easy * (3.0 - 2.0 * easy);   /* settle, not a jump cut */
        tilt = (gr & 1) ? 1.0 : -1.0;
        p->py -= (gr & 1) ? H * 0.018 : 0.0;
        p->cy = p->py - H * 0.245 + bp * H * 0.005;
        p->cx += tilt * H * 0.012 * easy;
        p->nx = p->cx;
        p->ny = p->cy - H * 0.080;
        p->hx = p->cx + tilt * w * 0.009;
        p->hy = p->ny - H * 0.117 + bp * H * 0.010;
        *turn = tilt * 0.45 * easy + bp * 0.10;

        pose_legs(p,
                  p->px - H * 0.086, ground - H * (0.272 + 0.014 * bp),
                  p->px - H * 0.104, ground,
                  p->px + H * 0.086, ground - H * 0.272,
                  p->px + H * 0.104, ground);

        ax = (gr == 0 || gr == 3) ? -H * 0.17 : H * 0.17;
        ay = (gr < 2) ? -H * 0.075 : H * 0.020;
        /* elbows locked square: the whole point of the style. The raised hand
         * ticks on the beat, which is the one loose joint in the frame. */
        pose_arms(p,
                  p->cx + ax * 0.60, p->cy + ay,
                  p->cx + ax, p->cy + (gr < 2 ? -H * 0.170 : H * 0.075)
                              - bp * H * 0.020,
                  p->cx - ax * 0.60, p->cy - ay * 0.55,
                  p->cx - ax * 1.02, p->cy - ay * 0.34 + H * 0.02
                                     + bp * H * 0.016);
    } else {                                     /* spin: arms out, ghosts */
        double spin = t * 3.0;
        double flat = 0.64 + 0.36 * cos(spin);
        double lift = 0.5 + 0.5 * sin(spin * 2.0);
        double bnc = (0.55 * lift + 0.45 * bp) * H * 0.032;
        /* the arms ripple instead of rising together, so the turn has a body
         * in it and not a scarecrow on a turntable */
        double rip = fsind(spin * 1.4);

        p->py -= bnc;
        p->cy = p->py - H * 0.245;
        p->nx = p->cx;
        p->ny = p->cy - H * 0.080;
        p->hy = p->ny - H * 0.117 + bp * H * 0.014;
        p->hx = p->cx + sin(spin) * w * 0.008;
        *turn = sin(spin) * 0.85 + bp * 0.10;

        /* the supporting leg straightens as she rises, so the turn has a
         * plié under it instead of hovering */
        pose_legs(p,
                  p->px - H * 0.072 * flat,
                  ground - H * (0.245 + 0.045 * lift),
                  p->px - H * 0.088 * flat, ground,
                  p->px + H * 0.072 * flat,
                  ground - H * (0.245 - 0.020 * lift),
                  p->px + H * 0.088 * flat, ground - H * 0.030 * lift);
        pose_arms(p,
                  p->cx - H * 0.205 * flat, p->cy - H * 0.010 + rip * H * 0.020,
                  p->cx - H * 0.345 * flat, p->cy - H * (0.035 + 0.012 * bp)
                                             + rip * H * 0.055,
                  p->cx + H * 0.205 * flat, p->cy - H * 0.010 - rip * H * 0.020,
                  p->cx + H * 0.345 * flat, p->cy - H * (0.035 + 0.012 * bp)
                                             - rip * H * 0.055);
    }
}

static void dance_pose(Cv *c, const UiModel *m, int style)
{
    double t = m->elapsed_sec;
    double lv = (double)m->vis_level;
    double w = (double)c->w, h = (double)c->h;
    double ground = h * 0.884;
    double leadH  = h * 0.852;
    double bp = beat_pulse(m);
    double turn = 0.0, tail = 0.0;
    int    r, g, b;
    Pose   p;
    Rig    rig;
    Kit    lead = { 178, 122, 94, 214, 82, 74, 26, 24, 44,
                    232, 236, 248, 62, 42, 36 };
    Kit    mate = { 142, 96, 74, 44, 146, 160, 20, 18, 32,
                    198, 204, 224, 48, 34, 30 };

    /* the light in the room, sampled from the music: the key is the cold front
     * light and the fill is whatever the wall is doing right now */
    art_col(band_at(m, 0.55), &r, &g, &b);
    rig.kr = 152;
    rig.kg = 206;
    rig.kb = 255;
    rig.fr = r;
    rig.fg = g;
    rig.fb = b;
    rig.sheen = 0.44 + 0.30 * lv;

    /* Two more performers, further back and out to the sides, out of phase with
     * the lead. A single figure in the middle of a wide stage reads as a test
     * model however well it is drawn; three read as a show. */
    {
        Pose   q, qm;
        double turn2, tail2;
        int    s;

        for (s = 0; s < 2; s++) {
            double off = s ? 0.212 : -0.238;
            double dt  = s ? 1.31 : -1.74;
            double H2  = leadH * (s ? 0.605 : 0.565);
            double g2  = ground - h * (s ? 0.052 : 0.086);

            dance_build(&q, t + dt, lv, w, h, style, w * (0.5 + off),
                        H2, g2, bp, &turn2, &tail2);
            /* a glow behind each performer: the wall is bright enough to eat a
             * figure that has nothing separating it from the panels */
            cv_ell_soft(c, q.cx, (q.cy + q.hy) * 0.5, H2 * 0.30, H2 * 0.42,
                        120, 190, 240, 22);
            art_figure_shadow(c, &q, g2, lv * 0.5);
            pose_mirror(&qm, &q, g2, 0.60);
            art_dancer2(c, &qm, &rig, lv, 2, turn2, tail2, t + dt, &mate);
            art_dancer2(c, &q, &rig, lv, 0, turn2, tail2, t + dt, &mate);
        }
        /* depth: everything behind the lead is pushed back a stop */
        cv_rect(c, 0, 0, c->w, c->h, 3, 4, 11, 40);
    }

    dance_build(&p, t, lv, w, h, style, w * 0.5, leadH, ground, bp,
                &turn, &tail);

    /* ---- a follow spot that is actually aimed at her ----
     * The truss lamps rake the floor; this one tracks the performer, which is
     * the difference between a lit stage and a stage someone is standing on. */
    {
        double sx = w * 0.5 + fsind(t * 0.23) * w * 0.15;
        int    k;

        for (k = 3; k >= 0; k--) {
            double sp = w * (0.010 + 0.026 * (double)k);

            cv_poly(c, (double[]){ sx - 6.0, sx + 6.0,
                                   p.px + sp, p.px - sp },
                       (double[]){ h * 0.040, h * 0.040, ground, ground }, 4,
                    190, 216, 255, 5 + 3 * k);
        }
        /* the beat lands on the boards under her */
        cv_ell_soft(c, p.px, ground - p.th * 0.08,
                    leadH * (0.14 + 0.05 * bp), leadH * 0.024,
                    190, 220, 255, (int)(24 + 46 * bp));
    }

    /* backlight: the beam behind her, so her outline is not the wall's */
    cv_ell_soft(c, p.cx, (p.cy + p.hy) * 0.5, leadH * 0.26, leadH * 0.40,
                130, 200, 246, 30);
    art_figure_shadow(c, &p, ground, lv);

    /* the boards are polished, so she is in them */
    {
        Pose m2;

        pose_mirror(&m2, &p, ground, 0.62);
        art_dancer2(c, &m2, &rig, lv, 2, turn, tail, t, &lead);
    }

    /* motion: two earlier selves, flat and faint, so a fast move smears */
    if (c->w >= 900) {
        int    k;
        double turn2, tail2;

        for (k = 2; k >= 1; k--) {
            Pose g2;

            dance_build(&g2, t - 0.030 * (double)k, lv, w, h, style,
                        w * 0.5, leadH, ground, bp, &turn2, &tail2);
            art_dancer2(c, &g2, &rig, lv, 1, turn2, tail2,
                        t - 0.030 * (double)k, &lead);
        }
    }

    art_dancer2(c, &p, &rig, lv, 0, turn, tail, t, &lead);

    /* the performer's own spill on the boards, in front of the shadow */
    cv_ell_soft(c, p.px, ground - p.th * 0.20, p.th * 3.4, p.th * 0.60,
                150, 190, 250, (int)(18 + 24 * lv));

    /* embers in the air between her and the camera: the cheapest depth cue in
     * the file, and the one that stops the stage looking like a backdrop */
    art_sparks(c, m, 0.0, w, h * 0.12, h * 0.90, 34, 205, 224, 255);
}

/* ------------------------------------------------------------- the booth --- */

/* ---- the pit's wardrobe --------------------------------------------------
 * The pit used to be one silhouette in five shirt colours, which is what made
 * it the flattest thing in the room: at this distance a person is read by
 * their cut and their trim, not by the colour of a sleeve. So everyone down
 * there now draws an outfit (tee, vest, cropped top over bare ribs, hoodie,
 * jersey, open shirt), a skin tone from six, a head from six cuts, and the
 * accessory that goes with them - cap, beanie, headphones round the neck,
 * shades, a wristband on the raised arm.
 *
 * It is all a few lines and two or three ellipses per garment, in the same lit
 * material vocabulary as the dancers, so the pit and the stage stay one room. */

/* The resolution step the current frame is being painted at, 1 = the frame's
 * own pixels. vis_art_draw() sets it before dispatch, so a look can drop the
 * work that a quarter of the pixels cannot show anyway. Declared up here
 * because the club's helpers below gate on it. It is declared further up the
 * file now, so the fluid can gate on it as well. */

/* ============================================== rave: tweakable settings ====
 * Everything about the club that is worth changing sits in this block. Every
 * number here is read by the code below, so a look change is one edit rather
 * than a hunt through the section.
 *
 *   crowd sizes   how many people stand in each depth layer, and how many
 *                 people there are at the lens
 *   haze / fog    strength of the two volumetric layers; 0 turns one off
 *   bloom gain    extra bloom the club asks for (art_finish reads it)
 *   rim           strength of the coloured rim light on the figures
 *   shake         strength of the bass shake on the foreground
 *   floor gloss   how hard the polished floor mirrors the room
 *   flecks / dust how many ball flecks and dust motes are in the air
 */
#define RV_CROWD_BACK   (cfg.rave.crowd_back)      /* far rank: small, dark, hazed            */
#define RV_CROWD_MID    (cfg.rave.crowd_mid)      /* middle rank                             */
#define RV_CROWD_FRONT  (cfg.rave.crowd_front)      /* front rank: largest, sharpest           */
#define RV_NEAR_PIT     (cfg.rave.near_pit)      /* out-of-focus people against the lens    */

#define RV_HAZE         (cfg.rave.haze)   /* laser haze and smoke, 0 = off           */
#define RV_FOG          (cfg.rave.fog)   /* low fog drifting over the floor         */
#define RV_BLOOM_GAIN   (cfg.rave.bloom_gain)   /* club-only extra bloom in art_finish     */
#define RV_RIM          (cfg.rave.rim)   /* rim light on figures and the DJ         */
#define RV_SHAKE        (cfg.rave.shake)   /* bass shake, 0 = steady camera           */
#define RV_FLOOR_GLOSS  (cfg.rave.floor_gloss)   /* strength of the floor reflection        */
#define RV_FLECK        (cfg.rave.fleck)      /* disco-ball flecks on walls and crowd    */
#define RV_DUST         (cfg.rave.dust)      /* dust motes hanging in the beams         */
#define RV_LASER_SPEED  (cfg.rave.laser_speed)   /* how fast the beams sweep                */
#define RV_LASER_WIDTH  (cfg.rave.laser_width)   /* how wide the beams open up              */
/* Where the wall meets the floor, as a fraction of the frame. Raising this
 * line gives the pit floor somewhere to be: below it is the only part of the
 * shot a reflection can be seen in. */
#define RV_WALL_Y       (cfg.rave.wall_y)

/* --- the floor's mirror ---------------------------------------------------
 * A reflection here is the real picture above the floor line, mirrored, faded
 * with distance from the feet and tinted by the light standing over it. This
 * is the thing that stops the crowd looking pasted onto the floor. */
#define RV_REFLECT      (cfg.rave.reflect)   /* strength of the mirror, 0 = off          */
#define RV_REFLECT_LEN  (cfg.rave.reflect_len)  /* how far a reflection runs below the feet */
#define RV_REFLECT_SQUASH (cfg.rave.reflect_squash)  /* vertical compression of the mirror       */
#define RV_REFLECT_BLUR (cfg.rave.reflect_blur)    /* horizontal blur radius, px at 1920 wide  */
#define RV_REFLECT_TINT (cfg.rave.reflect_tint)   /* how much the nearest light colours it    */

/* --- pools and the light they throw on people ----------------------------- */
#define RV_POOL_GAIN    (cfg.rave.pool_gain)   /* additive floor pools under every beam    */
#define RV_POOL_TINT    (cfg.rave.pool_tint)   /* how hard a pool lights the legs in it    */

/* --- fog ------------------------------------------------------------------ */
#define RV_FOG_KNEE     (cfg.rave.fog_knee)   /* knee-height fog thickness, 0 = off       */
#define RV_FOG_BACK     (cfg.rave.fog_back)   /* back rows are this much thicker than near*/

/* --- crowd shading -------------------------------------------------------- */
#define RV_CONTACT      (cfg.rave.contact)   /* contact shadow under every foot          */
#define RV_SHADOW_SIDE  (cfg.rave.shadow_side)   /* how hard the unlit side of a body goes   */
#define RV_WALL_DIM     (cfg.rave.wall_dim)   /* spectral wall brightness against the DJ  */

/* The club's light palette: every laser, rim, pool and fleck is tinted from
 * these five, so the room never drifts off the app's cyan-and-pink scheme. */
static const int k_rv_laser[5][3] = {
    {  60, 230, 255 }, { 255,  92, 210 }, { 150, 120, 255 },
    { 120, 255, 190 }, { 255, 170,  90 }
};

/* A colour pushed toward white as the track gets loud: at the drop the whole
 * rig goes hot instead of every light staying the same value all night. */
static void rv_hot(int *r, int *g, int *b, double amt)
{
    if (amt <= 0.0)
        return;
    if (amt > 0.85)
        amt = 0.85;
    *r = clampi((int)((double)*r + (244.0 - (double)*r) * amt), 0, 255);
    *g = clampi((int)((double)*g + (246.0 - (double)*g) * amt), 0, 255);
    *b = clampi((int)((double)*b + (255.0 - (double)*b) * amt), 0, 255);
}

/* Which of them is over this part of the room, 0..1 across the frame. */
static const int *rv_laser_at(double u)
{
    int i = (int)(u * 5.0);

    if (i < 0)
        i = 0;
    if (i > 4)
        i = 4;
    return k_rv_laser[i];
}

/* The rim colour the figures on the stage side are picking up. Set once per
 * person by rave_crowd_person() and read by crowd_figure(), which is cheaper
 * than threading two more arguments through a nine-parameter call. */
static int    rv_rim_r = 90, rv_rim_g = 150, rv_rim_b = 255;
static double rv_rim_a = 0.30;

/* Frame delta, set once by art_rave(). The arm easing below needs it, and so
 * does anything else that should settle rather than snap. */
static double rv_dt = 0.016;

/* ---- eased arms ---------------------------------------------------------
 * Each person keeps their own arm target between frames and moves toward it
 * instead of jumping to it. The moves themselves already live in time (a pump
 * is a sine), so the only thing that ever jumps is a *change* of move, and this
 * is what rounds that change off: a pit that swaps pose in one frame reads as a
 * row of puppets, a pit that eases into it reads as dancing. State is a small
 * table indexed by the dancer's slot, so it costs one lerp per joint. */
#define RV_SLOTS 48
static double rv_arm[RV_SLOTS][8];
static int    rv_arm_ok[RV_SLOTS];

static void rv_ease_arms(Pose *p, int slot)
{
    double *a;
    double k, src[8];
    int    i;

    if (slot < 0 || slot >= RV_SLOTS)
        return;
    src[0] = p->ex[0]; src[1] = p->ey[0]; src[2] = p->wx[0]; src[3] = p->wy[0];
    src[4] = p->ex[1]; src[5] = p->ey[1]; src[6] = p->wx[1]; src[7] = p->wy[1];
    a = rv_arm[slot];
    if (!rv_arm_ok[slot]) {
        for (i = 0; i < 8; i++)
            a[i] = src[i];
        rv_arm_ok[slot] = 1;
        return;
    }
    k = rv_dt * 6.0;                     /* ~0.17 s to most of the way */
    if (k > 1.0) k = 1.0;
    if (k < 0.0) k = 0.0;
    for (i = 0; i < 8; i++) {
        a[i] += (src[i] - a[i]) * k;
        src[i] = a[i];
    }
    p->ex[0] = src[0]; p->ey[0] = src[1]; p->wx[0] = src[2]; p->wy[0] = src[3];
    p->ex[1] = src[4]; p->ey[1] = src[5]; p->wx[1] = src[6]; p->wy[1] = src[7];
}

static void rv_rim_for(double u)
{
    const int *p = rv_laser_at(u);

    rv_rim_r = p[0];
    rv_rim_g = p[1];
    rv_rim_b = p[2];
}

/* Contact shadow: a wide soft pool, a tight core, and the dark under the feet.
 * Three ellipses a person is the whole difference between standing on a floor
 * and being pasted onto one. */
static void rv_contact(Cv *c, double cx, double gy, double halfw, int a)
{
    if (a < 2 || halfw < 1.5)
        return;
    {
        int s = (int)((double)a * RV_CONTACT);

        if (s < 2)
            return;
        cv_ell_soft(c, cx, gy, halfw * 1.20, halfw * 0.36, 2, 3, 9,
                    (int)((double)s * 0.60));
        cv_ell_soft(c, cx, gy - halfw * 0.02, halfw * 0.60, halfw * 0.19,
                    1, 2, 6, (int)((double)s * 0.86));
        cv_ell(c, cx, gy - 1.0, halfw * 0.34, halfw * 0.11, 1, 1, 5, s);
        /* the darkest point is the gap under the sole, not the shadow around it */
        cv_ell(c, cx, gy + 0.5, halfw * 0.20, halfw * 0.06, 0, 1, 4, s);
    }
}

/* A pool of coloured light on the floor, plus the wash it throws into the air
 * over it. Used four times a frame, block-stamped, so it is nearly free. */
static void rv_pool(Cv *c, double cx, double cy, double rx, double ry,
                    int r, int g, int b, int a)
{
    cv_ell_soft(c, cx, cy, rx, ry, r, g, b, (int)((double)a * 0.75));
    if (s_paint_step <= 2)
        cv_ell_soft(c, cx, cy, rx * 0.46, ry * 0.46, r, g, b,
                    (int)((double)a * 0.50));
}

/* ---- the room's static base ---------------------------------------------
 * The sky, the floor and its base light never change while the canvas size
 * does not, so they are baked once into a buffer and copied in. Those two
 * gradients are a million pixels each: repainting them every frame was the
 * single most expensive thing in the club that nobody could see. */
static Cv  s_rv_base;
static int s_rv_base_w, s_rv_base_h;

/* Every baked layer is stamped with this generation. Anything that changes
 * what a bake was built from - a config reload, the skin, a quality limit -
 * bumps it, and the next frame rebakes. The canvas size is compared directly,
 * so a quality step that resizes the canvas rebakes without being told. */
static unsigned s_cache_gen = 1;
static unsigned s_rv_base_gen;

/* ---- A3 counters ------------------------------------------------------
 * Instrumentation only: one increment per call on the two staging sites, no
 * allocation, no path change. Emitted through log_msg at a slow cadence so
 * app.log keeps the numbers next to the step decisions. */
static void a3_emit(void)
{
    if (!s_a3_frames)
        return;
    log_msg(LOG_INFO, "a3",
            "A3COUNTERS style=%d step=%d frames=%llu rv_calls=%llu rv_bytes=%llu "
            "rv_bakes=%llu rv_alloc_fail=%llu pr_calls=%llu pr_upscales=%llu "
            "pr_upscale_bytes=%llu pr_uploads=%llu pr_upload_bytes=%llu "
            "pr_texcreates=%llu pr_copies=%llu",
            s_a3_style, s_a3_step, s_a3_frames, s_a3_rv_calls, s_a3_rv_bytes,
            s_a3_rv_bakes, s_a3_rv_alloc_fail, s_a3_pr_calls, s_a3_pr_upscales,
            s_a3_pr_upscale_bytes, s_a3_pr_uploads, s_a3_pr_upload_bytes,
            s_a3_pr_texcreates, s_a3_pr_copies);
    s_a3_rv_calls = s_a3_rv_bakes = s_a3_rv_alloc_fail = 0;
    s_a3_rv_bytes = 0;
    s_a3_pr_calls = s_a3_pr_upscales = s_a3_pr_uploads = 0;
    s_a3_pr_texcreates = s_a3_pr_copies = 0;
    s_a3_pr_upscale_bytes = s_a3_pr_upload_bytes = 0;
    s_a3_frames = 0;
}

void vis_art_cache_invalidate(void)
{
    if (s_a3_frames)
        a3_emit();
    s_cache_gen++;
}

static void rv_base_bake(Cv *b)
{
    bg_grad(b, 0, b->h, 7, 7, 15, 3, 3, 8);
    bg_grad(b, (int)((double)b->h * RV_WALL_Y), b->h, 18, 12, 28, 4, 4, 8);
    cv_ell_soft(b, (double)b->w * 0.5, (double)b->h * (RV_WALL_Y + 0.020),
                (double)b->w * 0.60, (double)b->h * 0.050, 100, 60, 170, 60);
}

static void rv_base(Cv *c)
{
    Cv     b;
    size_t n;

    s_a3_rv_calls++;

    if (s_rv_base_gen != s_cache_gen ||
        s_rv_base_w != c->w || s_rv_base_h != c->h || !s_rv_base.p) {
        s_rv_base_gen = s_cache_gen;
        free(s_rv_base.p);
        s_rv_base.p = cv_alloc(c->w, c->h);
        s_rv_base_w = s_rv_base.p ? c->w : 0;
        s_rv_base_h = s_rv_base.p ? c->h : 0;
        if (!s_rv_base.p) {
            s_a3_rv_alloc_fail++;
            rv_base_bake(c);
            return;
        }
        b.p = s_rv_base.p;
        b.w = c->w;
        b.h = c->h;
        rv_base_bake(&b);
        s_a3_rv_bakes++;
    }
    n = (size_t)c->w * (size_t)c->h * 4;
    s_a3_rv_bytes += (unsigned long long)n;
    memcpy(c->p, s_rv_base.p, n);
}

/* ---- quarter-resolution soft layers (Stage B) ---------------------------
 *
 * Fog, haze, glows and light pools are soft, low-contrast shapes: none of them
 * has a hard edge, so drawing them at a quarter of the canvas in each direction
 * and adding the result back costs a sixteenth of the pixels and looks the same
 * once the upscale has blurred it again.
 *
 * One buffer is reused. The caller says which band of the canvas the layer
 * covers, so only that band is composited - a full-frame pass for a fog bank
 * that sits in the lower third would cost more than it saves.
 *
 * [quality] soft_quarter = 0 turns it off, which is how the console compares
 * the two without another build. */
static Cv  s_soft;

static Cv *soft_begin(Cv *c)
{
    int w, h;

    if (!c || !c->p || !cfg.quality.soft_quarter || s_paint_step >= 3)
        return NULL;
    w = c->w / 4;
    h = c->h / 4;
    if (w < 16 || h < 12)
        return NULL;
    if (!s_soft.p || s_soft.w != w || s_soft.h != h) {
        free(s_soft.p);
        s_soft.p = cv_alloc(w, h);
        s_soft.w = w;
        s_soft.h = h;
    }
    if (!s_soft.p)
        return NULL;
    memset(s_soft.p, 0, (size_t)w * (size_t)h * 4u);
    return &s_soft;
}

/* Bilinear upscale of the layer, added onto the canvas rows y0..y1 (fractions of
 * the canvas height). Additive because these layers are light, not paint. */
static void soft_add(Cv *c, Cv *s, double fy0, double fy1)
{
    int y, x, y0, y1;

    if (!c || !c->p || !s || !s->p)
        return;
    y0 = (int)(fy0 * (double)c->h);
    y1 = (int)(fy1 * (double)c->h);
    if (y0 < 0) y0 = 0;
    if (y1 > c->h) y1 = c->h;

    for (y = y0; y < y1; y++) {
        long fq = (((long)y * 2 + 1) * s->h * 256) / (c->h * 2) - 128;
        int  qy = (int)(fq >> 8), ty = (int)(fq & 255);
        const unsigned char *r0, *r1;
        unsigned char       *d;

        if (qy < 0) { qy = 0; ty = 0; }
        if (qy > s->h - 1) { qy = s->h - 1; ty = 0; }
        r0 = s->p + (size_t)qy * (size_t)s->w * 4u;
        r1 = (qy + 1 < s->h) ? r0 + (size_t)s->w * 4u : r0;
        d  = c->p + (size_t)y * (size_t)c->w * 4u;

        for (x = 0; x < c->w; x++) {
            long fx = (((long)x * 2 + 1) * s->w * 256) / (c->w * 2) - 128;
            int  qx = (int)(fx >> 8), tx = (int)(fx & 255);
            int  w00, w10, w01, w11, k;
            unsigned add[3];

            if (qx < 0) { qx = 0; tx = 0; }
            if (qx > s->w - 1) { qx = s->w - 1; tx = 0; }
            w00 = (256 - tx) * (256 - ty);
            w10 = tx * (256 - ty);
            w01 = (256 - tx) * ty;
            w11 = tx * ty;

            for (k = 0; k < 3; k++) {
                int s00 = r0[qx * 4 + k], s10, s01, s11;
                int v;

                s10 = (qx + 1 < s->w) ? r0[(qx + 1) * 4 + k] : s00;
                s01 = r1[qx * 4 + k];
                s11 = (qx + 1 < s->w) ? r1[(qx + 1) * 4 + k] : s01;
                v   = (s00 * w00 + s10 * w10 + s01 * w01 + s11 * w11) >> 16;
                add[k] = (unsigned)(v < 0 ? 0 : v);
            }
            for (k = 0; k < 3; k++) {
                unsigned v = (unsigned)d[x * 4 + k] + add[k];

                d[x * 4 + k] = (unsigned char)(v > 255u ? 255u : v);
            }
        }
    }
}

/* ---- low fog ------------------------------------------------------------
 * Three banks at different heights, each made of three lumps drifting past each
 * other, and each lump tinted by the laser nearest it - which is what makes the
 * fog look *lit* rather than painted. A single band the width of the room reads
 * as a smudge however you move it; separate lumps read as air moving.
 *
 * The falloff is block-stamped, so a bank of fog costs a few thousand stamps
 * rather than a pixel each. */
static void rv_fog(Cv *c, const UiModel *m, double wall, double lv)
{
    double t = m->elapsed_sec, w = (double)c->w, h = (double)c->h;
    int    b, i;

    static const double bank[4]  = { 0.742, 0.800, 0.858, 0.900 };

    (void)wall;
    if (RV_FOG <= 0.01 || RV_FOG_KNEE <= 0.01 || s_paint_step >= 3)
        return;
    /* Knee height, not wall height: the fog has to sit where legs are, and it is
     * thickest at the back of the room and thinnest at the lens. That gradient
     * is the depth cue - the back rows are veiled to the shoulder, the front
     * row up to the shin. The last bank is the near one, and because the whole
     * layer is drawn after the crowd it is what puts them *in* the fog rather
     * than behind it. */
    for (b = 0; b < 4; b++) {
        double y  = h * bank[b];
        double sp = 0.040 + 0.020 * (double)b;      /* each bank drifts faster */
        double th = b == 0 ? RV_FOG_BACK : (b == 1 ? 1.00 : (b == 2 ? 0.80 : 0.62));
        int    a  = (int)((7.0 + 9.5 * lv) * RV_FOG * RV_FOG_KNEE * th);

        if (a < 2)
            continue;
        /* One lump at a third of the canvas, two above it. Dropping to a single
         * lump at step 2 was what emptied the room at the step most consoles
         * settle on: the fog is the depth cue, not decoration. */
        int    lumps = s_paint_step >= 3 ? 1 : 2;

        for (i = 0; i < lumps; i++) {
            double px = w * (0.26 + 0.46 * (double)i)
                      + w * 0.070 * fsind(t * sp + (double)(b * 3 + i) * 1.9);
            const int *lc = k_rv_laser[(b * 3 + i) % 5];
            int    r  = (int)((152.0 + (double)lc[0]) * 0.50);
            int    g  = (int)((162.0 + (double)lc[1]) * 0.50);
            int    bl = (int)((204.0 + (double)lc[2]) * 0.50);

            /* Tall lumps, not a thin band: a wide flat ellipse the width of
             * the room reads as a stripe with a straight edge, which is the
             * one thing fog must never look like. Each lump also sits at its
             * own height, so the top of the layer is ragged. */
            cv_ell_soft(c, px,
                        y + h * (0.022 + 0.016) * fsind(t * 0.09
                                                        + (double)(b + i) * 2.3),
                        w * (0.26 + 0.07 * (double)(i & 1)),
                        h * (0.044 + 0.008 * (double)b), r, g, bl, a);
            /* the beam passing through it lights the middle of the lump */
            if (s_paint_step <= 1 && (b + i) % 2 == 0)
                cv_ell_soft(c, px, y + h * 0.004, w * 0.085,
                            h * 0.012, 235, 245, 255, a / 3);
        }
    }
}

/* ---- the polished floor -------------------------------------------------
 * A mirror is a per-pixel job the console cannot afford every frame, so the
 * floor reflects what a glossy floor actually shows from here: the bright
 * things above it, smeared straight down. One row of wall is read, averaged
 * five samples wide (that is the blur - it costs one add per tap), and every
 * column bright enough to matter throws a soft vertical streak of its own
 * colour into the pit. Add the booth's spill and the sheen along the far edge
 * and the floor reads as wet without a single reflected triangle.
 *
 * The streaks are drawn before the crowd, because people stand *on* a
 * reflection. */
static void rv_floor(Cv *c, const UiModel *m, double wall, double lv,
                     double kick)
{
    double t = m->elapsed_sec, w = (double)c->w, h = (double)c->h;
    double gloss = RV_FLOOR_GLOSS;
    int    x, sy, step, ga;

    if (gloss <= 0.01 || s_paint_step >= 3)
        return;
    step = (s_paint_step >= 2) ? 3 : 2;

    /* the sheen along the far edge: what says "wet" before anything else does */
    ga = (int)((34.0 + 52.0 * lv) * gloss);
    cv_ell_soft(c, w * 0.5, wall + h * 0.010, w * 0.62, h * 0.016,
                150, 172, 240, ga);

    /* the booth and its two platters, smeared under themselves */
    cv_ell_soft(c, w * 0.5, wall + h * 0.088, w * 0.105, h * 0.088,
                110, 92, 210, ga);
    cv_ell_soft(c, w * 0.5, wall + h * 0.034, w * 0.048, h * 0.034,
                180, 165, 245, ga);
    for (x = 0; x < 5; x++) {
        double px2 = w * (0.10 + 0.80 * ((double)x + 0.5) / 5.0);

        cv_ell_soft(c, px2, wall + h * 0.050, w * 0.012, h * 0.048,
                    255, 178, 120, ga / 2);
    }

    /* the reflection itself: one bright row of wall, streaked down */
    sy = cv_i(wall - h * 0.060);
    if (sy < 2 || sy > c->h - 2)
        return;
    for (x = 0; x < c->w; x += step) {
        double rr = 0.0, gg = 0.0, bb = 0.0, lum, len, al;
        int    k;

        for (k = -2; k <= 2; k++) {
            int    xx = x + k * step;
            unsigned char *q;

            if (xx < 0)
                xx = 0;
            if (xx >= c->w)
                xx = c->w - 1;
            q = c->p + ((size_t)sy * (size_t)c->w + (size_t)xx) * 4;
            rr += (double)q[0];
            gg += (double)q[1];
            bb += (double)q[2];
        }
        rr *= 0.2;
        gg *= 0.2;
        bb *= 0.2;
        lum = (rr * 0.30 + gg * 0.59 + bb * 0.11) / 255.0;
        if (lum < 0.10)
            continue;
        len = h * (0.014 + 0.055 * lum)
            * (1.0 + 0.10 * fsind(t * 2.1 + (double)x * 0.02));
        al  = (16.0 + 74.0 * lum) * gloss * (1.0 + 0.25 * kick);
        cv_ell_soft(c, x, wall + len * 0.5, step * 1.7, len,
                    (int)rr, (int)gg, (int)bb, (int)al);
        /* a brighter column also lays a wide shallow one, which is what a wet
         * floor does to a bright light: a long glow, not a stripe */
        if (s_paint_step <= 1 && (x & 31) == 0)
            cv_ell_soft(c, x, wall + len * 0.30, step * 3.4, len * 0.32,
                        (int)rr, (int)gg, (int)bb, (int)(al * 0.45));
    }
}

/* ---- flecks off the mirror ball, and dust in the beams -------------------
 * Both are single additive dots. The flecks wander over the wall and the crowd
 * on their own slow orbits (a real ball throws them round the room); the dust
 * sits in the top half where the beams are. */
/* ---- additive light ------------------------------------------------------
 * cv_ell_soft paints *over* what is there; light adds to it. This is the
 * additive ellipse the pools and the leg washes are made of: one square root
 * per row for the span, one multiply per pixel for the falloff, no division. */
static void rv_add_ell(Cv *c, double cx, double cy, double rx, double ry,
                       int r, int g, int b, int a)
{
    int y, y0, y1, x0, x1;

    if (!c->p || a < 2 || rx < 1.0 || ry < 1.0)
        return;
    x0 = cv_i(cx - rx);
    x1 = cv_i(cx + rx);
    y0 = cv_i(cy - ry);
    y1 = cv_i(cy + ry);
    if (x0 < 0)
        x0 = 0;
    if (y0 < 0)
        y0 = 0;
    if (x1 > c->w - 1)
        x1 = c->w - 1;
    if (y1 > c->h - 1)
        y1 = c->h - 1;
    for (y = y0; y <= y1; y++) {
        double ny  = ((double)y - cy) / ry;
        double row = 1.0 - ny * ny;
        double isp;
        int    span, x, cxx = cv_i(cx);

        if (row <= 0.0)
            continue;
        span = (int)(rx * sqrt(row));
        if (span < 1)
            continue;
        isp = 1.0 / (double)span;
        row *= row;
        for (x = cxx - span; x <= cxx + span; x++) {
            double nx = ((double)x - cx) * isp;
            int    al = (int)((double)a * row * (1.0 - nx * nx));

            if (al > 0)
                cv_add(c, x, y, r, g, b, al);
        }
    }
}

/* ---- the floor's mirror --------------------------------------------------
 * The real thing, in one pass. For each row below the floor line the row that
 * mirrors above it is read back out of the canvas, averaged three taps wide
 * (that is the blur, one add per tap), tinted by the light standing over that
 * part of the room, and laid down with a Fresnel falloff: full at the feet,
 * gone by the end of the run.
 *
 * Reading the canvas instead of drawing the people a second time is what makes
 * this affordable - the crowd is already painted, so a mirror costs one blend
 * per pixel rather than another crowd. The destination rows are always below
 * the source rows, so it can write back into the same buffer.
 *
 * The tint is picked per fifth of the frame, outside the pixel loop, so not one
 * division is spent on it. */
static void rv_reflect(Cv *c, double gy, double len, double clip,
                       double strength, double bass)
{
    double w      = (double)c->w;
    double squash = RV_REFLECT_SQUASH;
    int    blur   = (int)(RV_REFLECT_BLUR * (w / 1920.0) + 0.5);
    double tint   = RV_REFLECT_TINT;
    int    y0     = cv_i(gy) + 1;
    int    y1     = cv_i(gy + len);
    int    cl     = cv_i(clip);
    int    lstep  = c->w / 5;
    int    seg, y, x;

    if (!c->p || strength <= 0.01 || len < 2.0)
        return;
    if (lstep < 1)
        lstep = 1;
    if (blur < 0)
        blur = 0;
    if (y1 > cl)
        y1 = cl;
    if (y1 > c->h - 1)
        y1 = c->h - 1;

    for (seg = 0; seg < 5; seg++) {
        const int *lc  = k_rv_laser[seg];
        double     keep = 1.0 - tint;
        int        xa  = seg * lstep;
        int        xb  = seg == 4 ? c->w : (seg + 1) * lstep;

        if (xb > c->w)
            xb = c->w;
        if (xa >= xb)
            continue;
        for (y = y0; y <= y1; y++) {
            double k = ((double)y - gy) / len;
            double f = 1.0 - k;
            int    a, sy;
            unsigned char *src;

            if (f <= 0.0)
                break;
            f = f * (0.35 + 0.65 * f);      /* Fresnel-ish: hardest at the feet */
            a = (int)(255.0 * strength * f * (0.78 + 0.30 * bass));
            if (a < 3)
                continue;
            if (a > 235)
                a = 235;
            sy = cv_i(gy - ((double)y - gy) * squash);
            if (sy < 0 || sy >= c->h)
                continue;
            src = c->p + (size_t)sy * (size_t)c->w * 4;
            for (x = xa; x < xb; x++) {
                int xs = x - blur, xe = x + blur;
                int sr, sg, sb;
                double g0 = f * 1.25 * keep;
                double t0 = f * tint * 0.75;

                if (xs < 0)
                    xs = 0;
                if (xe > c->w - 1)
                    xe = c->w - 1;
                sr = (src[(size_t)xs * 4] + src[(size_t)x * 4]
                      + src[(size_t)xe * 4]) / 3;
                sg = (src[(size_t)xs * 4 + 1] + src[(size_t)x * 4 + 1]
                      + src[(size_t)xe * 4 + 1]) / 3;
                sb = (src[(size_t)xs * 4 + 2] + src[(size_t)x * 4 + 2]
                      + src[(size_t)xe * 4 + 2]) / 3;
                if (sr + sg + sb < 21)      /* nothing bright enough to mirror */
                    continue;
                /* Additive, not a blend: what a wet floor shows is the light
                 * coming off the room, and light adds. Blending a dark leg over
                 * an almost-black floor is arithmetically invisible; adding it
                 * is what makes the reflection read. */
                cv_add(c, x, y,
                       (int)((double)sr * g0 + (double)lc[0] * t0),
                       (int)((double)sg * g0 + (double)lc[1] * t0),
                       (int)((double)sb * g0 + (double)lc[2] * t0), 190);
            }
        }
    }
}

static void rv_flecks(Cv *c, const UiModel *m, double wall, double lv)
{
    double t = m->elapsed_sec, w = (double)c->w, h = (double)c->h;
    int    i;

    if (s_paint_step >= 3)
        return;
    for (i = 0; i < RV_FLECK; i++) {
        double a1 = (double)i * 2.399;
        double x  = w * (0.5 + 0.46 * fsind(a1 + t * 0.21));
        double y  = h * (0.26 + 0.54 * (0.5 + 0.5 * fsind(a1 * 1.7 + t * 0.16)));
        double tw = 0.4 + 0.6 * fsind(t * 3.1 + (double)i * 1.9);
        const int *lc = k_rv_laser[i % 5];
        int    al = (int)((10.0 + 26.0 * tw) * (0.4 + 0.8 * lv));

        if (s_paint_step >= 2 && (i & 1))
            continue;
        if (al < 2)
            continue;
        cv_add(c, (int)x, (int)y, 255, 248, 232, al);
        cv_soft(c, x, y, 2.0 + 2.0 * tw, lc[0], lc[1], lc[2], al / 3);
    }
    for (i = 0; i < RV_DUST; i++) {
        double a1 = (double)i * 1.618;
        double x  = w * (0.08 + 0.84 * (0.5 + 0.5 * fsind(a1 * 3.1 + t * 0.09)));
        double y  = wall * (0.10 + 0.86 * (0.5 + 0.5 * fsind(a1 * 1.3 + t * 0.11)));
        double tw = 0.35 + 0.65 * fsind(t * 1.9 + (double)i * 2.7);

        if (s_paint_step >= 2 && (i & 1))
            continue;
        cv_add(c, (int)x, (int)y, 210, 226, 255,
               (int)((5.0 + 14.0 * tw) * (0.4 + 0.8 * lv)));
    }
}

/* Four pools on the floor from the moving heads, drifting with the track, and
 * the coloured air standing over each of them. */
static void rv_pools(Cv *c, const UiModel *m, double wall, double lv)
{
    double t = m->elapsed_sec, w = (double)c->w, h = (double)c->h;
    int    i;

    if (s_paint_step >= 3 || RV_HAZE <= 0.01)
        return;
    double bass = (band_at(m, 0.02) + band_at(m, 0.06)) * 0.5;

    /* One pool per beam, where the beam lands, in that beam's colour. The beams
     * sweep, so the pools travel with them instead of sitting still, and every
     * one of them lifts on the low end - a light pool on a wet floor is the
     * floor answering the bass. */
    for (i = 0; i < 5; i++) {
        const int *lc = k_rv_laser[i];
        double u  = (double)i / 4.0;
        double dr = fsind(t * 0.23 + (double)i * 1.7) * 0.045;
        double x  = w * (0.13 + 0.74 * u + dr);
        /* in the clear strip between the wall and the back rank, which is the
         * only floor a pool can actually be seen on */
        double y  = wall + h * (0.046 + 0.020 * fsind(t * 0.19 + (double)i));
        double rx = w * (0.082 + 0.030 * (double)(i & 1));
        int    a  = (int)((28.0 + 44.0 * lv) * RV_HAZE * RV_POOL_GAIN
                          * (0.80 + 0.50 * bass));

        if (a < 3)
            continue;
        /* the pool, its hot middle, and the air it throws up: a light pool on
         * a glossy floor is brightest at the point the beam lands, so a flat
         * ellipse the same colour all over reads as a decal */
        rv_pool(c, x, y, rx, h * 0.030, lc[0], lc[1], lc[2], a);
        if (s_paint_step <= 1) {
            /* additive core: what makes it read as light lying on gloss rather
             * than as paint */
            rv_add_ell(c, x, y, rx * 0.58, h * 0.019, lc[0], lc[1], lc[2], a / 2);
            rv_add_ell(c, x, y, rx * 0.20, h * 0.009, 255, 250, 236, a / 3);
        }
        cv_ell_soft(c, x, y - h * 0.120, w * 0.058, h * 0.100,
                    lc[0], lc[1], lc[2], a / 4);
    }
    /* the rig's two fixed lamps, not the moving beams: white pools, so the
     * floor has one place where the light is not coloured */
    if (s_paint_step <= 1 && RV_POOL_GAIN > 0.01) {
        int wa = (int)((20.0 + 26.0 * lv) * RV_POOL_GAIN);

        rv_add_ell(c, w * 0.335, wall + h * 0.058, w * 0.070, h * 0.018,
                   214, 228, 255, wa);
        rv_add_ell(c, w * 0.665, wall + h * 0.058, w * 0.070, h * 0.018,
                   214, 228, 255, wa);
    }
}

typedef struct {
    Kit k;
    int alt_r, alt_g, alt_b;   /* trim, stripe, number panel */
    int leg_r, leg_g, leg_b;   /* trousers */
    int look;                  /* 0 tee 1 vest 2 crop 3 hoodie 4 jersey 5 open */
    int cut;                   /* 0 short 1 bun 2 cap 3 long 4 beanie 5 curls  */
    int acc;                   /* 0 none 1 phones 2 shades 3 band 4 chain      */
} CrowdFit;

/* Six skin tones. The old crowd gave every head the same one, which is the
 * single biggest reason a room full of people read as a texture. */
static void crowd_skin(int idx, int *r, int *g, int *b)
{
    static const int tone[6][3] = {
        { 230, 184, 152 }, { 204, 152, 118 }, { 174, 122,  90 },
        { 140,  94,  68 }, { 108,  72,  52 }, { 244, 212, 188 }
    };
    int i = ((idx % 6) + 6) % 6;

    *r = tone[i][0];
    *g = tone[i][1];
    *b = tone[i][2];
}

/* A head seen from the front or three-quarters.
 *
 * `facing` 2 is square on, 1 is turned a little, and the features slide to the
 * near side by that much - which is the whole difference between a face and a
 * mask painted on a ball. `open` is how far the mouth is, driven by the beat,
 * because a crowd sings the track back at the DJ. */
static void crowd_face(Cv *c, double hx, double hy, double hr, int facing,
                       const CrowdFit *f, int alpha, double open,
                       const Rig *rig)
{
    const Kit *k = &f->k;
    double a   = (double)alpha / 255.0;
    double sxo = facing >= 2 ? 0.0 : hr * 0.26;
    int    sR  = k->skin_r, sG = k->skin_g, sB = k->skin_b;
    int    i;

    /* ---- hair that lives behind the head ---- */
    if (f->cut == 5) {                          /* curls, a cloud around it */
        cv_ell(c, hx, hy - hr * 0.06, hr * 1.24, hr * 1.18,
               k->hair_r, k->hair_g, k->hair_b, alpha);
        for (i = 0; i < 7; i++) {
            double an = (double)i * 0.8976 + hx * 0.017;

            cv_ball(c, hx + fcosd(an) * hr * 1.00,
                    hy - hr * 0.10 + fsind(an) * hr * 0.94, hr * 0.42,
                    k->hair_r, k->hair_g, k->hair_b,
                    clampi(k->hair_r / 2, 0, 255), clampi(k->hair_g / 2, 0, 255),
                    clampi(k->hair_b / 2, 0, 255));
        }
    } else if (f->cut == 3) {                   /* long, falling past the jaw */
        cv_ell(c, hx - hr * 0.92, hy + hr * 0.42, hr * 0.40, hr * 1.14,
               k->hair_r, k->hair_g, k->hair_b, alpha);
        cv_ell(c, hx + hr * 0.92, hy + hr * 0.42, hr * 0.40, hr * 1.14,
               k->hair_r, k->hair_g, k->hair_b, alpha);
    } else if (f->cut == 1) {                   /* a bun, high and behind */
        cv_ball(c, hx, hy - hr * 1.02, hr * 0.40,
                k->hair_r, k->hair_g, k->hair_b,
                clampi(k->hair_r + 24, 0, 255), clampi(k->hair_g + 22, 0, 255),
                clampi(k->hair_b + 26, 0, 255));
    }

    /* ---- the skull, then the jaw under it ---- */
    cv_ball(c, hx, hy, hr, (int)((double)sR * 0.90), (int)((double)sG * 0.90),
            (int)((double)sB * 0.90), clampi(sR + 16, 0, 255),
            clampi(sG + 16, 0, 255), clampi(sB + 18, 0, 255));
    cv_ell(c, hx, hy + hr * 0.34, hr * 0.84, hr * 0.68,
           clampi(sR - 16, 0, 255), clampi(sG - 18, 0, 255),
           clampi(sB - 14, 0, 255), alpha);
    cv_ell_soft(c, hx, hy + hr * 0.82, hr * 0.66, hr * 0.24,
                18, 10, 14, (int)(74 * a));
    /* the cheekbones catch the wall, the eye sockets do not */
    for (i = 0; i < 2; i++) {
        double s2 = i ? 1.0 : -1.0;

        cv_ell_soft(c, hx + sxo + s2 * hr * 0.44, hy + hr * 0.06,
                    hr * 0.26, hr * 0.24,
                    clampi(sR + 26, 0, 255), clampi(sG + 22, 0, 255),
                    clampi(sB + 24, 0, 255), (int)(46 * a));
    }

    /* ---- hair in front: a cap of it over the brow, and a hairline ---- */
    if (f->cut == 2) {                          /* cap: crown and brim */
        cv_ell(c, hx, hy - hr * 0.60, hr * 1.02, hr * 0.62,
               k->hair_r, k->hair_g, k->hair_b, alpha);
        cv_ell(c, hx + sxo + hr * 0.10, hy - hr * 0.26, hr * 1.06, hr * 0.16,
               clampi(k->hair_r - 12, 0, 255), clampi(k->hair_g - 10, 0, 255),
               clampi(k->hair_b - 6, 0, 255), alpha);
        cv_line(c, hx - hr * 1.00, hy - hr * 0.20, hx + hr * 1.14, hy - hr * 0.20,
                hr * 0.10, 8, 9, 16, (int)(150 * a));
    } else if (f->cut == 4) {                   /* beanie: crown and fold */
        cv_ell(c, hx, hy - hr * 0.56, hr * 1.06, hr * 0.72,
               44, 46, 62, alpha);
        cv_ell(c, hx, hy - hr * 0.36, hr * 1.08, hr * 0.20, 66, 70, 90, alpha);
        cv_line(c, hx - hr * 1.04, hy - hr * 0.44, hx + hr * 1.04, hy - hr * 0.44,
                hr * 0.07, 96, 102, 126, (int)(120 * a));
    } else {
        cv_ell(c, hx, hy - hr * 0.52, hr * 1.00, hr * 0.60,
               k->hair_r, k->hair_g, k->hair_b, alpha);
        cv_line(c, hx - hr * 0.88, hy - hr * 0.22, hx + hr * 0.88, hy - hr * 0.22,
                hr * 0.07, clampi(k->hair_r - 24, 0, 255),
                clampi(k->hair_g - 22, 0, 255), clampi(k->hair_b - 20, 0, 255),
                (int)(120 * a));
    }

    /* ---- brows, eyes, one catchlight each ----
     * The socket carries the eye at this size, not the iris: a single dark
     * almond two pixels across disappears, so the sockets are a wide shadow
     * with a heavy lid line over it, and the catchlight is one dim pixel. */
    cv_ell_soft(c, hx + sxo, hy - hr * 0.07, hr * 0.70, hr * 0.20,
                12, 6, 10, (int)(92 * a));
    for (i = 0; i < 2; i++) {
        double s2 = i ? 1.0 : -1.0;
        double ex = hx + sxo + s2 * hr * 0.34;

        cv_line(c, ex - hr * 0.22, hy - hr * 0.30, ex + hr * 0.22, hy - hr * 0.34,
                hr * 0.17, clampi(k->hair_r / 2, 0, 255),
                clampi(k->hair_g / 2, 0, 255), clampi(k->hair_b / 2, 0, 255),
                (int)(220 * a));
        cv_ell(c, ex, hy - hr * 0.02, hr * 0.19, hr * 0.15, 20, 14, 18, alpha);
        /* the upper lid sits over the eye, and the lower lid catches a line of
         * light. A one-pixel catchlight at this size is a white speck that
         * reads as a glowing eye; a lit lower lid reads as an eye. */
        cv_line(c, ex - hr * 0.19, hy - hr * 0.10, ex + hr * 0.19, hy - hr * 0.11,
                hr * 0.08, 8, 5, 9, (int)(230 * a));
        cv_line(c, ex - hr * 0.15, hy + hr * 0.09, ex + hr * 0.15, hy + hr * 0.08,
                hr * 0.05, clampi(sR + 26, 0, 255), clampi(sG + 24, 0, 255),
                clampi(sB + 24, 0, 255), (int)(130 * a));
    }

    /* ---- nose: a lit ridge, a shadow down one side, two nostrils ---- */
    cv_line(c, hx + sxo - hr * 0.07, hy - hr * 0.10, hx + sxo - hr * 0.05,
            hy + hr * 0.20, hr * 0.09,
            clampi(sR + 12, 0, 255), clampi(sG + 10, 0, 255),
            clampi(sB + 12, 0, 255), (int)(110 * a));
    cv_line(c, hx + sxo + hr * 0.07, hy - hr * 0.08, hx + sxo + hr * 0.09,
            hy + hr * 0.22, hr * 0.10,
            clampi(sR - 56, 0, 255), clampi(sG - 52, 0, 255),
            clampi(sB - 44, 0, 255), (int)(150 * a));
    cv_ell_soft(c, hx + sxo + hr * 0.03, hy + hr * 0.20, hr * 0.15, hr * 0.09,
                clampi(sR + 26, 0, 255), clampi(sG + 22, 0, 255),
                clampi(sB + 22, 0, 255), (int)(76 * a));
    for (i = 0; i < 2; i++) {
        double s2 = i ? 1.0 : -1.0;

        cv_set(c, (int)(hx + sxo + s2 * hr * 0.15),
               (int)(hy + hr * 0.29), clampi(sR - 86, 0, 255),
               clampi(sG - 76, 0, 255), clampi(sB - 64, 0, 255),
               (int)(190 * a));
    }

    /* ---- the mouth: closed is a line, open is the track ---- */
    {
        double mh = hr * (0.045 + 0.150 * open);
        double my = hy + hr * 0.48;

        cv_ell(c, hx + sxo, my, hr * (0.24 + 0.06 * open), mh,
               46, 18, 24, alpha);
        cv_line(c, hx + sxo - hr * 0.16, my + mh * 0.96,
                hx + sxo + hr * 0.16, my + mh * 0.96, hr * 0.07,
                clampi(sR - 20, 0, 255), clampi(sG - 34, 0, 255),
                clampi(sB - 24, 0, 255), (int)(120 * a));
        if (open > 0.34) {
            cv_line(c, hx + sxo - hr * 0.15, my - mh * 0.72,
                    hx + sxo + hr * 0.15, my - mh * 0.72, hr * 0.07,
                    150, 132, 142, (int)(170 * a));
            cv_ell(c, hx + sxo, my + mh * 0.42, hr * 0.13, mh * 0.30,
                   150, 60, 66, (int)(150 * a));
        }
        cv_line(c, hx + sxo - hr * 0.19, my - mh * 1.02,
                hx + sxo + hr * 0.19, my - mh * 1.04, hr * 0.05,
                clampi(sR - 58, 0, 255), clampi(sG - 62, 0, 255),
                clampi(sB - 50, 0, 255), (int)(130 * a));
    }

    /* ---- the wall's rim down the far edge of the face ---- */
    cv_line(c, hx - hr * 0.92, hy - hr * 0.30, hx - hr * 0.80, hy + hr * 0.52,
            hr * 0.13, rig->fr, rig->fg, rig->fb, (int)(70 * a));

    /* ---- what they are wearing on their head ---- */
    if (f->acc == 2) {                          /* shades: a dark bar, a glint */
        cv_line(c, hx + sxo - hr * 0.58, hy - hr * 0.06,
                hx + sxo + hr * 0.58, hy - hr * 0.09, hr * 0.20,
                10, 11, 18, (int)(235 * a));
        cv_line(c, hx + sxo - hr * 0.50, hy - hr * 0.13,
                hx + sxo - hr * 0.16, hy - hr * 0.14, hr * 0.05,
                230, 238, 255, (int)(150 * a));
        cv_set(c, (int)(hx + sxo + hr * 0.34), (int)(hy - hr * 0.13),
               255, 255, 255, (int)(180 * a));
    }
    if (f->acc == 4) {                          /* a chain, catching the wall */
        cv_line(c, hx - hr * 0.40, hy + hr * 0.96, hx, hy + hr * 1.24,
                hr * 0.07, 214, 220, 240, (int)(150 * a));
        cv_line(c, hx, hy + hr * 1.24, hx + hr * 0.40, hy + hr * 0.96,
                hr * 0.07, 214, 220, 240, (int)(150 * a));
        cv_set(c, (int)hx, (int)(hy + hr * 1.26), 255, 250, 226,
               (int)(210 * a));
    }
}

/* One person in the pit, drawn the way the dancers are drawn.
 *
 * Same kit, same idea: a lit capsule per bone, a torso that narrows at the
 * waist, a cuff at each wrist, shoes instead of pointed ankles. Everyone faces
 * the stage, but not everyone faces it squarely - a third of the pit has
 * turned to a friend, or turned right round to dance at the camera, and those
 * are the ones with a face on them.
 *
 * They are still dark. That is the point: the stage is the light in this room,
 * and a crowd lit like the stage reads as cardboard cut-outs. What sells them
 * at this size is the rim each one picks up from the panel behind them. */
static void crowd_figure(Cv *c, const Pose *p, const Rig *rig, const CrowdFit *f,
                         int alpha, double phase, int facing, int detail)
{
    const Kit *k = &f->k;
    double t = p->th;
    double shy = p->cy - t * 0.95;
    double bp = 0.5 + 0.5 * fsind(phase * 1.3);
    Rig    skin = art_mat(rig, 0.30);
    Rig    cloth = art_mat(rig, 0.18);
    int    bare = (f->look == 1 || f->look == 2);
    /* bare limbs in a dark room are not the same value as a lit face: at full
     * skin they read as white stockings under a black shirt, which is what
     * made half the pit look like it was wearing luminous leggings */
    int    lr = (int)((double)k->skin_r * 0.40);
    int    lg = (int)((double)k->skin_g * 0.37);
    int    lb = (int)((double)k->skin_b * 0.36);
    int    i;

    /* ---- legs: thigh, knee, calf, then a shoe with a sole ---- */
    for (i = 1; i >= 0; i--) {
        double hipx = p->px + (i ? 1.0 : -1.0) * p->hw * 0.55;

        art_limb(c, hipx, p->py - t * 0.12, p->kx[i], p->ky[i],
                 t * 0.88, t * 0.56, f->leg_r, f->leg_g, f->leg_b,
                 alpha, &cloth);
        cv_ball(c, p->kx[i], p->ky[i], t * 0.38, f->leg_r, f->leg_g, f->leg_b,
                clampi(f->leg_r + 16, 0, 255), clampi(f->leg_g + 14, 0, 255),
                clampi(f->leg_b + 20, 0, 255));
        /* a bare calf under shorts is two lines of variety for the price of
         * the material already being here */
        art_limb(c, p->kx[i], p->ky[i], p->ax[i], p->ay[i],
                 t * 0.58, t * 0.27,
                 bare ? lr : f->leg_r, bare ? lg : f->leg_g,
                 bare ? lb : f->leg_b, alpha, &cloth);
        art_limb(c, p->ax[i] - t * 0.12, p->ay[i] - t * 0.14,
                 p->ax[i] + t * 0.52, p->ay[i] - t * 0.02,
                 t * 0.30, t * 0.21, k->shoe_r, k->shoe_g, k->shoe_b, alpha,
                 &cloth);
        if (!detail)
            cv_line(c, p->ax[i] - t * 0.14, p->ay[i] + t * 0.03,
                    p->ax[i] + t * 0.56, p->ay[i] + t * 0.05, t * 0.09,
                    196, 202, 218, (int)((double)alpha * 0.42));
    }

    /* ---- the body ---- */
    art_col_shade(c, shy, p->py + t * 0.32, p->cx, p->px,
                  p->sw * 1.04, p->hw * 1.00, p->hw * 1.10,
                  k->top_r, k->top_g, k->top_b, alpha, &cloth);

    if (bare && !detail) {
        /* shoulders out, and a strap over each of them */
        for (i = 0; i < 2; i++) {
            double s2 = i ? 1.0 : -1.0;

            cv_line(c, p->cx + s2 * p->sw * 0.98, shy + t * 0.06,
                    p->cx + s2 * p->sw * 0.52, shy + t * 0.44,
                    t * 0.42, k->skin_r, k->skin_g, k->skin_b, alpha);
            cv_line(c, p->cx + s2 * p->sw * 0.80, shy + t * 0.14,
                    p->cx + s2 * p->sw * 0.56, shy + t * 0.38,
                    t * 0.16, k->skin_r, k->skin_g, k->skin_b, alpha);
        }
    }
    if (f->look == 2 && !detail) {
        /* a cropped top: a hem across the ribs, then the strip of midriff under
         * it. Drawn narrow and dark - the wide bright band this used to be read
         * as a belt, not as skin. */
        cv_ell(c, p->cx, p->py + t * 0.04, p->hw * 0.84, t * 0.20,
               lr / 2, lg / 2, lb / 2, alpha);
        cv_line(c, p->cx - p->hw * 1.02, p->py - t * 0.30,
                p->cx + p->hw * 1.02, p->py - t * 0.30, t * 0.16,
                10, 11, 20, (int)((double)alpha * 0.62));
        cv_set(c, (int)p->cx, (int)(p->py - t * 0.04),
               clampi(lr - 26, 0, 255), clampi(lg - 24, 0, 255),
               clampi(lb - 20, 0, 255), (int)((double)alpha * 0.75));
    }
    if (f->look == 3 && !detail) {
        /* hoodie: the hood rolled at the neck, two strings, a big pocket */
        cv_ell(c, p->cx, shy + t * 0.04, p->sw * 0.80, t * 0.34,
               34, 36, 56, alpha);
        for (i = 0; i < 2; i++) {
            double s2 = i ? 1.0 : -1.0;

            cv_line(c, p->cx + s2 * p->sw * 0.24, shy + t * 0.20,
                    p->cx + s2 * p->sw * 0.30, shy + t * 1.10, t * 0.09,
                    206, 212, 232, (int)((double)alpha * 0.55));
        }
        cv_line(c, p->cx - p->hw * 0.86, p->py - t * 0.20,
                p->cx + p->hw * 0.86, p->py - t * 0.20, t * 0.10,
                8, 9, 16, (int)((double)alpha * 0.45));
    }
    if (f->look == 4 && !detail) {
        /* jersey: a shoulder stripe and a number panel on the back */
        cv_line(c, p->cx - p->sw * 1.00, shy + t * 0.34,
                p->cx + p->sw * 1.00, shy + t * 0.34, t * 0.22,
                f->alt_r, f->alt_g, f->alt_b, alpha);
        cv_rect(c, (int)(p->cx - p->sw * 0.40), (int)(shy + t * 0.80),
                (int)(p->sw * 0.80), (int)(t * 0.90),
                f->alt_r, f->alt_g, f->alt_b, (int)((double)alpha * 0.72));
        cv_rect(c, (int)(p->cx - p->sw * 0.10), (int)(shy + t * 0.94),
                (int)(p->sw * 0.20), (int)(t * 0.58),
                16, 18, 26, (int)((double)alpha * 0.55));
    }
    if (f->look == 5 && !detail) {
        /* open shirt over a tee: two panels and the gap between them */
        for (i = 0; i < 2; i++) {
            double s2 = i ? 1.0 : -1.0;

            cv_line(c, p->cx + s2 * p->sw * 0.90, shy + t * 0.10,
                    p->cx + s2 * p->hw * 0.70, p->py + t * 0.20,
                    t * 0.46, f->alt_r, f->alt_g, f->alt_b, alpha);
        }
        cv_line(c, p->cx - p->sw * 0.14, shy + t * 0.20,
                p->cx - p->hw * 0.10, p->py + t * 0.10, t * 0.08,
                8, 9, 16, (int)((double)alpha * 0.50));
    }

    /* the collar bunched at the neck, and a spine: the two lines that make a
     * back read as a back (a front gets a throat instead) */
    if (facing >= 1) {
        cv_ell_soft(c, p->cx, shy + t * 0.14, p->sw * 0.40, t * 0.24,
                    12, 10, 16, (int)((double)alpha * 0.45));
    } else {
        cv_ell_soft(c, p->cx, shy + t * 0.10, p->sw * 0.44, t * 0.30,
                    clampi(k->top_r / 2, 0, 255),
                    clampi(k->top_g / 2, 0, 255),
                    clampi(k->top_b / 2, 0, 255),
                    (int)((double)alpha * 0.55));
        if (!detail)
            cv_line(c, p->cx, shy + t * 0.52, p->px, p->py + t * 0.06,
                    t * 0.070, 8, 9, 18, (int)((double)alpha * 0.50));
    }

    /* ---- arms, far one first ---- */
    for (i = 1; i >= 0; i--) {
        double sx = p->cx + (i ? 1.0 : -1.0) * p->sw * 0.86;
        double c0x, c0y, c1x, c1y;

        art_limb(c, sx, shy + t * 0.06, p->ex[i], p->ey[i],
                 t * 0.40, t * 0.30,
                 bare ? lr : k->top_r, bare ? lg : k->top_g,
                 bare ? lb : k->top_b, alpha, &skin);
        cv_ball(c, p->ex[i], p->ey[i], t * 0.23,
                bare ? lr : k->top_r, bare ? lg : k->top_g,
                bare ? lb : k->top_b,
                clampi(k->skin_r + 12, 0, 255), clampi(k->skin_g + 14, 0, 255),
                clampi(k->skin_b + 16, 0, 255));
        art_limb(c, p->ex[i], p->ey[i], p->wx[i], p->wy[i],
                 t * 0.30, t * 0.22, k->skin_r, k->skin_g, k->skin_b, alpha,
                 &skin);
        /* a cuff at the wrist: one band stops an arm being a tube */
        lerp2(p->ex[i], p->ey[i], p->wx[i], p->wy[i], 0.76, &c0x, &c0y);
        lerp2(p->ex[i], p->ey[i], p->wx[i], p->wy[i], 0.90, &c1x, &c1y);
        if (!detail)
            art_limb(c, c0x, c0y, c1x, c1y, t * 0.245, t * 0.225,
                     k->top_r, k->top_g, k->top_b, alpha, &cloth);
        /* a band on the near wrist once in a while */
        if (f->acc == 3 && i == 0 && !detail) {
            cv_line(c, c0x, c0y, c1x, c1y, t * 0.30,
                    f->alt_r, f->alt_g, f->alt_b, (int)((double)alpha * 0.9));
        }
        /* the hand: a palm and a thumb, which at this size is the whole hand */
        cv_ball(c, p->wx[i], p->wy[i], t * 0.22, k->skin_r, k->skin_g, k->skin_b,
                clampi(k->skin_r + 18, 0, 255), clampi(k->skin_g + 18, 0, 255),
                clampi(k->skin_b + 20, 0, 255));
        if (!detail)
            cv_ball(c, p->wx[i] + (i ? -1.0 : 1.0) * t * 0.15,
                    p->wy[i] + t * 0.10, t * 0.10,
                    k->skin_r, k->skin_g, k->skin_b,
                    clampi(k->skin_r + 8, 0, 255),
                    clampi(k->skin_g + 8, 0, 255),
                    clampi(k->skin_b + 10, 0, 255));
    }

    /* ---- neck, then the head ---- */
    art_limb(c, p->nx, shy + t * 0.10, p->hx, p->hy + p->hr * 0.56,
             t * 0.26, t * 0.30, k->skin_r, k->skin_g, k->skin_b, alpha, &skin);

    if (facing >= 1) {
        crowd_face(c, p->hx, p->hy, p->hr, facing, f, alpha, bp, rig);
    } else {
        cv_ball(c, p->hx, p->hy, p->hr, k->skin_r, k->skin_g, k->skin_b,
                clampi(k->skin_r + 24, 0, 255), clampi(k->skin_g + 26, 0, 255),
                clampi(k->skin_b + 28, 0, 255));
        /* hair covers nearly all of a head seen from behind, so it is the shell
         * that carries the shape; the skull underneath only shows at the nape */
        cv_ell(c, p->hx, p->hy - p->hr * 0.04, p->hr * 1.05, p->hr * 1.05,
               k->hair_r, k->hair_g, k->hair_b, alpha);
        cv_ell_soft(c, p->hx - p->hr * 0.30, p->hy - p->hr * 0.54,
                    p->hr * 0.46, p->hr * 0.24, 150, 186, 230,
                    (int)((double)alpha * 0.20));
        for (i = 0; i < (detail ? 0 : 2); i++)
            cv_ell(c, p->hx + (i ? p->hr * 0.94 : -p->hr * 0.94),
                   p->hy + p->hr * 0.14, p->hr * 0.11, p->hr * 0.17,
                   clampi(k->skin_r - 26, 0, 255), clampi(k->skin_g - 24, 0, 255),
                   clampi(k->skin_b - 20, 0, 255), alpha);

        /* ---- the cut makes the person ---- */
        switch (f->cut) {
        case 0:                                 /* short, close to the skull */
            cv_ell(c, p->hx, p->hy - p->hr * 0.34, p->hr * 1.00, p->hr * 0.80,
                   clampi(k->hair_r - 10, 0, 255), clampi(k->hair_g - 10, 0, 255),
                   clampi(k->hair_b - 8, 0, 255), alpha);
            break;
        case 1:                                 /* bun */
            cv_ell(c, p->hx, p->hy - p->hr * 1.04, p->hr * 0.38, p->hr * 0.34,
                   k->hair_r, k->hair_g, k->hair_b, alpha);
            break;
        case 2:                                 /* cap: flat crown, dark band */
            cv_ell(c, p->hx, p->hy - p->hr * 0.38, p->hr * 1.00, p->hr * 0.76,
                   k->top_r, k->top_g, k->top_b, alpha);
            if (!detail)
                cv_line(c, p->hx - p->hr * 0.98, p->hy - p->hr * 0.06,
                        p->hx + p->hr * 0.98, p->hy - p->hr * 0.06,
                        p->hr * 0.24, 8, 9, 16, (int)((double)alpha * 0.55));
            break;
        case 3:                                 /* long, past the shoulders */
            cv_ell(c, p->hx - p->hr * 0.78, p->hy + p->hr * 0.62,
                   p->hr * 0.32, p->hr * 0.88,
                   k->hair_r, k->hair_g, k->hair_b, alpha);
            cv_ell(c, p->hx + p->hr * 0.78, p->hy + p->hr * 0.62,
                   p->hr * 0.32, p->hr * 0.88,
                   k->hair_r, k->hair_g, k->hair_b, alpha);
            break;
        case 4:                                 /* beanie with a fold */
            cv_ell(c, p->hx, p->hy - p->hr * 0.44, p->hr * 1.02, p->hr * 0.82,
                   44, 46, 62, alpha);
            cv_ell(c, p->hx, p->hy - p->hr * 0.06, p->hr * 1.04, p->hr * 0.22,
                   66, 70, 90, alpha);
            break;
        default:                                /* curls */
            cv_ell(c, p->hx, p->hy - p->hr * 0.10, p->hr * 1.22, p->hr * 1.14,
                   k->hair_r, k->hair_g, k->hair_b, alpha);
            if (!detail)
                cv_ball(c, p->hx, p->hy - p->hr * 0.76, p->hr * 0.52,
                        k->hair_r, k->hair_g, k->hair_b,
                        clampi(k->hair_r / 2, 0, 255),
                        clampi(k->hair_g / 2, 0, 255),
                        clampi(k->hair_b / 2, 0, 255));
            break;
        }
        /* headphones, worn round the neck where you see the band from behind */
        if (f->acc == 1 && !detail) {
            cv_line(c, p->hx - p->hr * 0.96, p->hy + p->hr * 1.16,
                    p->hx + p->hr * 0.96, p->hy + p->hr * 1.16, p->hr * 0.20,
                    20, 22, 32, alpha);
            for (i = 0; i < 2; i++)
                cv_ball(c, p->hx + (i ? p->hr * 1.00 : -p->hr * 1.00),
                        p->hy + p->hr * 1.14, p->hr * 0.30, 34, 36, 50,
                        120, 132, 170);
        }
    }

    /* ---- the light they are standing in ----
     * Three passes, the same three every lit figure in a game gets: a shadow
     * crescent on the side away from the room, a coloured rim from the nearest
     * beam, and an ambient wash on the open side. The rim used to be a fixed
     * wall tint on two short shoulder edges; it now takes the colour of the
     * laser over that person's head, which is what makes a pit read as lit by a
     * rig rather than by a rectangle behind it. */
    cv_ell_soft(c, p->cx + p->sw * 0.44, shy + t * 0.66, p->sw * 0.74,
                t * 1.10, 3, 4, 11, (int)((double)alpha * 0.30));
    if (rv_rim_a > 0.01) {
        int ar = (int)((double)alpha * 0.42 * rv_rim_a);

        /* one edge only, on the side the pit's light comes from: a rim on both
         * shoulders is an outline, and an outline is what a sticker has */
        cv_line(c, p->cx - p->sw * 0.94, shy + t * 0.02,
                p->cx - p->sw * 0.58, shy + t * 0.22,
                t * 0.075, rv_rim_r, rv_rim_g, rv_rim_b, ar);
        cv_line(c, p->cx - p->sw * 0.90, shy + t * 0.60,
                p->cx - p->sw * 0.52, shy + t * 0.46,
                t * 0.055, rv_rim_r, rv_rim_g, rv_rim_b, ar / 2);
        if (!detail)
            cv_ell_soft(c, p->hx - p->hr * 0.58, p->hy - p->hr * 0.30,
                        p->hr * 0.46, p->hr * 0.40, rv_rim_r, rv_rim_g,
                        rv_rim_b, (int)((double)alpha * 0.20 * rv_rim_a));
    }
}

/* One person in the pit.
 *
 * Twelve moves, dealt out across the ranks so no two neighbours are doing the
 * same thing: both arms up and pumping, one arm up, a phone held high, arms out
 * and waving, clapping overhead, a fist punched up, a hand on each neighbour's
 * shoulder, a drink raised, head down and hair flying, a jump with the knees
 * tucked, both hands pushing the air at the decks, and arms folded with the
 * shoulders going.
 *
 * The whole pit moves as one body rather than forty private sine waves. A slow
 * wave crosses it sideways (the lean), the downbeat arrives a fraction later at
 * each end of the room (the surge), and the loud parts of the track lift
 * everyone on it. A room that breathes together is a club; a room on its own
 * phase is a screensaver. */
static void rave_crowd_person(Cv *c, const UiModel *m, double cx, double ground,
                              double H, double phase, int alpha, int variant,
                              int facing, const Rig *rig, const Kit *base,
                              int detail, int slot)
{
    Pose     p;
    CrowdFit f;
    double   t    = m->elapsed_sec;
    double   w    = c->w > 0 ? (double)c->w : 1.0;
    double   u    = cx / w;
    double   lv   = (double)m->vis_level;
    double   en   = 0.32 + 0.68 * lv;             /* how much anyone moves */
    double   bp   = beat_shift(m, 0.035 * u);     /* the surge crosses the pit */
    double   pit  = fsind(t * 1.85 - u * 5.6);    /* one wave, side to side */
    double   sway = fsind(phase * 0.62) * H * 0.030 + pit * H * 0.028 * en;
    double   lean = pit * H * 0.022 * en;
        double air  = (variant == 9) ? 0.55 * bp + 0.45 * fabs(fsind(t * 1.9 + u * 2.0))
                                   : (variant == 10 ? 0.35 * bp : 0.0);
    /* the low end lifts the whole pit: a bass hit is everyone off the floor,
     * not just the one dancer whose move happens to be a jump */
    double bass = (band_at(m, 0.02) + band_at(m, 0.06)) * 0.5;
    double hop  = (0.24 * fabs(sin(phase * 0.8)) + 0.76 * bp) * H * 0.080 * en
                  * (0.70 + 0.70 * bass)
                  + air * H * 0.070;
    double   px   = cx + sway;
    double   wave = fsind(t * 2.3 + u * 6.0);     /* the ripple over raised arms */
    int      hs   = (int)(fmod(phase * 7.31, 1.0) * 1024.0);

    pose_default(&p, px, ground - hop, H);
    /* a crowd head is a touch smaller than a dancer's: at this size the full
     * dance proportion reads as a bobble-head */
    p.hr = H * 0.064;

    /* ---- the build -------------------------------------------------------
     * Nobody in a real pit is the same width, and a row of identical
     * silhouettes is the thing that reads as a crowd of clones. `build` widens
     * the shoulders and hips, `tall` changes the head and the carriage, and
     * both come from the same hash the wardrobe does, so they are stable for a
     * person all night. */
    {
        double build = 0.90 + 0.22 * (double)((hs >> 9) & 7) / 7.0;
        double tall  = 0.97 + 0.05 * (double)((hs >> 6) & 3) / 3.0;

        p.sw *= build;
        p.hw *= build * 1.02;
        p.th *= 0.94 + 0.12 * build;
        p.hr *= tall * (0.96 + 0.08 * build);
    }

    /* ---- wardrobe: six tops, six skins, six cuts, a few accessories ---- */
    {
        static const int tops[6][3] = {
            { 34, 38, 62 }, { 66, 32, 46 }, { 26, 52, 56 },
            { 54, 46, 30 }, { 28, 30, 46 }, { 44, 26, 38 }
        };
        static const int alts[6][3] = {
            { 176, 196, 255 }, { 255, 126, 158 }, { 120, 232, 220 },
            { 244, 206, 118 }, { 150, 160, 240 }, { 226, 146, 210 }
        };
        int ti = (hs >> 2) % 6;

        f.k    = *base;
        f.look = (hs + variant * 3) % 6;
        f.cut  = (hs >> 3) % 6;
        f.acc  = (hs >> 6) % 8;      /* 0..7 so shades and phones stay rare */
        crowd_skin((hs >> 1) % 6, &f.k.skin_r, &f.k.skin_g, &f.k.skin_b);
        f.k.top_r = tops[ti][0];
        f.k.top_g = tops[ti][1];
        f.k.top_b = tops[ti][2];
        f.alt_r   = alts[(ti + 2) % 6][0];
        f.alt_g   = alts[(ti + 2) % 6][1];
        f.alt_b   = alts[(ti + 2) % 6][2];
        f.leg_r   = 16 + (hs % 3) * 5;
        f.leg_g   = 16 + ((hs >> 2) % 3) * 5;
        f.leg_b   = 26 + ((hs >> 4) % 4) * 6;
        f.k.hair_r = clampi(base->hair_r + (hs % 40) - 10, 0, 255);
        f.k.hair_g = clampi(base->hair_g + ((hs >> 3) % 32) - 8, 0, 255);
        f.k.hair_b = clampi(base->hair_b + ((hs >> 5) % 44) - 10, 0, 255);
    }

    /* the head nods on the beat, and the whole body leans with the pit */
    p.cx += lean * 0.45;
    p.nx += lean * 0.70;
    p.hx += lean;
    p.hy += bp * H * 0.016 - fsind(phase * 0.8) * H * 0.004;

    switch (variant) {
    case 0:                                    /* both arms up, pumping */
    {
        double lift = bp * H * 0.050 + wave * H * 0.012;

        pose_arms(&p,
                  px - H * 0.195, p.cy - H * 0.020,
                  px - H * 0.185 + lean, p.hy - H * 0.245 - lift,
                  px + H * 0.195, p.cy - H * 0.020,
                  px + H * 0.185 + lean, p.hy - H * 0.300 - lift);
        break;
    }
    case 1:                                    /* one arm up, pointing */
        pose_arms(&p,
                  px - H * 0.190, p.cy - H * 0.010,
                  px - H * 0.176, p.hy - H * 0.286 - bp * H * 0.044 + lean,
                  px + H * 0.150, p.cy + H * 0.140,
                  px + H * 0.120, p.cy + H * 0.330 + fsind(phase) * H * 0.020);
        break;
    case 2:                                    /* phone held high */
        pose_arms(&p,
                  px - H * 0.155, p.cy + H * 0.100,
                  px - H * 0.125, p.cy + H * 0.260,
                  px + H * 0.160, p.cy - H * 0.060,
                  px + H * 0.120 + lean, p.hy - H * 0.320
                                     + fsind(phase * 1.7) * H * 0.030);
        break;
    case 3:                                    /* arms out, waving */
    {
        double wv = fsind(phase * 1.6) * H * 0.050 + wave * H * 0.016;

        pose_arms(&p,
                  px - H * 0.235, p.cy + H * 0.020,
                  px - H * 0.330, p.cy - H * 0.090 + wv,
                  px + H * 0.235, p.cy + H * 0.020,
                  px + H * 0.330, p.cy - H * 0.110 - wv);
        break;
    }
    case 4:                                    /* clapping, overhead */
    {
        /* hands meet just above the head, elbows stay near the shoulders: the
         * old arch made a triangle over the skull that read as a roof */
        double gap = H * (0.008 + 0.026 * (1.0 - bp));
        double up  = H * 0.105 + bp * H * 0.030;

        pose_arms(&p,
                  px - H * 0.185, p.cy - H * 0.045,
                  px - gap, p.hy - up,
                  px + H * 0.185, p.cy - H * 0.045,
                  px + gap, p.hy - up);
        break;
    }
    case 5:                                    /* fist punch, up on the beat */
        pose_arms(&p,
                  px - H * 0.196, p.cy - H * 0.030,
                  px - H * 0.150 + lean, p.hy - H * 0.330 - bp * H * 0.080,
                  px + H * 0.150, p.cy + H * 0.150,
                  px + H * 0.110, p.cy + H * 0.055);
        break;
    case 6:                                    /* hand on each neighbour */
        pose_arms(&p,
                  px - H * 0.240, p.cy + H * 0.010,
                  px - H * 0.400, p.cy - H * 0.080 + wave * H * 0.030,
                  px + H * 0.240, p.cy + H * 0.010,
                  px + H * 0.400, p.cy - H * 0.070 - wave * H * 0.030);
        break;
    case 7:                                    /* a drink, raised */
        pose_arms(&p,
                  px - H * 0.170, p.cy + H * 0.120,
                  px - H * 0.140, p.cy + H * 0.300,
                  px + H * 0.150, p.cy - H * 0.070,
                  px + H * 0.108 + lean, p.hy - H * 0.300 - bp * H * 0.030);
        break;
    case 8:                                    /* head down, hair flying */
        p.hy += H * 0.062;
        p.hx += H * 0.030;
        pose_arms(&p,
                  px - H * 0.200, p.cy + H * 0.060,
                  px - H * 0.170, p.cy + H * 0.290,
                  px + H * 0.200, p.cy + H * 0.060,
                  px + H * 0.170, p.cy + H * 0.290);
        break;
    case 9:                                    /* up, knees tucked */
        pose_arms(&p,
                  px - H * 0.200, p.cy - H * 0.080,
                  px - H * 0.250, p.hy - H * 0.200 + lean,
                  px + H * 0.200, p.cy - H * 0.080,
                  px + H * 0.250, p.hy - H * 0.180 + lean);
        break;
    case 10:                                   /* pushing the air at the decks */
        pose_arms(&p,
                  px - H * 0.150, p.cy - H * 0.110,
                  px - H * 0.100 + lean, p.cy - H * 0.240 - bp * H * 0.050,
                  px + H * 0.150, p.cy - H * 0.110,
                  px + H * 0.100 + lean, p.cy - H * 0.250 - bp * H * 0.050);
        break;
    default:                                   /* arms folded, shoulders going */
    {
        double sh = bp * H * 0.028;

        pose_arms(&p,
                  px - H * 0.185, p.cy + H * 0.030 + sh,
                  px + H * 0.075, p.cy + H * 0.075 + sh,
                  px + H * 0.185, p.cy + H * 0.030 + sh,
                  px - H * 0.075, p.cy + H * 0.105 + sh);
        break;
    }
    }

    if (variant == 9) {
        pose_legs(&p,
                  px - H * 0.105, ground - hop - H * 0.330,
                  px - H * 0.130, ground - hop - H * 0.120,
                  px + H * 0.105, ground - hop - H * 0.330,
                  px + H * 0.130, ground - hop - H * 0.120);
    } else if (variant == 8) {
        pose_legs(&p,
                  px - H * 0.086, ground - hop - H * 0.245,
                  px - H * 0.128 - sway * 0.30, ground - hop,
                  px + H * 0.086, ground - hop - H * 0.245,
                  px + H * 0.128 - sway * 0.30, ground - hop);
    } else {
        pose_legs(&p,
                  px - H * 0.072, ground - hop - H * (0.250 + 0.020 * bp),
                  px - H * 0.084 - sway * 0.30, ground - hop,
                  px + H * 0.072, ground - hop - H * (0.250 + 0.020 * bp),
                  px + H * 0.084 - sway * 0.30, ground - hop);
    }

    /* the panel's haze behind them, so nobody is pasted onto the floor */
    cv_soft(c, px, p.cy - H * 0.10, H * 0.34, rig->fr, rig->fg, rig->fb,
            (int)((10.0 + 22.0 * lv) * (double)alpha / 255.0));

    /* the arms ease toward whatever the current move asks for, which is what
     * keeps a change of move from snapping */
    rv_ease_arms(&p, slot);

    /* the contact shadow first, so it sits under the figure and not over it */
    rv_contact(c, px, ground + H * 0.012, H * 0.20,
               (int)(104.0 * (double)alpha / 255.0));

    /* the rim follows the beam over this part of the pit, and lifts with the
     * track: a quiet room has dim rims, a loud one has coloured edges */
    rv_rim_for(u * 0.8 + 0.1);
    /* the rim is the nearest beam hitting the edge of a body, so it is
     * strongest in a loud room and gone in a quiet one */
    rv_rim_a = RV_RIM * (0.26 + 0.58 * lv);

    crowd_figure(c, &p, rig, &f, alpha, phase, facing, detail);

    /* a glow stick in one hand for every third or fourth person: the thing
     * that puts real colour into a pit of dark bodies */
    if (variant == 0 || variant == 5) {
        static const int gcol[4][3] = { { 90, 240, 255 }, { 255, 108, 200 },
                                        { 176, 255, 120 }, { 255, 196, 108 } };
        int    gi = (hs >> 4) & 3;

        if (gi != 1) {
            int    ai = variant == 5 ? 0 : 1;
            double gx = p.wx[ai], gy2 = p.wy[ai];

            cv_line(c, gx, gy2, gx + H * 0.020, gy2 - H * 0.098, H * 0.011,
                    gcol[gi][0], gcol[gi][1], gcol[gi][2], 235);
            cv_line(c, gx, gy2, gx + H * 0.020, gy2 - H * 0.098, H * 0.004,
                    250, 250, 255, 200);
            cv_soft(c, gx + H * 0.020, gy2 - H * 0.098, H * 0.055,
                    gcol[gi][0], gcol[gi][1], gcol[gi][2], 54);
        }
    }

    /* the drink: a cup with a lit rim, which is the cheapest prop in the room */
    if (variant == 7) {
        double cxp = p.wx[1], cyp = p.wy[1];
        double a   = (double)alpha / 255.0;
        double cu  = H * 0.028;

        cv_line(c, cxp - cu, cyp - H * 0.052, cxp - cu * 0.7, cyp + H * 0.010,
                H * 0.008, 208, 216, 236, (int)(210 * a));
        cv_line(c, cxp + cu, cyp - H * 0.052, cxp + cu * 0.7, cyp + H * 0.010,
                H * 0.008, 208, 216, 236, (int)(210 * a));
        cv_line(c, cxp - cu * 0.74, cyp + H * 0.010, cxp + cu * 0.74,
                cyp + H * 0.010, H * 0.008, 190, 198, 220, (int)(200 * a));
        cv_ell(c, cxp, cyp - H * 0.050, cu, H * 0.008,
               246, 250, 255, (int)(230 * a));
        cv_line(c, cxp - cu * 0.8, cyp - H * 0.036, cxp + cu * 0.8,
                cyp - H * 0.036, H * 0.010, 214, 128, 96, (int)(190 * a));
        cv_soft(c, cxp, cyp - H * 0.055, H * 0.040, 255, 214, 160,
                (int)(30 * a));
    }

    if (variant == 2) {
        double hxp = p.wx[1], hyp = p.wy[1];
        double flick = 0.82 + 0.18 * fsind(phase * 2.3);
        double a = (double)alpha / 255.0;
        int    i;

        /* the phone: a cold spill on the faces around it, a dark body, then a
         * screen with a picture on it rather than a flat white slab */
        cv_soft(c, hxp, hyp, H * 0.26, 150, 205, 255, (int)(40 * flick * a));
        cv_rect(c, (int)(hxp - H * 0.040), (int)(hyp - H * 0.062),
                (int)(H * 0.080), (int)(H * 0.118), 12, 14, 22,
                (int)(232 * a));
        cv_rect(c, (int)(hxp - H * 0.033), (int)(hyp - H * 0.054),
                (int)(H * 0.066), (int)(H * 0.100), 210, 236, 255,
                (int)(215 * flick * a));
        for (i = 0; i < 3; i++) {
            double yy = hyp - H * 0.050 + (double)i * H * 0.032;

            cv_rect(c, (int)(hxp - H * 0.029), (int)yy,
                    (int)(H * 0.058), (int)(H * 0.014),
                    (int)(96 + 60 * (double)(i % 2)), (int)(150 + 40 * (double)i),
                    255, (int)(190 * flick * a));
        }
        cv_line(c, hxp - H * 0.030, hyp - H * 0.056, hxp + H * 0.030,
                hyp - H * 0.056, H * 0.008, 255, 255, 255, (int)(200 * a));
        /* the hand wrapped around the bottom of it */
        cv_ball(c, hxp - H * 0.014, hyp + H * 0.048, H * 0.024,
                f.k.skin_r, f.k.skin_g, f.k.skin_b,
                clampi(f.k.skin_r + 20, 0, 255), clampi(f.k.skin_g + 20, 0, 255),
                clampi(f.k.skin_b + 22, 0, 255));
        cv_ball(c, hxp + H * 0.016, hyp + H * 0.050, H * 0.022,
                f.k.skin_r, f.k.skin_g, f.k.skin_b,
                clampi(f.k.skin_r + 12, 0, 255), clampi(f.k.skin_g + 12, 0, 255),
                clampi(f.k.skin_b + 14, 0, 255));
    }
}

/* Two or three people right against the lens.
 *
 * They never move much and they cover almost nothing, but a pit with nobody
 * between it and the camera is a diorama: this is the cheapest depth in the
 * scene and the reason the front rank now has something behind it. Out of
 * focus, near black, lit only where the wall catches a shoulder. */
static void rave_near_pit(Cv *c, const UiModel *m, double lv, double shx)
{
    double t  = m->elapsed_sec;
    double w  = (double)c->w, h = (double)c->h;
    double bp = beat_pulse(m);
    int    i;

    for (i = 0; i < RV_NEAR_PIT; i++) {
        double x  = w * (i == 0 ? 0.105 : (i == 1 ? 0.885 : 0.685)) + shx;
        double H  = h * (i == 2 ? 0.200 : 0.235);
        double gy = h * 1.010;
        double sway = fsind(t * 1.5 + (double)i * 2.1) * w * 0.004;
        double bob = bp * h * 0.010;

        /* the shoulders, one mass: no face, no arms, just the back of someone
         * standing too close */
        cv_ell(c, x + sway, gy - H * 0.34 + bob, H * 0.30, H * 0.34,
               12, 12, 18, 255);
        cv_ell(c, x + sway, gy - H * 0.72 + bob, H * 0.13, H * 0.14,
               10, 10, 15, 255);
        cv_ell(c, x + sway, gy - H * 0.84 + bob, H * 0.126, H * 0.120,
               9, 9, 14, 255);
        /* the wall catching one edge of them */
        cv_line(c, x + sway - H * 0.29, gy - H * 0.40 + bob,
                x + sway - H * 0.22, gy - H * 0.62 + bob, h * 0.006,
                70, 88, 140, (int)(40 + 26 * lv));
        cv_line(c, x + sway + H * 0.10, gy - H * 0.88 + bob,
                x + sway + H * 0.12, gy - H * 0.80 + bob, h * 0.005,
                96, 108, 150, (int)(34 + 24 * lv));
    }
}

/* The DJ, seen from behind and close to the camera.
 *
 * A hoodie is a shaded column with a shoulder bar over it, the hood bunched at
 * the neck, one arm down onto the platter and one up on the headphone cup. The
 * head turns slightly with the pump, which is the difference between a statue
 * and someone playing. */
/* The DJ, seen from behind and close to the camera.
 *
 * Rebuilt as a body rather than a mascot. The old one was a head the size of a
 * melon on a long pale neck, a poncho for a jacket and two glowing rings where
 * the headphones should be. This one has a short neck, a head with a hairline,
 * headphones that sit on the skull, a hoodie with a hood rolled at the collar,
 * sleeves with ribbed cuffs, and two arms that reach out to the decks. The
 * hands are painted after the booth, so they land on the records. */
static void rave_dj(Cv *c, const UiModel *m, const Rig *rig)
{
    double t   = m->elapsed_sec;
    double w   = (double)c->w, h = (double)c->h;
    double bp  = beat_pulse(m);
    double lv  = (double)m->vis_level;
    double dx  = w * 0.500;
    double shy = h * (0.742 + 0.004 * bp);          /* shoulder line */
    double hr  = h * 0.049;                          /* head radius */
    double hy  = shy - h * (0.060 + 0.005 * bp);     /* short neck under it */
    double sway = fsind(t * 1.6) * w * 0.004;
    double xl  = dx - h * 0.086 + sway;
    double xr  = dx + h * 0.086 + sway;
    double ey  = shy + h * 0.072;                    /* elbow line */
    Rig    cloth = art_mat(rig, 0.26);
    Rig    skin  = art_mat(rig, 0.40);
    Kit    k = { 176, 126, 102, 52, 56, 78, 30, 30, 42,
                 206, 212, 230, 34, 25, 26 };
    int    i;

    /* ---- the torso -------------------------------------------------------
     * He is working the decks between himself and us, so he faces us. This is
     * the front of him: a zip down the middle, two slant pockets, a badge.
     * The old build drew the back of a hoodie - a yoke, a seam down the spine,
     * a nape, a bun - and then reached his hands forward over a booth in front
     * of him, which is the contradiction that read as facing the wrong way. */
    art_col_shade(c, shy - h * 0.004, h * 1.02, dx + sway, dx + sway * 1.3,
                  h * 0.096, h * 0.088, h * 0.116, 52, 56, 78, 255, &cloth);
    /* the chest, lit by the wall he is standing in front of */
    art_col_shade(c, shy + h * 0.014, shy + h * 0.160, dx + sway, dx + sway,
                  h * 0.086, h * 0.090, h * 0.086, 58, 63, 88, 110, &cloth);
    /* the zip, its teeth, and the pull at the throat */
    cv_line(c, dx + sway, shy + h * 0.026, dx + sway, h * 1.00,
            h * 0.0045, 20, 22, 34, 215);
    for (i = 0; i < 15; i++) {
        double yz = shy + h * (0.036 + 0.044 * (double)i);

        cv_line(c, dx + sway - h * 0.0045, yz, dx + sway + h * 0.0045, yz,
                h * 0.0018, 156, 162, 182, 95);
    }
    cv_ell(c, dx + sway, shy + h * 0.030, h * 0.007, h * 0.011,
           180, 186, 204, 235);
    /* the pockets, angled the way a hoodie's are, and cut off by the booth */
    for (i = 0; i < 2; i++) {
        double s2 = i ? 1.0 : -1.0;

        cv_line(c, dx + sway + s2 * h * 0.024, h * 0.902,
                dx + sway + s2 * h * 0.078, h * 0.956,
                h * 0.004, 26, 28, 44, 150);
        cv_line(c, dx + sway + s2 * h * 0.078, h * 0.956,
                dx + sway + s2 * h * 0.074, h * 0.996,
                h * 0.004, 26, 28, 44, 150);
    }
    /* a badge on the chest, answering the wall */
    cv_ell(c, dx + sway - h * 0.048, shy + h * 0.066, h * 0.011, h * 0.011,
           22, 24, 38, 255);
    cv_line(c, dx + sway - h * 0.055, shy + h * 0.066,
            dx + sway - h * 0.041, shy + h * 0.066, h * 0.0035,
           rig->fr, rig->fg, rig->fb, 210);

    /* ---- the collar: the hood bunched behind the shoulders, where you see it
     * from the front, and a ribbed V at the throat ---- */
    cv_ell(c, dx + sway, shy - h * 0.016, h * 0.074, h * 0.021, 62, 68, 92, 255);
    cv_ell(c, dx + sway, shy - h * 0.020, h * 0.062, h * 0.015, 40, 44, 62, 255);
    for (i = 0; i < 2; i++) {
        double s2 = i ? 1.0 : -1.0;

        cv_line(c, dx + sway + s2 * h * 0.007, shy + h * 0.034,
                dx + sway + s2 * h * 0.052, shy - h * 0.002,
                h * 0.011, 70, 76, 104, 255);
        cv_line(c, dx + sway + s2 * h * 0.014, shy + h * 0.030,
                dx + sway + s2 * h * 0.050, shy + h * 0.002,
                h * 0.004, 108, 114, 146, 150);
    }
    cv_ell_soft(c, dx + sway, shy + h * 0.012, h * 0.048, h * 0.012,
                8, 9, 16, 140);

    /* ---- sleeves: shoulder, elbow, then out to the deck ---- */
    for (i = 0; i < 2; i++) {
        double sx = i ? xr : xl;
        double ex = dx + (i ? h * 0.122 : -h * 0.122) + sway;
        double wx = w * (i ? 0.600 : 0.400);

        cv_ball(c, sx, shy + h * 0.008, h * 0.019, 52, 56, 78, 74, 84, 116);
        art_limb(c, sx, shy + h * 0.010, ex, ey, h * 0.032, h * 0.028,
                 44, 48, 68, 255, &cloth);
        cv_ball(c, ex, ey, h * 0.027, 44, 48, 68, 66, 76, 108);
        art_limb(c, ex, ey, wx, h * 0.902, h * 0.028, h * 0.022,
                 44, 48, 68, 255, &cloth);
        /* a ribbed cuff at the wrist, which is also where the hand starts */
        cv_line(c, wx - h * 0.008, h * 0.892, wx + h * 0.008, h * 0.898,
                h * 0.011, 186, 194, 218, 180);
        cv_line(c, wx - h * 0.007, h * 0.898, wx + h * 0.007, h * 0.904,
                h * 0.004, 210, 218, 238, 120);
    }

    /* ---- his rim ---------------------------------------------------------
     * He is the one figure in the room close enough to carry a full rim: down
     * both shoulders, and a hot line along the top of the skull where the
     * spotlight strikes it. That edge is what lifts him off the wall behind. */
    for (i = 0; i < 2; i++) {
        double s2 = i ? 1.0 : -1.0;

        cv_line(c, dx + sway + s2 * h * 0.094, shy + h * 0.008,
                dx + sway + s2 * h * 0.086, shy + h * 0.070,
                h * 0.007, 150, 198, 255, (int)(70 + 70 * lv));
        cv_line(c, dx + sway + s2 * h * 0.070, shy + h * 0.150,
                dx + sway + s2 * h * 0.078, shy + h * 0.096,
                h * 0.004, 190, 220, 255, (int)(40 + 50 * lv));
    }
    cv_ell_soft(c, dx + sway - hr * 0.30, hy - hr * 0.92, hr * 0.66, hr * 0.22,
                255, 246, 226, (int)(70 + 60 * lv));

    /* ---- neck, head, hair, headphones ---- */
    /* trapezius first, so the neck is not a stick pushed into the shoulders */
    for (i = 0; i < 2; i++)
        art_limb(c, dx + sway, shy + h * 0.004,
                 dx + sway + (i ? h * 0.046 : -h * 0.046), shy + h * 0.022,
                 h * 0.014, h * 0.011, 52, 56, 78, 255, &cloth);
    /* a short, shaded neck: the old one was a pale column half a head long,
     * which is what made him read as a lollipop */
    art_limb(c, dx + sway, shy + h * 0.004, dx + sway, hy + hr * 0.84,
             h * 0.021, h * 0.020,
             clampi(k.skin_r - 34, 0, 255), clampi(k.skin_g - 34, 0, 255),
             clampi(k.skin_b - 28, 0, 255), 255, &skin);
    cv_ell_soft(c, dx + sway, hy + hr * 0.84, hr * 0.40, hr * 0.18,
                40, 16, 24, 150);

    /* ---- the face -------------------------------------------------------
     * We are the crowd. He is looking at us: brow, eyes that blink, a nose, a
     * mouth that opens with the track. A smooth skin ball with a band around
     * it is a mascot; a face is a person. */
    cv_ball(c, dx + sway, hy, hr, k.skin_r, k.skin_g, k.skin_b,
            clampi(k.skin_r + 26, 0, 255), clampi(k.skin_g + 26, 0, 255),
            clampi(k.skin_b + 24, 0, 255));
    /* the jaw's shadow, so the chin has an edge */
    cv_ell_soft(c, dx + sway, hy + hr * 0.70, hr * 0.64, hr * 0.22,
                40, 18, 24, 54);
    /* The hair: a cap that stops above the brow - the first version of this
     * sat low enough to cover his eyes and nose, which is most of the face -
     * with a fringe and two short sideburns. */
    cv_ell(c, dx + sway, hy - hr * 0.62, hr * 1.03, hr * 0.42,
           k.hair_r, k.hair_g, k.hair_b, 255);
    for (i = 0; i < 2; i++) {
        double s2 = i ? 1.0 : -1.0;

        cv_ell(c, dx + sway + s2 * hr * 0.96, hy - hr * 0.06,
               hr * 0.12, hr * 0.30, k.hair_r, k.hair_g, k.hair_b, 255);
        cv_line(c, dx + sway + s2 * hr * 0.04, hy - hr * 0.74,
                dx + sway + s2 * hr * 0.50, hy - hr * 0.40,
                hr * 0.13, k.hair_r, k.hair_g, k.hair_b, 255);
    }
    /* a warm sheen along the top of the hair, not on the back of his head */
    cv_ell_soft(c, dx + sway - hr * 0.16, hy - hr * 0.90, hr * 0.44, hr * 0.16,
                226, 190, 160, 30);

    {
        double blink = 1.0;
        double bt = fmod(t, 4.3);

        if (bt > 3.94)
            blink = 0.10;                       /* a blink every four seconds */
        for (i = 0; i < 2; i++) {
            double s2 = i ? 1.0 : -1.0;
            double ex = dx + sway + s2 * hr * 0.36;
            double eyp = hy - hr * 0.02;

            /* brow */
            cv_line(c, ex - hr * 0.17, eyp - hr * 0.24,
                    ex + hr * 0.15, eyp - hr * 0.28, hr * 0.048,
                    30, 20, 22, 215);
            /* the eye, and its lid */
            cv_ell(c, ex, eyp, hr * 0.135, hr * 0.098 * blink, 34, 26, 30, 235);
            if (blink > 0.4) {
                cv_ell(c, ex + s2 * hr * 0.02, eyp, hr * 0.052, hr * 0.050,
                       14, 12, 16, 255);
                cv_ell(c, ex + s2 * hr * 0.05, eyp - hr * 0.03,
                       hr * 0.020, hr * 0.016, 252, 250, 246, 220);
            }
        }
        /* nose: a shadow down the side and a lit tip */
        cv_line(c, dx + sway + hr * 0.05, hy + hr * 0.04,
                dx + sway + hr * 0.09, hy + hr * 0.30, hr * 0.05,
                118, 68, 64, 90);
        cv_ell_soft(c, dx + sway + hr * 0.02, hy + hr * 0.26, hr * 0.10,
                    hr * 0.07, 252, 216, 192, 110);
        /* mouth: a line that opens when the track is loud */
        cv_ell(c, dx + sway, hy + hr * 0.52, hr * 0.155,
               hr * (0.018 + 0.048 * lv), 104, 52, 52, 210);
        cv_line(c, dx + sway - hr * 0.06, hy + hr * 0.50,
                dx + sway + hr * 0.12, hy + hr * 0.50, hr * 0.024,
                244, 206, 190, 80);
    }

    /* headphones: one smooth band following the skull, then two dark cups
     * that sit on it, with a dim ring instead of a glowing donut */
    {
        double xs[34], ys[34];
        int    n = 0, k2;

        for (k2 = 0; k2 <= 16; k2++) {
            double a = -ART_PI * 0.94 + (double)k2 * (ART_PI * 0.88 / 16.0);

            xs[n] = dx + sway + fcosd(a) * hr * 1.13;
            ys[n++] = hy + fsind(a) * hr * 1.07;
        }
        for (k2 = 16; k2 >= 0; k2--) {
            double a = -ART_PI * 0.94 + (double)k2 * (ART_PI * 0.88 / 16.0);

            xs[n] = dx + sway + fcosd(a) * hr * 1.02;
            ys[n++] = hy + fsind(a) * hr * 0.96;
        }
        cv_poly(c, xs, ys, n, 26, 28, 36, 250);
    }
    for (i = 0; i < 2; i++) {
        double cxp = dx + sway + (i ? hr * 0.99 : -hr * 0.99);

        cv_ell(c, cxp, hy + hr * 0.10, hr * 0.34, hr * 0.44, 28, 30, 40, 255);
        cv_ell(c, cxp, hy + hr * 0.10, hr * 0.24, hr * 0.33, 38, 42, 56, 255);
        cv_ell(c, cxp, hy + hr * 0.10, hr * 0.13, hr * 0.19, 30, 33, 46, 255);
        cv_line(c, cxp + (i ? hr * 0.30 : -hr * 0.30), hy - hr * 0.12,
                cxp + (i ? hr * 0.30 : -hr * 0.30), hy + hr * 0.32,
                1.4, 110, 180, 240, 120);
        cv_soft(c, cxp, hy + hr * 0.10, hr * 0.20, 120, 190, 255, 24);
    }
    /* the cable, sagging down his back to the mixer */    /* the cable, sagging down his back to the mixer */
    {
        double x0 = dx + sway + hr * 1.02, y0 = hy + hr * 0.56;
        double x1 = dx + w * 0.020, y1 = h * 0.930;
        double px_ = x0, py_ = y0;
        int    k2;

        for (k2 = 1; k2 <= 10; k2++) {
            double u  = (double)k2 / 10.0;
            double nx = x0 + (x1 - x0) * u + sin(u * ART_PI) * w * 0.018;
            double ny = y0 + (y1 - y0) * u * u;

            cv_line(c, px_, py_, nx, ny, h * 0.0030, 16, 18, 28, 230);
            cv_line(c, px_, py_, nx, ny, h * 0.0014, 84, 92, 120, 140);
            px_ = nx;
            py_ = ny;
        }
    }
}

/* The hands, painted after the booth so they land on the records instead of
 * behind it. Two hands, fingers spread on the platters, lifting a hair on the
 * beat. This is the detail the old build could not have: it drew the DJ before
 * the decks, so his hands were always underneath them. */
static void rave_dj_hands(Cv *c, const UiModel *m, const Rig *rig)
{
    double h  = (double)c->h, w = (double)c->w;
    double bp = beat_pulse(m);
    Rig    skin  = art_mat(rig, 0.40);
    Rig    cloth = art_mat(rig, 0.26);
    Kit    k = { 176, 126, 102, 52, 56, 78, 30, 30, 42,
                 206, 212, 230, 52, 34, 30 };
    int    i;

    for (i = 0; i < 2; i++) {
        /* the hand lies on the record: a palm and four fingers reaching in
         * toward the label, and the forearm that carries it, painted here
         * because it crosses the deck. Cutting the arm off above the booth
         * lip is what made the hands look stuck on, or worse, backwards. */
        double px  = w * (i ? 0.605 : 0.395);
        double py  = h * (0.950 - 0.004 * bp);
        double dir = i ? -1.0 : 1.0;
        double ex  = w * 0.500 + (i ? h * 0.122 : -h * 0.122);
        double eyp = h * 0.814;
        double y0  = h * 0.876;
        double x0  = ex + (px - ex) * ((y0 - eyp) / (py - eyp));
        int    f;

        art_limb(c, x0, y0, px, py - h * 0.014, h * 0.028, h * 0.019,
                 44, 48, 68, 255, &cloth);
        cv_line(c, px - h * 0.016, py - h * 0.026, px + h * 0.016, py - h * 0.020,
                h * 0.010, 186, 194, 218, 205);
        cv_line(c, px - h * 0.014, py - h * 0.020, px + h * 0.014, py - h * 0.016,
                h * 0.004, 216, 222, 240, 120);
        cv_ell(c, px + dir * w * 0.004, py, w * 0.017, h * 0.0095,
               k.skin_r, k.skin_g, k.skin_b, 255);
        cv_ell_soft(c, px + dir * w * 0.004, py - h * 0.004,
                    w * 0.012, h * 0.0055, 255, 248, 242, 80);
        for (f = 0; f < 4; f++) {
            double off = ((double)f - 1.5) * h * 0.0055;

            art_limb(c, px + dir * w * 0.008, py + off,
                     px + dir * w * 0.030, py + off * 1.25,
                     h * 0.0032, h * 0.0026,
                     k.skin_r, k.skin_g, k.skin_b, 255, &skin);
        }
        /* the thumb, on the near edge of the record */
        art_limb(c, px - dir * w * 0.006, py + h * 0.004,
                 px - dir * w * 0.020, py + h * 0.014,
                 h * 0.0036, h * 0.0028,
                 k.skin_r, k.skin_g, k.skin_b, 255, &skin);
        cv_soft(c, px, py + h * 0.006, w * 0.012, 210, 236, 255, 30);
    }
}

/* The booth in the foreground: the riser, two decks with platters that actually
 * turn, a mixer with live VU columns, and a small screen running a waveform.
 * This is the detail that makes the shot read as a club and not as a crowd of
 * silhouettes in front of a light show. */
static void rave_decks(Cv *c, const UiModel *m)
{
    double t = m->elapsed_sec;
    double w = (double)c->w, h = (double)c->h;
    double lv = (double)m->vis_level;
    double bx0 = w * 0.245, bx1 = w * 0.755;   /* deck top, back edge */
    double fy0 = h * 0.918, fy1 = h * 1.06;    /* deck top, front edge */
    double fx0 = w * 0.150, fx1 = w * 0.850;
    double turn = t * 1.05;
    int    i, k;

    /* riser front, lit from the wall behind it */
    bg_rect(c, 0, cv_i(fy0), c->w, c->h - cv_i(fy0), 10, 10, 16);
    cv_ell_soft(c, w * 0.50, fy0 + h * 0.03, w * 0.42, h * 0.045,
                70, 40, 120, 120);
    cv_rect(c, 0, (int)fy0, c->w, 2, 168, 128, 246, 225);
    cv_ell_soft(c, w * 0.50, fy0, w * 0.46, h * 0.013, 140, 90, 220, 110);

    /* a chase strip along the front of the riser: the booth is a light source
     * too, and a moving strip is the cheapest way to say "this is playing" */
    {
        double bp = beat_pulse(m);
        double seg = w / 26.0;
        int    sg;

        for (sg = 0; sg < 26; sg++) {
            double on = 0.22 + 0.78 * fabs(fsind((double)sg * 0.42 - t * 4.0));
            int    cr, cg, cb;

            art_col(fmod((double)sg / 26.0 + t * 0.10, 1.0), &cr, &cg, &cb);
            cv_rect(c, cv_i((double)sg * seg + 2.0), cv_i(fy0 + h * 0.011),
                    cv_i(seg - 4.0), (int)(h * 0.006),
                    (int)((double)cr * on), (int)((double)cg * on),
                    (int)((double)cb * on), (int)(120 + 100 * bp));
        }
    }

    /* the deck top, in perspective */
    cv_poly(c, (double[]){ bx0, bx1, fx1, fx0 },
               (double[]){ fy0, fy0, fy1, fy1 }, 4, 26, 27, 38, 255);
    cv_line(c, bx0, fy0, bx1, fy0, 2.0, 150, 120, 210, 170);
    cv_line(c, fx0, fy1, bx0, fy0, 1.4, 70, 72, 96, 150);
    cv_line(c, bx1, fy0, fx1, fy1, 1.4, 70, 72, 96, 150);

    /* two platters: concentric rings, radial marks that rotate, a label */
    for (i = 0; i < 2; i++) {
        double pcx = w * (i ? 0.605 : 0.395);
        double pcy = h * 0.962;
        double prx = w * 0.050, pry = h * 0.026;
        double dir = i ? -1.0 : 1.0;

        cv_ell(c, pcx, pcy + h * 0.004, prx * 1.04, pry * 1.10,
               8, 8, 13, 255);
        cv_ell(c, pcx, pcy, prx, pry, 18, 18, 26, 255);
        for (k = 1; k <= 4; k++) {
            double u = (double)k / 5.0;

            cv_ell(c, pcx, pcy, prx * u, pry * u, 26, 26, 38, 210);
            cv_ell(c, pcx, pcy, prx * u - 1.4, pry * u - 1.0, 16, 16, 24, 210);
        }
        /* the marks: eight spokes, so the platter is visibly turning */
        for (k = 0; k < 8; k++) {
            double a = turn * dir + (double)k * ART_PI / 4.0;
            double depth = 0.55 + 0.45 * fsind(a);      /* near half brighter */

            cv_line(c, pcx + fcosd(a) * prx * 0.42, pcy + fsind(a) * pry * 0.42,
                    pcx + fcosd(a) * prx * 0.92, pcy + fsind(a) * pry * 0.92,
                    1.6, 150, 170, 210, (int)(60 + 70 * depth));
        }
        cv_ell(c, pcx, pcy, prx * 0.28, pry * 0.30, 190, 60, 140, 255);
        cv_ell(c, pcx, pcy, prx * 0.10, pry * 0.11, 240, 232, 240, 255);
        cv_ring(c, pcx, pcy, prx * 0.99, 1.6, 120, 150, 200, 120);
        cv_soft(c, pcx, pcy, prx * 1.2, 120, 90, 200, (int)(14 + 20 * lv));

        /* tonearm, hinged at the corner, reaching for the label */
        cv_line(c, pcx - dir * prx * 1.25, pcy + h * 0.008,
                pcx - dir * prx * 0.52, pcy - h * 0.004, 3.0,
                180, 186, 206, 230);
        cv_ball(c, pcx - dir * prx * 1.25, pcy + h * 0.008, h * 0.009,
                60, 62, 78, 200, 210, 230);
    }

    /* mixer between them: VU columns, a crossfader, a row of knobs */
    {
        double mx = w * 0.500, mw = w * 0.074;
        double my = h * 0.938, mh = h * 0.055;

        bg_rect(c, cv_i(mx - mw / 2), cv_i(my), cv_i(mw), cv_i(mh), 14, 14, 20);
        cv_line(c, mx - mw / 2, my, mx + mw / 2, my, 1.4, 150, 110, 210, 130);
        for (i = 0; i < 2; i++) {
            double vx = mx + (i ? mw * 0.20 : -mw * 0.20);
            int    seg = 9, s;

            for (s = 0; s < seg; s++) {
                double u = (double)s / (double)(seg - 1);
                double band = band_at(m, u * 0.9);
                double on = band > (0.24 + 0.62 * (1.0 - u)) ? 1.0 : 0.22;
                int    cr = (int)(70 + 185 * u) * on;
                int    cg = (int)(220 - 120 * u) * on;
                int    cb = (int)(120 + 80 * u) * on;

                cv_rect(c, cv_i(vx), cv_i(my + mh - (double)(s + 1) * mh / 10.0),
                        cv_i(mw * 0.055), cv_i(mh / 12.0), cr, cg, cb,
                        (int)(150 + 105 * beat_pulse(m) * (0.4 + 0.6 * on)));
            }
        }
        /* crossfader */
        cv_rect(c, cv_i(mx - mw * 0.16), cv_i(my + mh * 0.86),
                cv_i(mw * 0.32), 2, 60, 62, 80, 235);
        cv_rect(c, cv_i(mx - mw * 0.04 + mw * 0.10 * fsind(t * 0.9)),
                cv_i(my + mh * 0.82), cv_i(mw * 0.05), cv_i(mh * 0.09),
                220, 224, 238, 240);
        for (i = 0; i < 4; i++)
            cv_ball(c, mx - mw * 0.27 + mw * 0.18 * (double)i, my + mh * 0.30,
                    h * 0.0055, 70, 72, 92, 210, 220, 240);
    }

    /* the laptop screen, tilted, running a waveform */
    {
        double sx = w * 0.718, sy = h * 0.900;
        double sw = w * 0.092, sh = h * 0.046;

        cv_poly(c, (double[]){ sx - sw * 0.52, sx + sw * 0.52,
                               sx + sw * 0.62, sx - sw * 0.42 },
                   (double[]){ sy, sy, sy + sh, sy + sh }, 4, 8, 10, 18, 255);
        for (i = 0; i < (int)(sw * 0.9); i += 2) {
            double u = (double)i / (sw * 0.9);
            double v = wave_at(m, fmod(u + t * 0.10, 1.0));
            double yy = sy + sh * (0.50 - 0.42 * v);

            cv_line(c, sx - sw * 0.44 + (double)i, sy + sh * 0.50,
                    sx - sw * 0.44 + (double)i, yy, 1.4, 120, 220, 255, 210);
        }
        cv_line(c, sx - sw * 0.44, sy + sh * 0.50, sx + sw * 0.46,
                sy + sh * 0.50, 1.0, 60, 110, 160, 130);
        cv_soft(c, sx, sy + sh * 0.5, sw * 0.7, 60, 150, 210, 26);
    }
}

/* Laser beams raking the pit.
 *
 * The stage beams stop at the floor; these come off the truss and go out over
 * the crowd, which is the light everyone remembers from a club. Each one is a
 * cone that widens as it travels and fades as it goes, with a thin hot core and
 * a hit on the floor: three or four sheets of color is what makes a beam look
 * like it is in air rather than drawn on the frame. They are painted after the
 * crowd, because a beam that crosses a person is in front of them. */
static void rave_lasers(Cv *c, const UiModel *m, double wall, double lv,
                        int beams)
{
    double t  = m->elapsed_sec;
    double w  = (double)c->w, h = (double)c->h;
    double bp = beat_pulse(m);
    /* the low end of the track, which is what a laser rig actually follows */
    double bass = (band_at(m, 0.02) + band_at(m, 0.06)) * 0.5;
    int    i, k;

    if (beams < 1)
        beams = 1;
    for (i = 0; i < beams; i++) {
        double u    = (double)i / (double)(beams > 1 ? beams - 1 : 1);
        double ax   = w * (0.14 + 0.72 * u);
        double ay   = h * 0.034;
        /* louder music, wider and faster sweep: the beams calm right down
         * when the track does */
        double sweep = t * (0.30 + 0.28 * lv) * RV_LASER_SPEED;
        double tx   = w * (0.5 + (u - 0.5) * 1.30)
                    + fsind(sweep + (double)i * 1.21)
                      * w * (0.09 + 0.09 * lv) * RV_LASER_WIDTH;
        double ty   = h * (0.96 + 0.06 * fsind(sweep * 0.8 + (double)i));
        double head = 0.5 + 0.5 * fsind(sweep * 1.4 + (double)i * 0.94);
        double lit  = (0.25 + 0.75 * head) * (0.30 + 0.90 * lv)
                    + bp * 0.30 + bass * 0.25;
        int    cr, cg, cb;

        art_col(fmod(u + t * 0.05, 1.0), &cr, &cg, &cb);
        /* a loud, bass-heavy passage burns the colour out toward white */
        rv_hot(&cr, &cg, &cb, 0.40 * lv * (0.45 + 0.55 * bass));
        if (lit < 0.16)
            continue;

        /* Three additive sheets, widening as they travel and falling in
         * strength outward: that is a cone of light in air. Additive matters
         * here - two beams crossing now make a bright X instead of one beam
         * lying on top of the other. */
        for (k = 2; k >= 0; k--) {
            double sp = w * (0.006 + 0.020 * (double)k)
                      * (0.70 + 0.55 * lv) * RV_LASER_WIDTH;
            double wob = fsind(t * 1.7 + (double)k * 2.1) * w * 0.004;
            int    al = (int)((36.0 - 9.0 * (double)k) * lit * RV_HAZE);

            if (al < 2)
                continue;
            cv_beam_add(c, ax, ay, tx + wob, ty, 2.4, sp, cr, cg, cb, al);
        }
        /* the core, hot enough to read on a phone screen */
        cv_beam_add(c, ax, ay, tx, ty, 1.6, 1.9, 255, 248, 255,
                    (int)(50 + 110 * lit));
        cv_soft(c, ax, ay, h * 0.020, 255, 244, 255,
                (int)((40 + 110 * lit) * RV_HAZE));
        /* the air is thickest where the beam leaves the rig */
        cv_soft(c, ax, ay + h * 0.018, w * 0.034, cr, cg, cb,
                (int)((14 + 26 * lit) * RV_HAZE));
        if (ty > wall)
            cv_ell_soft(c, tx, ty - h * 0.008, w * 0.026, h * 0.016,
                        cr, cg, cb, (int)(20 + 40 * lit));
    }
}

/* Two speaker stacks at the front corners of the pit, seen from behind: the
 * silhouette that frames the shot, and four drivers each that pump on the
 * beat. They stand in front of the crowd, so a person or two is behind them,
 * which is what gives the pit its depth. */
static void rave_stacks(Cv *c, const UiModel *m, double lv)
{
    double t  = m->elapsed_sec;
    double w  = (double)c->w, h = (double)c->h;
    double bp = beat_pulse(m);
    int    i, s, k;

    for (s = 0; s < 2; s++) {
        double xc  = s ? w * 0.962 : w * 0.038;
        double bw  = w * 0.052;
        double top = h * 0.598;
        double bot = h * 0.952;
        double cab = (bot - top) / 3.0;

        /* the rim the wall throws down the inner edge of the stack */
        cv_rect(c, (int)(xc - bw * 0.5), (int)top, (int)bw, (int)(bot - top),
                9, 9, 15, 255);
        cv_rect(c, (int)(xc + (s ? -bw * 0.5 : bw * 0.5) - 2),
                (int)top, 2, (int)(bot - top), 66, 62, 104, 200);
        for (i = 0; i < 3; i++) {
            double y0 = top + (double)i * cab;

            bg_rect(c, cv_i(xc - bw * 0.46), cv_i(y0 + 3.0),
                    cv_i(bw * 0.92), cv_i(cab - 6.0), 14, 14, 22);
            for (k = 0; k < 2; k++) {
                double cxx = xc + (k ? bw * 0.20 : -bw * 0.20);
                double cyy = y0 + cab * 0.50;
                double rad = bw * (0.21 + 0.060 * bp * (0.5 + 0.5 * lv));

                cv_ell(c, cxx, cyy, rad, rad * 0.92, 8, 8, 12, 255);
                cv_ell(c, cxx, cyy, rad * 0.72, rad * 0.66, 22, 22, 32, 255);
                cv_ell(c, cxx, cyy, rad * 0.30, rad * 0.27, 44, 44, 58, 255);
                cv_ring(c, cxx, cyy, rad * 0.94, 1.4, 120, 130, 180, 90);
            }
        }
        /* a strip light down the front edge, chasing with the beat */
        for (i = 0; i < 14; i++) {
            double yy = top + (double)i * (bot - top) / 14.0;
            double on = 0.35 + 0.65 * fabs(fsind(t * 2.2 + yy * 0.02));

            cv_rect(c, cv_i(xc - bw * 0.52), cv_i(yy), 2, cv_i((bot - top) / 16.0),
                    90, (int)(120 + 90 * on), (int)(150 + 90 * on),
                    (int)(90 * on));
        }
    }
}

/* Two dancers up on the side platforms, running the same choreography as the
 * dance looks at a third of the size. The club and the dance scenes are one
 * room, and this is what makes them read that way: same body, same beat, same
 * wardrobe, different distance from the camera. */
static void rave_gogo(Cv *c, const UiModel *m, const Rig *rig, double lv)
{
    double t = m->elapsed_sec;
    double w = (double)c->w, h = (double)c->h;
    double bp = beat_pulse(m);
    int    s;

    for (s = 0; s < 2; s++) {
        double cx = w * (s ? 0.757 : 0.243);
        double H  = h * 0.216;
        double g  = h * 0.845;
        double off = (double)s * 1.37;
        double turn, tail;
        Pose   p, pm;
        Kit    kit = { 150, 106,  88, 168, 62, 58, 22, 20, 36,
                       186, 192, 214, 40, 28, 26 };

        /* the platform: a lit disc with its own spill on the pit floor */
        cv_ell(c, cx, g + h * 0.008, H * 0.32, H * 0.050, 14, 14, 22, 255);
        cv_ell_soft(c, cx, g + h * 0.006, H * 0.40, H * 0.032,
                    120, 180, 240, (int)(40 + 50 * bp));
        dance_build(&p, t + off, lv, w, h, VIS_STYLE_DANCE, cx, H, g,
                    bp, &turn, &tail);
        cv_ell_soft(c, p.cx, (p.cy + p.hy) * 0.5, H * 0.30, H * 0.42,
                    120, 190, 240, 22);
        /* the reflection is a second complete body in a mirrored pose: at a
         * stepped quality the dancer gets a dark shadow on the platform
         * instead, which is all the pixels can show anyway */
        if (s_paint_step >= 2) {
            cv_ell(c, p.cx, g + h * 0.004, H * 0.30, H * 0.036, 4, 4, 8, 210);
        } else {
            pose_mirror(&pm, &p, g, 0.58);
            art_dancer2(c, &pm, rig, lv, 2, turn, tail, t, &kit);
        }
        art_dancer2(c, &p, rig, lv, 0, turn, tail, t, &kit);
    }
}

/* Pendant lamps over the pit, and the mirror ball behind them.
 *
 * Five warm drops in a cold room: this is what a club ceiling looks like from
 * the floor, and it puts something between the wall and the crowd. The ball is
 * small and mostly dark with a few facets catching the light, which is what a
 * mirror ball actually looks like; a white disc would be a moon. */
static void rave_pendants(Cv *c, const UiModel *m, double lv, int n,
                          int have_ball)
{
    double t = m->elapsed_sec;
    double w = (double)c->w, h = (double)c->h;
    int    i;

    if (n < 1)
        n = 1;
    for (i = 0; i < n; i++) {
        double u    = (double)(i + 0.5) / (double)n;
        double x    = w * (0.10 + 0.80 * u);
        double sway = fsind(t * 0.9 + (double)i * 1.4) * w * 0.004;
        double y    = h * (0.588 + 0.030 * (double)(i % 3));
        double flick = 0.72 + 0.28 * fsind(t * 5.0 + (double)i * 2.1);

        cv_line(c, x, h * 0.048, x + sway, y - h * 0.028, 1.2, 40, 40, 52, 180);
        cv_poly(c, (double[]){ x + sway - w * 0.011, x + sway + w * 0.011,
                               x + sway + w * 0.023, x + sway - w * 0.023 },
                   (double[]){ y - h * 0.028, y - h * 0.028, y, y }, 4,
                24, 24, 32, 255);
        cv_line(c, x + sway - w * 0.023, y, x + sway + w * 0.023, y,
                2.0, 224, 174, 116, 190);
        cv_soft(c, x + sway, y + h * 0.010, h * 0.028, 255, 188, 120,
                (int)(26 + 54 * flick * (0.35 + 0.65 * lv)));
        cv_soft(c, x + sway, y + h * 0.052, h * 0.030, 255, 178, 118,
                (int)(10 + 10 * flick));
    }

    /* the mirror ball */
    if (have_ball) {
        double bx = w * 0.500, by = h * 0.150;
        double br = h * 0.038;
        int    r, cc;

        cv_line(c, bx, h * 0.048, bx, by - br, 1.2, 40, 40, 52, 170);
        cv_soft(c, bx, by, br * 1.9, 120, 150, 210, 20);
        cv_ball(c, bx, by, br, 42, 46, 62, 96, 116, 152);
        for (r = 0; r < 5; r++) {
            double yy = (double)r / 4.0 * 2.0 - 1.0;
            double hw = sqrt(1.0 - yy * yy);

            for (cc = -3; cc <= 3; cc++) {
                double xx = (double)cc / 3.4;
                double ph = fsind(t * 1.7 + (double)(r * 7 + cc) * 1.3);

                if (xx * xx + yy * yy > 0.94)
                    continue;
                if (ph < 0.45)
                    continue;
                cv_ball(c, bx + xx * br * hw, by + yy * br, br * 0.11,
                        240, 244, 255, 255, 255, 255);
                cv_soft(c, bx + xx * br * hw, by + yy * br, br * 0.20,
                        255, 250, 230, (int)(26 + 40 * (ph - 0.45)));
            }
        }
    }
}

/* Which room this track opens in. The name of the track picks it, so a song
 * always plays in the same set and no two songs look alike. Four sets, each
 * with its own panel count, lighting rig and furniture:
 *   0  the warehouse   - twelve panels, five pendants, the ball, four beams
 *   1  the laser room  - eight panels, no pendants, no ball, six beams
 *   2  the lounge       - sixteen panels, seven pendants, the ball, two beams
 *   3  the smoke room   - six panels, two pendants, no ball, three beams, haze
 */
static int rave_set(const UiModel *m)
{
    const char *nm = NULL;
    unsigned    hsh = 2166136261u;
    int         i;

    if (m->tracks && m->current >= 0 && m->current < m->track_count)
        nm = m->tracks[m->current].name;
    if (!nm || !nm[0])
        nm = m->app_title ? m->app_title : "ultimate";
    for (i = 0; nm[i] && i < 64; i++) {
        hsh ^= (unsigned char)nm[i];
        hsh *= 16777619u;
    }
#ifdef RAVE_SET_TEST
    (void)hsh;                                  /* preview-only: force a set */
    return RAVE_SET_TEST;
#else
    return (int)(hsh % 4u);
#endif
}

/* A body at the back of the pit, painted for what a body that far away
 * actually shows: a dark shape and one lit edge. Four soft shapes and a line,
 * against twenty-odd for a figure whose clothes nobody can read at this size.
 * Used for the back rank at every stepped quality, and for the whole back row
 * once the canvas has been halved. */
static void rv_sil(Cv *c, double cx, double ground, double H, double phase,
                   int alpha, const Rig *rig)
{
    double bob = fsind(phase * 0.80) * H * 0.020;   /* everybody breathes */
    double top = ground - H + bob;
    double sw  = H * 0.235;                         /* half a shoulder */

    cv_ell_soft(c, cx, top + H * 0.092, H * 0.072, H * 0.084, 5, 5, 12, alpha);
    cv_ell_soft(c, cx, top + H * 0.240, sw * 1.02, H * 0.072, 4, 4, 11, alpha);
    cv_ell_soft(c, cx, top + H * 0.470, sw, H * 0.235, 4, 4, 10, alpha);
    cv_ell_soft(c, cx + sw * 0.20, top + H * 0.820, sw * 0.62, H * 0.150,
                3, 3, 9, alpha * 8 / 10);
    /* the edge the wall lights, so a silhouette in fog is still in the room */
    cv_line(c, cx + sw * 0.84, top + H * 0.150, cx + sw * 0.90, top + H * 0.620,
            1.5, rig->fr, rig->fg, rig->fb, alpha / 4);
}

static void art_rave(Cv *c, const UiModel *m)
{
    double t = m->elapsed_sec;
    double lv = (double)m->vis_level;
    double w = (double)c->w, h = (double)c->h;
    double wall = h * RV_WALL_Y;             /* where the wall meets the floor */
    int    set  = rave_set(m);
    int    panels = set == 1 ? 8 : (set == 2 ? 16 : (set == 3 ? 6 : 12));
    int    pend = set == 1 ? 0 : (set == 2 ? 7 : (set == 3 ? 2 : 5));
    int    beams = set == 1 ? 6 : (set == 2 ? 2 : (set == 3 ? 3 : 4));
    int    ball = set != 1 && set != 3;
    int    i, x, r, g, b;
    Rig    rig;
    static double s_rv_last;
    double bass, kick, shx;
    double dt = s_rv_last > 0.0 ? t - s_rv_last : 0.016;

    if (dt < 0.001 || dt > 0.25)
        dt = 0.016;
    rv_dt = dt;
    s_rv_last = t;

    /* What the room answers to: the low end of the track, and the kick the
     * beat clock puts under it. Every reaction below hangs off these two. */
    bass = (band_at(m, 0.02) + band_at(m, 0.06)) * 0.5;
    kick = beat_pulse(m) * (0.30 + 0.70 * bass);
    shx  = RV_SHAKE * kick * w * 0.0045 * fsind(t * 37.0);

    art_col(band_at(m, 0.45), &r, &g, &b);
    rig.kr = 150;
    rig.kg = 200;
    rig.kb = 255;
    rig.fr = r;
    rig.fg = g;
    rig.fb = b;
    rig.sheen = 0.30 + 0.30 * lv;

    /* ---- the room ----
     * The sky and the floor come from the cached base; everything from here on
     * is what actually moves. */
    rv_base(c);

    /* ---- the wall ---------------------------------------------------------
     * An LED wall, not a bar chart: twelve panels across and four down, each
     * panel a stack of light that answers its own band, a true black bezel
     * between the panels, a dot grid across the face of each one and a hot
     * head where the stack tops out.
     *
     * The old wall was one magenta gradient per pixel column under a grid line
     * every thirty pixels, which is what a printed bar chart looks like, and it
     * was the cheapest thing in the scene. The colour now comes from the same
     * palette as every other look - cold cyan and blue, hot pink only where the
     * music is - and the panels are the light source for the rest of the room,
     * which is why the crowd's rims are sampled from them. */
    {
        const int    pn   = (panels > 16) ? 16 : panels; /* panels across */
        const int    rows = 4;                         /* panels down */
        const int    pw   = (c->w + pn - 1) / pn;
        const double wtop = h * 0.052;                 /* the top rail */
        const double wh   = wall - wtop;
        int          cell = (int)(h * 0.0110);
        double       lit_p[16], top_p[16];
        int          col_r[16], col_g[16], col_b[16];
        int          pi;

        if (cell < 4)
            cell = 4;
        for (pi = 0; pi < pn; pi++) {
            double bc = band_at(m, ((double)pi + 0.5) / (double)pn);

            lit_p[pi] = bc;
            top_p[pi] = wall - wh * (0.22 + 0.70 * bc);
            /* each panel takes its own colour from the palette, so the wall
             * runs cyan to pink across the room instead of being one wash */
            art_col(bc, &col_r[pi], &col_g[pi], &col_b[pi]);
        }

        /* This loop covers four fifths of the canvas and measured as the wall's
         * whole cost, so it is written the way the water fill is: one inverse
         * per column instead of a divide per pixel, and every column written
         * through a row pointer instead of through cv_put's bounds test. */
        for (x = 0; x < c->w; x++) {
            double e    = fabs((double)x / (w > 1.0 ? w - 1.0 : 1.0) - 0.5) * 2.0;
            double fade;
            double tp, inv;
            int    y0, y1, y0l, grid;
            unsigned char *q;

            pi = x / pw;
            if (pi >= pn)
                pi = pn - 1;
            /* brightest at the middle of a panel, and dimmer at the ends of
             * the wall, so it curves away from the camera */
            fade = (1.0 - 0.34 * fabs(((double)(x - pi * pw) - (double)pw * 0.5)
                                      / ((double)pw * 0.5)))
                 * (1.0 - 0.30 * e * e);
            /* the stack rises smoothly, panel to panel, the way a spectrum
             * does: the panels are the hardware, not the shape */
            tp = wall - wh * (0.22 + 0.70
                              * band_at(m, (double)x / (w > 1.0 ? w - 1.0 : 1.0)));
            y0 = cv_i(tp);
            y1 = cv_i(wall);
            if (y0 < 0)
                y0 = 0;
            if (y1 > c->h)
                y1 = c->h;
            inv = 1.0 / (wall - tp + 1.0);
            /* the LED seam: it used to be a rect a column drawn after the
             * whole wall, which is a second pass over the same pixels. It is
             * one test here and nothing at all */
            grid = (x % cell) == 0;
            y0l  = cv_i(tp) + 2;
            if (y0l < cv_i(wtop))
                y0l = cv_i(wtop);
            q = c->p + ((size_t)y0 * (size_t)c->w + (size_t)x) * 4;
            for (; y0 < y1; y0++, q += (size_t)c->w * 4) {
                double v  = 1.0 - ((double)y0 - tp) * inv;
                double vv, hh;
                int    rr, gg, bb;
                /* one scan line in ninety-six running down the wall */
                int    scan = (((y0 + (int)(t * 150.0)) % 96) == 0) ? 14 : 0;

                if (v < 0.0)
                    v = 0.0;
                if (v > 1.0)
                    v = 1.0;
                vv = v * v * (3.0 - 2.0 * v);
                hh = vv * vv;
                hh *= hh * vv;             /* only the top of the stack burns */
                hh *= 1.0 + 0.55 * kick;   /* and it flares on the kick */
                /* The wall is the room's light, not its subject: dimmed and
                 * pushed a little further into the blue so the DJ's spot is
                 * the brightest thing in the frame. */
                rr = (int)((4.0 + (double)col_r[pi] * 0.50 * vv * fade
                            + 150.0 * hh * fade) * RV_WALL_DIM) + scan;
                gg = (int)((7.0 + (double)col_g[pi] * 0.54 * vv * fade
                            + 168.0 * hh * fade) * RV_WALL_DIM * 0.94) + scan;
                bb = (int)((20.0 + (double)col_b[pi] * 0.70 * vv * fade
                            + 178.0 * hh * fade) * (RV_WALL_DIM + 0.06)) + scan;
                if (grid && y0 >= y0l) {
                    rr = (rr * 169) / 255;
                    gg = (gg * 169) / 255;
                    bb = (bb * 169) / 255;
                }
                q[0] = (unsigned char)(rr < 0 ? 0 : rr > 255 ? 255 : rr);
                q[1] = (unsigned char)(gg < 0 ? 0 : gg > 255 ? 255 : gg);
                q[2] = (unsigned char)(bb < 0 ? 0 : bb > 255 ? 255 : bb);
            }
            /* the lit lip along the top of the stack, which is what stops the
             * column ending in a fade instead of in an edge */
            if (cv_i(tp) >= 0 && cv_i(tp) < c->h - 1)
                cv_put(c, x, cv_i(tp),
                       (int)((110.0 + (double)col_r[pi] * 0.56 * fade) * RV_WALL_DIM),
                       (int)((132.0 + (double)col_g[pi] * 0.50 * fade) * RV_WALL_DIM),
                       (int)((164.0 + (double)col_b[pi] * 0.36 * fade)
                             * (RV_WALL_DIM + 0.04)));
        }

        /* the hardware: a black bezel between the panels, a rail across the top
         * and a lip where the wall meets the floor */
        for (pi = 0; pi <= pn; pi++) {
            int bx = pi * pw;

            if (bx > c->w - 2)
                bx = c->w - 2;
            cv_rect(c, bx, cv_i(wtop), 2, (int)wh, 2, 2, 5, 240);
        }
        for (pi = 1; pi < rows; pi++)
            cv_rect(c, 0, cv_i(wtop + wh * (double)pi / (double)rows),
                    c->w, 2, 2, 2, 5, 230);
        cv_rect(c, 0, cv_i(wtop), c->w, 4, 10, 10, 16, 255);
        cv_rect(c, 0, cv_i(wall) - 3, c->w, 3, 6, 6, 11, 245);

        /* (the LED seam that used to live here is drawn inside the column
         * loop above: it is the same pixels, without a second pass over them) */

        /* the head of each panel burns into the air above it */
        for (pi = 0; pi < pn; pi++) {
            double bc = lit_p[pi];
            int    pr, pg, pb;

            if (bc < 0.08)
                continue;
            art_col(bc, &pr, &pg, &pb);
            cv_soft(c, ((double)pi + 0.5) * (double)pw, top_p[pi], h * 0.060,
                    pr, pg, pb, (int)((22.0 + 72.0 * bc) * RV_WALL_DIM));
        }
        /* the wall's wash is the room's light */
        cv_soft(c, w * 0.5, h * 0.30, w * 0.56, r, g, b, (int)(16 + 30 * lv));
    }

    /* haze, three layers, so the beams have air to sit in */
    cv_soft(c, w * 0.28, h * 0.18, w * 0.42, 96, 62, 180, 24);
    cv_soft(c, w * 0.74, h * 0.24, w * 0.38, 60, 124, 196, 22);
    cv_soft(c, w * 0.50, h * 0.52, w * 0.62, 74, 42, 126, 26);

    /* ---- truss and lamps ---- */
    bg_rect(c, 0, 0, c->w, (int)(h * 0.040), 10, 10, 16);
    for (i = 0; i < 8; i++) {
        double sx = w * (0.05 + 0.128 * (double)i);
        double ex = w * 0.5 + sin(t * 0.6 + (double)i * 0.9) * w * 0.48;
        double ey = h * (0.18 + 0.28 * fabs(sin(t * 0.8 + (double)i * 1.3)));
        int    k;

        cv_ball(c, sx, h * 0.040, h * 0.016, 18, 18, 24, 90, 90, 120);
        /* Additive sheets, widening as they fall: light through smoke adds
         * up, which is why the beam now brightens where it crosses another
         * one instead of painting over it. */
        for (k = 4; k >= 0; k--) {
            double sp = (4.0 + 7.0 * (double)k) * (0.80 + 0.50 * lv)
                      * RV_HAZE * RV_LASER_WIDTH;
            int    al = (int)((8.0 + 7.0 * (double)(4 - k)) * RV_HAZE);

            if (al < 2)
                continue;
            cv_beam_add(c, sx, h * 0.040, ex, ey, 2.5, sp, 130, 230, 255, al);
        }
        cv_soft(c, ex, ey, 16.0, 160, 240, 255, (int)(22 * RV_HAZE));
        cv_soft(c, sx, h * 0.050, h * 0.030, 170, 235, 255, (int)(20 * RV_HAZE));
    }

    /* ---- the floor: the base buffer has its gradient, this is the light on it
     * ---- */

    /* the wall runs down the polished floor: one smear per panel, which is
     * what puts the crowd in the room instead of in front of it */
    for (i = 0; i < 9; i++) {
        double u = ((double)i + 0.5) / 9.0;
        int    pr, pg, pb;

        art_col(band_at(m, u), &pr, &pg, &pb);
        cv_ell_soft(c, u * w, wall + h * 0.048, w * 0.038, h * 0.048,
                    pr, pg, pb, (int)(12 + 26 * lv));
    }

    /* the light the rig actually throws on the floor, and the coloured air over
     * it - the pools are what the crowd's rims are sampled from */
    {
        Cv *sub = soft_begin(c);
        Cv *dst = sub ? sub : c;

        /* the layer's own pixel height decides where the floor is in it */
        rv_pools(dst, m, wall * (double)dst->h / (double)c->h, lv);
        if (sub && s_paint_step < 3 && RV_HAZE > 0.01)
            soft_add(c, sub, 0.50, 0.80);
    }

    /* ---- the glossy floor: reflections, sheen, and the booth's spill ---- */
    rv_floor(c, m, wall, lv, kick);

    /* ---- the crowd, three ranks -------------------------------------------
     * The same lit capsules the dancers are built from, seen from behind, on
     * the beat, with six different moves and four different cuts. The back
     * rank is a haze of shoulders, the front rank is close enough to see a
     * phone screen, and the masking bands between them are what make the pit
     * recede instead of stacking people like shelves. */
    rave_stacks(c, m, lv);
    rave_pendants(c, m, lv, pend, ball);

    /* the smoke room's air, before anybody stands in it */
    if (set == 3) {
        cv_soft(c, w * 0.30, h * 0.50, w * 0.52, 118, 130, 158, 26);
        cv_soft(c, w * 0.72, h * 0.44, w * 0.46, 100, 118, 152, 22);
        cv_soft(c, w * 0.50, h * 0.78, w * 0.62, 92, 98, 118, 20);
    }

    {
        Kit far_k  = { 120,  92,  80, 18, 20, 32, 14, 14, 22, 11,  8, 14,
                        12,  9,  15 };
        Kit mid_k  = { 132, 102,  88, 20, 22, 36, 15, 15, 25, 12,  9, 15,
                        14, 11,  17 };
        Kit near_k = { 180, 140, 120, 30, 32, 50, 22, 22, 36, 16, 12, 18,
                        18, 14,  20 };
        int rank, thin = (s_paint_step >= 2);

        for (rank = 0; rank < 3; rank++) {
            int    n = rank == 0 ? RV_CROWD_BACK
                     : (rank == 1 ? RV_CROWD_MID : RV_CROWD_FRONT);
            double H = rank == 0 ? h * 0.126 : (rank == 1 ? h * 0.158 : h * 0.204);
            /* the ranks sit a little further back than they used to, which is
             * what leaves the front row a strip of floor to be reflected in */
            double gy = rank == 0 ? h * 0.752 : (rank == 1 ? h * 0.814 : h * 0.893);
            int    al = rank == 0 ? 172 : (rank == 1 ? 212 : 255);
            /* the back of the pit is drawn soft whatever the quality: no
             * faces, no garment detail, and the haze band over it does the
             * blur. That is the cheap version of baking the back layer. */
            int    det = thin || rank == 0;

            /* A stepped frame is painted at half the pixels, and the back of
             * the pit is then a smear of shoulders that costs as much as the
             * front rank and shows nothing: drop it, and thin the middle rank
             * to six. The masking bands stay, so the pit still recedes into
             * haze instead of stopping at a hard edge. */
            /* Stepped quality used to delete the back rank outright, which is
             * why the pit went from three rows to two and the wall behind it
             * looked like it was standing in an empty room. The row comes back
             * as silhouettes instead: same bodies, same places, a quarter of
             * the cost. Only the middle rank is thinned now. */
            if (thin && rank == 1)
                n = RV_CROWD_MID / 2;

            if (n <= 0)
                continue;

            /* the strip of floor this rank stands on, laid before them so
             * their contact shadows have something to fall on */
            cv_ell_soft(c, w * 0.5, gy + h * 0.008, w * 0.56, h * 0.024,
                        rig.fr, rig.fg, rig.fb, 22 + (int)(24 * lv));
            cv_ell_soft(c, w * 0.5, gy + h * 0.006, w * 0.34, h * 0.014,
                        rig.fr, rig.fg, rig.fb, 16 + (int)(18 * lv));

            /* the dancers stand on the platforms between the back rank and
             * the middle one, so the pit is in front of them */
            if (rank == 1)
                rave_gogo(c, m, &rig, lv);
            const Kit *kk = rank == 0 ? &far_k : (rank == 1 ? &mid_k : &near_k);

            for (i = 0; i < n; i++) {
                double r1 = sin((double)(i + rank * 17) * 12.9898) * 0.5 + 0.5;
                /* the rows are staggered against each other, so shoulders sit
                 * between shoulders and the pit reads packed instead of lined
                 * up in three neat shelves */
                double slot = (double)i
                            + (rank == 0 ? 0.18 : rank == 1 ? 0.62 : 0.34)
                            + 0.52 * r1;
                double cx = w * (slot < 0.02 ? 0.02
                               : slot > (double)n - 0.02 ? (double)n - 0.02
                               : slot) / (double)n;
                double phase = t * (4.6 + 0.6 * (double)rank)
                             + (double)i * 1.37 + (double)rank * 0.7;
                double hh = H * (1.0 + 0.22 * r1);
                double ground = gy - r1 * h * 0.014;
                Rig    pr = rig;

                art_col(band_at(m, cx / (w > 1.0 ? w : 1.0)),
                        &pr.fr, &pr.fg, &pr.fb);
                /* The pit is lit by the wall at its back, not by the stage in
                 * front of it. art_shade turns this fill into an edge on every
                 * limb, so at full wall strength every arm and leg gets a hot
                 * outline and the crowd goes pale - which is exactly what it
                 * did. Halved, it lights without outlining. */
                pr.fr = (int)((double)pr.fr * 0.52);
                pr.fg = (int)((double)pr.fg * 0.52);
                pr.fb = (int)((double)pr.fb * 0.52);
                pr.sheen *= 0.55;
                int mv = (i * 7 + rank * 5) % 12;
                int fc = 0;

                /* who has turned round. The back of the room watches the
                 * decks; the front of it is where people dance at each other,
                 * so that is where the faces are. */
                if (rank == 2)
                    fc = (i % 3 == 0) ? 2 : ((i % 4 == 1) ? 1 : 0);
                else if (rank == 1)
                    fc = (i % 5 == 2) ? 1 : 0;
                else
                    fc = (i % 7 == 3) ? 1 : 0;
                /* a loud passage turns the room round: the arms go up as the
                 * track builds, which is the pit moving with the music */
                if (lv > 0.60 && (mv == 3 || mv == 6 || mv == 11))
                    mv = (i & 1) ? 5 : 0;
                else if (lv > 0.86 && mv == 4)
                    mv = 0;

                if (rank == 0) {
                    /* The back row is seventy pixels tall, behind two bands of
                     * fog and a haze wash: what is readable there is a shape
                     * and an edge, not a wardrobe. Drawn as silhouettes at every
                     * quality it is also the single largest saving in the look,
                     * because the far rank was costing as much as the front one
                     * and showing a quarter as much. */
                    rv_sil(c, cx, ground, hh, phase, al, &pr);
                } else {
                    rave_crowd_person(c, m, cx, ground, hh, phase, al,
                                      mv, fc, &pr, kk, det, rank * 16 + i);
                    /* The stepped figure is drawn without its own rim, and a
                     * pit of flat cut-outs was the other half of why step 2
                     * looked dead. One line a person puts the wall's light
                     * back on their edge. */
                    if (thin)
                        cv_line(c, cx + hh * 0.090, ground - hh * 0.82,
                                cx + hh * 0.128, ground - hh * 0.24,
                                1.6, pr.fr, pr.fg, pr.fb, 110);
                }

                /* The unlit side of the body: one soft dark wash on the side
                 * away from the nearest beam. With the rim on the other edge
                 * this is what gives a figure a lit side and a shadow side
                 * instead of a flat fill, and it is one ellipse a person. */
                if (RV_SHADOW_SIDE > 0.01 && !det) {
                    int    li  = (int)(cx / (w > 1.0 ? w : 1.0) * 5.0);
                    double sgn = (li & 1) ? 1.0 : -1.0;
                    int    sa  = (int)(30.0 * RV_SHADOW_SIDE
                                       * (double)al / 255.0);

                    if (sa > 1)
                        cv_ell_soft(c, cx + sgn * hh * 0.26, ground - hh * 0.46,
                                    hh * 0.27, hh * 0.40, 3, 4, 11, sa);
                }
            }
            {
                /* the masking bands between the ranks breathe with the kit,
                 * so the pit reads as a moving mass and not three shelves */
                int bpb = (int)(beat_pulse(m) * 26.0);

                if (rank == 0) {
                    cv_rect(c, 0, (int)(h * 0.596), c->w, (int)(h * 0.070),
                            34, 20, 62, 48 + bpb);
                    cv_rect(c, 0, (int)(h * 0.666), c->w, (int)(h * 0.058),
                            26, 15, 48, 44 + bpb);
                } else if (rank == 1) {
                    cv_rect(c, 0, (int)(h * 0.700), c->w, (int)(h * 0.062),
                            22, 13, 42, 34 + bpb);
                }
            }

            /* ---- the floor mirrors this rank ----------------------------
             * Drawn after the rank and before the next one, so a nearer row
             * stands in front of a farther row's reflection the way it does in
             * the room. The front rank's run is clipped at the booth riser,
             * which is where its floor ends. */
            if (RV_REFLECT > 0.01 && !(s_paint_step >= 3 && rank != 2)) {
                double len = h * RV_REFLECT_LEN * (rank == 2 ? 0.55 : 1.0);

                rv_reflect(c, gy, len, h * 0.916, RV_REFLECT, bass);
            }

            /* the pools throw their light up the legs standing in them */
            if (RV_POOL_TINT > 0.01 && s_paint_step <= 2) {
                int p;

                for (p = 0; p < 3; p++) {
                    const int *lc = k_rv_laser[(p * 2 + rank) % 5];
                    double px = w * (0.22 + 0.28 * (double)p)
                              + w * 0.030 * fsind(t * 0.23 + (double)p
                                                  + (double)rank);
                    int    pa = (int)(16.0 * RV_POOL_TINT
                                      * (0.55 + 0.55 * bass));

                    if (pa > 1)
                        rv_add_ell(c, px, gy - h * 0.018, w * 0.062, h * 0.042,
                                   lc[0], lc[1], lc[2], pa);
                }
            }
        }
    }

    /* ---- the people right against the lens ----
     * The shake lives here and on the frame edge, not on the whole canvas: a
     * full-frame shift would mean moving eight megabytes a frame, and the
     * foreground moving against a steady wall is what a camera shake looks
     * like anyway. */
    rave_near_pit(c, m, lv, shx);

    /* ---- the floor fog, in front of their feet ---- */
    {
        Cv *sub = soft_begin(c);

        rv_fog(sub ? sub : c, m, wall, lv);
        if (sub && s_paint_step < 3 && RV_FOG > 0.01 && RV_FOG_KNEE > 0.01)
            soft_add(c, sub, 0.66, 1.0);
    }

    /* ---- the beams over the pit ---- */
    rave_lasers(c, m, wall, lv, beams);

    /* ---- flecks in front of all of it, so the air is not flat ---- */
    rv_flecks(c, m, wall, lv);

    /* ---- the DJ, then the booth in front of him ---- */
    rave_dj(c, m, &rig);
    rave_decks(c, m);
    rave_dj_hands(c, m, &rig);

    /* ---- the DJ's own spotlight --------------------------------------------
     * The only beam in the room that does not sweep. It is what makes him the
     * focus instead of the tallest person in the pit. Drawn before him, so he
     * stands in it. */
    {
        double jx = w * 0.5, jy = h * 0.742;

        cv_beam_add(c, jx, h * 0.040, jx, h * 0.905, h * 0.008,
                    h * (0.056 + 0.012 * lv), 232, 238, 255,
                    (int)((34 + 30 * lv) * RV_HAZE));
        cv_beam_add(c, jx, h * 0.040, jx, h * 0.905, h * 0.003, h * 0.022,
                    255, 250, 240, (int)((20 + 22 * lv) * RV_HAZE));
        cv_soft(c, jx, jy - h * 0.070, h * 0.095, 255, 244, 226,
                (int)(8 + 12 * lv));
    }

    /* ---- the CO2 jets, on the big hits ---- */
    if (lv > 0.52) {
        double a = (lv - 0.52) / 0.48;
        int    j;

        for (j = 0; j < 2; j++) {
            double jx = w * (j ? 0.665 : 0.335);
            int    k;

            for (k = 0; k < 7; k++) {
                double up = (double)k / 6.0;

                cv_soft(c, jx + fsind(t * 3.0 + (double)k * 1.7) * w * 0.014 * up,
                        h * 0.712 - up * h * 0.300,
                        w * (0.009 + 0.030 * up), 232, 242, 255,
                        (int)(28 * a * (1.0 - up)));
            }
        }
    }

    /* ---- embers in the air over the pit ---- */
    art_sparks(c, m, w * 0.02, w * 0.98, h * 0.26, h * 0.74, 44,
               190, 220, 255);

    /* ---- booth columns at the frame edges: something in front of the shot,
     * which is what makes the rest of it read as being behind it ---- */
    {
        double mw = w * 0.030;
        int    xx;

        int so = (int)shx;

        for (xx = 0; xx < (int)mw; xx++) {
            double edge = 1.0 - (double)xx / mw;
            int    sh = (int)(3 + 14 * edge * edge);

            bg_rect(c, xx + so, 0, 1, c->h, sh, sh, sh + 8);
        }
        for (xx = c->w - (int)mw; xx < c->w; xx++) {
            double edge = (double)(xx - (c->w - mw)) / mw;
            int    sh = (int)(3 + 14 * edge * edge);

            bg_rect(c, xx + so, 0, 1, c->h, sh, sh, sh + 8);
        }
        cv_line(c, mw + so, 0.0, mw + so, h, 1.8, 76, 60, 140, 120);
        cv_line(c, w - mw + so, 0.0, w - mw + so, h, 1.8, 76, 60, 140, 120);
    }

    /* ---- foreground bokeh: two heads and a shoulder, close and dark ---- */
    cv_ell_soft(c, w * 0.075 + shx, h * 0.965, w * 0.075, h * 0.070, 2, 2, 6, 190);
    cv_ell_soft(c, w * 0.075 + shx, h * 1.020, w * 0.150, h * 0.090, 2, 2, 6, 200);
    cv_ell_soft(c, w * 0.930 + shx, h * 0.995, w * 0.070, h * 0.065, 2, 2, 6, 180);
    cv_ell_soft(c, w * 0.930 + shx, h * 1.045, w * 0.145, h * 0.085, 2, 2, 6, 195);
    cv_ell_soft(c, w * 0.930, h * 0.985, w * 0.085, h * 0.060,
                120, 40, 150, 40);

    /* sweeping laser beams and thin haze over the pit */
    cv_ell_soft(c, w * 0.5, h * 0.86, w * 0.52, h * 0.030,
                120, 60, 190, (int)(18 + 26 * lv));

    /* the bloom gets a kick on the bass, which is free: art_finish is already
     * blurring a quarter-size copy, this only raises its gain for a frame */
    s_bloom_boost = RV_BLOOM_GAIN * (1.0 + 0.45 * kick);

    /* Strobe: the whole frame flashes with the level. This runs over every
     * pixel, so the constants are hoisted and the divides are constant divides
     * the compiler can turn into a multiply - it used to recompute 255*a and
     * run three divisions per pixel, and it is the one pass in the look that
     * switches itself on at exactly the loudest moment of the track. */
    if (lv > 0.62) {
        int a  = (int)((lv - 0.62) * 150.0);
        int ia, na, j, n2 = c->w * c->h;

        if (a > 110)
            a = 110;
        ia = 255 - a;
        na = 255 * a;
        for (i = 0; i < n2; i++) {
            j = i * 4;
            c->p[j + 0] = (unsigned char)((c->p[j + 0] * ia + na) / 255);
            c->p[j + 1] = (unsigned char)((c->p[j + 1] * ia + na) / 255);
            c->p[j + 2] = (unsigned char)((c->p[j + 2] * ia + na) / 255);
        }
    }
}


/* --------------------------------------------------------------- helpers --- */

static void cv_round_rect(Cv *c, double x, double y, double w, double h, double r,
                          int cr, int cg, int cb, int a)
{
    int ix, iy;

    for (iy = 0; iy < (int)h; iy++) {
        for (ix = 0; ix < (int)w; ix++) {
            double px = x + (double)ix + 0.5, py = y + (double)iy + 0.5;
            double dx = 0.0, dy = 0.0, cov;

            if (px < x + r)
                dx = (x + r) - px;
            else if (px > x + w - r)
                dx = px - (x + w - r);
            if (py < y + r)
                dy = (y + r) - py;
            else if (py > y + h - r)
                dy = py - (y + h - r);
            cov = r + 0.6 - sqrt(dx * dx + dy * dy);
            if (cov <= 0.0)
                continue;
            if (cov > 1.0)
                cov = 1.0;
            cv_set(c, (int)x + ix, (int)y + iy, cr, cg, cb, (int)(a * cov));
        }
    }
}

/* peak caps and their fall, kept between frames */
static float  s_peak[VIS_BANDS];
static int    s_peak_ready;
static double s_peak_t;

static void peaks_track(const UiModel *m)
{
    double dt = s_peak_ready ? m->elapsed_sec - s_peak_t : 0.0;
    int    i;

    if (dt < 0.0 || dt > 0.5)
        dt = 0.10;
    for (i = 0; i < VIS_BANDS; i++) {
        float b = m->vis_bands[i];

        if (!s_peak_ready || b > s_peak[i])
            s_peak[i] = b;
        else {
            s_peak[i] -= (float)(dt * 0.55);
            if (s_peak[i] < 0.0f)
                s_peak[i] = 0.0f;
        }
    }
    s_peak_ready = 1;
    s_peak_t = m->elapsed_sec;
}

static double band_at(const UiModel *m, double u)
{
    double bi = u * (double)(VIS_BANDS - 1);
    int    b0 = (int)bi, b1 = b0 + 1;
    double f;

    if (b1 >= VIS_BANDS)
        b1 = VIS_BANDS - 1;
    f = bi - b0;
    return (double)m->vis_bands[b0] * (1.0 - f) + (double)m->vis_bands[b1] * f;
}

static double wave_at(const UiModel *m, double u)
{
    double wi = u * (double)(VIS_WAVE - 1);
    int    w0 = (int)wi, w1 = w0 + 1;
    double f;

    if (w1 >= VIS_WAVE)
        w1 = VIS_WAVE - 1;
    f = wi - w0;
    return (double)m->vis_wave[w0] * (1.0 - f) + (double)m->vis_wave[w1] * f;
}

/* the palette every look shares: cold cyan through blue to hot pink */
static void art_col(double v, int *r, int *g, int *b)
{
    if (v < 0.5) {
        double t = v * 2.0;

        *r = (int)(40 + t * 40);
        *g = (int)(225 - t * 60);
        *b = (int)(205 + t * 50);
    } else {
        double t = (v - 0.5) * 2.0;

        *r = (int)(80 + t * 175);
        *g = (int)(165 - t * 80);
        *b = (int)(255);
    }
}

/* -------------------------------------------------------------- 3D camera -- */

/* Everything from here on is built in three dimensions: points in world space,
 * a camera that stands somewhere and turns, and a projection onto the canvas.
 *
 * The console's software renderer has no depth buffer, so faces are painter
 * sorted - the caller draws far boxes before near ones - which is exact for a
 * field of separate solids like these and far cheaper than a z-buffer at 1080p.
 * Each face is lit by its own normal against one light, so a box reads as a
 * box: three visible faces, three different shades. */

typedef struct { double x, y, z; } V3;

typedef struct {
    double cy, sy;              /* cos/sin of yaw   */
    double cp, sp;              /* cos/sin of pitch */
    double f;                   /* focal length, in pixels */
    double ox, oy;              /* where the camera axis meets the canvas */
    double ex, ey, ez;          /* where the camera stands */
} Cam;

static double s_fog_near = 4.0, s_fog_far = 40.0;
static int    s_fog_r = 8, s_fog_g = 12, s_fog_b = 24;

/* One light, up and to the left, in world space. */
#define ARTL_X (-0.38)
#define ARTL_Y ( 0.84)
#define ARTL_Z ( 0.39)

static void v3set(V3 *p, double x, double y, double z)
{
    p->x = x;
    p->y = y;
    p->z = z;
}

static V3 v3(double x, double y, double z)
{
    V3 p;

    v3set(&p, x, y, z);
    return p;
}

static void cam_make(Cam *k, double yaw, double pitch, double f,
                     double ox, double oy, double ex, double ey, double ez)
{
    k->cy = fcosd(yaw); k->sy = fsind(yaw);
    k->cp = fcosd(pitch); k->sp = fsind(pitch);
    k->f  = f;
    k->ox = ox; k->oy = oy;
    k->ex = ex; k->ey = ey; k->ez = ez;
}

/* World space to the canvas. 0 means the point is behind the eye: a face with
 * one corner behind the camera is dropped rather than clipped, which is the
 * one thing this renderer deliberately does not do. */
static int cam_proj(const Cam *k, V3 p, double *sx, double *sy, double *z)
{
    double x  = p.x - k->ex, y = p.y - k->ey, dz = p.z - k->ez;
    double rx =  x * k->cy - dz * k->sy;
    double rz =  x * k->sy + dz * k->cy;
    double ry =  y * k->cp - rz * k->sp;
    double rr =  y * k->sp + rz * k->cp;

    if (rr < 0.45)
        return 0;
    *sx = k->ox + rx * k->f / rr;
    *sy = k->oy - ry * k->f / rr;
    *z  = rr;
    return 1;
}

/* One flat-shaded face: lit by its normal, then pulled toward the room's
 * colour as it recedes. That pair is most of what makes a flat fill read as
 * solid geometry. */
static void face3(Cv *c, const Cam *k, const V3 *p, int r, int g, int b, int a)
{
    double xs[4], ys[4], zs[4], zm = 0.0;
    double nx, ny, nz, len, d, shade, fogt, keep;
    int    i, cr, cg, cb;

    for (i = 0; i < 4; i++) {
        if (!cam_proj(k, p[i], &xs[i], &ys[i], &zs[i]))
            return;
        zm += zs[i];
    }
    zm *= 0.25;

    nx = (p[1].y - p[0].y) * (p[2].z - p[0].z) - (p[1].z - p[0].z) * (p[2].y - p[0].y);
    ny = (p[1].z - p[0].z) * (p[2].x - p[0].x) - (p[1].x - p[0].x) * (p[2].z - p[0].z);
    nz = (p[1].x - p[0].x) * (p[2].y - p[0].y) - (p[1].y - p[0].y) * (p[2].x - p[0].x);
    len = sqrt(nx * nx + ny * ny + nz * nz);
    if (len < 1e-9)
        return;
    d = (nx * ARTL_X + ny * ARTL_Y + nz * ARTL_Z) / len;
    if (d < 0.0)
        d = -d;
    shade = 0.30 + 0.85 * d;

    fogt = (zm - s_fog_near) / (s_fog_far - s_fog_near);
    if (fogt < 0.0) fogt = 0.0;
    if (fogt > 1.0) fogt = 1.0;
    keep = 1.0 - fogt * 0.92;

    cr = (int)((double)r * shade * keep + (double)s_fog_r * fogt * 0.92);
    cg = (int)((double)g * shade * keep + (double)s_fog_g * fogt * 0.92);
    cb = (int)((double)b * shade * keep + (double)s_fog_b * fogt * 0.92);
    cv_poly(c, xs, ys, 4, clampi(cr, 0, 255), clampi(cg, 0, 255),
            clampi(cb, 0, 255), a);
}

/* A box standing on the floor at (x, z), h tall. Only the faces that look at
 * the camera are painted, which is both correct and most of the saving. With
 * refl set the box is also drawn upside down under the floor at quarter
 * strength: the reflection is what sells a polished stage, and a capped one
 * costs a fraction of a full mirror. */
static void box3(Cv *c, const Cam *k, double x, double y, double z,
                 double hw, double h, double hd,
                 int r, int g, int b, int a, int refl)
{
    V3     f[4];
    double x0 = x - hw, x1 = x + hw, z0 = z - hd, z1 = z + hd;
    int    pass;

    for (pass = 0; pass < 2; pass++) {
        double yb, yt;
        int    sa;

        if (pass) {
            double cap = h > 2.4 ? 2.4 : h;

            if (!refl)
                break;
            yb = -y;
            yt = -(y + cap);
            sa = a / 4;
        } else {
            yb = y;
            yt = y + h;
            sa = a;
        }

        if (k->ex > x1) {
            v3set(&f[0], x1, yb, z1); v3set(&f[1], x1, yb, z0);
            v3set(&f[2], x1, yt, z0); v3set(&f[3], x1, yt, z1);
            face3(c, k, f, r, g, b, sa);
        }
        if (k->ex < x0) {
            v3set(&f[0], x0, yb, z0); v3set(&f[1], x0, yb, z1);
            v3set(&f[2], x0, yt, z1); v3set(&f[3], x0, yt, z0);
            face3(c, k, f, r, g, b, sa);
        }
        if (k->ez > z1) {
            v3set(&f[0], x0, yb, z1); v3set(&f[1], x1, yb, z1);
            v3set(&f[2], x1, yt, z1); v3set(&f[3], x0, yt, z1);
            face3(c, k, f, r, g, b, sa);
        }
        if (k->ez < z0) {
            v3set(&f[0], x1, yb, z0); v3set(&f[1], x0, yb, z0);
            v3set(&f[2], x0, yt, z0); v3set(&f[3], x1, yt, z0);
            face3(c, k, f, r, g, b, sa);
        }
        if (!pass && k->ey > y + h) {
            v3set(&f[0], x0, yt, z1); v3set(&f[1], x1, yt, z1);
            v3set(&f[2], x1, yt, z0); v3set(&f[3], x0, yt, z0);
            face3(c, k, f, r + 40, g + 36, b + 30, a);
        }
    }
}

/* The stage in world space: a floor that recedes to a lit horizon, its grid,
 * and dust hanging in the air. Every 3D look starts here, so the bars, the
 * city and the corridor all share one point of view. */
static void art_stage3(Cv *c, const Cam *k, const UiModel *m,
                       int rt, int gt, int bt)
{
    double w = (double)c->w, h = (double)c->h;
    double t = m->elapsed_sec;
    int    i;

    cv_vgrad(c, 0, 0, c->w, c->h, rt, gt, bt, 2, 3, 8);
    cv_soft(c, w * 0.5, h * 0.46, w * 0.60, rt + 45, gt + 85, bt + 140, 58);

    for (i = -22; i <= 22; i += 2) {
        double x0, y0, z0, x1, y1, z1;

        if (cam_proj(k, v3((double)i, 0.0, 1.2), &x0, &y0, &z0) &&
            cam_proj(k, v3((double)i, 0.0, 44.0), &x1, &y1, &z1))
            cv_line(c, x0, y0, x1, y1, 1.2, rt + 45, gt + 90, bt + 145, 24);
    }
    for (i = 1; i <= 16; i++) {
        double z = 1.6 + (double)i * 2.6;
        double x0, y0, z0, x1, y1, z1;
        int    al = 36 - i * 2;

        if (al < 5)
            al = 5;
        if (cam_proj(k, v3(-40.0, 0.0, z), &x0, &y0, &z0) &&
            cam_proj(k, v3( 40.0, 0.0, z), &x1, &y1, &z1))
            cv_line(c, x0, y0, x1, y1, 1.0, rt + 45, gt + 90, bt + 145, al);
    }

    for (i = 0; i < 40; i++) {
        double sx, sy, sz;
        double tw = 0.5 + 0.5 * fsind(t * 1.6 + (double)i * 0.9);
        double px = fmod((double)i * 3.7 + t * ((double)(i % 5) + 1.0) * 0.4, 40.0) - 20.0;

        if (cam_proj(k, v3(px, 0.5 + (double)(i % 9) * 0.85,
                           2.5 + (double)((i * 7) % 38)), &sx, &sy, &sz))
            cv_soft(c, sx, sy, 1.2 + (double)(i % 3) * 0.5, 210, 232, 255,
                    (int)(8 + 26 * tw));
    }
}

/* A shared stage: sky, a horizon that glows, a floor that recedes and slow
 * dust in the air. The flat looks start here, so the picture reads as a place
 * with depth rather than a gradient with shapes floating on it. */
static void art_stage(Cv *c, const UiModel *m, int rt, int gt, int bt)
{
    double w = (double)c->w, h = (double)c->h;
    double horizon = h * 0.60;
    double t = m->elapsed_sec;
    int    i;

    cv_vgrad(c, 0, 0, c->w, c->h, rt, gt, bt, 2, 3, 7);
    cv_soft(c, w * 0.5, horizon, w * 0.62, rt + 40, gt + 75, bt + 120, 52);
    cv_rect(c, 0, (int)horizon, c->w, 2, rt + 80, gt + 125, bt + 180, 80);

    for (i = -12; i <= 12; i++) {
        double x0 = w * 0.5 + (double)i * w * 0.045;
        /* rays stop at the edge of the frame: drawing them out to seven screen
         * widths spent most of the stage's time off-canvas */
        double x1 = w * 0.5 + (double)i * w * 0.55;

        if (x1 < -w * 0.05) x1 = -w * 0.05;
        if (x1 >  w * 1.05) x1 =  w * 1.05;
        cv_line(c, x0, horizon, x1, h, 1.2, rt + 60, gt + 105, bt + 170, 34);
    }
    for (i = 1; i <= 7; i++) {
        double f = (double)i / 7.0;
        double y = horizon + (h - horizon) * f * f;

        cv_line(c, 0, y, w, y, 1.2, rt + 60, gt + 105, bt + 170, 40 - i * 3);
    }

    for (i = 0; i < 44; i++) {
        double sx = fmod((double)i * 137.5 + t * (4.0 + (double)(i % 5)), w);
        double sy = fmod((double)i * 71.3 + t * (1.4 + (double)(i % 3)), h * 0.95);
        double tw = 0.5 + 0.5 * fsind(t * 1.7 + (double)i * 0.9);

        cv_soft(c, sx, sy, 1.0 + (double)(i % 3) * 0.5, 210, 230, 255,
                (int)(10 + 30 * tw));
    }
}

/* ---------------------------------------------------------------- spectrum -- */

/* A wall of lit glass columns standing on the floor, seen from above and a
 * little to the side. The console gets a real perspective row instead of a
 * band of rectangles: every column has a lit face, a shaded side, a white-hot
 * cap and its own reflection in the polished floor. */
static void art_spectrum(Cv *c, const UiModel *m)
{
    const int N = VIS_BANDS;
    double    t = m->elapsed_sec;
    Cam       k;
    int       i;

    s_fog_near = 9.0;
    s_fog_far  = 30.0;
    s_fog_r = 10; s_fog_g = 14; s_fog_b = 26;
    cam_make(&k, 0.10 * fsind(t * 0.19), -0.10, (double)c->h * 1.30,
             (double)c->w * 0.5, (double)c->h * 0.56, 0.5, 1.9, -3.2);
    art_stage3(c, &k, m, 10, 13, 25);

    for (i = 0; i < N; i++) {
        double u = (double)i / (double)(N - 1);
        double v = band_at(m, u);
        double pv = (double)s_peak[i];
        double x = -9.8 + u * 19.6;
        double hgt = 0.30 + 5.8 * (0.05 + 0.95 * v);
        int    cr, cg, cb;

        art_col(u, &cr, &cg, &cb);
        box3(c, &k, x, 0.0, 11.0, 0.30, hgt, 0.30, cr, cg, cb, 250, 1);
        box3(c, &k, x, hgt, 11.0, 0.33, 0.10, 0.33, 250, 252, 255, 230, 0);
        /* the peak marker takes the column's own colour: a row of white flags
         * on top of coloured glass was the one thing in this look that did not
         * belong to it */
        if (pv > v + 0.03)
            box3(c, &k, x, 0.30 + 5.8 * (0.05 + 0.95 * pv), 11.0,
                 0.30, 0.05, 0.30,
                 clampi(cr + 90, 0, 255), clampi(cg + 90, 0, 255),
                 clampi(cb + 90, 0, 255), 120, 0);
    }

    /* the light the columns throw on the floor, and the dust in it */
    cv_ell_soft(c, (double)c->w * 0.5, (double)c->h * 0.84,
                (double)c->w * 0.40, (double)c->h * 0.055,
                60, 120, 200, (int)(26 + 34 * (double)m->vis_level));
    art_sparks(c, m, 0.0, (double)c->w, (double)c->h * 0.06,
               (double)c->h * 0.80, 26, 200, 226, 255);
}

/* ------------------------------------------------------------------- wave -- */

/* A field of traces receding to the horizon, all sampled from the same
 * waveform and each with its reflection in the floor. The near rows are wide
 * and bright, the far ones thin and dim, and the whole field shares the
 * floor's point of view. */
static void art_wave(Cv *c, const UiModel *m)
{
    const int ROWS = 18, SEG = 56;
    double    t = m->elapsed_sec;
    Cam       k;
    int       r, i;

    s_fog_near = 4.0;
    s_fog_far  = 34.0;
    s_fog_r = 9; s_fog_g = 12; s_fog_b = 24;
    cam_make(&k, 0.17 * fsind(t * 0.11), -0.24, (double)c->h * 1.18,
             (double)c->w * 0.5, (double)c->h * 0.58, 0.0, 2.4, -2.0);
    art_stage3(c, &k, m, 9, 12, 24);

    for (r = ROWS - 1; r >= 0; r--) {
        double z    = 3.4 + (double)r * 1.5;
        double amp  = 1.1 + (double)r * 0.10;
        double fogt = (z - s_fog_near) / (s_fog_far - s_fog_near);
        int    al;
        double px = 0.0, py = 0.0, qy = 0.0;
        int    have = 0;

        if (fogt < 0.0) fogt = 0.0;
        if (fogt > 1.0) fogt = 1.0;
        al = (int)(240.0 - 205.0 * fogt);

        for (i = 0; i <= SEG; i++) {
            double u  = (double)i / (double)SEG;
            double sx, sy, sz, x, y;
            int    cr, cg;

            /* Each row is the same waveform at a different depth. When the
             * phase offset was tiny the rows landed almost on top of each
             * other and the field moired into a wire mesh; a wider offset and
             * an amplitude that grows faster down the field fixes it. */
            y = 1.0 + wave_at(m, u + (double)r * 0.014) * amp;
            x = -13.0 + u * 26.0;
            if (!cam_proj(&k, v3(x, y, z), &sx, &sy, &sz)) {
                have = 0;
                continue;
            }
            /* its own reflection, for the near rows only: far ones put it
             * off the floor and just add noise */
            if (r < 14) {
                double rx, ry, rz;

                /* a reflection that lands off the canvas would draw a long
                 * diagonal streaking back to the frame edge */
                if (cam_proj(&k, v3(x, -y, z), &rx, &ry, &rz) && have &&
                    rx > 0.0 && rx < (double)c->w &&
                    ry > 0.0 && ry < (double)c->h)
                    cv_line(c, px, qy, rx, ry, 1.6 - 1.0 * fogt, 40, 110, 190,
                            al / 4);
                qy = ry;
            }
            if (have) {
                cr = 70 + (int)(150.0 * u);
                cg = 165 + (int)(70.0 * u);
                cv_line(c, px, py, sx, sy, 2.6 - 1.8 * fogt, cr, cg, 255, al);
            }
            px = sx;
            py = sy;
            have = 1;
        }
    }

    /* the horizon answers the beat, and the crests throw spray into the air */
    cv_ell_soft(c, (double)c->w * 0.5, (double)c->h * 0.58,
                (double)c->w * 0.44, (double)c->h * 0.035,
                90, 160, 230, (int)(18 + 26 * beat_pulse(m)));
    art_sparks(c, m, 0.0, (double)c->w, (double)c->h * 0.20,
               (double)c->h * 0.80, 24, 170, 214, 255);
}

/* ----------------------------------------------------------------- radial --- */

static void art_radial(Cv *c, const UiModel *m)
{
    double w = (double)c->w, h = (double)c->h;
    double cx = w * 0.5, cy = h * 0.5;
    double r0 = (h < w * 0.55 ? h : w * 0.55) * 0.255;
    double spin = m->elapsed_sec * 0.22;
    int    i, layer;

    cv_vgrad(c, 0, 0, c->w, c->h, 9, 11, 23, 8, 10, 20);
    cv_soft(c, cx, cy, r0 * 1.5, 50, 120, 210, 46);

    /* the dial: a ring of small ticks that turns the other way */
    for (i = 0; i < 96; i++) {
        double a = -spin * 1.6 + 6.2831853 * (double)i / 96.0;
        double r1 = r0 * 1.22;
        double r2 = r1 + ((i % 8 == 0) ? h * 0.035 : h * 0.016);
        int    al = (i % 8 == 0) ? 150 : 72;

        cv_line(c, cx + cos(a) * r1, cy + sin(a) * r1,
                cx + cos(a) * r2, cy + sin(a) * r2, 1.4, 130, 180, 235, al);
    }

    /* the spokes: tapered wedges, drawn three times so each one has a glow, a
     * body and a hot core instead of being one flat line */
    for (i = 0; i < VIS_BANDS; i++) {
        double a0 = spin + 6.2831853 * (double)i / (double)VIS_BANDS;
        double v = (double)m->vis_bands[i];
        double len = r0 + h * 0.04 + v * h * 0.235;
        double half = 0.012 + 0.014 * (1.0 - v);
        int    cr, cg, cb;

        art_col((double)i / (double)VIS_BANDS, &cr, &cg, &cb);

        for (layer = 0; layer < 3; layer++) {
            double k0 = layer == 0 ? 1.0 : layer == 1 ? 0.99 : 0.55;
            double kx0 = layer == 0 ? r0 * 0.98 : r0 + 4.0;
            double hw = half * (layer == 0 ? 1.7 : layer == 1 ? 1.0 : 0.30);
            double xs[4], ys[4];
            int    al = layer == 0 ? 42 : layer == 1 ? 200 : 235;
            int    r = layer == 2 ? 250 : cr;
            int    g = layer == 2 ? 252 : cg;
            int    b = layer == 2 ? 255 : cb;

            xs[0] = cx + cos(a0 - hw) * kx0;
            ys[0] = cy + sin(a0 - hw) * kx0;
            xs[1] = cx + cos(a0 + hw) * kx0;
            ys[1] = cy + sin(a0 + hw) * kx0;
            xs[2] = cx + cos(a0 + hw * 0.6) * len * k0;
            ys[2] = cy + sin(a0 + hw * 0.6) * len * k0;
            xs[3] = cx + cos(a0 - hw * 0.6) * len * k0;
            ys[3] = cy + sin(a0 - hw * 0.6) * len * k0;
            cv_poly(c, xs, ys, 4, r, g, b, al);
        }
        cv_ball(c, cx + cos(a0) * len, cy + sin(a0) * len, 2.2 + v * 4.2,
                250, 252, 255, 255, 255, 255);
    }

    /* a counter-rotating inner ring: half-length spokes between the long
     * ones, which is what turns a sunburst into a machine */
    for (i = 0; i < 24; i++) {
        double a = -spin * 2.2 + 6.2831853 * (double)i / 24.0;
        double r1 = r0 * 0.52, r2 = r0 * (0.78 + 0.10 * (double)(i % 3));

        cv_line(c, cx + cos(a) * r1, cy + sin(a) * r1,
                cx + cos(a) * r2, cy + sin(a) * r2, 1.6,
                130, 190, 245, 105);
    }
    /* a dark disc behind the hub, so the spokes stop at a surface */
    cv_ball(c, cx, cy, r0 * 0.66, 6, 8, 16, 30, 50, 86);

    /* the hub: a shaded sphere sitting in a lit well */
    cv_soft(c, cx, cy, r0, 30, 80, 150, 90);
    cv_ring(c, cx, cy, r0 * 0.95, 6.0, 50, 110, 180, 80);
    cv_ring(c, cx, cy, r0, 2.6, 210, 235, 255, 120);
    cv_ring(c, cx, cy, r0 * 0.62, 1.2, 120, 175, 230, 70);
    cv_soft(c, cx, cy, r0 * (0.34 + 0.20 * (double)m->vis_level),
            120, 200, 255, 150);

    /* an outer ring of running lamps: the dial gets a rim it can turn inside,
     * and the whole disc reads as a machine rather than a flower */
    cv_ring(c, cx, cy, r0 * 1.58, 1.2, 90, 150, 210, 46);
    for (i = 0; i < 28; i++) {
        double a = -spin * 0.85 + 6.2831853 * (double)i / 28.0;
        double on = 0.5 + 0.5 * fsind(spin * 2.4 + (double)i);

        cv_soft(c, cx + cos(a) * r0 * 1.58, cy + sin(a) * r0 * 1.58,
                1.8 + 2.2 * on, 150, 212, 255, (int)(26 + 58 * on));
    }
}
/* ------------------------------------------------------------------ pulse --- */

static void art_pulse(Cv *c, const UiModel *m)
{
    double w = (double)c->w, h = (double)c->h;
    double cx = w * 0.5, cy = h * 0.5;
    double lv = (double)m->vis_level;
    double rad = (w < h ? w : h) * (0.11 + 0.11 * lv);
    int    i, k;

    art_stage(c, m, 10, 10, 24);
    for (i = 0; i < 48; i++) {
        double sx = fmod((double)i * 73.7 + (double)(i * i) * 0.31, w);
        double sy = fmod((double)i * 39.1, h);
        double tw = 0.5 + 0.5 * sin(m->elapsed_sec * 1.7 + (double)i);

        cv_soft(c, sx, sy, 1.3 + (double)(i % 3) * 0.6, 205, 225, 255,
                (int)(30 + 70 * tw));
    }

    /* rings leaving the orb, thinning as they go */
    for (i = 0; i < 6; i++) {
        double ph = fmod(m->elapsed_sec * 0.5 + (double)i * 0.1667, 1.0);
        double rr = rad * (1.02 + ph * 4.6);
        int    al = (int)(110 * (1.0 - ph) * (0.30 + lv));

        cv_ring(c, cx, cy, rr, 3.0 * (1.0 - ph) + 0.6, 120, 215, 255, al);
    }

    cv_soft(c, cx, cy, rad * 2.1, 60, 140, 225, 55);
    /* the orb itself: dark side, bright side, rim, specular */
    cv_ball(c, cx, cy, rad * 1.02, 10, 30, 60, 90, 200, 255);
    cv_ball(c, cx, cy, rad * 0.82, 60, 130, 200, 235, 250, 255);
    cv_ring(c, cx, cy, rad * 1.0, 1.8, 230, 245, 255, 190);

    /* the meters on either side light their segments one by one */
    for (i = 0; i < VIS_BANDS; i++) {
        double v = (double)m->vis_bands[i];
        double bh = (h * 0.30) * v;
        double x = cx + rad * 1.9 + (double)i * (w * 0.0115);
        int    cr, cg, cb;

        art_col((double)i / (double)VIS_BANDS, &cr, &cg, &cb);
        for (k = 0; k < 3; k++) {
            double q = (double)k;
            double xx = x - q * 1.6;

            cv_round_rect(c, xx, cy - bh - q * 3.0, w * 0.006, bh * 2.0 + q * 6.0,
                          2.0, k == 2 ? 255 : cr, k == 2 ? 255 : cg,
                          k == 2 ? 255 : cb, k == 2 ? 26 : 70 + 40 * k);
        }
        cv_round_rect(c, x, cy - bh, w * 0.006, bh * 2.0 + 1.0, 2.0,
                      cr, cg, cb, (int)(140 + 110 * v));
        cv_round_rect(c, w - x - w * 0.006, cy - bh, w * 0.006, bh * 2.0 + 1.0,
                      2.0, cr, cg, cb, (int)(140 + 110 * v));
    }

    /* the shock of the beat: a ring of sparks thrown off the orb and dying
     * before the next one lands */
    {
        double bp = beat_pulse(m);
        double spread = 1.0 + 2.6 * (1.0 - bp);

        for (i = 0; i < 20; i++) {
            double a = 6.2831853 * (double)i / 20.0 + m->elapsed_sec * 0.30;

            cv_soft(c, cx + cos(a) * rad * spread,
                    cy + sin(a) * rad * spread * 0.94,
                    1.4 + 2.6 * bp, 180, 232, 255, (int)(52 * bp));
        }
    }
}
/* ----------------------------------------------------------------- mirror --- */

/* A corridor of lit columns on both walls, drifting past the camera, each one
 * mirrored in the wet floor. Cleared and rebuilt from the farthest column
 * every frame, so the reflections and the columns themselves stay in the right
 * order as they pass. */
static void art_mirror(Cv *c, const UiModel *m)
{
    const int N = 14;
    double    t = m->elapsed_sec;
    double    z[N];
    int       used[N];
    Cam       k;
    int       i, s2, step;

    s_fog_near = 6.0;
    s_fog_far  = 42.0;
    s_fog_r = 12; s_fog_g = 14; s_fog_b = 26;
    cam_make(&k, 0.05 * fsind(t * 0.23), -0.04, (double)c->h * 1.22,
             (double)c->w * 0.5, (double)c->h * 0.50, 0.0, 2.0, 0.0);
    art_stage3(c, &k, m, 8, 10, 20);

    /* a lit slot at the end of the corridor, and the floor's receding lines:
     * without them the columns float in a void */
    cv_ell_soft(c, (double)c->w * 0.5, (double)c->h * 0.545,
                (double)c->w * 0.26, (double)c->h * 0.045, 90, 160, 230, 84);
    for (i = 1; i < 9; i++) {
        double yy = (double)c->h * (0.565 + 0.050 * (double)i);

        cv_line(c, 0.0, yy, (double)c->w, yy, 1.0, 70, 120, 190,
                (int)(34 - 3 * i));
    }

    /* long light strips in the ceiling, and their smeared twins in the floor:
     * the corridor now has a room above it as well as a floor below */
    for (i = 0; i < 2; i++) {
        double yy = (double)c->h * (0.040 + 0.052 * (double)i);
        int    al = (int)(34 + 26 * beat_pulse(m));

        cv_line(c, 0.0, yy, (double)c->w, yy, 3.0, 96, 156, 224, al);
        cv_line(c, 0.0, (double)c->h - yy * 1.7, (double)c->w,
                (double)c->h - yy * 1.7, 2.0, 70, 130, 200, al / 2);
    }

    for (i = 0; i < N; i++) {
        z[i]    = 3.6 + fmod((double)i * 2.5 - t * 1.7 + 400.0, 30.0);
        used[i] = 0;
    }

    /* far to near, one column at a time */
    for (step = 0; step < N; step++) {
        int    far = -1;
        double fz  = -1.0;

        for (i = 0; i < N; i++)
            if (!used[i] && z[i] > fz) { fz = z[i]; far = i; }
        if (far < 0)
            break;
        used[far] = 1;

        {
            double u   = (double)(far % 7) / 6.0;
            double v   = band_at(m, u);
            double hgt = 0.6 + 4.4 * (0.10 + 0.90 * v);
            int    cr, cg, cb;

            int br, bg2, bb;

            art_col(0.15 + 0.7 * u, &cr, &cg, &cb);
            /* the body of a column is in shadow: the light is on its edge, its
             * cap and the pool it throws. Pale slabs in fog was the old look. */
            br  = (int)((double)cr * 0.70);
            bg2 = (int)((double)cg * 0.70);
            bb  = (int)((double)cb * 0.74);
            for (s2 = -1; s2 <= 1; s2 += 2) {
                double x0p, y0p, z0p, x1p, y1p, z1p;
                double inner = 4.6 * (double)s2 - (double)s2 * 0.30;

                box3(c, &k, 4.6 * (double)s2, 0.0, fz, 0.30, hgt, 0.30,
                     br, bg2, bb, 250, 1);
                /* The inner edge is where the light is. Without this the
                 * columns were pale slabs floating in fog; with it each one
                 * has a lit corner, a hot cap and a pool on the floor. */
                if (cam_proj(&k, v3(inner, 0.02, fz), &x0p, &y0p, &z0p) &&
                    cam_proj(&k, v3(inner, hgt, fz), &x1p, &y1p, &z1p)) {
                    cv_line(c, x0p, y0p, x1p, y1p, 2.4,
                            clampi(cr + 96, 0, 255), clampi(cg + 74, 0, 255),
                            clampi(cb + 34, 0, 255), 175);
                    cv_line(c, x0p, y0p, x1p, y1p, 0.9, 245, 250, 255, 110);
                    cv_soft(c, x1p, y1p, 15.0, cr, cg, cb, 95);
                    cv_ell_soft(c, x0p, (double)c->h * 0.962,
                                (double)c->w * 0.055, (double)c->h * 0.009,
                                cr, cg, cb, 46);
                }
            }
        }
    }
}

/* ----------------------------------------------------------------- blocks --- */

/* A voxel city: one tower per band, painted from the back row to the front so
 * the near towers cover the far ones. Height comes from the band, so the city
 * rises and falls with the music instead of lighting up cells in a grid. */
static void art_blocks(Cv *c, const UiModel *m)
{
    const int COLS = 10, ROWS = 6;
    double    t = m->elapsed_sec;
    Cam       k;
    int       ix, iz;

    s_fog_near = 8.0;
    s_fog_far  = 40.0;
    s_fog_r = 6; s_fog_g = 8; s_fog_b = 16;
    cam_make(&k, 0.34 + 0.12 * fsind(t * 0.16), -0.34, (double)c->h * 1.45,
             (double)c->w * 0.5, (double)c->h * 0.44, 3.4, 8.5, -5.0);
    art_stage3(c, &k, m, 6, 8, 15);

    for (iz = ROWS - 1; iz >= 0; iz--) {
        for (ix = 0; ix < COLS; ix++) {
            double u   = (double)ix / (double)(COLS - 1);
            double v   = band_at(m, u);
            double rnd = 0.55 + 0.45 * fabs(fsind((double)(ix * 7 + iz * 13)));
            double x   = ((double)ix - (double)(COLS - 1) * 0.5) * 1.55;
            double z   = 9.0 + (double)iz * 1.55;
            double hgt = 0.6 + 4.8 * (0.12 + 0.88 * v) * rnd *
                               (1.0 - (double)iz * 0.07);
            int    cr, cg, cb;

            art_col(0.12 + 0.72 * u, &cr, &cg, &cb);
            box3(c, &k, x, 0.0, z, 0.56, hgt, 0.56, cr, cg, cb, 245, 0);
            box3(c, &k, x, hgt, z, 0.58, 0.10, 0.58, 250, 246, 255, 190, 0);
        }
    }

    /* three searchlights raking the city: the sky needs something in it, and
     * this is what makes a voxel field look like a place with weather */
    for (ix = 0; ix < 3; ix++) {
        double ox = (double)c->w * (0.24 + 0.26 * (double)ix);
        double sw = fsind(t * 0.31 + (double)ix * 1.9) * (double)c->w * 0.16;
        int    k2;

        int    col_r, col_g, col_b;

        art_col(0.12 + 0.30 * (double)ix, &col_r, &col_g, &col_b);
        for (k2 = 3; k2 >= 0; k2--) {
            double sp = (double)c->w * (0.006 + 0.016 * (double)k2);
            int    al = (int)((3.0 + 2.4 * (double)k2)
                              * (0.30 + 0.7 * (double)m->vis_level));

            cv_poly(c, (double[]){ ox - 2.5, ox + 2.5,
                                   ox + sw + sp, ox + sw - sp },
                       (double[]){ 0.0, 0.0, (double)c->h * 0.60,
                                   (double)c->h * 0.60 }, 4,
                    col_r, col_g, col_b, al);
        }
        cv_line(c, ox, 0.0, ox + sw, (double)c->h * 0.60, 0.8,
                col_r + 120, col_g + 110, col_b + 100, 60);
    }
}

/* ------------------------------------------------------------------ scope --- */

static void art_scope(Cv *c, const UiModel *m)
{
    double mid = (double)c->h * 0.5;
    double h = (double)c->h;
    int    i, k;

    cv_vgrad(c, 0, 0, c->w, c->h, 4, 12, 8, 6, 16, 10);
    for (i = 0; i < c->w; i += (int)((double)c->w / 10.0) + 1)
        cv_rect(c, i, 0, 1, c->h, 40, 120, 70, 60);
    for (i = 0; i < c->h; i += (int)((double)c->h / 6.0) + 1)
        cv_rect(c, 0, i, c->w, 1, 40, 120, 70, 60);
    cv_rect(c, 0, (int)mid, c->w, 1, 60, 170, 100, 90);

    for (i = 3; i >= 1; i--) {
        double px_ = 0.0, py_ = 0.0;

        for (k = 0; k < c->w; k++) {
            double u = (double)k / (double)((c->w > 1) ? c->w - 1 : 1);
            double idx = u + (double)i * 0.006;
            double y, x;

            if (idx > 1.0)
                idx -= 1.0;
            y = mid - wave_at(m, idx) * h * 0.42;
            x = (double)k;
            if (y < 2.0)
                y = 2.0;
            if (y > h - 2.0)
                y = h - 2.0;
            if (k > 0)
                cv_line(c, px_, py_, x, y, 2.0, 60, 220, 120, 30 / i);
            px_ = x;
            py_ = y;
        }
    }
    /* the glass of the tube, a row of faint scanlines leaning on everything */
    for (k = 0; k < c->h; k += 3)
        cv_rect(c, 0, k, c->w, 1, 0, 6, 2, 30);

    {
        double px_ = 0.0, py_ = 0.0;

        for (k = 0; k < c->w; k++) {
            double u = (double)k / (double)((c->w > 1) ? c->w - 1 : 1);
            double y = mid - wave_at(m, u) * h * 0.42;
            double x = (double)k;

            if (y < 2.0)
                y = 2.0;
            if (y > h - 2.0)
                y = h - 2.0;
            if (k > 0) {
                cv_line(c, px_, py_, x, y, 9.0, 40, 200, 90, 26);
                cv_line(c, px_, py_, x, y, 3.4, 120, 255, 160, 210);
                cv_line(c, px_, py_, x, y, 1.4, 240, 255, 240, 240);
            }
            px_ = x;
            py_ = y;
        }
    }

    /* a second channel, mirrored under the axis at a third of the weight:
     * the tube now carries a stereo pair the way a real scope does */
    {
        double px_ = 0.0, py_ = 0.0;

        for (k = 0; k < c->w; k++) {
            double u = (double)k / (double)((c->w > 1) ? c->w - 1 : 1);
            double y = mid + wave_at(m, fmod(u + 0.5, 1.0)) * h * 0.21;
            double x = (double)k;

            if (k > 0) {
                cv_line(c, px_, py_, x, y, 2.6, 30, 150, 190, 60);
                cv_line(c, px_, py_, x, y, 1.2, 90, 230, 240, 130);
            }
            px_ = x;
            py_ = y;
        }
    }
    /* peak dots, one every sixteenth of the screen */
    for (k = 16; k < c->w - 16; k += 16) {
        double u  = (double)k / (double)((c->w > 1) ? c->w - 1 : 1);
        double u0 = (double)(k - 8) / (double)((c->w > 1) ? c->w - 1 : 1);
        double u1 = (double)(k + 8) / (double)((c->w > 1) ? c->w - 1 : 1);
        double y  = mid - wave_at(m, u) * h * 0.42;
        double y0 = mid - wave_at(m, u0) * h * 0.42;
        double y1 = mid - wave_at(m, u1) * h * 0.42;

        if (y <= y0 && y <= y1) {
            cv_ball(c, (double)k, y, 2.4, 210, 255, 220, 255, 255, 255);
            cv_soft(c, (double)k, y, 6.0, 120, 255, 170, 40);
        }
    }

    /* the sweep: a cursor riding the trace, with the phosphor bloom a real
     * tube leaves behind it */
    {
        double ph = fmod(m->elapsed_sec * 0.33, 1.0);
        double x = ph * (double)c->w;
        double y = mid - wave_at(m, ph) * h * 0.42;

        cv_line(c, x, 0.0, x, (double)c->h, 1.0, 60, 220, 120, 44);
        cv_soft(c, x, y, 14.0, 120, 255, 170, 90);
        cv_ball(c, x, y, 3.2, 226, 255, 236, 255, 255, 255);
    }
}

/* ------------------------------------------------------------------ orbit --- */


/* An orbit drawn as an ellipse rather than a circle, with the near half lit
 * and the far half fading into the dark. A flat ring reads as a target; a
 * tilted one with a lit front reads as something going round a body in space,
 * which is the whole point of the look. Segmented finely enough that the curve
 * stays smooth at 1080p. */
static void orbit_ring(Cv *c, double cx, double cy, double rad, double tilt,
                       double lv)
{
    int k, n = 128;

    for (k = 0; k < n; k++) {
        double a0  = 6.2831853 * (double)k / (double)n;
        double a1  = 6.2831853 * (double)(k + 1) / (double)n;
        double z0  = sin(a0), z1 = sin(a1);
        double dep = 0.5 + 0.5 * (z0 + z1) * 0.5;
        double x0  = cx + cos(a0) * rad, y0 = cy + z0 * rad * tilt;
        double x1  = cx + cos(a1) * rad, y1 = cy + z1 * rad * tilt;

        cv_line(c, x0, y0, x1, y1, 2.0 + 2.4 * dep,
                40, 70, 140, (int)(26 + 72 * dep));
        cv_line(c, x0, y0, x1, y1, 0.8 + 0.9 * dep,
                110, 150, 225, (int)((30 + 122 * dep) * (0.75 + 0.25 * lv)));
    }
}

static void art_orbit(Cv *c, const UiModel *m)
{
    double w = (double)c->w, h = (double)c->h;
    double cx = w * 0.5, cy = h * 0.5;
    double small_ = w < h ? w : h;
    double t = m->elapsed_sec;
    int    i, ring;

    art_stage(c, m, 6, 7, 20);
    for (i = 0; i < 60; i++) {
        double sx = fmod((double)i * 91.3, w);
        double sy = fmod((double)i * 53.9, h);
        double tw = 0.5 + 0.5 * sin(t * 1.4 + (double)i);

        cv_soft(c, sx, sy, 1.2 + (double)(i % 3) * 0.6, 220, 235, 255,
                (int)(30 + 60 * tw));
    }
    /* dust in the system, lit from the star at its centre */
    art_sparks(c, m, 0.0, w, h * 0.12, h * 0.88, 30, 232, 196, 255);

    cv_soft(c, cx, cy, small_ * 0.34, 255, 150, 220, (int)(40 + 70 * m->vis_level));
    cv_ball(c, cx, cy, small_ * (0.058 + 0.034 * (double)m->vis_level),
            255, 200, 235, 255, 255, 255);
    /* a comet on a long ellipse, trailing sparks behind it: the system has
     * something moving through it now, not just rings */
    {
        double ca = t * 0.42, crx = small_ * 0.46, cry = small_ * 0.15;
        int    k2;

        for (k2 = 14; k2 >= 0; k2--) {
            double aa = ca - (double)k2 * 0.045;
            double tail = 1.0 - (double)k2 / 15.0;

            cv_soft(c, cx + cos(aa) * crx, cy + sin(aa) * cry,
                    2.0 + 4.0 * tail, 220, 240, 255,
                    (int)(16 + 60 * tail));
        }
        cv_ball(c, cx + cos(ca) * crx, cy + sin(ca) * cry, 4.2,
                250, 250, 255, 255, 255, 255);
    }

    for (ring = 0; ring < 3; ring++) {
        double rad = small_ * (0.29 + 0.14 * (double)ring);
        double speed = 0.55 - 0.12 * (double)ring;
        double tilt = 0.30 + 0.09 * (double)ring;

        orbit_ring(c, cx, cy, rad, tilt, (double)m->vis_level);
        for (i = 0; i < VIS_BANDS; i += 2) {
            int    b = (i + ring * 3) % VIS_BANDS;
            double v = (double)m->vis_bands[b];
            double a = t * speed + 6.2831853 * (double)i / (double)VIS_BANDS;
            double rr = rad + v * small_ * 0.09;
            double dep = 0.5 + 0.5 * sin(a);      /* lit at the front */
            double px_ = cx + cos(a) * rr;
            double py_ = cy + sin(a) * rr * tilt;
            int    cr, cg, cb, k;

            art_col((double)b / (double)VIS_BANDS, &cr, &cg, &cb);
            for (k = 1; k <= 5; k++) {
                double ta = a - (double)k * 0.05 * speed;

                cv_soft(c, cx + cos(ta) * rr,
                        cy + sin(ta) * rr * tilt,
                        2.4 + v * 2.0, cr, cg, cb,
                        (int)((60 - k * 10) * (0.45 + 0.55 * dep)));
            }
            cv_soft(c, px_, py_, (7.0 + v * 6.0) * (0.70 + 0.45 * dep), cr, cg, cb,
                    (int)((60 + 90 * v) * (0.55 + 0.45 * dep)));
            cv_ball(c, px_, py_, (3.4 + v * 4.4) * (0.74 + 0.38 * dep),
                    cr, cg, cb, 255, 255, 255);
        }
    }
}

/* ------------------------------------------------------------------- neon --- */

static void art_neon(Cv *c, const UiModel *m)
{
    double w = (double)c->w, h = (double)c->h;
    double cx = w * 0.5, cy = h * 0.5;
    double small_ = w < h ? w : h;
    double ring = small_ * 0.24 + (double)m->vis_level * small_ * 0.06;
    int    i, k;

    art_stage(c, m, 4, 6, 16);

    for (k = 6; k >= 1; k--)
        cv_ring(c, cx, cy, ring, (double)k * 4.0, 30, 120, 230, 26 - k * 3);

    cv_ring(c, cx, cy, ring, 9.0, 24, 70, 170, 255);
    cv_ring(c, cx, cy, ring, 5.0, 70, 175, 255, 255);
    cv_ring(c, cx, cy, ring, 1.8, 235, 250, 255, 255);

    for (i = 0; i < 40; i++) {
        double a0 = m->elapsed_sec * 1.6 + (double)i * 0.02;
        double a1 = a0 + 0.02;

        cv_line(c, cx + cos(a0) * ring, cy + sin(a0) * ring,
                cx + cos(a1) * ring, cy + sin(a1) * ring, 9.0,
                180, 235, 255, 160);
    }

    for (i = 0; i < VIS_BANDS; i++) {
        double a = 6.2831853 * (double)i / (double)VIS_BANDS - 1.5707963;
        double v = (double)m->vis_bands[i];
        double r0 = ring + 8.0;
        double r1 = r0 + 6.0 + v * small_ * 0.26;
        double x0 = cx + cos(a) * r0, y0 = cy + sin(a) * r0;
        double x1 = cx + cos(a) * r1, y1 = cy + sin(a) * r1;

        cv_line(c, x0, y0, x1, y1, 10.0, 30, 90, 200, 40);
        cv_line(c, x0, y0, x1, y1, 5.0, 70, 175, 255, 200);
        cv_line(c, x0, y0, x1, y1, 2.0, 240, 252, 255, 230);
        cv_ball(c, x1, y1, 2.6 + v * 3.0, 235, 250, 255, 255, 255, 255);
    }

    cv_soft(c, cx, cy, ring * 1.1, 90, 190, 255, 90);
    cv_ball(c, cx, cy, 7.0 + (double)m->vis_level * small_ * 0.05,
            200, 240, 255, 255, 255, 255);

    /* the sign in a wet street: three flattened smears of it below the ring,
     * each one wider, fainter and further down */
    for (k = 0; k < 3; k++) {
        double d = 0.10 + 0.09 * (double)k;

        cv_ell_soft(c, cx, cy + ring + small_ * d,
                    ring * (0.72 + 0.10 * (double)k), small_ * 0.016,
                    70, 175, 255, 56 - 14 * k);
    }
    /* and a low fog drifting past, which is what neon needs to glow into */
    cv_ell_soft(c, cx + small_ * 0.10, cy + ring * 0.55,
                small_ * 0.42, small_ * 0.05, 90, 165, 220, 26);
}


/* ------------------------------------------------------------- tesseract -- */

typedef struct { double x, y, z, w; } T4;

typedef struct { double m[3][3]; } M3;

static double t4_rand(unsigned *s)
{
    *s = *s * 1664525u + 1013904223u;
    return (double)((*s >> 9) & 0x7fffu) / 32767.0;
}

static void t4_rot(T4 *v, int a, int b, double ang)
{
    double *p[4];
    double ca = cos(ang), sa = sin(ang), na, nb;

    p[0] = &v->x; p[1] = &v->y; p[2] = &v->z; p[3] = &v->w;
    na = *p[a] * ca - *p[b] * sa;
    nb = *p[a] * sa + *p[b] * ca;
    *p[a] = na;
    *p[b] = nb;
}

static void m3_apply(const M3 *m, double x, double y, double z,
                     double *ox, double *oy, double *oz)
{
    *ox = m->m[0][0] * x + m->m[0][1] * y + m->m[0][2] * z;
    *oy = m->m[1][0] * x + m->m[1][1] * y + m->m[1][2] * z;
    *oz = m->m[2][0] * x + m->m[2][1] * y + m->m[2][2] * z;
}

static void m3_transpose(M3 *o, const M3 *a)
{
    int i, j;

    for (i = 0; i < 3; i++)
        for (j = 0; j < 3; j++)
            o->m[i][j] = a->m[j][i];
}

static void m3_rot(M3 *o, double yaw, double pitch, double roll)
{
    double cy_ = cos(yaw),   sy_ = sin(yaw);
    double cp  = cos(pitch), sp  = sin(pitch);
    double cr  = cos(roll),  sr  = sin(roll);
    M3     ry, rx, rz, tmp;

    ry.m[0][0] = cy_;  ry.m[0][1] = 0.0;  ry.m[0][2] = sy_;
    ry.m[1][0] = 0.0;  ry.m[1][1] = 1.0;  ry.m[1][2] = 0.0;
    ry.m[2][0] = -sy_; ry.m[2][1] = 0.0;  ry.m[2][2] = cy_;

    rx.m[0][0] = 1.0;  rx.m[0][1] = 0.0;  rx.m[0][2] = 0.0;
    rx.m[1][0] = 0.0;  rx.m[1][1] = cp;   rx.m[1][2] = -sp;
    rx.m[2][0] = 0.0;  rx.m[2][1] = sp;   rx.m[2][2] = cp;

    rz.m[0][0] = cr;   rz.m[0][1] = -sr;  rz.m[0][2] = 0.0;
    rz.m[1][0] = sr;   rz.m[1][1] = cr;   rz.m[1][2] = 0.0;
    rz.m[2][0] = 0.0;  rz.m[2][1] = 0.0;  rz.m[2][2] = 1.0;

    {
        int i, j, k;

        for (i = 0; i < 3; i++)
            for (j = 0; j < 3; j++) {
                double sum = 0.0;

                for (k = 0; k < 3; k++)
                    sum += rz.m[i][k] * rx.m[k][j];
                tmp.m[i][j] = sum;
            }
        for (i = 0; i < 3; i++)
            for (j = 0; j < 3; j++) {
                double sum = 0.0;

                for (k = 0; k < 3; k++)
                    sum += tmp.m[i][k] * ry.m[k][j];
                o->m[i][j] = sum;
            }
    }
}

/* The small tesseracts that share the room. They are drawn with the same
 * design as the big one, so they read as the same kind of object, and they
 * carry position and speed because they actually fly, bounce off the walls
 * and knock into the big cage and into each other. */
#define TESS_SATS 4

typedef struct {
    double x, y;        /* position across the canvas, 0..1 */
    double vx, vy;      /* speed in canvas widths per second */
    double size;        /* scale against the big cage */
    double spin, spinv; /* its own four-dimensional twist */
    double bounce;      /* impact flash, decays */
    int    init;
} TessSat;

/* Every piece of the scene's memory: the bloom and the cage's drift. */
static struct {
    TessSat  sat[TESS_SATS];
    double   hit;                   /* the cage was struck this beat */
    int      init;
    double   last_level;
    unsigned seed;
    double   dir[3];
    double   amp, age;
    double   tx, ty, tvx, tvy;
    double   yaw, pitch, roll;      /* the badge, turning on the spot */
    double   echo[3][3];
    double   echo_age[3];
    int      echo_i;
    double   prev_t;
} s_tess;

/* One frame: a new random bloom on every jump in level, then the cage drifts
 * and bounces off the walls of the room. The badge does not fly: it hangs at
 * the centre of the cage, turning on the spot, and grows with the bloom. */
/* One collision between two flying cages, worked out in pixels so an impact
 * looks the same whatever the canvas is called. */
static void sat_collide(TessSat *a, TessSat *b, double w, double h, double rmin)
{
    double dx = (a->x - b->x) * w, dy = (a->y - b->y) * h;
    double d  = sqrt(dx * dx + dy * dy);
    double nx, ny, overlap, apx, apy, bpx, bpy, rel, imp;

    if (d >= rmin || d < 1e-4)
        return;
    nx = dx / d;
    ny = dy / d;
    overlap = (rmin - d) * 0.5;
    a->x += (nx * overlap) / w;
    a->y += (ny * overlap) / h;
    b->x -= (nx * overlap) / w;
    b->y -= (ny * overlap) / h;

    apx = a->vx * w; apy = a->vy * h;
    bpx = b->vx * w; bpy = b->vy * h;
    rel = (apx - bpx) * nx + (apy - bpy) * ny;
    if (rel > 0.0)
        return;                     /* already separating */
    imp = -1.92 * rel * 0.5;
    apx += imp * nx; apy += imp * ny;
    bpx -= imp * nx; bpy -= imp * ny;
    a->vx = apx / w; a->vy = apy / h;
    b->vx = bpx / w; b->vy = bpy / h;
    a->bounce = b->bounce = 1.0;
}

static void tess_tick(const UiModel *m, double w, double h)
{
    double dt, lv = (double)m->vis_level;

    if (!s_tess.init) {
        s_tess.seed = 0x2545f491u;
        s_tess.tx = 0.50;
        s_tess.ty = 0.52;
        s_tess.tvx = 0.26;
        s_tess.tvy = 0.18;
        s_tess.yaw = 0.40;
        s_tess.pitch = -0.10;
        s_tess.roll = 0.0;
        s_tess.last_level = lv;
        s_tess.prev_t = m->elapsed_sec;
        s_tess.init = 1;
    }

    dt = m->elapsed_sec - s_tess.prev_t;
    if (dt <= 0.0 || dt > 0.12)
        dt = 0.033;
    s_tess.prev_t = m->elapsed_sec;

    if (lv > s_tess.last_level + 0.05 && lv > 0.28) {
        int e = s_tess.echo_i % 3;

        s_tess.dir[0] = t4_rand(&s_tess.seed) * 2.0 - 1.0;
        s_tess.dir[1] = t4_rand(&s_tess.seed) * 2.0 - 1.0;
        s_tess.dir[2] = t4_rand(&s_tess.seed) * 2.0 - 1.0;
        s_tess.amp = 0.50 + 0.95 * lv;
        s_tess.age = 0.0;
        s_tess.tvx += s_tess.dir[0] * 0.30 * lv;
        s_tess.tvy += s_tess.dir[1] * 0.30 * lv;

        s_tess.echo[e][0] = s_tess.dir[0];
        s_tess.echo[e][1] = s_tess.dir[1];
        s_tess.echo[e][2] = s_tess.dir[2];
        s_tess.echo_age[e] = 0.0;
        s_tess.echo_i++;
    }
    s_tess.last_level += (lv - s_tess.last_level) * (lv > s_tess.last_level ? 0.50 : 0.10);
    s_tess.age += dt;

    {
        int i;

        for (i = 0; i < 3; i++)
            s_tess.echo_age[i] += dt;
    }

    s_tess.tx += s_tess.tvx * dt;
    s_tess.ty += s_tess.tvy * dt;
    s_tess.tvx *= 0.996;
    s_tess.tvy *= 0.996;
    s_tess.tvx += 0.05 * sin(m->elapsed_sec * 0.70);
    s_tess.tvy += 0.04 * cos(m->elapsed_sec * 0.53);
    if (s_tess.tx < 0.28) { s_tess.tx = 0.28; s_tess.tvx = fabs(s_tess.tvx) * 0.95 + 0.05; }
    if (s_tess.tx > 0.72) { s_tess.tx = 0.72; s_tess.tvx = -fabs(s_tess.tvx) * 0.95 - 0.05; }
    if (s_tess.ty < 0.28) { s_tess.ty = 0.28; s_tess.tvy = fabs(s_tess.tvy) * 0.95 + 0.05; }
    if (s_tess.ty > 0.70) { s_tess.ty = 0.70; s_tess.tvy = -fabs(s_tess.tvy) * 0.95 - 0.05; }

    /* the badge turns where it hangs, a touch faster when the music moves */
    s_tess.yaw += dt * (0.52 + 0.85 * lv);
    s_tess.pitch = 0.26 * sin(m->elapsed_sec * 0.41);
    s_tess.roll = 0.16 * sin(m->elapsed_sec * 0.27 + 1.2);

    /* The small cages: their own drift, their own bounce, and real collisions
     * with the walls, the big cage and each other. */
    {
        double small = w < h ? w : h;
        double sc    = small * 0.215;
        int    i, j;

        if (!s_tess.sat[0].init) {
            for (i = 0; i < TESS_SATS; i++) {
                TessSat *s = &s_tess.sat[i];

                s->x    = 0.20 + 0.60 * t4_rand(&s_tess.seed);
                s->y    = 0.24 + 0.52 * t4_rand(&s_tess.seed);
                s->vx   = (t4_rand(&s_tess.seed) * 2.0 - 1.0) * 0.085;
                s->vy   = (t4_rand(&s_tess.seed) * 2.0 - 1.0) * 0.060;
                s->size = 0.34 + 0.20 * t4_rand(&s_tess.seed);
                s->spin = t4_rand(&s_tess.seed) * 6.28;
                s->spinv = 0.30 + 0.60 * t4_rand(&s_tess.seed);
                s->bounce = 0.0;
                s->init = 1;
            }
        }

        s_tess.hit *= 0.90;

        for (i = 0; i < TESS_SATS; i++) {
            TessSat *a = &s_tess.sat[i];

            a->x += a->vx * dt;
            a->y += a->vy * dt;
            a->vx += 0.030 * dt * fsind(m->elapsed_sec * 0.70 + (double)i * 1.3);
            a->vy += 0.030 * dt * fcosd(m->elapsed_sec * 0.60 + (double)i * 0.9);
            a->bounce *= exp(-dt * 2.6);
            a->spin += a->spinv * dt * (1.0 + 0.8 * lv);

            if (a->x < 0.10) { a->x = 0.10; a->vx = fabs(a->vx) * 0.92; a->bounce = 1.0; }
            if (a->x > 0.90) { a->x = 0.90; a->vx = -fabs(a->vx) * 0.92; a->bounce = 1.0; }
            if (a->y < 0.22) { a->y = 0.22; a->vy = fabs(a->vy) * 0.92; a->bounce = 1.0; }
            if (a->y > 0.76) { a->y = 0.76; a->vy = -fabs(a->vy) * 0.92; a->bounce = 1.0; }

            /* the big cage is an obstacle they cannot pass through, and it
             * hands them back part of its own speed */
            {
                double dx = (a->x - s_tess.tx) * w;
                double dy = (a->y - s_tess.ty) * h;
                double d  = sqrt(dx * dx + dy * dy);
                double rmin = 0.30 * small * (1.0 + a->size);

                if (d < rmin && d > 1e-4) {
                    double nx = dx / d, ny = dy / d;
                    double vn, push = rmin - d;

                    a->x += (nx * push) / w;
                    a->y += (ny * push) / h;
                    vn = (a->vx * w) * nx + (a->vy * h) * ny;
                    if (vn < 0.0) {
                        a->vx -= 1.85 * vn * nx / w;
                        a->vy -= 1.85 * vn * ny / h;
                        a->bounce = 1.0;
                        s_tess.hit = 1.0;
                    }
                    a->vx += s_tess.tvx * 0.35;
                    a->vy += s_tess.tvy * 0.35;
                }
            }

            for (j = i + 1; j < TESS_SATS; j++) {
                double rmin = 0.22 * small * (a->size + s_tess.sat[j].size);

                sat_collide(a, &s_tess.sat[j], w, h, rmin);
            }
            (void)sc;
        }
    }
}

/* ----------------------------------------------------------------- badge -- */

#define PS_BADGE_LAYERS 16

/* bilinear coverage out of the traced silhouette */
static double ps_alpha_at(double u, double v)
{
    int    x = (int)floor(u), y = (int)floor(v);
    double fx, fy;

    if (x < 0 || y < 0 || x >= PS_MARK_W - 1 || y >= PS_MARK_HEIGHT - 1)
        return 0.0;
    fx = u - x;
    fy = v - y;
    {
        double a = ps_mark_alpha[y * PS_MARK_W + x];
        double b = ps_mark_alpha[y * PS_MARK_W + x + 1];
        double c2 = ps_mark_alpha[(y + 1) * PS_MARK_W + x];
        double d = ps_mark_alpha[(y + 1) * PS_MARK_W + x + 1];

        return ((a * (1.0 - fx) + b * fx) * (1.0 - fy) +
                (c2 * (1.0 - fx) + d * fx) * fy) / 255.0;
    }
}

/* The PlayStation mark as a solid. The real silhouette is the slice: nine of
 * them are stacked through the depth of the object and drawn back to front,
 * each in its own shade of steel, so the logo has genuine thickness, chamfered
 * sides and a polished face with a travelling sheen. Because the shape comes
 * from the traced outline, every pixel of every slice is the actual logo. */
static void tess_badge(Cv *c, double sx, double sy, double height,
                       double yaw, double pitch, double roll, double sweep)
{
    M3     rot, inv;
    double hw, hh, depth, inv22;
    int    k;

    if (height < 8.0)
        return;

    hw = height * (double)PS_MARK_W / (double)PS_MARK_HEIGHT * 0.5;
    hh = height * 0.5;
    depth = height * 0.22;

    m3_rot(&rot, yaw, pitch, roll);
    m3_transpose(&inv, &rot);
    inv22 = inv.m[2][2];
    if (fabs(inv22) < 1e-3)
        inv22 = inv22 < 0.0 ? -1e-3 : 1e-3;

    for (k = 0; k < PS_BADGE_LAYERS; k++) {
        double t = (double)k / (double)(PS_BADGE_LAYERS - 1);
        double z = (-0.5 + t) * depth;
        double x0 = 1e9, x1 = -1e9, y0 = 1e9, y1 = -1e9;
        int    i, x, y;

        for (i = 0; i < 4; i++) {
            double u = (i & 1) ? hw : -hw;
            double v = (i & 2) ? hh : -hh;
            double rx, ry, rz, qx, qy;

            m3_apply(&rot, u, v, z, &rx, &ry, &rz);
            (void)rz;
            qx = sx + rx;
            qy = sy + ry;
            if (qx < x0) x0 = qx;
            if (qx > x1) x1 = qx;
            if (qy < y0) y0 = qy;
            if (qy > y1) y1 = qy;
        }

        for (y = (int)floor(y0) - 1; y <= (int)ceil(y1) + 1; y++) {
            for (x = (int)floor(x0) - 1; x <= (int)ceil(x1) + 1; x++) {
                double dx = x + 0.5 - sx, dy = y + 0.5 - sy;
                double lam, lx, ly, cov;
                int    r, g, b, al;

                /* the plane this slice lives on, hit by the view ray */
                lam = (z - (inv.m[2][0] * dx + inv.m[2][1] * dy)) / inv22;
                lx = inv.m[0][0] * dx + inv.m[0][1] * dy + inv.m[0][2] * lam;
                ly = inv.m[1][0] * dx + inv.m[1][1] * dy + inv.m[1][2] * lam;
                if (lx < -hw - 1.0 || lx > hw + 1.0 ||
                    ly < -hh - 1.0 || ly > hh + 1.0)
                    continue;
                /* the mask is PS_MARK_W x PS_MARK_HEIGHT texels, the badge is
                 * 2*hw x 2*hh pixels: sample in texel space */
                cov = ps_alpha_at((lx + hw) / (hw * 2.0) * (double)PS_MARK_W,
                                  (ly + hh) / (hh * 2.0) * (double)PS_MARK_HEIGHT);
                if (cov < 0.02)
                    continue;

                if (k == PS_BADGE_LAYERS - 1) {
                    double ux = (lx + hw) / (hw * 2.0);
                    double uy = (ly + hh) / (hh * 2.0);
                    /* polished steel: a vertical ramp, a diagonal sheen that
                     * travels across the face, a cool tint low down and a lit
                     * edge all the way round the silhouette */
                    double met = 0.62 + 0.38 * cos((uy - 0.28) * 2.2);
                    double hi = exp(-(ux - sweep) * (ux - sweep) / 0.020);
                    double rim = cov < 0.90 ? (0.90 - cov) * 1.9 : 0.0;
                    double cool = uy > 0.55 ? (uy - 0.55) * 0.55 : 0.0;
                    /* brushed steel: two fine ripple frequencies across the
                     * face, so the metal has a grain instead of a clean
                     * gradient - at full resolution that is the difference
                     * between a surface and a decal */
                    double gr = 0.5 * fsind(uy * 420.0 + ux * 40.0) +
                                0.5 * fsind(uy * 151.0 + 2.3);

                    r = (int)(200 * met + 70 * hi + 150 * rim - 40 * cool + 13 * gr);
                    g = (int)(218 * met + 58 * hi + 160 * rim - 20 * cool + 13 * gr);
                    b = (int)(240 * met + 40 * hi + 170 * rim + 11 * gr);
                } else {
                    double sh = t * t;

                    r = (int)(24 + 190 * sh);
                    g = (int)(50 + 186 * sh);
                    b = (int)(100 + 140 * sh);
                }
                al = (int)(cov * 255.0);
                cv_set(c, x, y, r > 255 ? 255 : r, g > 255 ? 255 : g,
                       b > 255 ? 255 : b, al);
            }
        }
    }
}

/* one cell of the tesseract: its glass faces, its twelve edges, its corners */
static void tess_cell(Cv *c, const double *px, const double *py,
                      const double *pz, int near, double lv)
{
    int base = near ? 8 : 0, a, s, q, i, e;

    /* Winding order, not bit order: (0,0) (1,0) (1,1) (0,1). The panes are
     * filled from this so the texture map is not a bowtie. */
    static const int qord[4] = { 0, 1, 3, 2 };

    for (a = 0; a < 3; a++) {
        int    o1 = (a + 1) % 3, o2 = (a + 2) % 3;
        int    front = 0;
        double fz = -1e9;

        /* Of the two panes on this axis, the one whose corners sit nearer the
         * eye is the one that gets the full treatment: the pane behind it stays
         * a faint wash, so the cell still reads as glass rather than a solid. */
        for (s = 0; s < 2; s++) {
            double z = 0.0;

            for (q = 0; q < 4; q++) {
                int idx = base | (s << a) |
                          (((qord[q] >> 1) & 1) << o1) | ((qord[q] & 1) << o2);

                z += pz[idx];
            }
            if (z > fz) {
                fz    = z;
                front = s;
            }
        }

        for (s = 0; s < 2; s++) {
            double xs[4], ys[4];
            int    idxs[4];

            for (q = 0; q < 4; q++) {
                int idx = base | (s << a) |
                          (((qord[q] >> 1) & 1) << o1) | ((qord[q] & 1) << o2);

                xs[q]   = px[idx];
                ys[q]   = py[idx];
                idxs[q] = idx;
            }
            if (s == front) {
                /* panelled glass: a depth gradient across the pane, fine seams
                 * across it, and the truss that holds the pane in its frame */
                double dep = 0.5 + 0.5 * (pz[idxs[0]] + pz[idxs[2]]) * 0.5;

                if (near) {
                    cv_quad_tex(c, xs, ys, 70, 140, 235, 130, 190, 255,
                                (int)(17 + 15 * dep), 21, 5);
                    cv_line(c, xs[0], ys[0], xs[2], ys[2], 0.7,
                            155, 210, 255, 26);
                    cv_line(c, xs[1], ys[1], xs[3], ys[3], 0.7,
                            155, 210, 255, 26);
                } else {
                    cv_quad_tex(c, xs, ys, 70, 80, 190, 100, 115, 225,
                                (int)(9 + 9 * dep), 14, 3);
                    cv_line(c, xs[0], ys[0], xs[2], ys[2], 0.6,
                            135, 160, 245, 22);
                    cv_line(c, xs[1], ys[1], xs[3], ys[3], 0.6,
                            135, 160, 245, 22);
                }
            } else if (near) {
                cv_poly(c, xs, ys, 4, 80, 160, 250, 10);
            } else {
                cv_poly(c, xs, ys, 4, 110, 90, 200, 7);
            }
        }
    }

    for (i = 0; i < 8; i++) {
        for (e = 0; e < 3; e++) {
            int    j = i ^ (1 << e);
            double lit, x0, y0, x1, y1;
            int    al;

            if (j < i)
                continue;
            lit = 0.5 + 0.5 * (pz[base + i] + pz[base + j]) * 0.5;
            al = (int)(100 + 110 * lit);
            x0 = px[base + i]; y0 = py[base + i];
            x1 = px[base + j]; y1 = py[base + j];

            cv_line(c, x0, y0, x1, y1, 3.4 + 1.4 * lv,
                    near ? 40 : 80, near ? 110 : 60, 220, (int)(al * 0.22));
            cv_line(c, x0, y0, x1, y1, 2.4,
                    near ? 110 : 160, near ? 180 : 130, 250, al);
            cv_line(c, x0, y0, x1, y1, 1.0,
                    near ? 230 : 220, near ? 245 : 205, 255, (int)(al * 0.85));
        }
    }

    for (i = 0; i < 8; i++) {
        double x = px[base + i], y = py[base + i], dot = 2.0 + 2.4 * lv;

        if (near) {
            cv_soft(c, x, y, dot * 3.2, 120, 220, 255, 60);
            cv_ball(c, x, y, dot, 150, 235, 255, 255, 255, 255);
        } else {
            cv_soft(c, x, y, dot * 2.4, 190, 130, 255, 45);
            cv_ball(c, x, y, dot * 0.8, 170, 130, 255, 255, 240, 255);
        }
    }
}

/* the eight edges that carry the far cell out to the near one */
static void tess_links(Cv *c, const double *px, const double *py,
                       const double *pz, double lv)
{
    int i;

    for (i = 0; i < 8; i++) {
        double lit = 0.5 + 0.5 * (pz[i] + pz[i + 8]) * 0.5;
        int    al = (int)(70 + 90 * lit);

        cv_line(c, px[i], py[i], px[i + 8], py[i + 8], 4.0 + 1.5 * lv,
                60, 90, 190, (int)(al * 0.20));
        cv_line(c, px[i], py[i], px[i + 8], py[i + 8], 1.6,
                120, 140, 235, al);
    }
}

/* The sixteen corners of a hypercube, turned in four dimensions, split into
 * the two nested cubes that make a tesseract read as itself. The big cage and
 * the small ones are the same object at two sizes, which is why they look like
 * the same design instead of two drawings. */
static void tess_cage(double *px_, double *py_, double *pz_,
                      double cx, double cy, double sc_, double t,
                      double spin, double bloom, const double *dir)
{
    double x3[16], y3[16], z3[16];
    int    i, cell;

    for (i = 0; i < 16; i++) {
        T4 p;

        p.x = (i & 1) ? 1.0 : -1.0;
        p.y = (i & 2) ? 1.0 : -1.0;
        p.z = (i & 4) ? 1.0 : -1.0;
        p.w = (i & 8) ? 1.0 : -1.0;

        t4_rot(&p, 0, 3, t * 0.33 + spin);
        t4_rot(&p, 1, 2, t * 0.27 + 0.60 + spin * 0.7);
        t4_rot(&p, 0, 2, t * 0.19 + spin * 0.5);
        t4_rot(&p, 1, 3, t * 0.23 + 1.10 + spin * 0.3);

        x3[i] = p.x; y3[i] = p.y; z3[i] = p.z;
    }

    /* The fourth axis sets the two cubes' size. Each corner is pulled a little
     * toward an axis-aligned cube, which keeps the frame readable from every
     * angle instead of collapsing to an edge-on sliver - and since the corners
     * of one cell all sit on one sphere, the cubes stay concentric however far
     * the twist runs. */
    for (cell = 0; cell < 2; cell++) {
        double wf   = 1.35 / (1.35 - (cell ? 1.0 : -1.0) * 0.45);
        double grow = 1.0 + bloom * (cell ? 0.50 : 0.34);
        double span = 0.0;

        for (i = 0; i < 8; i++) {
            int    k = cell * 8 + i;
            double len = sqrt(x3[k] * x3[k] + y3[k] * y3[k] + z3[k] * z3[k]);

            if (len > span)
                span = len;
        }
        if (span < 1e-6)
            span = 1.0;

        for (i = 0; i < 8; i++) {
            int    k = cell * 8 + i;
            double ax = (k & 1) ? 0.5773503 : -0.5773503;
            double ay = (k & 2) ? 0.5773503 : -0.5773503;
            double az = (k & 4) ? 0.5773503 : -0.5773503;
            double X, Y, Z;

            X = (x3[k] / span * 0.58 + ax * 0.42) * 1.7320508 * wf * grow;
            Y = (y3[k] / span * 0.58 + ay * 0.42) * 1.7320508 * wf * grow;
            Z = (z3[k] / span * 0.58 + az * 0.42) * 1.7320508 * wf * grow;

            if (dir) {
                X += dir[0] * bloom * 0.42;
                Y += dir[1] * bloom * 0.42;
                Z += dir[2] * bloom * 0.42;
            }

            /* orthographic on purpose: a per-corner perspective divide would
             * pull the two cubes off center and undo the nesting */
            px_[k] = cx + X * sc_;
            py_[k] = cy + Y * sc_;
            pz_[k] = Z;
        }
    }
}

/* One of the small cages: its own light, its wake, its place in the floor. */
static void tess_sat_draw(Cv *c, const TessSat *s, double t, double big_sc,
                          const UiModel *m)
{
    double w = (double)c->w, h = (double)c->h;
    double ssc = big_sc * s->size;
    double sx = s->x * w, sy = s->y * h;
    double floor_y = h * 0.87;
    double px_[16], py_[16], pz_[16];
    int    i, e;

    tess_cage(px_, py_, pz_, sx, sy, ssc, t, s->spin, s->bounce * 0.5, NULL);

    cv_soft(c, sx, sy, ssc * (1.20 + 0.6 * s->bounce), 90, 170, 255,
            clampi((int)(26 + 90 * s->bounce), 0, 130));
    cv_line(c, sx - s->vx * w * 0.11, sy - s->vy * h * 0.11, sx, sy,
            1.6, 120, 190, 255, 30);

    for (i = 0; i < 16; i++) {
        for (e = 0; e < 4; e++) {
            int j = i ^ (1 << e);

            if (j < i)
                continue;
            cv_line(c, px_[i], 2.0 * floor_y - py_[i],
                    px_[j], 2.0 * floor_y - py_[j], 1.0, 70, 140, 230, 26);
        }
    }

    tess_cell(c, px_, py_, pz_, 0, (double)m->vis_level * 0.7);
    tess_cell(c, px_, py_, pz_, 1, (double)m->vis_level * 0.7);
}

static void art_tesseract(Cv *c, const UiModel *m)
{
    double   w = (double)c->w, h = (double)c->h;
    double   small_ = w < h ? w : h;
    double   t = m->elapsed_sec;
    double   lv = (double)m->vis_level;
    double   cx, cy, sc, bloom;
    double   px_[16], py_[16], pz_[16];
    int      i;

    tess_tick(m, w, h);
    bloom = s_tess.amp * exp(-s_tess.age * 3.0);

    cv_vgrad(c, 0, 0, c->w, c->h, 8, 10, 22, 4, 5, 12);

    /* the room: one-point perspective, so the cage has walls to bounce off */
    {
        double bx0 = w * 0.14, by0 = h * 0.13, bx1 = w * 0.86, by1 = h * 0.87;
        int    k;

        for (k = 1; k < 8; k++) {
            double u = (double)k / 8.0;

            cv_line(c, bx0 + (bx1 - bx0) * u, by0, bx0 + (bx1 - bx0) * u, by1,
                    1.0, 80, 130, 200, 14);
            cv_line(c, bx0, by0 + (by1 - by0) * u, bx1, by0 + (by1 - by0) * u,
                    1.0, 80, 130, 200, 14);
        }
        cv_line(c, bx0, by0, 0.0, 0.0, 1.4, 80, 140, 215, 34);
        cv_line(c, bx1, by0, w, 0.0, 1.4, 80, 140, 215, 34);
        cv_line(c, bx0, by1, 0.0, h, 1.4, 80, 140, 215, 34);
        cv_line(c, bx1, by1, w, h, 1.4, 80, 140, 215, 34);
        cv_line(c, bx0, by0, bx1, by0, 1.6, 120, 175, 240, 45);
        cv_line(c, bx1, by0, bx1, by1, 1.6, 120, 175, 240, 45);
        cv_line(c, bx1, by1, bx0, by1, 1.6, 120, 175, 240, 45);
        cv_line(c, bx0, by1, bx0, by0, 1.6, 120, 175, 240, 45);
    }

    {
        int i;

        for (i = 0; i < 54; i++) {
            double sx = fmod((double)i * 137.5 + t * (6.0 + (double)(i % 5)), w);
            double sy = fmod((double)i * 71.3 + t * (2.0 + (double)(i % 3) * 1.5), h);
            double tw = 0.5 + 0.5 * sin(t * 1.7 + (double)i * 0.9);

            cv_soft(c, sx, sy, 1.1 + (double)(i % 3) * 0.5, 200, 225, 255,
                    (int)(16 + 46 * tw * (0.4 + 0.6 * lv)));
        }
    }

    cx = s_tess.tx * w;
    cy = s_tess.ty * h;
    sc = small_ * 0.215;

    /* the bloom: rays thrown out along this beat's random direction */
    if (bloom > 0.03) {
        double base = atan2(s_tess.dir[1], s_tess.dir[0]);
        int    k;

        for (k = 0; k < 7; k++) {
            double ang = base + (double)(k - 3) * 0.24;
            double far = sc * (0.75 + 2.10 * bloom) * (k == 3 ? 1.0 : 0.55);
            int    al  = (int)(150 * bloom);

            if (al > 170) al = 170;
            cv_line(c, cx + cos(ang) * sc * 0.45, cy + sin(ang) * sc * 0.45,
                    cx + cos(ang) * (sc * 0.45 + far),
                    cy + sin(ang) * (sc * 0.45 + far),
                    k == 3 ? 3.2 : 1.6, 140, 225, 255, al);
        }
        cv_ring(c, cx, cy, sc * (0.80 + 1.30 * bloom), 2.2, 120, 215, 255,
                clampi((int)(90 * bloom), 0, 120));
    }
    cv_soft(c, cx, cy, sc * (1.30 + 0.35 * lv), 70, 150, 255,
            clampi((int)(22 + 30 * lv), 0, 60));

    tess_cage(px_, py_, pz_, cx, cy, sc, t, 0.0, bloom, s_tess.dir);

    /* the small cages behind the big one, so the scene has depth */
    for (i = 0; i < TESS_SATS; i++)
        if (s_tess.sat[i].y <= s_tess.ty)
            tess_sat_draw(c, &s_tess.sat[i], t, sc, m);

    /* depth order does the work: the far cell and the links are drawn, then
     * the emblem, then the near cell on top of it, so the logo really is shut
     * inside the cage instead of pasted over it */
    /* the cage reflected in the floor of the room, so it sits in the space
     * instead of floating in front of it */
    {
        double floor_y = h * 0.87;
        int    i, e;

        for (i = 0; i < 16; i++) {
            for (e = 0; e < 4; e++) {
                int j = i ^ (1 << e);

                if (j < i)
                    continue;
                cv_line(c, px_[i], 2.0 * floor_y - py_[i],
                        px_[j], 2.0 * floor_y - py_[j], 1.8,
                        70, 140, 230, 52);
            }
        }
    }

    /* earlier blooms still ringing outward, faintly */
    {
        int i;

        for (i = 0; i < 3; i++) {
            double age = s_tess.echo_age[i];

            if (age > 1.6)
                continue;
            cv_ring(c, cx, cy, sc * (0.9 + 1.5 * age), 1.8,
                    120, 210, 255, clampi((int)(70 * (1.0 - age / 1.6)), 0, 70));
        }
    }

    tess_links(c, px_, py_, pz_, lv);
    tess_cell(c, px_, py_, pz_, 0, lv);

    {
        /* The badge hangs dead centre. It does not fall, drift or bounce: the
         * cage blooms and the badge blooms with it, swelling and settling on
         * the same beat, and only turns where it hangs. */
        double grow = 1.0 + 0.62 * bloom;

        cv_soft(c, cx, cy, sc * (0.95 + 0.9 * bloom), 120, 200, 255,
                clampi((int)(26 + 90 * bloom), 0, 150));
        tess_badge(c, cx, cy, sc * 1.36 * grow,
                   s_tess.yaw, s_tess.pitch, s_tess.roll,
                   0.5 + 0.45 * sin(m->elapsed_sec * 0.55));

        cv_soft(c, cx, cy, sc * 0.55 * grow, 210, 240, 255,
                clampi((int)(18 + 60 * bloom), 0, 90));
    }

    tess_cell(c, px_, py_, pz_, 1, lv);

    /* the small cages in front of it, and the flash when one strikes it */
    for (i = 0; i < TESS_SATS; i++)
        if (s_tess.sat[i].y > s_tess.ty)
            tess_sat_draw(c, &s_tess.sat[i], t, sc, m);
    if (s_tess.hit > 0.05) {
        cv_ring(c, cx, cy, sc * (1.55 + 0.5 * s_tess.hit), 2.4, 160, 225, 255,
                clampi((int)(120 * s_tess.hit), 0, 140));
        cv_soft(c, cx, cy, sc * 1.2, 150, 210, 255,
                clampi((int)(70 * s_tess.hit), 0, 90));
    }

    /* the corners themselves: small glass nodes with their own light, sized by
     * depth, so the far cube reads as further away instead of merely thinner */
    {
        int n;

        for (n = 0; n < 16; n++) {
            double rad = sc * (0.019 + 0.007 * (pz_[n] + 1.0));
            double lit = 0.55 + 0.45 * lv + 0.35 * bloom;

            cv_soft(c, px_[n], py_[n], rad * 5.5, 90, 170, 255,
                    clampi((int)(18 + 40 * lit + 18 * bloom), 0, 120));
            cv_ball(c, px_[n], py_[n], rad, 110, 180, 240, 255, 255, 255);
        }
    }
}

/* ------------------------------------------------------------------ entry -- */

/* Resolution step for the big canvases. 1 paints at the frame's resolution, 2
 * at half, 3 at a third - chosen from a timer, not from a guess about the
 * hardware. The small panel on the music screen is never stepped. */
static int    s_q_step = 1;
static double s_q_avg;
/* What each step actually cost last time it was used, and when we last dropped
 * quality. Both exist so the ladder stops hunting: a look that sits on the
 * threshold used to climb, measure, fall, and climb again forever. */
static double s_q_cost[4];
static double s_q_t_down;
static double s_q_t_last;
static int    s_q_last_style = -1;
#define SQ_SETTLE_MS 5000.0   /* after dropping quality, stay here this long */
#define SQ_MARGIN    0.92     /* a step only counts as affordable below this */
static int    s_q_n;
static int    s_force_step;
static int    s_force_read;

/* ---- what the ladder judges ---------------------------------------------
 * The look's own drawing is barely half of a frame on the console: the rest is
 * SDL_RenderFlush, which is where the queued drawing actually runs, plus the
 * present and the flip the display waits on. Judging only the drawing is why a
 * 100 ms frame reached the ladder as about 70 ms, stayed under the 88 ms limit
 * and never dropped to step 3. main() reports the whole frame once per frame
 * through vis_art_frame_ms() and the ladder uses that number instead. */
static int    s_drew;            /* a look was drawn since the last report */
static double s_frame_ms;
static int    s_frame_ready;

void vis_art_frame_ms(double frame_ms)
{
    if (!s_drew)
        return;
    s_drew = 0;
    s_a3_frames++;
    if ((s_a3_frames % 60ULL) == 0ULL)
        a3_emit();
    if (frame_ms > 0.0) {
        s_frame_ms    = frame_ms;
        s_frame_ready = 1;
    }
}

static double art_now_ms(void)
{
    return (double)SDL_GetTicks();
}

int vis_art_step(void)
{
    return s_q_step;
}

/* VIS_STEP=2 or 3 pins the step, so the reduced path can be looked at without
 * waiting for a slow machine to choose it. */
static void force_step_read(void)
{
    const char *e;

    if (s_force_read)
        return;
    s_force_read = 1;
    e = getenv("VIS_STEP");
    if (e && e[0] >= '1' && e[0] <= '3' && e[1] == '\0')
        s_force_step = e[0] - '0';
}

int vis_art_draw(SDL_Renderer *r, const UiModel *m, int style,
                 int x, int y, int w, int h)
{
    Cv  c;
    int step, ok;
    double big, t0;

    if (style < 0 || style >= VIS_STYLE_COUNT)
        style = VIS_STYLE_SPECTRUM;
    if (w < 32 || h < 24)
        return 0;

    /* The settings are read out of config.ini from here on; this only fills
     * the defaults in, which the host preview relies on. */
    cfg_ready();

    peaks_track(m);
    force_step_read();

    /* Painted at the frame's own resolution by default - half resolution was
     * the main thing making every look look soft. A big canvas that cannot
     * hold its frame time steps down on its own (see the timer below) instead
     * of stuttering, and steps back up when there is room again. */
    big = (double)w * (double)h;
    t0  = big > 400000.0 ? art_now_ms() : 0.0;
    step = big > 400000.0 ? s_q_step : 1;
    if (s_force_step)
        step = s_force_step;
    if (step < 1)
        step = 1;
    s_paint_step = step;
    if (s_a3_frames && (style != s_a3_style || step != s_a3_step))
        a3_emit();
    s_a3_style = style;
    s_a3_step = step;
    s_bloom_boost = (style == VIS_STYLE_RAVE) ? RV_BLOOM_GAIN : 1.0;
    c.w = w / step;
    c.h = h / step;
    if (c.w < 32)
        c.w = w;
    if (c.h < 24)
        c.h = h;
    c.p = cv_get(c.w, c.h);
    if (!c.p)
        return 0;
    /* Rave's first act is to copy a full-canvas base over the frame, so for that
     * one look the clear is a megapixel written and immediately overwritten.
     * Every other look starts from it. */
    if (style != VIS_STYLE_RAVE)
        cv_fill(&c, 8, 10, 18);

    switch (style) {
    case VIS_STYLE_SPECTRUM: art_spectrum(&c, m); break;
    case VIS_STYLE_WAVE:     art_wave(&c, m);     break;
    case VIS_STYLE_RADIAL:   art_radial(&c, m);   break;
    case VIS_STYLE_PULSE:    art_pulse(&c, m);    break;
    case VIS_STYLE_MIRROR:   art_mirror(&c, m);   break;
    case VIS_STYLE_BLOCKS:   art_blocks(&c, m);   break;
    case VIS_STYLE_SCOPE:    art_scope(&c, m);    break;
    case VIS_STYLE_ORBIT:    art_orbit(&c, m);    break;
    case VIS_STYLE_NEON:     art_neon(&c, m);     break;
    case VIS_STYLE_LIQUID:   art_liquid(&c, m);   break;
    case VIS_STYLE_FLAG:     art_flag(&c, m);     break;
    case VIS_STYLE_WORM:     art_worm(&c, m);     break;
    case VIS_STYLE_WINDMILL: art_windmill(&c, m); break;
    case VIS_STYLE_DANCE:
        dance_stage(&c, m, 1);
        dance_pose(&c, m, VIS_STYLE_DANCE);
        break;
    case VIS_STYLE_DANCE2:
        dance_stage(&c, m, 0);
        dance_pose(&c, m, VIS_STYLE_DANCE2);
        break;
    case VIS_STYLE_DANCE3:
        dance_stage(&c, m, 0);
        dance_pose(&c, m, VIS_STYLE_DANCE3);
        break;
    case VIS_STYLE_TESSERACT:
        art_tesseract(&c, m);
        break;
    default:
        art_rave(&c, m);
        break;
    }

    /* each look gets its own last layer: a floor to stand on, a sky behind it,
     * or the hardware it would be built into */
    switch (style) {
    case VIS_STYLE_SPECTRUM:
        fx_wall(&c, 70, 105, 170, 24);
        fx_reflect(&c, h * 0.86, 0.55, 0.55);
        break;
    case VIS_STYLE_WAVE:
        fx_grid_hint(&c, 60, 120, 190, 26);
        fx_reflect(&c, h * 0.50, 0.30, 0.90);
        break;
    case VIS_STYLE_RADIAL:
        fx_reflect(&c, h * 0.64, 0.32, 0.25);
        break;
    case VIS_STYLE_PULSE:
        fx_reflect(&c, h * 0.62, 0.30, 0.35);
        break;
    case VIS_STYLE_MIRROR:
        fx_reflect(&c, h * 0.55, 0.42, 0.65);
        break;
    case VIS_STYLE_BLOCKS:
        fx_bezel(&c);
        break;
    case VIS_STYLE_SCOPE:
        fx_ticks(&c, 70, 200, 120, 120);
        fx_reflect(&c, h * 0.50, 0.22, 0.0);
        break;
    case VIS_STYLE_ORBIT:
        fx_stars(&c, m->elapsed_sec, 90, h);
        fx_reflect(&c, h * 0.58, 0.28, 0.20);
        break;
    case VIS_STYLE_NEON:
        fx_stars(&c, m->elapsed_sec * 0.6, 70, h * 0.55);
        fx_reflect(&c, h * 0.62, 0.34, 0.15);
        break;
    case VIS_STYLE_FLAG:
        fx_reflect(&c, h * 0.90, 0.30, 0.20);
        break;
    case VIS_STYLE_DANCE:
    case VIS_STYLE_DANCE2:
    case VIS_STYLE_DANCE3:
        fx_reflect(&c, h * 0.884, 0.34, 0.16);
        break;
    case VIS_STYLE_WORM:
        fx_reflect(&c, h * 0.78, 0.22, 0.12);
        break;
    case VIS_STYLE_WINDMILL:
        fx_stars(&c, m->elapsed_sec, 120, h * 0.55);
        fx_reflect(&c, h * 0.66, 0.26, 0.10);
        break;
    case VIS_STYLE_RAVE:
        fx_lasers(&c, m->elapsed_sec, (double)m->vis_level, h * 0.55);
        break;
    default:
        break;
    }

    art_finish(&c, m);
    ok = art_present(r, &c, x, y, w, h);

    /* this frame drew a look, so main will hand back what the whole frame cost */
    s_drew = 1;

    if (t0 > 0.0 && !s_force_step) {
        double now = art_now_ms();
        double dt  = s_frame_ready ? s_frame_ms : (now - t0);

        s_frame_ready = 0;

        /* A different style is a different workload, so what the last one cost
         * at each step says nothing about this one. Forget it, and let this one
         * be measured from scratch instead of being judged on another look's
         * numbers. */
        if (style != s_q_last_style) {
            s_q_last_style = style;
            s_q_cost[1] = s_q_cost[2] = s_q_cost[3] = 0.0;
            s_q_avg = 0.0;
            s_q_n   = 0;
            /* a new style may also bring a new ceiling from config.ini */
            if (s_q_step > cfg.quality.max_step)
                s_q_step = cfg.quality.max_step;
        }
        s_q_avg = s_q_n ? s_q_avg * 0.85 + dt * 0.15 : dt;
        if (s_q_step >= 1 && s_q_step <= 3)
            s_q_cost[s_q_step] = s_q_cost[s_q_step] > 0.0
                               ? s_q_cost[s_q_step] * 0.85 + dt * 0.15 : dt;
        if (s_q_n < 100)
            s_q_n++;
        if (s_q_n >= 8) {
            /* Full resolution is the default and the point: the picture stays
             * sharp until a frame is genuinely over budget, not merely slower
             * than a desktop refresh. Only a look that cannot hold ~17 fps steps
             * down.
             *
             * Going back up is decided on the *remembered* cost of the better
             * step, not on how fast the current one is: at step 2 a heavy look
             * runs at 21 ms, which says nothing about whether step 1 fits, and
             * judging by it is what made the ladder flap. And once quality has
             * been dropped it stays dropped for a few seconds, because every
             * change is a visible pop and a look on the threshold would
             * otherwise hunt. */
            double budget = s_q_step == 1 ? cfg.quality.budget_step1_ms
                                          : cfg.quality.budget_ms;

            if (s_q_avg > budget && s_q_step < cfg.quality.max_step) {
                log_msg(LOG_INFO, "vis",
                        "quality step %d -> %d (reason: over budget, %.1f ms > %.0f ms at %dx%d, style %d %s)",
                        s_q_step, s_q_step + 1, s_q_avg, budget,
                        w / s_q_step, h / s_q_step, style,
                        vis_style_name(style));
                s_q_step++;
                s_q_t_down = now;
                s_q_avg = 0.0;
                s_q_n = 0;
            } else if (s_q_step > 1) {
                int    better = s_q_step - 1;
                double need   = better == 1 ? cfg.quality.budget_step1_ms
                                            : cfg.quality.budget_ms;
                double settle = cfg.quality.settle_seconds * 1000.0;
                double was    = s_q_cost[better];
                double hold   = now - s_q_t_down;

                if (was > 0.0 && was < need * SQ_MARGIN
                    && hold > settle) {
                    log_msg(LOG_INFO, "vis",
                            "quality step %d -> %d (reason: step %d measured %.1f ms, under %.0f ms budget; %.1f s since last drop, at %dx%d, style %d %s)",
                                  s_q_step, better, better, was, need,
                                  hold / 1000.0, w / s_q_step, h / s_q_step,
                                  style, vis_style_name(style));
                    s_q_step = better;
                    s_q_avg = 0.0;
                    s_q_n = 0;
                } else if (was > 0.0 && hold <= settle
                           && was < need * SQ_MARGIN
                           && now - s_q_t_last > 2000.0) {
                    /* said once every few seconds, so the log shows why a look
                     * that could climb is not climbing */
                    s_q_t_last = now;
                    log_msg(LOG_DEBUG, "vis",
                            "holding step %d (reason: step %d measured %.1f ms would fit, but only %.1f s of the %.0f s settle)",
                            s_q_step, better, was, hold / 1000.0,
                            cfg.quality.settle_seconds);
                }
            }
        }
    }
    return ok;
}
